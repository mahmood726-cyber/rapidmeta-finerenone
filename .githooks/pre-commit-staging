#!/bin/sh
# CLASS 3 RULE MADE MECHANICAL: stage by path, never `git add -A`.
# Prose did not hold it -- the rule was broken in the commit immediately after
# it was written. This refuses a commit that stages files outside ssot/,
# scripts/, .githooks/, evidence/, or a top-level markdown/config file, unless
# STAGING_WIDE=1 is set deliberately.
#
# evidence/ ADDED 2026-08-31. It is a TRACKED directory holding 30+ committed files and the
# set above never named it, so every commit that adds evidence had to reach for
# STAGING_WIDE=1. TWO LANES HIT THAT IN ONE NIGHT.
#
# A guard lanes route around stops being a guard: the override gets used often enough to
# become reflex, and is then available for the case the guard exists to catch. The refusals
# were correct about the letter and wrong about the set.
#
# tests/ ADDED 2026-08-31, for the identical reason and by the identical evidence: it is a
# TRACKED directory holding 61 committed files, the set never named it, and a lane adding a
# test file was refused. Naming it is the remedy this file already prescribes for evidence/;
# reaching for STAGING_WIDE=1 to add a test is exactly the reflex the note above warns about.
# The recurrence is itself the finding -- the set was enumerated from habit rather than from
# `git ls-files`, so it will keep missing tracked directories until it is derived from them.
#
# corrections/ ADDED 2026-09-01, and the reason is the strongest of the three. A correction is
# a RETRACTION RECORD. If it is untracked it does not travel: it works for whoever wrote it and
# is absent for every other lane and every fresh clone -- the exact failure that hit two guards
# last night, whose inputs sat in a directory that could not travel, so they passed for their
# author and failed closed for everyone else. Of all the things in this repository, the record
# of what we got WRONG is the one that most needs to survive a clone.
#
# This is the third directory named here, and that pattern is itself the finding: the set was
# enumerated from habit rather than from `git ls-files`, so it keeps missing directories one at
# a time. It is still NOT widened to every tracked directory -- outputs/, findings/, protocols/,
# nma/, vendor/ and retired/ remain outside, deliberately, because a set that names everything
# refuses nothing.
#
# The purpose is unchanged and is NOT widened. This still exists to refuse `git add -A`, and
# it still refuses everything outside the named prefixes and a top-level markdown/config file.
changed=$(git diff --cached --name-only)
bad=$(printf '%s\n' "$changed" | grep -vE '^(ssot/|scripts/|\.githooks/|evidence/|tests/|corrections/|[A-Za-z0-9_.-]+\.(md|json|txt|yml|yaml)$|\.gitignore$)' | head -20)
if [ -n "$bad" ] && [ "$STAGING_WIDE" != "1" ]; then
  echo "REFUSED: staged paths outside the declared set." >&2
  echo "$bad" >&2
  echo "" >&2
  echo "This is the 'git add -A' guard. If these files are genuinely yours and" >&2
  echo "belong in this commit, re-run with STAGING_WIDE=1 -- deliberately." >&2
  exit 1
fi
exit 0
