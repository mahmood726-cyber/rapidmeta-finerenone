#!/bin/sh
# Refuse a commit whose staged diff net-deletes from an SSOT object.
#
# WHY A HOOK AND NOT A HELPER: scripts/rebuild_guard.py was written for this exact
# defect and committed the day before it recurred. It did not fire, because the
# offending script used a different write path. A guard that must be remembered is
# not a guard -- an available mechanism is not an operative one.
#
# Override with a reason on the record:
#   SSOT_ALLOW_NET_DELETION="why" git commit ...
python "$(git rev-parse --show-toplevel)/scripts/ssot_net_deletion_check.py" || exit 1

# class-3 staging guard
sh "$(git rev-parse --show-toplevel)/.githooks/pre-commit-staging" || exit 1

python "$(git rev-parse --show-toplevel)/scripts/lint_subprocess_decode.py" >/dev/null || { echo "REFUSED: subprocess decode-hazard sites present (scripts/lint_subprocess_decode.py)"; exit 1; }

# HEREDOC MANGLING, both halves. The class recurred EIGHT times in one night against an author
# who had read, written, and committed the rule. Prose does not hold it; these two do.
#   control chars in SOURCE  -- the shell-transport path (`\b` arriving as 0x08)
#   escape hazards in VALUES -- the non-raw-literal path, which leaves the source byte-clean
R="$(git rev-parse --show-toplevel)"
python "$R/scripts/lint_control_chars.py"   >/dev/null || { echo "REFUSED: control characters in tracked text (scripts/lint_control_chars.py)"; exit 1; }
python "$R/scripts/lint_escape_hazards.py"  >/dev/null || { echo "REFUSED: escape hazards in pattern literals (scripts/lint_escape_hazards.py)"; exit 1; }

# E8 -- a shipped page must name a build command that exists and a commit that RESOLVES.
# The stamp was always honest; nothing ever asserted it named something real.
python "$R/scripts/generator_stamp_gate.py" >/dev/null || { echo "REFUSED: a gated page carries a generator stamp that names nothing checkable (scripts/generator_stamp_gate.py)"; exit 1; }

# A FILE NAMED *_gate.py MUST BE ABLE TO FAIL. The name is a promise. Four files named gate had
# no reachable non-zero exit -- they were correctly-built TRIAGE tools wearing the wrong name,
# and are now *_triage.py. This stops the fifth being written tomorrow.
python "$R/scripts/lint_gate_can_fail.py" >/dev/null || { echo "REFUSED: a file named *_gate.py cannot fail (scripts/lint_gate_can_fail.py)"; exit 1; }

# ABSENCE IS NOT ZERO. 3 of 135 topics carry a k_cascade; 132 have never had k counted. Any
# summary that adds NO_CASCADE to remainder:0 declares a false all-clear over 132 topics.
python "$R/scripts/lint_no_false_allclear.py" >/dev/null || { echo "REFUSED: code turns an uncounted topic into a clear one (scripts/lint_no_false_allclear.py)"; exit 1; }

# A REVIEW QUESTION MUST NOT BE ONE OF ITS TRIALS' REGISTRY FIELDS.
python "$R/scripts/lint_question_is_a_question.py" >/dev/null || { echo "REFUSED: a NEW topic's question/title is a copied registry field, above the known baseline (scripts/lint_question_is_a_question.py) -- see BLOCKED-ablation-af-review-2026-08-19.md"; exit 1; }

# A STORED BLOCK MAY NOT ASSERT A STATE THE OBJECT CONTRADICTS. P6 once refused with a reason
# that was not true -- "k=1, no meta-analysis was performed" on an object that pooled six.
python "$R/scripts/lint_block_contradicts_object.py" >/dev/null || { echo "REFUSED: a stored block asserts a state its own object contradicts (scripts/lint_block_contradicts_object.py)"; exit 1; }

# RESTRAINT (E4). Every other check here catches overreach. This one catches an instrument
# REFUSING where an independent instrument decides -- the class that silently shrank evidence
# bases corpus-wide and that no guard could see, because withholding leaves no trace in the
# object. A ratchet: findings are DISAGREEMENTS to adjudicate, not proven defects, so it blocks
# on an increase rather than on a nonzero count.
python "$R/scripts/lint_restraint.py" >/dev/null || { echo "REFUSED: new restraint candidate(s) -- an instrument refuses where an independent one decides (scripts/lint_restraint.py)"; exit 1; }

# IDENTIFIERS FROM RECALL. A recalled id in a build makes a wrong value; in an AUDIT it makes
# an accusation, and nothing audits the auditor. Exit 2 = empty vocabulary, which is a broken
# instrument, not a pass.
python "$R/scripts/lint_identifier_pairing.py" >/dev/null
case $? in
  0) ;;
  1) echo "REFUSED: a registration id is written beside another trial's acronym (scripts/lint_identifier_pairing.py)"; exit 1 ;;
  *) echo "REFUSED: identifier-pairing check could not run -- empty acronym vocabulary. A check with nothing to check against passes everything."; exit 1 ;;
esac

# ROUTE 7 -- A SCREENER THAT ASKS THE NEIGHBOURING TOPIC'S QUESTION UNDER THIS TOPIC'S NAME.
# The six earlier contamination routes carried one topic's DATA; this carries its CRITERIA, and
# the output is complete, plausible and INVERTED. A sed-renamed sibling screener parses, imports,
# runs, and passes every other detector in this file -- proven by planting the regenerated
# artefact (scripts/prove_criteria_fingerprint.py). Only a behavioural fingerprint sees it.
python "$R/scripts/lint_criteria_fingerprint.py" >/dev/null || { echo "REFUSED: a screener does not implement its own review's criteria (scripts/lint_criteria_fingerprint.py)"; exit 1; }

# THE VERSION MARKER THAT MAKES STALENESS VISIBLE WENT STALE, AND NOTHING NOTICED FOR SEVEN
# BUMPS. PAGE-STANDARD.md said 1.6.0, its own newest log entry said 1.12.0, and the builder
# stamped 1.13.0. Nothing shipped wrong -- pages carry the CODE's version -- which is precisely
# why it survived: the drift had NO DOWNSTREAM SYMPTOM. On its first live run this gate found a
# second drift of the same kind in the same file: ten properties listed and never dated.
python "$R/scripts/standard_version_agreement_gate.py" >/dev/null || { echo "REFUSED: PAGE-STANDARD.md, its version log and ssot/build_to_standard.py do not agree on the standard version (scripts/standard_version_agreement_gate.py)"; exit 1; }

# A BARE STRING WHERE A COLLECTION OF TERMS IS EXPECTED. `locate(study, "bococizumab")` made
# `any(s in blob for s in syns)` iterate CHARACTERS -- every arm matched on single letters, the
# cascade read a perfectly ordinary 17/0/0/5, and one of the review's own included trials was
# excluded because its ATORVASTATIN arm "contained bococizumab". No exception, no null, nothing
# malformed: THE WRONG ANSWER HAS THE SHAPE OF THE RIGHT ONE. Caught only by a known-answer
# trial falling out. Runtime half: topic_identity.require_terms().
python "$R/scripts/lint_string_where_collection_expected.py" >/dev/null || { echo "REFUSED: a bare string reaches a parameter that is membership-tested (scripts/lint_string_where_collection_expected.py)"; exit 1; }
python "$R/scripts/lint_pmid_names_two_trials.py" >/dev/null || { echo "REFUSED: one PMID is attributed to two different trials somewhere in the corpus (scripts/lint_pmid_names_two_trials.py). It is wrong on at least one side and the command cannot say which -- look both up."; exit 1; }
python "$R/scripts/lint_refusal_contradicted_by_its_own_section.py" >/dev/null || { echo "REFUSED: a page opens a tab by denying something it then prints (scripts/lint_refusal_contradicted_by_its_own_section.py). A refusal contradicted by the content beneath it reads as diligence and is false. Re-run with --repair."; exit 1; }
python "$R/scripts/sweep_mojibake.py" --gate >/dev/null || { echo "REFUSED: a delivered page carries a double-encoded character (scripts/sweep_mojibake.py --gate). The GENERATOR that produces them is UNTRACED, so this cannot be assumed fixed. Re-run: python scripts/fix_double_encoded_delivered_pages.py --apply"; exit 1; }
python "$R/scripts/dashboard_projection_gate.py" >/dev/null || { echo "REFUSED: the dashboard data is stale against the objects, or serves a pooled estimate for a topic whose object withdrew one (scripts/dashboard_projection_gate.py). Re-run: python scripts/project_dashboard_index.py --apply"; exit 1; }

# A PUBLISHED ESTIMATE THE PAGE CANNOT DISPLAY IS ONE NOBODY CAN VERIFY. Twice in one
# session, on the first two CONTINUOUS endpoints ever gated: the object stored four
# DECIMALS and the page renders four SIGNIFICANT FIGURES, so the stored string appeared
# nowhere in the delivered bytes and verify_delivered_bytes.py refused -- AFTER a deploy.
# A ratchet, not a block: 13 topics predate it and are baselined, unabsolved.
python "$R/scripts/lint_pooled_point_is_displayable.py" >/dev/null || { echo "REFUSED: a NEW pooled point is stored at a precision the page cannot render (scripts/lint_pooled_point_is_displayable.py)"; exit 1; }

# E10 -- CURSOR ABANDONMENT. A search that returned fewer records than it REPORTED must say
# so. colchicine returned 100 of 137 with a live cursor, and CLEAR SYNERGY (n=7264) -- one of
# that review's own three included trials, and the largest -- is on page 2 only. A partial
# page produces a cascade that reconciles with itself and is missing trials, in the direction
# that makes a review look FINISHED. A DECLARED shortfall passes; an undeclared one is the
# defect. Same class as the phase filter that cost apixaban NCT02366871, by a different route.
python "$R/scripts/lint_search_pagination_declared.py" >/dev/null || { echo "REFUSED: a search returned fewer records than it reported and does not declare the shortfall (scripts/lint_search_pagination_declared.py)"; exit 1; }

# P35 -- THE PRIMARY OUTCOME IS READ BY MATCHING ITS TEXT, NEVER BY POSITION.
# `outcomeMeasures[0]` is ADVANCE-2's SECONDARY and its three companions' PRIMARY. A pool built
# on element zero is WRONG WITH NOTHING MALFORMED ANYWHERE -- no parse error, no null, no
# missing key, four numbers of the right shape. There is no downstream symptom to notice, which
# is why prose cannot hold this class. Twelve baselined sites remain and are printed, unabsolved.
python "$R/scripts/lint_primary_by_position.py" >/dev/null || { echo "REFUSED: a new positional read of an outcome collection (scripts/lint_primary_by_position.py)"; exit 1; }

# P33 + P36 -- COMPOSITES ARE COMPARED BY COMPONENTS, NEVER BY NAME.
# "total VTE + VTE-RELATED death" and "VTE + ALL-CAUSE death" are the same name and different
# endpoints. Three instances in one night, and heterogeneity settled none of them: mismatched
# estimands pooled at 0.0%, 3.9% and 83.6%. Pooling a mismatch may be right; doing it SILENTLY
# never is, so the block is on an unrecorded mismatch, not on mismatch.
python "$R/scripts/lint_composite_by_components.py" >/dev/null || { echo "REFUSED: a pool combines endpoints with different component sets and records no component_mismatch (scripts/lint_composite_by_components.py)"; exit 1; }

# E4 -- A REFUSAL TO POOL MUST HAVE LOOKED BELOW THE PRIMARY.
# Withholding leaves NO trace in the object, which is why this guard is about the process and
# not the result. 115 topics decline at least one outcome; 46 carry no evidence that anything
# below the primary was ever read. Two of exactly that shape became real pooled estimates
# tonight, one of them replacing a k=1 figure that measured a different question entirely.
python "$R/scripts/lint_withholding_asked.py" >/dev/null
case $? in
  0) ;;
  1) echo "REFUSED: a new refusal to pool with no evidence that any rank below the primary was read (scripts/lint_withholding_asked.py)"; exit 1 ;;
  *) echo "REFUSED: the withholding check found NO topic declining anything -- its vocabulary no longer matches the objects. A check with nothing to check against passes everything."; exit 1 ;;
esac

# AND THE OTHER HALF OF E4: the check above proves the question was ASKED. This one proves the
# corpus is not publishing only the answers it likes. Every earlier instance RECOVERED a pool --
# sglt2-hf, apixaban prophylaxis 3 -> 8 -- and a check that has only ever returned the
# convenient answer cannot be told apart from no check. apixaban TREATMENT ran the identical
# discipline and went 8 -> 3, costing it the two largest trials in its field. Neither number is
# publishable without the other, so an object stating one is refused.
python "$R/scripts/lint_withholding_direction_paired.py" >/dev/null
case $? in
  0) ;;
  1) echo "REFUSED: an object states its withholding direction without a counter-instance that exists, points back, and runs the other way (scripts/lint_withholding_direction_paired.py)"; exit 1 ;;
  *) echo "REFUSED: NO object declares a withholding direction -- the check has nothing to check against, which is a broken instrument and not a clean corpus."; exit 1 ;;
esac
