#!/usr/bin/env bash
# RapidMeta pre-push regression hook.
#
# Runs regression_check.py against all 53 *_REVIEW.html apps to verify none
# of the 7 signals (page errors, trials seeded, auto-include, RoB banner,
# protocol link, WebR tag, pool computes) have regressed before pushing.
#
# Install once per clone with:  git config core.hooksPath .githooks
# Skip with:                    SKIP_REGRESSION=1 git push
# Runtime: ~60 seconds (headless chromium walk over 53 apps).

set -e

if [ "$SKIP_REGRESSION" = "1" ]; then
    echo "[pre-push] Regression check skipped via SKIP_REGRESSION=1"
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
SCRIPT="$REPO_ROOT/scripts/regression_check.py"

if [ ! -f "$SCRIPT" ]; then
    echo "[pre-push] regression_check.py not found at $SCRIPT -- skipping."
    exit 0
fi

# Require a running HTTP server on 127.0.0.1:8787 OR start a short-lived one.
PORT=8787
if ! curl -sf "http://127.0.0.1:$PORT/index.html" > /dev/null 2>&1; then
    echo "[pre-push] Starting local HTTP server on :$PORT ..."
    ( cd "$REPO_ROOT" && python -m http.server $PORT --bind 127.0.0.1 > /dev/null 2>&1 ) &
    SERVER_PID=$!
    sleep 2
    trap 'kill $SERVER_PID 2>/dev/null || true' EXIT
fi

echo "[pre-push] Running 53-app regression check ..."
# STATUS must be the exit code of python, NOT of tail. `cmd | tail` makes a bare
# `$?` read tail's status, which is always 0 -- that made this gate structurally
# incapable of failing (it printed PASS while regression_check.py was crashing on
# a missing Playwright browser, having checked 0 of 53 apps). Capture PIPESTATUS[0].
# errexit is lifted around the pipeline so we can report the code instead of
# aborting silently on it.
set +e
set -o pipefail
python "$SCRIPT" --base-url "http://127.0.0.1:$PORT" 2>&1 | tail -15
STATUS=${PIPESTATUS[0]}
set +o pipefail
set -e

RESULTS="$REPO_ROOT/regression_results.json"

if [ "$STATUS" -eq 2 ]; then
    echo ""
    echo "[pre-push] Regression check COULD NOT RUN (precondition failed: no HTTP server,"
    echo "           no apps matched, or the Playwright browser is not installed)."
    echo "           A run that could not execute is NOT a pass. Push blocked."
    echo "           If the browser is missing:  python -m playwright install chromium"
    echo "           Inspect $RESULTS"
    exit 1
fi

if [ "$STATUS" -ne 0 ]; then
    echo ""
    echo "[pre-push] Regression check FAILED (exit $STATUS). Inspect $RESULTS."
    echo "          Override with: SKIP_REGRESSION=1 git push"
    exit 1
fi

echo "[pre-push] Regression check PASS (python exit 0). Proceeding with push."
exit 0
