#!/usr/bin/env bash
# RapidMeta pre-push regression hook.
#
# Runs scripts/regression_check.py over the *_REVIEW.html pages THIS PUSH TOUCHES
# and blocks the push if any of the 7 signals fire (page errors, trials seeded,
# auto-include, RoB banner, protocol link, WebR tag, pool computes).
#
# Install once per clone with:  git config core.hooksPath .githooks
#
# ---------------------------------------------------------------------------
# WHY THIS FILE WAS REWRITTEN, 2026-08-12
#
# The previous version could not fail, for two independent reasons, and so every
# push this repository has ever made was effectively ungated:
#
#   1.  python "$SCRIPT" 2>&1 | tail -15
#       STATUS=$?
#     `$?` after a pipeline is the LAST stage's status, so STATUS read `tail`,
#     which is always 0. The `if [ $STATUS -ne 0 ]` branch was unreachable.
#
#   2. scripts/regression_check.py contained no sys.exit at all. Even with the
#     pipe fixed it exited 0 whatever it found. Both layers had to be repaired;
#     fixing either alone would have left the gate inert.
#
# A third defect made it unusable rather than merely useless: the header claimed
# "53 apps ... ~60 seconds", but the script globs every *_REVIEW.html in the repo
# -- 1,449 of them -- so a push sat in a headless-browser walk for hours. That is
# what made bypassing it feel reasonable, which is how a broken guard survives.
#
# There is deliberately NO skip flag. The previous SKIP_REGRESSION escape existed
# because the gate was slow and inert; scoping it to the pushed pages removes the
# reason to skip. A push that touches no app page now checks nothing and passes in
# under a second, which is a scoped pass and not a bypass.
# ---------------------------------------------------------------------------

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
SCRIPT="$REPO_ROOT/scripts/regression_check.py"

if [ ! -f "$SCRIPT" ]; then
    echo "[pre-push] regression_check.py not found at $SCRIPT" >&2
    echo "[pre-push] Refusing to pass a check that is not present." >&2
    exit 1
fi

# Which app pages does this push actually change? git feeds the hook
# "<local ref> <local sha> <remote ref> <remote sha>" on stdin, one line per ref.
CHANGED=""
INDEX_TOUCHED=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac   # deletion, nothing to check
    case "$remote_sha" in
        *[!0]*) RANGE="$remote_sha..$local_sha" ;;
        *)      RANGE="$local_sha" ;;                      # new branch
    esac
    FILES="$(git diff --name-only "$RANGE" -- '*_REVIEW.html' 2>/dev/null || true)"
    CHANGED="$CHANGED $FILES"
    if git diff --name-only "$RANGE" -- 'index.html' 2>/dev/null | grep -q .; then
        INDEX_TOUCHED=1
    fi
done

CHANGED="$(printf '%s\n' $CHANGED | sed '/^$/d' | sort -u | xargs -r basename -a 2>/dev/null || true)"

# ---------------------------------------------------------------------------
# INDEX MARKUP GATE, added 2026-08-17.
#
# Everything above this line looks only at *_REVIEW.html. index.html -- the root,
# the surface Mahmood actually opens to decide whether a thing is done, and the
# one file edited BY HAND on nearly every deploy -- sat outside every gate in
# this repository. On 2026-08-17 a superseded card was rewritten without closing
# its <span>, so the replacement card shipped nested INSIDE the old card's
# anchor. An <a> inside an <a> is invalid HTML and no two browsers repair it the
# same way.
#
# The generator does not produce this defect: a sweep of all 1,486 root HTML
# pages found zero. It is a hand-edit defect on the one hand-edited file, which
# is exactly the file nothing was watching. Scope follows edit method, not file
# type -- that is the general lesson, and the reason this block exists.
# ---------------------------------------------------------------------------
if [ -n "$INDEX_TOUCHED" ]; then
    GATE="$REPO_ROOT/scripts/index_markup_gate.py"
    if [ ! -f "$GATE" ]; then
        echo "[pre-push] index.html is in this push but index_markup_gate.py is missing." >&2
        echo "[pre-push] Refusing to pass a check that is not present." >&2
        exit 1
    fi
    echo "[pre-push] index.html touched; checking root markup ..."
    set +e
    python "$GATE" "$REPO_ROOT/index.html"
    IDX_STATUS=$?
    set -e
    if [ "$IDX_STATUS" -ne 0 ]; then
        echo ""
        echo "[pre-push] Root index markup FAILED: nested/unclosed anchors, or a card"
        echo "[pre-push] pointing at a page that does not exist. This gate has no override."
        exit 1
    fi
    echo "[pre-push] Root index markup PASS."
fi

# ---------------------------------------------------------------------------
# DURABLE ARTEFACT GATE, added 2026-08-17. Runs on EVERY push, unscoped.
#
# The waiver register was written to outputs/, which is gitignored. It wrote
# fine, read back fine, and the gate consuming it worked -- on this machine and
# nowhere else. A backlog that cannot be committed is not a backlog, and 51
# pages meant to be COUNTED would have silently become 51 pages nobody tracked.
#
# Unscoped deliberately: the artefacts it guards are exactly the ones no push
# "touches", so a scoped check would never look at them. That was the same
# reasoning error as the index -- scope followed what changed, when the risk
# lives in what does not.
# ---------------------------------------------------------------------------
DGATE="$REPO_ROOT/scripts/durable_artefact_gate.py"
if [ ! -f "$DGATE" ]; then
    echo "[pre-push] durable_artefact_gate.py is missing." >&2
    echo "[pre-push] Refusing to pass a check that is not present." >&2
    exit 1
fi
set +e
python "$DGATE" > /tmp/durable_gate.log 2>&1
DUR_STATUS=$?
set -e
if [ "$DUR_STATUS" -ne 0 ]; then
    cat /tmp/durable_gate.log
    echo ""
    echo "[pre-push] A durable artefact is MISSING, IGNORED or UNTRACKED."
    echo "[pre-push] Writing a file is not preserving it. This gate has no override."
    exit 1
fi
echo "[pre-push] Durable artefacts tracked."

# ---------------------------------------------------------------------------
# ORDER IS LOAD-BEARING: THESE RUN BEFORE THE SCOPED EARLY EXIT.
#
# They were appended AFTER it, and so they never ran. A push that touches no
# *_REVIEW.html -- which is most pushes, including the one that installed them --
# hit `exit 0` at the 'nothing to regression-check' line thirty lines below and
# returned SUCCESS without executing a single gate. Nine gates, the meta-gate and
# 24 repo checks: installed, invoked, and inert.
#
# The durable-artefact gate above already records this exact reasoning -- 'scope
# followed what changed, when the risk lives in what does not' -- and the mistake
# was made anyway, in the wiring of the suite built to catch it. That is the fifth
# available-not-operative instance of this run and the only one that was mine.
#
# A gate whose position makes it unreachable is indistinguishable, in a log, from
# a gate that passed.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# EXECUTABLE-RULE GATES, added 2026-08-28. gates/run_all.py --fast
#
# WHY THESE EXIST AT ALL. Every rule they enforce was already written down, owned, and broken
# anyway. `prune_legacy_corpus_2026_08_26.py` says in its own docstring "never delete what you
# merely failed to recognise", and a sibling script selected 763 pages by absence two days
# later. `field_aliases.py` exists specifically to stop one concept being read under several
# names, and the two spellings actually in use were not in it. A rule fires only when its
# author already knows which rule applies, which is the part that goes wrong.
#
# --fast RUNS SIX OF THE NINE. Gates 2, 5 and 6 read all 1,426 delivered pages and take
# about 70 seconds; they run in CI and by hand, not on every push. The runner PRINTS which
# gates it skipped, because a scoped pass that does not name its scope is how "53 apps" turned
# out to be 1,522.
#
# EXIT 2 IS VACUOUS AND IT BLOCKS. A gate that never reached the case it was built to find is
# more dangerous than one that objected, because it reads as a pass. This hook treats it as a
# failure, deliberately.
# ---------------------------------------------------------------------------
GATES="$REPO_ROOT/gates/run_all.py"
if [ ! -f "$GATES" ]; then
    echo "[pre-push] gates/run_all.py is missing." >&2
    echo "[pre-push] Refusing to pass a check that is not present." >&2
    exit 1
fi
set +e
python "$GATES" --fast
GATE_STATUS=$?
set -e
if [ "$GATE_STATUS" -eq 2 ]; then
    echo ""
    echo "[pre-push] A gate went VACUOUS: it never reached a case it was built to find."
    echo "[pre-push] That is a filter hiding the motivating case, not a clean run."
    exit 1
fi
if [ "$GATE_STATUS" -ne 0 ]; then
    echo ""
    echo "[pre-push] Executable-rule gates FAILED (exit $GATE_STATUS)."
    echo "[pre-push] Run: python gates/run_all.py     This gate has no override."
    exit 1
fi
echo "[pre-push] Executable-rule gates PASS (6 of 9; 2, 5 and 6 are CI-only, see above)."

# ---------------------------------------------------------------------------
# THE CHECKS THIS REPOSITORY ALREADY OWNED, added 2026-08-28.
#
# 200 scripts here are named like a gate and CAN fail. 156 were called by NOTHING; 44 were
# wired. A further 59 are named like a gate and have no failing exit at all -- so 17% of the
# check-shaped scripts in this repository were operative. That is not a missing gate, it is
# knowledge recorded and connected to nothing.
#
# 24 of them run GREEN in 32 seconds total, MEASURED by running all 48 candidates rather than
# by reading their names. The labelled set would have blocked every push and taken an hour.
# gates/WIRED_REPO_CHECKS.json carries the exit code and wall time behind every entry, plus
# the 8 that are CI-only, the 12 that fail on the corpus today, and the 4 that time out.
#
# Failures are reported PER CHECK with the script named. A group gate whose failure you
# cannot read is a group gate that gets skipped.
# ---------------------------------------------------------------------------
RCHECKS="$REPO_ROOT/gates/run_repo_checks.py"
if [ ! -f "$RCHECKS" ]; then
    echo "[pre-push] gates/run_repo_checks.py is missing." >&2
    echo "[pre-push] Refusing to pass a check that is not present." >&2
    exit 1
fi
set +e
python "$RCHECKS"
RC_STATUS=$?
set -e
if [ "$RC_STATUS" -ne 0 ]; then
    echo ""
    echo "[pre-push] A repo check FAILED. These are this project's own checks, named above."
    echo "[pre-push] Fix it, or move it out of gates/WIRED_REPO_CHECKS.json with a reason."
    exit 1
fi

if [ -z "$CHANGED" ]; then
    echo "[pre-push] No *_REVIEW.html pages in this push; nothing to regression-check."
    exit 0
fi

# ---------------------------------------------------------------------------
# HARNESS GATE (verification lane). The 20 artefact-decidable detectors, over
# the objects behind the pages this push touches.
#
# NOT WIRED AS HANDOFF Sec 3a SPECIFIES, AND HERE IS WHY. That block feeds
# build-artefacts/<page>.json, which did not exist: nothing produced the shape
# the detectors read. Handed our real SSOT objects the gate matched NOTHING and
# printed PASS on 0 check executions -- installed, green, seeing nothing, while
# wiring.detect() would have flipped the ledger headline to ~50% coverage.
# INVOKED IS NOT SEEING. So the artefact is EXPORTED from the object first, and
# an artefact yielding no checks now exits 2 rather than 0.
#
# Proved on a REAL past defect in a REAL object, not a fixture: ARNI's object
# with one per-trial measure flipped HR -> OR (the MITRAL shape) exits 1 on
# CHK018_MIXED_POOLING; the unmodified object exits 0.
# ---------------------------------------------------------------------------
HGATE="$REPO_ROOT/scripts/harness_gate.py"
HEXPORT="$REPO_ROOT/scripts/export_artefact.py"
HMAP="$REPO_ROOT/scripts/objects_for_pages.py"
for _f in "$HGATE" "$HEXPORT" "$HMAP"; do
    if [ ! -f "$_f" ]; then
        echo "[pre-push] $(basename "$_f") is missing." >&2
        echo "[pre-push] Refusing to pass a check that is not present." >&2
        exit 1
    fi
done
HOBJS="$(python "$HMAP" $CHANGED 2>/tmp/harness_unmapped.log || true)"
if [ -s /tmp/harness_unmapped.log ]; then
    echo "[pre-push] Harness gate: these changed pages have NO SSOT object, so the"
    echo "[pre-push] 20 artefact detectors did not run on them. That is not coverage:"
    sed 's/^/[pre-push]   /' /tmp/harness_unmapped.log
fi
if [ -n "$HOBJS" ]; then
    echo "[pre-push] Harness gate: exporting artefacts ..."
    set +e
    python "$HEXPORT" $HOBJS --outdir "$REPO_ROOT/build-artefacts" > /tmp/harness_export.log 2>&1
    EX_STATUS=$?
    set -e
    if [ "$EX_STATUS" -ne 0 ]; then
        cat /tmp/harness_export.log
        echo "[pre-push] Artefact export produced nothing checkable. Not a pass."
        exit 1
    fi
    HARTS=""
    for _o in $HOBJS; do
        HARTS="$HARTS $REPO_ROOT/build-artefacts/$(basename "$(dirname "$_o")").json"
    done
    set +e
    python "$HGATE" $HARTS
    HG_STATUS=$?
    set -e
    if [ "$HG_STATUS" -eq 2 ]; then
        echo "[pre-push] Harness gate could not see: unfit registry, INVALID share"
        echo "[pre-push] above the ceiling, or an artefact that yielded no checks."
        echo "[pre-push] That is not a pass."
        exit 1
    fi
    if [ "$HG_STATUS" -ne 0 ]; then
        echo "[pre-push] Harness gate FAILED. This gate has no override."
        exit 1
    fi
fi

COUNT="$(printf '%s\n' $CHANGED | wc -l | tr -d ' ')"
echo "[pre-push] Regression checking $COUNT changed app page(s) ..."

# THE SERVER MUST BE SERVING *THIS* WORKING TREE (2026-08-17).
#
# This block used to probe `curl -sf .../index.html` and reuse whatever answered.
# On 2026-08-17 port 8787 was held by the SIBLING WORKING TREE of this same repo,
# on a different branch, and the whole day's regression verdicts were measured
# against files that were not the ones being pushed -- ARNI 912,140 bytes over
# the wire against 6,147,695 on disk. A green gate that had never seen the pages.
#
# `index.html` answering proves SOMETHING is there. It cannot prove it is us.
# A nonce written into this tree and fetched over HTTP is the one probe another
# directory cannot satisfy, because it did not exist a moment ago. Same lesson as
# vendor liveness: a check that can only report "alive" is not a check.
PORT=8787
SERVER_PID=""
NONCE="._rm_hook_identity_$$"
echo hook-identity-probe > "$REPO_ROOT/$NONCE"
cleanup_nonce() { rm -f "$REPO_ROOT/$NONCE"; }
trap cleanup_nonce EXIT
if [ "$(curl -sf "http://127.0.0.1:$PORT/$NONCE" 2>/dev/null || true)" != "hook-identity-probe" ]; then
    if curl -sf "http://127.0.0.1:$PORT/index.html" > /dev/null 2>&1; then
        echo "[pre-push] Port $PORT is answering but is NOT serving $REPO_ROOT."
        echo "[pre-push] Using an unused port instead of another tree's bytes."
        PORT=8799
    fi
fi
if [ "$(curl -sf "http://127.0.0.1:$PORT/$NONCE" 2>/dev/null || true)" != "hook-identity-probe" ]; then
    echo "[pre-push] Starting local HTTP server on :$PORT ..."
    ( cd "$REPO_ROOT" && python -m http.server $PORT --bind 127.0.0.1 > /dev/null 2>&1 ) &
    SERVER_PID=$!
    sleep 2
fi
cleanup() { [ -n "$SERVER_PID" ] && kill "$SERVER_PID" 2>/dev/null || true; }
trap cleanup EXIT

# Status is captured from the SCRIPT, not from a pipe. Output goes to a log and is
# shown afterwards, so nothing is buffered behind `tail` and nothing masks $?.
LOG="$(mktemp)"
set +e
python "$SCRIPT" --port "$PORT" --only $CHANGED > "$LOG" 2>&1
STATUS=$?
set -e
tail -25 "$LOG"

if [ "$STATUS" -ne 0 ]; then
    echo ""
    echo "[pre-push] Regression check FAILED (exit $STATUS). Full log: $LOG"
    echo "[pre-push] Fix the regression. This gate has no override."
    exit 1
fi


# FIELD NAMES IN READER-FACING PROSE. ~45s over 157 delivered pages, so it runs here rather
# than on every commit. Its positive control is MAVACAMTEN's `bar:`, found by a person reading
# the page -- not a fixture written by whoever wrote the fix.
python "$(git rev-parse --show-toplevel)/scripts/lint_field_name_in_reader_prose_2026_08_23.py" >/dev/null || { echo "[pre-push] REFUSED: a schema identifier reaches reader-facing prose (scripts/lint_field_name_in_reader_prose_2026_08_23.py)"; exit 1; }

echo "[pre-push] Regression check PASS on $COUNT page(s). Proceeding with push."

exit 0
