#!/usr/bin/env bash
# RapidMeta pre-push regression hook.
#
# Runs scripts/regression_check.py over the *_REVIEW.html apps actually being
# pushed, verifying none of the 7 signals (page errors, trials seeded,
# auto-include, RoB banner, protocol link, WebR tag, pool computes) regressed.
#
# Install once per clone with:  git config core.hooksPath .githooks
# Skip with:                    SKIP_REGRESSION=1 git push
#
# SCOPE: the corpus is ~1217 *_REVIEW.html apps, not the 53 an earlier version
# of this comment claimed. A full walk is hours, not "~60 seconds", so this
# hook checks only the apps changed in the push range. A hook slow enough to be
# bypassed every time is not a gate. If the range cannot be determined it falls
# back to a bounded sample and SAYS SO rather than implying full coverage.

set -uo pipefail

if [ "${SKIP_REGRESSION:-}" = "1" ]; then
    echo "[pre-push] Regression check skipped via SKIP_REGRESSION=1"
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
SCRIPT="$REPO_ROOT/scripts/regression_check.py"

if [ ! -f "$SCRIPT" ]; then
    echo "[pre-push] BLOCK: regression_check.py not found at $SCRIPT"
    echo "           A missing checker is not a pass. Restore it or use"
    echo "           SKIP_REGRESSION=1 deliberately."
    exit 1
fi

# --- work out which apps this push actually touches -------------------------
# pre-push receives "<local ref> <local sha> <remote ref> <remote sha>" on stdin.
CHANGED=""
CAPPED=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac   # branch deletion
    case "$remote_sha" in
        *[!0]*) RANGE="$remote_sha..$local_sha" ;;         # existing remote branch
        *)      RANGE="$local_sha" ;;                      # new branch: its own commits
    esac
    CHANGED="$CHANGED
$(git diff --name-only "$RANGE" -- '*_REVIEW.html' 2>/dev/null || true)"
done

APPS=$(printf '%s\n' "$CHANGED" | grep -E '_REVIEW\.html$' | sed 's#.*/##; s#\.html$##' | sort -u)
N=$(printf '%s\n' "$APPS" | grep -c . || true)

ARGS=()
if [ "$N" -eq 0 ]; then
    echo "[pre-push] No *_REVIEW.html changed in this push; nothing to regress."
    exit 0
fi
MAX=40
if [ "$N" -gt "$MAX" ]; then
    # Do not silently truncate: say what is being dropped.
    echo "[pre-push] NOTE: $N apps changed; checking the first $MAX only."
    echo "           Coverage is PARTIAL - run the full sweep separately:"
    echo "           python scripts/regression_check.py"
    APPS=$(printf '%s\n' "$APPS" | head -n "$MAX")
    CAPPED=1
fi
while IFS= read -r a; do [ -n "$a" ] && ARGS+=(--app "$a"); done <<< "$APPS"

# --- serve the corpus -------------------------------------------------------
PORT=8787
if ! curl -sf "http://127.0.0.1:$PORT/index.html" > /dev/null 2>&1; then
    echo "[pre-push] Starting local HTTP server on :$PORT ..."
    ( cd "$REPO_ROOT" && python -m http.server $PORT --bind 127.0.0.1 > /dev/null 2>&1 ) &
    SERVER_PID=$!
    sleep 2
    trap 'kill $SERVER_PID 2>/dev/null || true' EXIT
fi

echo "[pre-push] Regression check over $(printf '%s\n' "$APPS" | grep -c .) changed app(s) ..."

# Capture the CHECKER's status, not the pager's. `python ... | tail` makes $?
# the exit code of tail, which is always 0 -- that single line is what made
# this hook unable to fail. pipefail plus PIPESTATUS[0] fixes it both ways.
python "$SCRIPT" --base-url "http://127.0.0.1:$PORT" "${ARGS[@]}" 2>&1 | tail -20
STATUS=${PIPESTATUS[0]}

if [ "$STATUS" -eq 2 ]; then
    echo ""
    echo "[pre-push] BLOCK: regression check could not run (precondition failure,"
    echo "           exit 2). A check that did not run is not a pass."
    exit 1
fi
if [ "$STATUS" -ne 0 ]; then
    echo ""
    echo "[pre-push] BLOCK: regression check FAILED (exit $STATUS)."
    echo "           Inspect $REPO_ROOT/regression_results.json"
    echo "           Override deliberately with: SKIP_REGRESSION=1 git push"
    exit 1
fi

if [ "$CAPPED" -eq 1 ]; then
    echo "[pre-push] PASS on the checked subset (coverage was capped - see note above)."
else
    echo "[pre-push] PASS on all changed apps. Proceeding with push."
fi
exit 0
