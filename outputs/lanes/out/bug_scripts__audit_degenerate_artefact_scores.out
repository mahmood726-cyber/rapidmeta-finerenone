  40: REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
  41: sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
  42: from instrument_controls import require_controls
  43: import lint_paper_reads_as_prose as L
  44: import prove_register_change_moved_no_content as PROVE
  45: 
  46: HEAD = '<span id="paper"></span><h2 id="paper-paper">Paper</h2>'
  47: TAIL = '<section class="panel" id="pn-analysis">'
  48: 
  49: EMPTY = HEAD + (
  50:     "<h3>Paper Studio</h3><p>Not held in this object. No manuscript has been generated "
  51:     "for this review. A manuscript belongs to one review, so none from another review is "
  52:     "shown here.</p>") + TAIL
  53: 
  54: BOILERPLATE = HEAD + "".join(
  55:     "<h3>%s</h3><p>This section is part of the standard structure of a systematic "
  56:     "review report and is included here for completeness of presentation.</p>" % h
  57:     for h in ("Abstract", "Introduction", "Methods", "Results", "Discussion",
  58:               "Conclusions", "Limitations", "References")) + TAIL
  59: 
  60: REFUSALS = HEAD + "".join(
  61:     "<h3>%s</h3><div class='absent-state' role='note'><strong>Refused:</strong> the %s -- "
  62:     "no field on this object supports it, and none is generated here: a %s written by the "
  63:     "renderer would be an argument no field supports.</div>" % (h, h.lower(), h.lower())
  64:     for h in ("Abstract", "Introduction", "Methods", "Results", "Discussion",
  65:               "Conclusions", "Limitations", "Certainty of the evidence")) + TAIL
  66: 
  67: # A real page, for the comparison. Sentences with the register we actually want.
  68: REAL = HEAD + (
  69:     "<h3>Results</h3><p>The pooled hazard ratio for cardiovascular death or "
  70:     "hospitalisation for heart failure was 0.76 (0.71 to 0.83) across three trials, "
  71:     "against placebo.<sup class='prov-ref'>1</sup></p>"
  72:     "<p>The trials' results were closely consistent with one another: I-squared, the share "
  73:     "of the variation between them that is more than chance alone would produce, was 0%; "
  74:     "the estimated variance of the true effects between trials (tau-squared) was 0.<sup "
  75:     "class='prov-ref'>2</sup></p>"
  76:     "<p>DELIVER does not post the first-event two-component outcome, so a pool of three "
  77:     "trials we can fully vouch for was preferred to a pool of four with one input we "
  78:     "cannot.<sup class='prov-ref'>3</sup></p>"
  79:     "<div class='prov-block'><p class='prov-title'>Where the statements in this section "
  80:     "come from, in order</p><ol class='prov-list'><li><code>results.by_outcome.x.pooled"
  81:     "</code></li></ol></div>") + TAIL
  82: 
  83: 
  84: def score(name, raw):
  85:     tmp = os.path.join(REPO, "outputs", "_degenerate_%s.html" % name)
  86:     os.makedirs(os.path.dirname(tmp), exist_ok=True)
  87:     io.open(tmp, "w", encoding="utf-8", newline=chr(10)).write(raw)
  88:     try:
  89:         m = L.measure(tmp)
  90:         fp = PROVE.flow_paths(raw)
  91:         if m is None:
  92:             return None
  93:         rate = (100.0 * m["machine"] / m["sentences"]) if m["sentences"] else 0.0
  94:         return {"sentences": m["sentences"], "machine": m["machine"], "rate": rate,
  95:                 "flow_paths": fp}
  96:     finally:
  97:         if os.path.exists(tmp):
  98:             os.remove(tmp)
  99: 
 100: 
 101: def main():
 102:     cases = [("EMPTY", EMPTY), ("BOILERPLATE", BOILERPLATE), ("REFUSALS", REFUSALS),
 103:              ("REAL", REAL)]
 104:     scores = dict((n, score(n, raw)) for n, raw in cases)
 105: 
 106:     # CONTROL. The whole file is worthless if the empty page does NOT beat the real one --
 107:     # that is the finding, and if it fails to reproduce, the metrics have changed and the
 108:     # rest of this output describes a repository that no longer exists.
 109:     e, r = scores["EMPTY"], scores["REAL"]
 110:     require_controls(
 111:         "audit_degenerate_artefact_scores",
 112:         positive=("the EMPTY page's machine-vocabulary rate is no worse than the REAL "
 113:                   "page's -- the finding this file exists to state",
 114:                   e is not None and r is not None and e["rate"] <= r["rate"], True),
 115:         negative=("the REAL page scores as a degenerate one on sentence count",
 116:                   r is not None and r["sentences"] < 3, True))
 117: 
 118:     print("")
 119:     print("%-12s %10s %10s %10s %12s" % ("artefact", "sentences", "machine", "rate %",
 120:                                          "flow paths"))
 121:     print("-" * 60)
 122:     for n, _raw in cases:
 123:         s = scores[n]
 124:         if s is None:
 125:             print("%-12s   NO PAPER PANEL FOUND" % n)
 126:             continue
 127:         print("%-12s %10d %10d %9.0f%% %12d"
 128:               % (n, s["sentences"], s["machine"], s["rate"], s["flow_paths"]))
 129: 
 130:     print("")
 131:     print("WOULD A GUARD ON EACH METRIC PREFER A DEGENERATE PAGE TO THE REAL ONE?")
 132:     print("")
 133:     verdicts = []
 134:     for metric, better in (("machine sentences (absolute)", lambda a, b: a["machine"] <= b["machine"]),
 135:                            ("machine-vocabulary RATE", lambda a, b: a["rate"] <= b["rate"]),
 136:                            ("field paths in the flow", lambda a, b: a["flow_paths"] <= b["flow_paths"]),
 137:                            ("sentence count", lambda a, b: a["sentences"] >= b["sentences"])):
 138:         losers = [n for n in ("EMPTY", "BOILERPLATE", "REFUSALS")
 139:                   if scores[n] and scores["REAL"] and better(scores[n], scores["REAL"])]
 140:         verdicts.append((metric, losers))
 141:         if losers:
 142:             print("    %-32s DEFENDS %s" % (metric, ", ".join(losers)))
 143:         else:
 144:             print("    %-32s prefers the real page" % metric)
 145: 
 146:     print("")
 147:     print("READ THE `sentence count` ROW CAREFULLY. It is the only metric here that a blank")
 148:     print("page LOSES, which is why the rollout's gained-a-manuscript branch is keyed on it")
 149:     print("rather than on any of the quality measures. A COUNT OF THINGS PRESENT IS THE ONLY")
 150:     print("ONE OF THESE A DEGENERATE ARTEFACT CANNOT WIN, and it is the crudest of them.")
 151:     print("")
 152:     print("AND THE REFUSALS PAGE IS THE UNCOMFORTABLE CASE. Refusing by name is REQUIRED")
 153:     print("behaviour in this project. A page that does nothing else is honest, scores at or")
 154:     print("near the top of every readability measure written tonight, and is worthless to a")
 155:     print("reader. P47 exists for that reason; these metrics do not know it.")
 156: 
 157: 
 158: if __name__ == "__main__":
 159:     main()

