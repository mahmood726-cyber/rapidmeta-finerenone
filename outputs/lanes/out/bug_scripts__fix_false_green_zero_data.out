  21: pass. The counts are not zeroed and left otherwise intact, because "0 findings"
  22: on an empty ledger reads as a clean bill; the verdict says NO_DATA and every
  23: gate is reported as NOT APPLICABLE rather than as a zero.
  24: """
  25: import io
  26: import json
  27: import re
  28: import sys
  29: 
  30: sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
  31: 
  32: APPS = [
  33:     {
  34:         "file": "EZETIMIBE_LIPID_AUTO_FULL_REVIEW.html",
  35:         "subject": "ezetimibe in hyperlipidaemia",
  36:         "storage": "rapid_meta_ezetimibe_lipid_auto_v1_0",
  37:     },
  38:     {
  39:         "file": "LISINOPRIL_HTN_AUTO_FULL_REVIEW.html",
  40:         "subject": "lisinopril in hypertension",
  41:         "storage": "rapid_meta_lisinopril_htn_auto_v1_0",
  42:     },
  43: ]
  44: 
  45: 
  46: def build_verdict(subject):
  47:     return {
  48:         "verdict": "NO_DATA",
  49:         "counts": {
  50:             "n_trials_in_ledger": 0,
  51:             "n_trials_analysed": 0,
  52:             "P0_internal": None,
  53:             "P0_aact_nct_missing": None,
  54:             "P0_grim": None,
  55:             "P1_aact_concord": None,
  56:             "P1_fi_critical": None,
  57:             "P1_fi_warn": None,
  58:             "P1_pi_gap": None,
  59:             "P2_evidence_incomplete": None,
  60:             "P2_aact_advisory": None,
  61:             "n_trials_seen": 0,
  62:         },
  63:         "counts_note": (
  64:             "Every gate count is null, not zero. There is no evidence in this app to "
  65:             "test, so no gate ran. A zero here would read as a clean bill."
  66:         ),
  67:         "reasons": [
  68:             "This app contains NO trial data. realData is empty, no trial is marked for "
  69:             "inclusion, no analysis is produced, and the pooled estimate renders as '--'.",
  70:             "The previous visible badge read 'INTERNAL CHECKS PASSED - Fabrication-risk "
  71:             "score 0.275 - Trials: 2' in green, and this same window.__verdict object read "
  72:             "'STABLE' with n_trials_seen 2. Both were app-shell boilerplate inherited from "
  73:             "a 2-trial clone. Neither described this page. There were never 2 trials here.",
  74:             "No integrity gate has run or could run: GRIM/GRIMMER, Benford, registry "
  75:             "concordance, fragility index and arm-orientation checks all require per-arm "
  76:             "data that does not exist in this file.",
  77:             f"Nothing on this page may be cited as evidence about {subject}.",
  78:             "AMSTAR-2 confidence: not assessable - there is no review to appraise.",
  79:         ],
  80:         "p0_total": None,
  81:         "p0_total_note": (
  82:             "null, not 0. No P0 check executed, because there is nothing to check."
  83:         ),
  84:         "pooled": None,
  85:         "pooled_note": "No pooled estimate exists. The app displays '--'.",
  86:     }
  87: 
  88: 
  89: def build_badge(subject):
  90:     return (
  91:         '<div id="rapidmeta-integrity-badge" role="status" '
  92:         'style="background:#7c2d12;color:#fff;padding:12px 20px;font-family:system-ui,sans-serif;'
  93:         'font-size:13.5px;border-bottom:3px solid #431407;line-height:1.55;">'
  94:         '<div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">'
  95:         '<strong style="font-size:14px;letter-spacing:0.04em;">NO DATA '
  96:         '&mdash; THIS IS NOT AN INTEGRITY PASS</strong>'
  97:         '<span style="font-size:11.5px;">Trials in ledger: <strong>0</strong> &middot; '
  98:         'Trials analysed: <strong>0</strong> &middot; Pooled estimate: '
  99:         '<strong>none</strong></span></div>'
 100:         '<div style="margin-top:6px;font-size:12.5px;">'
 101:         'This app contains <strong>no trial data</strong>. Its evidence ledger is empty, no '
 102:         'trial is marked for inclusion, and the pooled estimate renders as &ldquo;--&rdquo;. '
 103:         f'<strong>Nothing on this page may be cited as evidence about {subject}.</strong>'
 104:         '</div>'
 105:         '<div style="margin-top:6px;font-size:11.5px;">'
 106:         '<strong>What this badge used to say, and why it was wrong.</strong> It read '
 107:         '&ldquo;INTERNAL CHECKS PASSED &middot; Fabrication-risk score 0.275 &middot; '
 108:         'Trials: 2&rdquo; on a green background, and the page&rsquo;s '
 109:         '<code style="background:rgba(255,255,255,0.28);padding:1px 4px;border-radius:2px;">'
 110:         'window.__verdict</code> agreed with it &mdash; &ldquo;STABLE&rdquo;, '
 111:         '<em>n_trials_seen: 2</em>. Both were app-shell boilerplate inherited from a '
 112:         'two-trial clone. <strong>There were never two trials in this app.</strong> The two '
 113:         'surfaces agreed with each other and both were false; that is why agreement between '
 114:         'them is checked against the ledger, not against each other.</div>'
 115:         '<div style="margin-top:6px;font-size:10.5px;">'
 116:         '<strong>No gate has run, and none could.</strong> GRIM/GRIMMER, Benford, '
 117:         'ClinicalTrials.gov registry concordance, fragility index and arm-orientation checks '
 118:         'all require per-arm counts that do not exist in this file. Every gate count in '
 119:         '<code style="background:rgba(255,255,255,0.28);padding:1px 4px;border-radius:2px;">'
 120:         'window.__verdict</code> is <strong>null, not zero</strong> &mdash; a zero would read '
 121:         'as a clean bill, and absence of testing is not absence of defects. AMSTAR-2 '
 122:         'confidence: <strong>not assessable</strong>; there is no review here to appraise.'
 123:         '</div></div>'
 124:     )
 125: 
 126: 
 127: for app in APPS:
 128:     path, subject = app["file"], app["subject"]
 129:     s = open(path, encoding="utf-8").read()
 130:     before = len(s)
 131: 
 132:     # Fail closed if the app is not actually empty.
 133:     m = re.search(r"realData:\{\}", s)
 134:     assert m, f"{path}: realData is NOT empty - refusing to write a NO_DATA badge"
 135:     assert "AUTO_INCLUDE_TRIAL_IDS=new Set([])" in s, f"{path}: AUTO_INCLUDE is not empty"
 136:     assert '"data/realData.json"' not in s, f"{path}: carries an embedded data blob"
 137: 
 138:     # ---- surface 1: window.__verdict ----
 139:     old_v = re.search(r"<script>window\.__verdict = \{.*?\};</script>", s)
 140:     assert old_v, f"{path}: no __verdict surface found"
 141:     s = s.replace(
 142:         old_v.group(0),
 143:         "<script>window.__verdict = "
 144:         + json.dumps(build_verdict(subject), ensure_ascii=False)
 145:         + ";</script>",
 146:         1,
 147:     )
 148: 
 149:     # ---- surface 2: the visible badge ----
 150:     i = s.index('id="rapidmeta-integrity-badge"')
 151:     st = s.rfind("<div", 0, i)
 152:     depth, k = 0, st
 153:     while k < len(s):
 154:         if s.startswith("<div", k):
 155:             depth += 1
 156:         elif s.startswith("</div>", k):
 157:             depth -= 1
 158:             if depth == 0:
 159:                 k += 6
 160:                 break
 161:         k += 1
 162:     old_badge = s[st:k]
 163:     assert "INTERNAL CHECKS PASSED" in old_badge, f"{path}: badge is not the false-green one"
 164:     s = s[:st] + build_badge(subject) + s[k:]
 165: 
 166:     open(path, "w", encoding="utf-8", newline="").write(s)
 167:     print(f"{path}: {before} -> {len(s)} bytes")
 168:     print("  - window.__verdict  STABLE / n_trials_seen 2  ->  NO_DATA / 0, gate counts null")
 169:     print("  - visible badge     green INTERNAL CHECKS PASSED / Trials: 2  ->  NO DATA (not a pass)")
 170: 
 171: 
 172: # ---------------------------------------------------------------------------
 173: # Pre-existing base-engine contamination, identical in both apps.
 174: # The contamination gate returns the SAME 4 HARD findings against the
 175: # unmodified files at HEAD, so none of this was introduced by the badge fix.
 176: # These apps hold no trials at all, so the honest alias table is the empty one.
 177: # ---------------------------------------------------------------------------
 178: OLD_ALIASES = (
 179:     'const KNOWN_TRIAL_ALIASES={NCT01035255:["paradigm-hf","paradigm"],'
 180:     'NCT01920711:["paragon-hf","paragon"],NCT02924727:["paradise-mi","paradise"],'
 181:     'NCT03988634:["paraglide-hf","paraglide"]}'
 182: )
 183: OLD_NMA = (
 184:     'trialData=["NCT01035255","NCT01920711","NCT02924727"]'
 185:     ".filter(id=>!RapidMeta.state.excludedTrials?.[id])"
 186: )
 187: NEW_NMA = (
 188:     "trialData=Object.keys(RapidMeta.realData??{})"
 189:     ".filter(id=>!RapidMeta.state.excludedTrials?.[id])"
 190: )
 191: 
 192: for app in APPS:
 193:     path = app["file"]
 194:     s = open(path, encoding="utf-8").read()
 195:     before = len(s)
 196:     notes = []
 197:     if s.count(OLD_ALIASES) == 1:
 198:         # Older lineage: table still holds the sacubitril/valsartan HF trials.
 199:         s = s.replace(OLD_ALIASES, "const KNOWN_TRIAL_ALIASES={}", 1)
 200:         notes.append("KNOWN_TRIAL_ALIASES: PARADIGM/PARAGON/PARADISE/PARAGLIDE -> {} (this app has no trials)")
 201:     elif "const KNOWN_TRIAL_ALIASES={}" in s:
 202:         # main already purged it (5e63960c9). Leave it empty - that purge IS the
 203:         # anti-contamination fix, and an app holding zero trials has no aliases
 204:         # of its own to resolve, so there is nothing that could need re-adding.
 205:         notes.append("KNOWN_TRIAL_ALIASES: already EMPTY on main (5e63960c9) - left empty, main's fix preserved")
 206:     else:
 207:         raise AssertionError(f"{path}: KNOWN_TRIAL_ALIASES in an unrecognised state")
 208: 
 209:     if s.count(OLD_NMA) == 1:
 210:         s = s.replace(OLD_NMA, NEW_NMA, 1)
 211:         notes.append("NMAEngine.run: hardcoded HF trial list -> derived from this app's realData")
 212:     elif NEW_NMA in s:
 213:         notes.append("NMAEngine.run: already derived from realData - no change")
 214:     else:
 215:         raise AssertionError(f"{path}: NMAEngine trialData in an unrecognised state")
 216: 
 217:     open(path, "w", encoding="utf-8", newline="").write(s)
 218:     print(f"{path}: {before} -> {len(s)} bytes")
 219:     for n in notes:
 220:         print("  - " + n)
 221: 
 222: 
 223: # ---------------------------------------------------------------------------
 224: # The LISINOPRIL redirect stub carries NEITHER verdict surface - the same defect
 225: # as the APIXABAN stub. Same app, two files, one previously asserting PASSED and
 226: # one asserting nothing. Give it both, agreeing with the full app.
 227: # (EZETIMIBE_LIPID has no stub variant.)
 228: # ---------------------------------------------------------------------------
 229: STUB = "LISINOPRIL_HTN_AUTO_REVIEW.html"
 230: s = open(STUB, encoding="utf-8").read()
 231: if "__verdict" in s:
 232:     print(f"{STUB}: already carries a verdict surface - skipped")
 233: else:
 234:     before = len(s)
 235:     banner = (
 236:         '<div id="rapidmeta-integrity-badge" role="status" '
 237:         'style="background:#7c2d12;color:#fff;padding:12px 20px;font-family:system-ui,sans-serif;'
 238:         'font-size:13.5px;border-bottom:3px solid #431407;line-height:1.55;">'
 239:         '<strong style="font-size:14px;letter-spacing:0.04em;">NO DATA '
 240:         '&mdash; THIS IS NOT AN INTEGRITY PASS</strong>'
 241:         '<div style="margin-top:6px;font-size:12.5px;">This app contains '
 242:         '<strong>no trial data</strong> &mdash; 0 trials in the ledger, 0 analysed, no '
 243:         'pooled estimate. Nothing on it may be cited as evidence about lisinopril in '
 244:         'hypertension. The full review previously showed a green &ldquo;INTERNAL CHECKS '
 245:         'PASSED &middot; Trials: 2&rdquo; badge over an empty ledger; that claim has been '
 246:         'removed.</div></div>\n'
 247:     )
 248:     verdict_js = (
 249:         '<script>window.__verdict = {"verdict":"NO_DATA","counts":{"n_trials_in_ledger":0,'
 250:         '"n_trials_analysed":0,"n_trials_seen":0},"reasons":["Redirect stub. Verdict mirrors '
 251:         'LISINOPRIL_HTN_AUTO_FULL_REVIEW.html: this app holds no trial data, so no gate ran '
 252:         'and no pooled estimate exists. The previous green pass badge was app-shell '
 253:         'boilerplate from a 2-trial clone."],"p0_total":null,"p0_total_note":"null, not 0. '
 254:         'Nothing was checked because there is nothing to check.","pooled":null};</script>\n'
 255:     )
 256:     m = re.search(r"<body[^>]*>", s)
 257:     assert m, f"{STUB}: no <body> tag"
 258:     s = s[:m.end()] + "\n" + banner + verdict_js + s[m.end():]
 259:     open(STUB, "w", encoding="utf-8", newline="").write(s)
 260:     print(f"{STUB}: {before} -> {len(s)} bytes  (badge + __verdict added; had neither)")

codex
Found defects:

- **Instrument reads a name, not its binding**: line 133.  
  Exact input in either full app: `<script>/* realData:{} */ const RapidMeta={realData:{NCT1:{}}}; const AUTO_INCLUDE_TRIAL_IDS=new Set([]);</script><script>window.__verdict = {"verdict":"STABLE","n_trials_seen":2};</script><div id="rapidmeta-integrity-badge">INTERNAL CHECKS PASSED</div>`  
  Consequence: the guard passes on a comment and writes a NO_DATA verdict over a non-empty `realData`.

- **Probe keyed to one removable string form**: line 136.  
  Exact input: `<script>const RapidMeta={realData:{}}; const AUTO_INCLUDE_TRIAL_IDS=new Set([]); fetch('data/realData.json');</script><script>window.__verdict = {"verdict":"STABLE","n_trials_seen":2};</script><div id="rapidmeta-integrity-badge">INTERNAL CHECKS PASSED</div>`  
  Consequence: a single-quoted real-data load survives the guard and the script stamps the page NO_DATA anyway.

- **Idempotency guard satisfied by a comment/marker**: line 201.  
  Exact input in a full app after the first loop: `<!-- const KNOWN_TRIAL_ALIASES={} --><script>const KNOWN_TRIAL_ALIASES = {NCT01035255:["paradigm-hf","paradigm"]}</script>`  
  Consequence: the script reports the aliases already empty while leaving the live hardcoded alias table in place.

- **Idempotency guard satisfied by a comment/marker**: line 212.  
  Exact input: `// trialData=Object.keys(RapidMeta.realData??{}).filter(id=>!RapidMeta.state.excludedTrials?.[id])\ntrialData = ["NCT01035255","NCT01920711","NCT02924727"].filter(id=>!RapidMeta.state.excludedTrials?.[id])`  
  Consequence: the script reports NMA already derived from `realData` while leaving the live hardcoded HF trial list.

- **Idempotency guard satisfied by its own marker**: line 231.  
  Exact input for `LISINOPRIL_HTN_AUTO_REVIEW.html`: `<html><body><!-- TODO: add __verdict --></body></html>`  
  Consequence: the stub is skipped and receives neither the badge nor the verdict surface.

- **Check that cannot fail when optimized**: lines 134-136, 140, 163, 257.  
  Exact input: run `python -O scripts/fix_false_green_zero_data.py`.  
  Consequence: Python removes every `assert`, including the fail-closed data guards.

