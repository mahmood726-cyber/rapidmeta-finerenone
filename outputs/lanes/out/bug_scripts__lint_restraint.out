  68: REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
  69: SSOT = os.path.join(REPO, "ssot")
  70: sys.path.insert(0, SSOT)
  71: 
  72: BASELINE_PATH = os.path.join(REPO, "scripts", ".restraint-baseline.json")
  73: CACHE = os.environ.get(
  74:     "RM_CTGOV_CACHE",
  75:     "F:/claude-temp/claude/F--rapidmeta-ssot-shell/"
  76:     "eb4d84e5-8a24-4c3b-afe2-34bd91c20bc7/scratchpad/.ctgov-raw-cache")
  77: 
  78: # Topic key -> the synonym-set key ssot/topic_identity uses. Declared, never guessed: an
  79: # unmapped topic is REPORTED AS UNCHECKED rather than silently skipped, because a topic that
  80: # falls out of the loop is exactly the silent loss this file exists to detect.
  81: TOPIC_SYNONYM_KEY = {
  82:     "iv-iron-hf": "intravenous iron",
  83:     "sglt2-hf": "sglt2 inhibitors",
  84: }
  85: 
  86: 
  87: def raw_record(nct):
  88:     """The raw v2 payload for one registration, from the local cache. None if not cached."""
  89:     if not os.path.isdir(CACHE):
  90:         return None
  91:     for fn in os.listdir(CACHE):
  92:         if fn.startswith(nct + "_") and fn.endswith(".json"):
  93:             try:
  94:                 with io.open(os.path.join(CACHE, fn), encoding="utf-8") as fh:
  95:                     return json.load(fh)
  96:             except (ValueError, OSError):
  97:                 return None
  98:     return None
  99: 
 100: 
 101: def lane1_inclusion_vs_armrole():
 102:     """The object INCLUDES a trial; the classifier declines to call it the intervention."""
 103:     from topic_identity import locate, synonyms_for
 104:     findings, unchecked = [], []
 105:     for topic in sorted(os.listdir(SSOT)):
 106:         p = os.path.join(SSOT, topic, topic + ".json")
 107:         if not os.path.exists(p):
 108:             continue
 109:         key = TOPIC_SYNONYM_KEY.get(topic)
 110:         if not key:
 111:             unchecked.append((topic, "no declared synonym key"))
 112:             continue
 113:         try:
 114:             with io.open(p, encoding="utf-8") as fh:
 115:                 obj = json.load(fh)
 116:             syns = synonyms_for(key)
 117:         except (ValueError, OSError, KeyError) as e:
 118:             unchecked.append((topic, "unreadable: %s" % e))
 119:             continue
 120:         for t in ((obj.get("inputs") or {}).get("trials") or []):
 121:             nct = t.get("nct")
 122:             if not nct:
 123:                 continue
 124:             rec = raw_record(nct)
 125:             if rec is None:
 126:                 unchecked.append((topic, "%s not cached" % nct))
 127:                 continue
 128:             role, ev = locate(rec, syns)
 129:             if role != "experimental":
 130:                 findings.append({
 131:                     "lane": 1, "topic": topic, "nct": nct, "verdict_b": role,
 132:                     "why": ("the object INCLUDES this trial as a contributing randomised "
 133:                             "contrast; locate() independently returns %r" % role),
 134:                     "evidence_b": (ev or "")[:120]})
 135:     return findings, unchecked
 136: 
 137: 
 138: # Lane 2: precondition refusals that cite absence, paired with the object path that would
 139: # settle them. DECLARED, because a refusal reason is prose and guessing which field it means is
 140: # the substring-is-not-identity defect all over again.
 141: REFUSAL_CITES_ABSENCE = {
 142:     "criteria_stated": ["screening.eligibility"],
 143:     "criteria_predefined": ["screening.eligibility_provenance"],
 144:     "population_stated": ["question"],
 145:     "estimand_named": ["outcomes"],
 146: }
 147: 
 148: 
 149: def _dig(obj, path):
 150:     node = obj
 151:     for part in path.split("."):
 152:         node = node.get(part) if isinstance(node, dict) else None
 153:         if node is None:
 154:             return None
 155:     return node
 156: 
 157: 
 158: def lane2_refusal_vs_content():
 159:     """A precondition says 'cannot assess: absent' while the field is present and non-empty."""
 160:     findings = []
 161:     for topic in sorted(os.listdir(SSOT)):
 162:         p = os.path.join(SSOT, topic, topic + ".json")
 163:         if not os.path.exists(p):
 164:             continue
 165:         try:
 166:             with io.open(p, encoding="utf-8") as fh:
 167:                 obj = json.load(fh)
 168:         except (ValueError, OSError):
 169:             continue
 170:         pv = obj.get("precondition_verdict") or {}
 171:         for name, paths in REFUSAL_CITES_ABSENCE.items():
 172:             entry = pv.get(name)
 173:             if not isinstance(entry, dict):
 174:                 continue
 175:             verdict = str(entry.get("verdict") or "")
 176:             reason = str(entry.get("reason") or "")
 177:             if "NOT_ASSESSABLE" not in verdict.upper().replace("-", "_"):
 178:                 continue
 179:             if not any(w in reason.lower() for w in
 180:                        ("absent", "neither", "no ", "not present", "cannot assess")):
 181:                 continue
 182:             for path in paths:
 183:                 val = _dig(obj, path)
 184:                 if val:
 185:                     findings.append({
 186:                         "lane": 2, "topic": topic, "precondition": name,
 187:                         "verdict_b": "NOT_ASSESSABLE",
 188:                         "why": ("refusal cites absence, but %s is PRESENT and non-empty "
 189:                                 "(%s)" % (path, type(val).__name__)),
 190:                         "evidence_b": reason[:120]})
 191:     return findings
 192: 
 193: 
 194: def main():
 195:     sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
 196:     f1, unchecked = lane1_inclusion_vs_armrole()
 197:     f2 = lane2_refusal_vs_content()
 198:     findings = f1 + f2
 199: 
 200:     for f in findings:
 201:         who = f.get("nct") or f.get("precondition")
 202:         print("LANE %d  %s  %s" % (f["lane"], f["topic"], who))
 203:         print("        %s" % f["why"])
 204:         if f.get("evidence_b"):
 205:             print("        instrument B: %s" % f["evidence_b"])
 206:     if unchecked:
 207:         print()
 208:         print("UNCHECKED (reported, never silently skipped -- a topic that falls out of the")
 209:         print("loop is the silent loss this file exists to detect):")
 210:         for topic, why in unchecked[:12]:
 211:             print("   %-24s %s" % (topic, why))
 212:         if len(unchecked) > 12:
 213:             print("   ... and %d more" % (len(unchecked) - 12))
 214: 
 215:     base = 0
 216:     if os.path.exists(BASELINE_PATH):
 217:         try:
 218:             with io.open(BASELINE_PATH, encoding="utf-8") as fh:
 219:                 base = json.load(fh).get("count", 0)
 220:         except (ValueError, OSError):
 221:             base = 0
 222:     print()
 223:     print("lane 1 (inclusion vs arm-role)     %d" % len(f1))
 224:     print("lane 2 (refusal vs content)        %d" % len(f2))
 225:     print("restraint candidates               %d   (baseline %d)" % (len(findings), base))
 226:     print("unchecked                          %d" % len(unchecked))
 227:     if len(findings) > base:
 228:         print()
 229:         print("REFUSED: %d restraint candidate(s), above the baseline of %d."
 230:               % (len(findings), base))
 231:         print("Each is a DISAGREEMENT between two independent instruments, not a proven defect.")
 232:         print("Adjudicate it: either the classifier is withholding, or the inclusion is wrong.")
 233:         print("Both are findings. Neither is a safe default.")
 234:         return 1
 235:     print()
 236:     print("no NEW restraint candidates: no instrument refuses where an independent one decides.")
 237:     return 0
 238: 
 239: 
 240: if __name__ == "__main__":
 241:     sys.exit(main())

