 472: def main():
 473:     sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
 474:     dry = "--apply" not in sys.argv
 475:     only = [a for a in sys.argv[1:] if not a.startswith("--")]
 476:     n_ref = n_int = n_bk = topics = 0
 477:     no_ref = []
 478:     for path in sorted(glob.glob(os.path.join(REPO, "ssot", "*", "*.json"))):
 479:         topic = os.path.basename(os.path.dirname(path))
 480:         if os.path.basename(path) != topic + ".json":
 481:             continue
 482:         if only and topic not in only:
 483:             continue
 484:         try:
 485:             obj = json.load(io.open(path, encoding="utf-8"))
 486:         except ValueError:
 487:             continue
 488:         # `--all` WIDENS THE SCOPE TO EVERY TOPIC WITH A PAGE, not only the 28 that
 489:         # pool. Each part still refuses on its own terms: a topic with no included
 490:         # registration gets no reference list, one with no pooled interval gets no
 491:         # drafts. That is a per-part absence with a reason, not a whole topic
 492:         # skipped for want of one field.
 493:         if not ALL_TOPICS and not p46.pooled_outcomes(obj):
 494:             continue
 495:         topics += 1
 496:         # `setdefault` RETURNS AN EXISTING NULL. Twelve topics hold `manuscript: null`, so
 497:         # `setdefault("manuscript", {})` handed back None, the isinstance guard skipped them,
 498:         # and the run reported 16 of 28 while printing no reason for the other 12.
 499:         # THE GUARD, IMPORTED RATHER THAN REMEMBERED. `man["references"] = refs`
 500:         # below is UNCONDITIONAL, so a `--all` run over an authored object replaces
 501:         # written argument with a projection. `do_not_rebuild` guarded the BUILDER and
 502:         # this write came through a different door.
 503:         _dnr.check_object(path)
 504:         man = obj.get("manuscript")
 505:         if not isinstance(man, dict):
 506:             man = {}
 507:             obj["manuscript"] = man
 508: 
 509:         refs = references(obj)
 510:         if refs:
 511:             # AUTHORED PROSE IS THE ONE THING HERE THAT CANNOT BE REGENERATED. This assignment
 512:             # was unconditional while `introduction` below was guarded -- one field careful and
 513:             # the next not, in the same function.
 514:             _ag.refuse_if_authored(man, "references", topic,
 515:                                    "build_paper_bookkeeping_2026_08_21")
 516:             man["references"] = refs
 517:             n_ref += 1
 518:         else:
 519:             no_ref.append(topic)
 520: 
 521:         intro = introduction(obj)
 522:         if intro and not str(man.get("introduction") or "").strip():
 523:             _ag.refuse_if_authored(man, "introduction", topic,
 524:                                    "build_paper_bookkeeping_2026_08_21")
 525:             man["introduction"] = intro
 526:             n_int += 1
 527: 
 528:         bk = bookkeeping(obj, topic)
 529:         if len(bk) > 1:
 530:             obj["bookkeeping_%s" % TODAY.replace("-", "_")] = bk
 531:             n_bk += 1
 532: 
 533:         obj.setdefault("display_change_announced", []).append({
 534:             "date": TODAY,
 535:             "change": "references, the Introduction's factual half, and the five fetchable "
 536:                       "bookkeeping claims assembled from stored fields",
 537:             "values_moved": "NONE -- no estimate, judgement, rating or certainty is touched",
 538:             "what_changed": "references %s, introduction %s, bookkeeping claims %d"
 539:                             % ("built" if refs else "not buildable",
 540:                                "written" if intro else "not buildable", len(bk) - 1),
 541:             "why": ("A paper with no reference list and a 47-character Introduction is "
 542:                     "incomplete in ways that are pure assembly. Nothing interpretive is "
 543:                     "written: the four judgement claims are named as owed."),
 544:         })
 545:         print("%-44s refs %-3s intro %-3s bookkeeping %d"
 546:               % (topic[:44], "yes" if refs else "NO", "yes" if intro else "NO", len(bk) - 1))
 547:         if not dry:
 548:             atomic_write.write_json(path, obj, indent=1)
 549: 
 550:     if not topics:
 551:         sys.exit("PROOF FAILED: no topic with a pooled outcome was read. 28 have one.")
 552:     print("\n%d topic(s): references on %d, introduction on %d, bookkeeping on %d"
 553:           % (topics, n_ref, n_int, n_bk))
 554:     if no_ref:
 555:         print("NO REFERENCE LIST BUILDABLE (no included trial carries a registration): %s"
 556:               % ", ".join(no_ref))
 557:     if dry:
 558:         print("DRY RUN -- pass --apply to write")
