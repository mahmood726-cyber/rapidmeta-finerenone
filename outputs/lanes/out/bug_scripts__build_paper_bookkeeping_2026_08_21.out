 123: def _join_clause(tail):
 124:     """Attach a flattened block to a clause with the punctuation the tail actually needs.
 125: 
 126:     THE SEAM, AND IT APPEARED THE MOMENT THE LEAD-INS LANDED. The join was hardcoded as
 127:     `"; " + tail.rstrip(".")`, which was right while `_flat` produced a lowercase key --
 128:     "... on each entry; what verifies this object: ...". With English lead-ins the tail is a
 129:     capitalised SENTENCE, so the same join produced:
 130: 
 131:         "... on the dates recorded on each entry; This object's verification rests on ..."
 132: 
 133:     A semicolon followed by a capital is wrong either way round: a full stop before a sentence,
 134:     or a lowercase continuation after a semicolon. `.rstrip(".")` compounded it by removing the
 135:     sentence's own terminator.
 136: 
 137:     So the connector is chosen from the TAIL rather than fixed: a sentence gets a full stop and
 138:     keeps its punctuation; a lowercase fragment keeps the semicolon it was written for. Returns
 139:     "." alone when there is no tail, so the head still ends as a sentence.
 140:     """
 141:     t = (tail or "").strip()
 142:     if not t:
 143:         return "."
 144:     if t[:1].isupper():
 145:         return ". " + (t if t.endswith((".", "?", "!")) else t + ".")
 146:     return "; " + t.rstrip(".") + "."
