  76: def _flat(v):
  77:     """A stored value as prose. NEVER `str()` a container into a manuscript.
  78: 
  79:     `str(obj.get("verification_basis") or "")` put this, verbatim, into MAVACAMTEN's
  80:     Methods -- search paragraph on a page built 2026-08-18:
  81: 
  82:         {'what_verifies_this_object': 'ClinicalTrials.gov protocol records, read 2026-08-18',
