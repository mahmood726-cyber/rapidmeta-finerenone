 263:                   "is what a reader would look up."),
 264:         "included_studies": inc,
 265:         "published_syntheses_compared_against": pub,
 266:         "_published_syntheses_note": (
 267:             ("Appraised against this review; the comparison and its denominator are in "
 268:              "`published_comparison`. " if pub else
 269:              "No published synthesis is listed here. The comparison section states its own "
 270:              "denominator and why nothing citable was appraised. ")
 271:             + (("%d appraised record(s) -- %s -- carry an identifier and NO title, journal or "
 272:                 "year, so they cannot be written as a citation and are named here rather than "
 273:                 "drawn as a blank row under a filled header."
 274:                 % (len(unc), ", ".join(unc))) if (unc := unciteable_syntheses(obj)) else "")),
 275:         "methods_guidance_and_software": meth,
 276:     }
 277: 
 278: 
 279: def introduction(obj):
 280:     """The factual half. The interpretive sentences are named as owed, never written."""
 281:     q = str(obj.get("question") or "").strip()
 282:     outs = [o for o in (obj.get("outcomes") or []) if isinstance(o, dict)]
 283:     pools = pooled_blocks(obj)
 284:     ks, n = [], 0
 285:     for blk in pools.values():
 286:         if isinstance((blk or {}).get("k"), int):
 287:             ks.append(blk["k"])
 288:         for t in ((blk or {}).get("per_trial") or []):
 289:             for key in ("n", "n_total", "enrolment", "registered_enrolment"):
 290:                 if isinstance((t or {}).get(key), int):
 291:                     n += t[key]
 292:                     break
 293:     if not q or not pools:
 294:         return None
 295:     k = max(ks) if ks else 0
 296:     names = [str(o.get("name") or o.get("id")) for o in outs if o.get("name") or o.get("id")]
 297:     comp = next((str(o.get("comparator")) for o in outs if o.get("comparator")), None)
 298:     if not comp:
 299:         comp = next((str((b or {}).get("comparator")) for b in pools.values()
 300:                      if (b or {}).get("comparator")), None)
 301: 
 302:     parts = []
 303:     # TERMINAL PUNCTUATION IS NOT ONLY "?". This tested for a question mark and appended a full
 304:     # stop otherwise, so a question already ending in a full stop got a second one: "... which
 305:     # is not what the withdrawal on this page said.. It examines 2 randomised trials ...", on
 306:     # ~20 objects. Found by the grammar-seam gate on its first real run, and it predates the
 307:     # lead-in work entirely -- nothing had ever looked at the joins.
 308:     parts.append("This review asks: %s"
 309:                  % (q if q.rstrip().endswith(("?", ".", "!")) else q + "."))
 310:     # "IT POOLS 3 RANDOMISED TRIALS" ON A PAGE WHOSE THESIS IS THAT THEY CANNOT BE COMBINED.
 311:     #
 312:     # mavacamten-hcm exists to say its three trials register three unrelated primaries and are
 313:     # not poolable; its Introduction announced a pool anyway. malaria-act read "It pools 0
 314:     # randomised trials, against not applicable." The verb was unconditional -- the same defect
 315:     # as the abstract's Methods sentence, in a second section, from the same field.
 316:     _pooled_any = any(
 317:         isinstance((b or {}).get("pooled"), dict)
 318:         and (b or {}).get("pooled", {}).get("point") is not None
 319:         and not (b or {}).get("pooled", {}).get("withdrawn")
 320:         for b in pools.values())
 321:     if _pooled_any:
 322:         base = "It pools %d randomised trial%s" % (k, "" if k == 1 else "s")
 323:     elif k:
 324:         base = ("It examines %d randomised trial%s and DOES NOT POOL THEM"
 325:                 % (k, "" if k == 1 else "s"))
 326:     else:
 327:         base = "It identifies no trial that can be pooled"
 328:     if n:
 329:         base += " comprising %s participants as registered" % format(n, ",")
 330:     if comp and str(comp).strip().lower() not in (
 331:             "", "none", "not applicable", "n/a", "not recorded", "unknown"):
 332:         base += ", against %s" % comp
 333:     parts.append(base + ".")
 334:     if names:
 335:         # THE THIRD SURFACE ASSERTING A POOL. "The outcome pooled is ..." on a page that
 336:         # pools nothing is the same defect as the Methods sentence and the "It pools N"
 337:         # clause, in a third place, and it would have survived fixing the other two.
 338:         parts.append(("The outcome%s pooled %s %s." if _pooled_any else
 339:                       "The outcome%s sought %s %s.")
 340:                      # STRIPPED BEFORE JOINING. An outcome name carrying trailing whitespace
 341:                      # -- "Percentage of Observed Participants With Outcome " -- met the
 342:                      # appended full stop and produced "... With Outcome ." on pcsk9. A stored
 343:                      # value is not guaranteed tidy, and a join is the wrong place to assume it.
 344:                      % ("" if len(names) == 1 else "s",
 345:                         "is" if len(names) == 1 else "are",
 346:                         "; ".join(str(n).strip() for n in names[:6])))
 347:     prov = _flat(obj.get("provenance"))
 348:     if prov:
 349:         parts.append("Every count and denominator behind those estimates is read as follows. "
 350:                      + (prov if prov.endswith(".") else prov + "."))
 351:     parts.append(
 352:         "Everything in this paragraph is derived from stored fields and none of it is "
 353:         "authored. The interpretive sentences that follow are marked as drafts and are the "
 354:         "author's to replace.")
 355:     return "\n\n".join(parts)
 356: 
 357: 
 358: def bookkeeping(obj, topic):
 359:     out = {"_what": ("The five reporting claims a PRISMA-2020 manuscript needs that are "
 360:                      "FETCHABLE rather than argued -- each derived from a field here, or "
 361:                      "stated as an honest absence.")}
 362: 
 363:     # 1. WHICH LIMBS THIS REVIEW REFUSES
 364:     try:
 365:         sc = p46.score(obj)
 366:     except Exception:                                          # noqa: BLE001
 367:         sc = None
 368:     if isinstance(sc, dict):
 369:         # `score` returns {limb: [STATE, detail]}, not {limb: STATE}. Read the state.
 370:         def _state(v):
 371:             return str(v[0] if isinstance(v, (list, tuple)) and v else v).upper()
 372:         held = sorted(k for k, v in sc.items() if _state(v) == "HELD")
 373:         not_held = sorted(k for k, v in sc.items() if k not in held)
 374:         out["which_limbs_this_review_refuses"] = (
 375:             "Of the four properties this project requires of a completed topic, %d are held "
 376:             "(%s)%s." % (len(held), ", ".join(x.replace("_", " ") for x in held) or "none",
 377:                          "" if not not_held else
 378:                          " and %d are refused with the obstacle named in the evidence (%s)"
 379:                          % (len(not_held),
 380:                             ", ".join(x.replace("_", " ") for x in not_held))))
 381: 
 382:     # 2. THE SEARCH -- TWO HALVES, NEVER CONFLATED
 383:     scr = None
 384:     for p in sorted(glob.glob(os.path.join(REPO, "ssot", topic, "appraisal", "*.json"))):
 385:         try:
 386:             d = json.load(io.open(p, encoding="utf-8"))
 387:         except ValueError:
 388:             continue
 389:         if d.get("query_as_executed"):
 390:             scr = d
 391:             break
 392:     halves = []
 393:     prov = _flat(obj.get("provenance"))
 394:     vb = _flat(obj.get("verification_basis"))
 395:     inc = included_studies(obj)
 396:     if inc:
 397:         dates = sorted({r["read_utc"] for r in inc if r["read_utc"]})
 398:         halves.append(
 399:             "PRIMARY TRIALS. NO BIBLIOGRAPHIC SEARCH FOR PRIMARY TRIALS WAS RUN. The %d "
 400:             "included trial%s %s identified by reading named registration%s on %s%s"
 401:             % (len(inc), "" if len(inc) == 1 else "s",
 402:                "was" if len(inc) == 1 else "were", "" if len(inc) == 1 else "s",
 403:                " and ".join(dates) if dates else "the dates recorded on each entry",
 404:                _join_clause(vb or prov)))
 405:     if scr:
 406:         halves.append(
 407:             "PUBLISHED SYNTHESES. %s, executed %s. Query as executed: %s. It matched %s "
 408:             "record(s), of which %s were retrieved and %s read; %s appraised."
 409:             % (scr.get("source", "a bibliographic database"), scr.get("executed_utc", "?"),
 410:                scr.get("query_as_executed"), scr.get("matched", "?"),
 411:                scr.get("retrieved", "?"), scr.get("read", "?"),
 412:                len(scr.get("appraised") or []) if isinstance(scr.get("appraised"), list)
 413:                else scr.get("appraised", "?")))
 414:     if halves:
 415:         out["the_search_its_date_and_its_databases"] = " ".join(halves)
 416: 
 417:     # 3. PROSPECTIVE REGISTRATION
 418:     pro = g(obj, "prospero") or g(obj, "protocol.prospero") or g(obj, "protocol.registration")
 419:     out["whether_this_review_was_prospectively_registered"] = (
 420:         str(pro) if isinstance(pro, str) and pro.strip() else
 421:         "NO PROSPERO REGISTRATION OR PROTOCOL RECORD IS HELD ON THIS OBJECT. That is not the "
 422:         "same as knowing this review was not registered, and neither claim is made. It is "
 423:         "recorded here as an absence so that a reader does not have to infer it from silence.")
 424: 
 425:     # 4. THE SECOND ASSESSOR
 426:     rob = obj.get("risk_of_bias") or {}
 427:     sa = next((rob[k] for k in sorted(rob) if str(k).startswith("SECOND_ASSESSOR")
 428:                and isinstance(rob[k], dict)), None)
 429:     if sa:
 430:         rc = next((sa[k] for k in sorted(sa) if k.startswith("RECOUNTED_AFTER")
 431:                    and isinstance(sa[k], dict)), None)
 432:         out["that_two_assessors_disagreed_and_where"] = (
 433:             "Risk of bias was assessed independently a second time by %s, blind to this "
 434:             "assessment and given the same registry facts. %s By domain: %s.%s"
 435:             % (sa.get("assessor_2", "a second assessor"),
 436:                sa.get("DISAGREEMENT_RATE", ""),
 437:                ", ".join("%s %s" % (k, v) for k, v in
 438:                          sorted((sa.get("PER_DOMAIN") or {}).items())) or "not recorded",
 439:                (" Recounted after this review's D1 judgements moved: %s."
 440:                 % rc.get("recounted_now", "")) if rc else ""))
 441:     else:
 442:         out["that_two_assessors_disagreed_and_where"] = (
 443:             "NO SECOND, INDEPENDENT RISK-OF-BIAS ASSESSMENT IS RECORDED FOR THIS TOPIC. The "
 444:             "judgements were made once. Stated so that single assessment is not mistaken for "
 445:             "agreement between two.")
 446: 
 447:     # 5. WHICH ROB DOMAINS DROVE THE RATING
 448:     drove = {}
 449:     for oid, per in (rob.get("by_outcome") or {}).items():
 450:         if not isinstance(per, dict):
 451:             continue
 452:         for rid, j in per.items():
 453:             if not isinstance(j, dict):
 454:                 continue
 455:             ov = str(j.get("overall") or "").upper()
 456:             if ov in ("", "LOW"):
 457:                 continue
 458:             for k, v in (j.get("domains") or {}).items():
 459:                 if isinstance(v, dict) and str(v.get("judgement") or "").upper() == ov:
 460:                     drove[str(k).split("_")[0].upper()] = drove.get(
 461:                         str(k).split("_")[0].upper(), 0) + 1
 462:     if drove:
 463:         out["which_risk_of_bias_domains_drove_the_rating"] = (
 464:             "Where a result is rated worse than LOW overall, the domain carrying that "
 465:             "judgement is: %s. The overall rating is the worst domain, so these are the "
 466:             "domains that determine it."
 467:             % ", ".join("%s on %d result(s)" % (k, n)
 468:                         for k, n in sorted(drove.items(), key=lambda kv: (-kv[1], kv[0]))))
 469:     return out
 470: 
