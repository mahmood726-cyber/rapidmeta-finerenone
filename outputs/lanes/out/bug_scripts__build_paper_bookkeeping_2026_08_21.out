  97:         parts = [_flat(x) for x in v]
  98:         parts = [x for x in parts if x]
  99:         if not parts:
 100:             return ""
 101:         return ", ".join(parts[:-1]) + (" and " + parts[-1] if len(parts) > 1 else parts[0])
