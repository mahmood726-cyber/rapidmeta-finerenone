  61: 
  62: GUIDANCE = {
  63:     "rob2": ("Sterne JAC, Savovic J, Page MJ, et al. RoB 2: a revised tool for assessing risk "
  64:              "of bias in randomised trials. BMJ. 2019;366:l4898. doi:10.1136/bmj.l4898"),
  65:     "grade": ("Schunemann HJ, Higgins JPT, Vist GE, et al. Chapter 14: Completing 'Summary of "
  66:               "findings' tables and grading the certainty of the evidence. In: Cochrane "
  67:               "Handbook for Systematic Reviews of Interventions version 6.5. Cochrane; 2024."),
