 136: # something is narrow and countable:
 137: #
 138: #     A NEGATIVE GUARD INSIDE A LOOP OVER THE CORPUS.
 139: #
 140: # A negative guard inside one page's rendering is a local decision. A negative guard inside
 141: # a loop over every object or every page DECIDES WHAT A FIX REACHES -- and `zero paper-*
 142: # sections` standing in for `built by an older generator` silently removed three live pages
 143: # from the reading-order rollout, two of which serve nothing for a pooled point their own
 144: # object holds.
 145: #
 146: # RATCHET, NOT CLEARANCE. The subset present today is recorded in a baseline. It must not
 147: # grow. Each entry is a candidate, not a verdict: excluding a record that genuinely has no
 148: # comparator arm is correct, and only reading settles which. What the ratchet buys is that
 149: # THE NEXT ONE IS SEEN WHEN IT IS WRITTEN, rather than after it has quietly excluded
 150: # something from a corpus-wide pass.
 151: # ---------------------------------------------------------------------------------------
 152: 
 153: CORPUS_LOOP = re.compile(
 154:     r"for\s+\w+.*\bin\b.*(?:glob\.glob\(|os\.listdir\(|os\.walk\(|PAGE_MAP|apps\b|"
 155:     r"topics\b|objects\b|pages\b)")
 156: 
 157: BASELINE = os.path.join(REPO, "scripts", "baselines", "exclusion_by_absence_baseline.json")
 158: 
 159: 
 160: def indent_of(line):
 161:     return len(line) - len(line.lstrip())
 162: 
 163: 
 164: def corpus_wide_subset():
 165:     """Negative guards lexically inside a loop that iterates the corpus."""
 166:     out = []
 167:     for root in (os.path.join(REPO, "scripts"), os.path.join(REPO, "ssot")):
 168:         if not os.path.isdir(root):
 169:             continue
 170:         for dp, _d, names in os.walk(root):
 171:             for nm in sorted(names):
 172:                 if not nm.endswith(".py"):
 173:                     continue
 174:                 fp = os.path.join(dp, nm)
 175:                 rel = os.path.relpath(fp, REPO).replace("\\", "/")
 176:                 try:
 177:                     lines = io.open(fp, encoding="utf-8", errors="replace").read().split("\n")
 178:                 except Exception:
 179:                     continue
 180:                 # Stack of open corpus loops as (indent, header line number).
 181:                 stack = []
 182:                 for i, ln in enumerate(lines):
 183:                     if not ln.strip() or ln.strip().startswith("#"):
 184:                         continue
 185:                     ind = indent_of(ln)
 186:                     while stack and ind <= stack[-1][0]:
 187:                         stack.pop()
 188:                     if CORPUS_LOOP.search(ln):
 189:                         stack.append((ind, i + 1))
 190:                         continue
 191:                     if not stack:
 192:                         continue
 193:                     if not NEG_GUARD.search(ln):
 194:                         continue
 195:                     nxt = "\n".join(lines[i + 1:i + 3])
 196:                     if EXIT.search(nxt):
 197:                         out.append((rel, i + 1, stack[-1][1], ln.strip()[:76]))
 198:     return out
 199: 
 200: 
 201: def keys_for(subset):
 202:     """Baseline keys: FILE :: GUARD TEXT # nth-occurrence-of-that-text-in-that-file.
 203: 
 204:     KEYED BY LINE NUMBER, THIS RATCHET REPORTED UNCHANGED GUARDS AS NEW EVERY TIME ANYTHING
 205:     ABOVE THEM WAS EDITED. `audit_p46_limbs_reach_a_reader.py`'s three guards were re-baselined
 206:     THREE TIMES for that reason alone -- the baseline's own note says so -- and a fourth
 207:     re-baselining was what blocked the commit that prompted this change. Re-writing the entries
 208:     a fourth time would have been the symptom fix; the key is the cause.
 209: 
 210:     IT IS NOT MERELY LOOSER. A bare file+text key would collapse two identical guard lines in
 211:     one file into a single entry, and a genuinely new second instance would then hide behind
 212:     the first -- three files carry such a pair today. The occurrence index keeps them distinct,
 213:     so the ratchet still rises when a duplicate guard is ADDED, and stops rising when a line is
 214:     merely MOVED. `prove_ratchet` demonstrates both directions on every run.
 215: 
 216:     The line number stays in the printed report, where it helps a reader open the file. It is
 217:     no longer part of the identity, because it was never the thing that made a guard the guard.
 218:     """
 219:     seen = {}
 220:     out = []
 221:     for h in subset:
 222:         base = "%s::%s" % (h[0], h[3])
 223:         n = seen.get(base, 0)
 224:         seen[base] = n + 1
 225:         out.append("%s#%d" % (base, n))
 226:     return out
 227: 
 228: 
 229: def ratchet(subset, write_if_missing=True):
 230:     """-> (known, new, healed). Exits non-zero from main() when `new` is non-empty."""
 231:     present = sorted(keys_for(subset))
 232:     if not os.path.exists(BASELINE):
 233:         if not write_if_missing:
 234:             return set(), [], []
 235:         os.makedirs(os.path.dirname(BASELINE), exist_ok=True)
 236:         json.dump({
 237:             "written": "2026-08-20",
 238:             "what": ("Negative guards lexically inside a loop over the corpus. A guard here "
 239:                      "decides what a corpus-wide fix REACHES, which is how the reading-order "
 240:                      "rollout's `zero paper sections` silently dropped three live pages."),
 241:             "not_a_verdict": ("Each entry is a CANDIDATE. Many are correct. The ratchet "
 242:                               "exists so the next one is seen when it is written."),
 243:             "guards": present,
 244:         }, io.open(BASELINE, "w", encoding="utf-8", newline="\n"), indent=1,
 245:             ensure_ascii=False)
 246:         print("wrote baseline %s with %d guards" % (BASELINE, len(present)))
 247:         return set(present), [], []
 248:     base = json.load(io.open(BASELINE, encoding="utf-8"))
 249:     known = set(base.get("guards") or [])
 250:     new = sorted(set(present) - known)
 251:     healed = sorted(known - set(present))
 252:     return known, new, healed
 253: 
 254: 
 255: def main():
 256:     files, hits = code_sweep()
 257:     objects, reasons = object_sweep()
 258:     if files == 0 and objects == 0:
 259:         print("NOT_ASSESSABLE: read no files and no objects.")
 260:         return 2
 261: 
 262:     print("python files read                            %d" % files)
 263:     print("NEGATIVE guards that exclude, skip or return %d" % len(hits))
 264:     print()
 265:     print("objects read                                 %d" % objects)
 266:     print("recorded exclusions phrased as an absence    %d" % len(reasons))
 267:     print()
 268:     byfile = {}
 269:     for rel, ln, txt in hits:
 270:         byfile.setdefault(rel, []).append((ln, txt))
 271:     print("TOP FILES BY NEGATIVE-EXCLUSION COUNT:")
 272:     for rel, rows in sorted(byfile.items(), key=lambda kv: -len(kv[1]))[:16]:
 273:         print("   %-56s %3d" % (rel, len(rows)))
 274:     print()
 275:     if reasons:
 276:         from collections import Counter
 277:         c = Counter(n for n, _t in reasons)
 278:         print("OBJECTS WITH THE MOST ABSENCE-PHRASED EXCLUSIONS:")
 279:         for n, k in c.most_common(8):
 280:             print("   %-46s %4d" % (n, k))
 281:         print()
 282:         print("   examples:")
 283:         for n, t in reasons[:5]:
 284:             print("     %-30s %s" % (n[:30], t))
 285:     print()
 286:     print("COUNTED AND NAMED, NOT ADJUDICATED. Many of these are correct -- excluding a")
 287:     print("record that genuinely has no comparator arm is right. The defect is only where")
 288:     print("the absence stands in for a DIFFERENT property that was meant, as `zero paper")
 289:     print("sections` stood in for `built by an older generator` and `phase not in the")
 290:     print("enumerated list` stood in for `not a phase 3 trial`. Reading each settles it.")
 291:     return 0
 292: 
 293: 
 294: def prove_ratchet():
 295:     """A guard not in the baseline must come back NEW. Otherwise the ratchet is decorative."""
 296:     subset = corpus_wide_subset()
 297:     fake = ("scripts/PROOF_not_a_real_file.py", 1, 1, "if not x:")
 298:     _k, new, _h = ratchet(subset + [fake], write_if_missing=False)
 299:     if "scripts/PROOF_not_a_real_file.py::if not x:#0" not in new:
 300:         sys.exit("PROOF FAILED: a guard absent from the baseline was NOT reported as new. "
 301:                  "The ratchet cannot rise and therefore cannot fall either.")
 302:     # THE DUPLICATE DIRECTION, WHICH THE NEW KEY COULD HAVE LOST AND THIS FORBIDS.
 303:     # Keying on file+text alone would let a SECOND copy of an already-baselined guard line
 304:     # slip in silently. Take a real baselined guard, add an identical one, and require the
 305:     # ratchet to see it. Without this the looser key would be an unmeasured weakening.
 306:     if subset:
 307:         dup = subset[0]
 308:         _k, newd, _h = ratchet(subset + [dup], write_if_missing=False)
 309:         if not newd:
 310:             sys.exit("PROOF FAILED: a SECOND copy of an already-baselined guard line was not "
 311:                      "reported as new. The occurrence index is not distinguishing duplicates, "
 312:                      "so the key is looser than the line-number key it replaced.")
 313:     _k, new2, _h = ratchet(subset, write_if_missing=False)
 314:     if new2:
 315:         sys.exit("PROOF FAILED: the unmodified corpus reports %d new guards, so the "
 316:                  "baseline does not describe the corpus it was written from." % len(new2))
 317:     print("PROOF PASSED: an unbaselined corpus-wide negative guard is reported NEW, a DUPLICATE")
 318:     print("of a baselined one is reported NEW, and the corpus as it stands reports none.")
 319: 
 320: 
 321: def report_corpus_subset(gate):
 322:     subset = corpus_wide_subset()
 323:     print("")
 324:     print("THE ENUMERABLE SUBSET -- negative guards INSIDE a loop over the corpus: %d"
 325:           % len(subset))
 326:     print("A guard here decides what a corpus-wide FIX REACHES. The reading-order rollout's")
 327:     print("`zero paper-* sections` excluded three live pages, two of which serve nothing for")
 328:     print("a pooled point their object holds.")
 329:     for rel, ln, loop, txt in subset[:40]:
 330:         print("    %s:%d  (loop opened at line %d)" % (rel, ln, loop))
 331:         print("        %s" % txt)
 332:     if len(subset) > 40:
 333:         print("    ... +%d more" % (len(subset) - 40))
 334:     known, new, healed = ratchet(subset)
 335:     if healed:
 336:         print("")
 337:         print("%d guard(s) in the baseline are gone." % len(healed))
 338:     if new:
 339:         print("")
 340:         print("REFUSED: %d NEW negative guard(s) inside a corpus-wide loop:" % len(new))
 341:         for k in new:
 342:             print("    %s" % k)
 343:         print("")
 344:         print("State the POSITIVE property instead -- `built by generator X`, not `has zero")
 345:         print("X sections` -- or add it to the baseline with a line saying why the absence")
 346:         print("IS the property you mean.")
 347:         if gate:
 348:             sys.exit(1)
 349:     elif os.path.exists(BASELINE):
 350:         print("NO NEW CORPUS-WIDE NEGATIVE GUARD. The baseline has not risen.")
 351: 
 352: 
 353: if __name__ == "__main__":
 354:     if "--prove" in sys.argv:
 355:         prove_ratchet()
 356:     else:
 357:         main()
 358:         report_corpus_subset("--gate" in sys.argv)

codex
Found defects:

- **CHECK THAT CANNOT FAIL**, line 258. Input: repo with `scripts/audit_exclusion_by_absence.py` present and `ssot/` empty; run `python scripts/audit_exclusion_by_absence.py`. Consequence: `files == 0` is false because the script reads itself, so `NOT_ASSESSABLE` cannot fire in the asserted module location.

- **SELECTOR KEYED TOO NARROWLY**, line 61. Input scanned file:
  `if not x.get("paper_sections", []):` then `continue`. Consequence: the documented `if not x.get(...)` case is missed because the regex cannot consume comma/space arguments.

- **INSTRUMENT READS A NAME, NOT ITS BINDING**, lines 153-155. Input scanned file:
  `def f(pages):` / `for page in pages:` / `if not page:` / `continue`. Consequence: a local loop named `pages` is reported as corpus-wide.

- **SELECTOR MISSES A CORPUS GLOB FORM**, lines 153-155. Input scanned file:
  `for page in Path("out").glob("*.html"):` / `if not sections:` / `continue`. Consequence: a corpus-wide guard is not ratcheted because only `glob.glob(` is recognized.

- **STATUS/EXIT PROBE FALSE POSITIVE**, line 64. Input scanned file:
  `if not sections:` / `skip_reason = "kept"` / `render()`. Consequence: `skip` inside `skip_reason` is counted as an excluding action.

- **STATUS/EXIT PROBE FALSE NEGATIVE**, line 195. Input scanned file:
  `if not sections:` / `log()` / `seen += 1` / `continue`. Consequence: a real skip is missed because only the next two lines are inspected.

- **ZERO CONFLATED WITH ABSENT**, line 117. Input object: `{"screening":{"excluded":0}}`. Consequence: explicit scalar zero is treated the same as a missing/empty exclusion list, hiding malformed or meaningful data.

No proven defect found for: probe keyed to a string a fix removes; idempotency guard satisfied by its own comment; CRLF/LF text comparison; merged-cell/off-by-one tabulation; negation dropped.
