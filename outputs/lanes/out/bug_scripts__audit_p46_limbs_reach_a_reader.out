 328:     print("")
 329:     print("TOPICS WITH AT LEAST ONE POOLED OUTCOME: %d" % len(rows))
 330:     print("")
 331:     hdr = ("topic", "RoB", "GRADE", "compare", "output")
 332:     print("%-42s %-13s %-13s %-13s %-13s" % hdr)
 333:     tally = dict((s, 0) for s in
 334:                  ("HELD+RENDERS", "HELD ONLY", "REFUSED+NAMED", "REFUSED, NOT NAMED",
 335:                   "NO PAGE", "UNPROBEABLE", "WEAK PROBE", "not held"))
 336:     both = held_only_topics = []
