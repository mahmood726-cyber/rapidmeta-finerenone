 156: 
 157: def strings_under(node, depth=0):
 158:     """Every string leaf under `node`, longest first, skipping bookkeeping keys."""
 159:     out = []
 160:     if isinstance(node, str):
 161:         out.append(node)
 162:     elif isinstance(node, dict):
 163:         for k, v in node.items():
 164:             if str(k).startswith("_") or str(k).upper().startswith("SUPERSEDED"):
 165:                 continue
 166:             out.extend(strings_under(v, depth + 1))
 167:     elif isinstance(node, list):
 168:         for v in node:
 169:             out.extend(strings_under(v, depth + 1))
 170:     return out
 171: 
 172: 
 173: def limb_probe(obj, limb):
 174:     """A string the renderer should emit for this limb, taken out of the object."""
 175:     if limb == "rob_per_result":
 176:         node = (obj.get("risk_of_bias") or {}).get("by_outcome")
 177:     elif limb == "grade_per_pool":
 178:         node = (obj.get("grade") or {}).get("by_outcome")
 179:         if not node:
 180:             node = [blk.get("grade") for _, blk in p46.pooled_outcomes(obj)]
 181:     elif limb == "comparison_denominator":
 182:         node = obj.get("published_comparison")
 183:     else:
 184:         # PROBE THE VERBATIM, WHICH IS THE THING THE LIMB SCORES.
 185:         #
 186:         # The first version of this function EXCLUDED `verbatim` and probed the prose fields
 187:         # around it -- what_it_is, interval_method, reproduction_of_the_previous_value -- on
 188:         # the reasoning that machine output is full of quotes. It reported HELD ONLY for
 189:         # eleven topics INCLUDING one whose R output I had confirmed on the public host an
 190:         # hour earlier. The prose fields genuinely do not render (the projector emits only
 191:         # environment, call and verbatim), but that is a different finding, and reporting it
 192:         # as "limb 4 reaches no reader" would have been false.
 193:         #
 194:         # A probe must come from the thing the limb scores. `p46_queue` scores
 195:         # `r_output.verbatim`; so does this. Class 77 in my own instrument, again.
 196:         node = [str((blk.get("r_output") or {}).get("verbatim") or "")
 197:                 for _, blk in p46.pooled_outcomes(obj)]
 198:         node = [s for s in node if s] or None
 199:     if not node:
 200:         return []
 201:     out = []
 202:     for s in sorted(strings_under(node), key=len, reverse=True):
 203:         p = probe_from(s)
 204:         if p and p not in out:
 205:             out.append(p)
 206:         if len(out) >= 12:
 207:             break
 208:     return out
