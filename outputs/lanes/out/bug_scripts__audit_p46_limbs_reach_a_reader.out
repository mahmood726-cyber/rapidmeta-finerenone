 233: 
 234: # Pages from OTHER topics, used to test that a probe is distinctive rather than boilerplate.
 235: # Chosen to span builders and eras: an authored docmodel, an antibiotic pool, a lipid pool.
 236: CONTROL_PAGES = ["ARNI_HF_REVIEW.html", "LEFAMULIN_CABP_AUTO_FULL_REVIEW.html",
 237:                  "INCLISIRAN_LIPID_KIDNEY_AUTO_FULL_REVIEW.html", "ATTR_CM_REVIEW.html"]
 238: 
 239: 
 240: def main():
 241:     rev = page_map()
 242:     cache = {}
 243: 
 244:     def delivered(page):
 245:         if page not in cache:
 246:             p = os.path.join(REPO, page)
 247:             cache[page] = io.open(p, encoding="utf-8", errors="replace").read() \
 248:                 if os.path.isfile(p) else None
 249:         return cache[page]
 250: 
 251:     # ---- CONTROLS. The positive is a limb VERIFIED ON THE PUBLIC HOST earlier tonight; the
 252:     # negative is a sentence of the right shape that is in no object at all.
 253:     cab = json.load(io.open(os.path.join(
 254:         REPO, "ssot", "cab-prep-hiv-review", "cab-prep-hiv-review.json"), encoding="utf-8"))
 255:     pos_probe = (limb_probe(cab, "comparison_denominator") or [None])[0]
 256:     pos_page = delivered("CAB_PREP_HIV_REVIEW.html") or ""
 257:     require_controls(
 258:         "audit_p46_limbs_reach_a_reader",
 259:         positive=("cab-prep-hiv-review's comparison probe, confirmed on the public host at "
 260:                   "2026-08-21, is found in the delivered bytes",
 261:                   bool(pos_probe) and pos_probe in pos_page, True),
 262:         negative=("a sentence of the right shape that no object contains is reported as "
 263:                   "rendering",
 264:                   "THIS SENTENCE IS IN NO OBJECT AND MUST NOT BE FOUND ANYWHERE" in pos_page,
 265:                   True))
 266: 
 267:     rows = []
 268:     for p in sorted(glob.glob(os.path.join(REPO, "ssot", "*", "*.json"))):
 269:         topic = os.path.basename(os.path.dirname(p))
 270:         if os.path.basename(p) != topic + ".json":
 271:             continue
 272:         try:
 273:             obj = json.load(io.open(p, encoding="utf-8"))
 274:         except ValueError:
 275:             continue
 276:         if not p46.pooled_outcomes(obj):
 277:             continue
 278:         sc = p46.score(obj)
 279:         pages = rev.get(topic) or []
 280:         row = {"topic": topic, "pages": pages, "limbs": {}}
 281:         for limb in LIMBS:
 282:             state = sc.get(limb, ("ABSENT", ""))[0]
 283:             if state == "ABSENT":
 284:                 row["limbs"][limb] = ("not held", state)
 285:                 continue
 286:             if not pages:
 287:                 row["limbs"][limb] = ("NO PAGE", "topic absent from PAGE_MAP")
 288:                 continue
 289: 
 290:             # A REFUSED LIMB IS A COMPLETED OUTCOME UNDER P46 AND ITS DELIVERY IS ASKED TOO.
 291:             # The claim is narrower and labelled as such: the projector generates its own
 292:             # refusal wording, so what can be tested is that the refusal is NAMED IN THIS
 293:             # LIMB'S OWN SECTION, not that the object's reason was projected.
 294:             if state == "REFUSED":
 295:                 named, why = False, "no section mapped for this limb"
 296:                 for pg in pages:
 297:                     named, why = refusal_named_in_section(delivered(pg) or "",
 298:                                                           SECTION_HEADING[limb])
 299:                     if named:
 300:                         break
 301:                 row["limbs"][limb] = (("REFUSED+NAMED", why) if named
 302:                                       else ("REFUSED, NOT NAMED", why))
 303:                 continue
 304: 
 305:             prs = limb_probe(obj, limb)
 306:             if not prs:
 307:                 row["limbs"][limb] = ("UNPROBEABLE", "no HTML-safe run of 40+ chars stored")
 308:                 continue
 309:             hit, pr = [], None
 310:             for cand in prs:
 311:                 hit = [pg for pg in pages if cand in (delivered(pg) or "")]
 312:                 if hit:
 313:                     pr = cand
 314:                     break
 315:             if not hit:
 316:                 row["limbs"][limb] = ("HELD ONLY", "none of %d stored sentence(s) is in %s"
 317:                                                    % (len(prs), ", ".join(pages)))
 318:                 continue
 319:             others = [delivered(pg) or "" for pg in CONTROL_PAGES if pg not in pages]
 320:             if not probe_is_distinctive(pr, delivered(hit[0]) or "", others):
 321:                 row["limbs"][limb] = ("WEAK PROBE", "the probe also appears on another "
 322:                                                     "topic's page, so it is boilerplate and "
 323:                                                     "proves nothing about this limb")
 324:                 continue
 325:             row["limbs"][limb] = ("HELD+RENDERS", hit[0])
 326:         rows.append(row)
