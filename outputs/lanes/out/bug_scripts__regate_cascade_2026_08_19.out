 172: def included_ncts(topic_dir):
 173:     """The object's own included set, read from the object -- never recalled."""
 174:     path = f"{REPO}/ssot/{topic_dir}/{topic_dir}.json"
 175:     obj = json.load(open(path, encoding="utf-8"))
 176:     out = []
 177:     pf = (obj.get("prisma_flow") or {}).get("included") or {}
 178:     out += [str(n) for n in (pf.get("nct") or [])]
 179:     for t in ((obj.get("inputs") or {}).get("trials") or []):
 180:         for key in ("nct", "nct_id", "registration", "registration_id", "id"):
 181:             v = t.get(key)
 182:             if isinstance(v, str) and v.upper().startswith("NCT"):
 183:                 out.append(v)
 184:                 break
 185:     return sorted(set(out))
