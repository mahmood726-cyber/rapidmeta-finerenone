 213:                   f"The delta below is NOT attributable to locate() alone.")
 214:         state, ids, detail = raw_search(spec["raw_expr"])
 215:         ids = sorted(set(ids))
 216:         inc = included_ncts(topic_dir)
 217: 
 218:         roles_old, roles_new, unreachable = {}, {}, []
 219:         for nct in ids:
 220:             st, study, det = X.fetch_raw(nct)
 221:             if st != X.OK:
 222:                 unreachable.append(nct)
 223:                 continue
 224:             payload = X.require_raw_v2(study, nct)
 225:             roles_old[nct] = OLD.locate(payload, syns_old)[0]
 226:             roles_new[nct], ev = NEW.locate(payload, syns_new)
