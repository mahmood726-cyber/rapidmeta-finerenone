 188: def tally(roles, mod):
 189:     return {
 190:         "k2_role_located": sum(1 for r in roles.values()
 191:                                if r in (mod.EXPERIMENTAL, mod.COMPARATOR, mod.BACKGROUND)),
 192:         "k3_experimental": sum(1 for r in roles.values() if r == mod.EXPERIMENTAL),
 193:         "k4_comparator": sum(1 for r in roles.values() if r == mod.COMPARATOR),
 194:         "k5_background": sum(1 for r in roles.values() if r == mod.BACKGROUND),
 195:         "kNA_not_assessable": sum(1 for r in roles.values() if r == mod.NOT_ASSESSABLE),
 196:     }
