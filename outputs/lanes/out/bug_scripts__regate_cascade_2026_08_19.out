 252:         print(f"--- {topic_dir}   [{key}]")
 253:         print(f"    search  {state} -- {detail}")
 254:         print(f"    k0 stored {spec['stored_k0']:>4}  |  k0 today {len(ids):>4}  "
 255:               f"({'SAME SURFACED SIZE' if len(ids) == spec['stored_k0'] else 'REGISTRY DRIFT -- reported, NOT folded into the classifier delta'})")
 256:         if unreachable:
 257:             print(f"    kUNREACHABLE {len(unreachable)} -- never read; not a verdict: {unreachable}")
 258:         print(f"    {'stage':<20}{'OLD':>6}{'NEW':>6}{'delta':>8}")
 259:         for stg in ("k2_role_located", "k3_experimental", "k4_comparator",
 260:                     "k5_background", "kNA_not_assessable"):
