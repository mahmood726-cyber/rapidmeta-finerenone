 119:         "raw_expr": {"query.cond": "heart failure",
 120:                      "query.intr": ("dapagliflozin OR empagliflozin OR sotagliflozin OR "
 121:                                     "canagliflozin OR ertugliflozin"),
 122:                      "filter.advanced": ("AREA[StudyType]INTERVENTIONAL AND "
 123:                                          "AREA[Phase]PHASE3")},
 124:     },
 125: }
 126: 
 127: SEARCH_API = "https://clinicaltrials.gov/api/v2/studies"
 128: 
 129: 
 130: def raw_search(expr, page_size=1000):
 131:     """(state, ids, detail). Paginates; never returns a partial list as if complete."""
 132:     ids, token, pages, total = [], None, 0, None
 133:     while True:
 134:         params = dict(expr)
 135:         params["fields"] = "NCTId"
 136:         params["pageSize"] = str(page_size)
 137:         params["countTotal"] = "true"
 138:         if token:
 139:             params["pageToken"] = token
 140:         url = f"{SEARCH_API}?{urllib.parse.urlencode(params)}"
 141:         try:
 142:             with urllib.request.urlopen(url, timeout=90) as resp:
 143:                 if resp.status != 200:
 144:                     return X.UNREACHABLE, ids, f"HTTP {resp.status} on page {pages + 1}"
 145:                 payload = json.loads(resp.read().decode("utf-8"))
 146:         except Exception as exc:                       # noqa: BLE001 - transport, reported
 147:             return X.UNREACHABLE, ids, f"{type(exc).__name__}: {exc} on page {pages + 1}"
 148:         for s in payload.get("studies") or []:
 149:             nct = (((s.get("protocolSection") or {}).get("identificationModule")
 150:                     or {}).get("nctId"))
 151:             if nct:
 152:                 ids.append(nct)
 153:         pages += 1
 154:         token = payload.get("nextPageToken")
 155:         # FROM THE FIRST PAGE ONLY. `countTotal=true` populates totalCount on the first
 156:         # response and returns null on later ones, so reading it here reported
 157:         # `returned==totalCount: False` on a complete multi-page fetch. Every query this file
 158:         # runs fits in one page, so the last page WAS the first and the defect could not
 159:         # show -- it was found on a two-page query in scripts/search_ablation_split.
 160:         # A guard that has only ever run on single-page inputs has not been tested on the
 161:         # case it exists for.
 162:         if pages == 1:
 163:             total = payload.get("totalCount")
 164:         if not token:
 165:             return (X.OK, ids,
 166:                     f"{len(ids)} ids over {pages} page(s), totalCount={total}, "
 167:                     f"nextPageToken=null, returned==totalCount: {len(ids) == total}")
 168:         if pages > 20:
 169:             return X.MALFORMED, ids, "pagination did not terminate in 20 pages"
