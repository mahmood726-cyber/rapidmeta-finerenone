 237:         rec = {"topic_dir": topic_dir, "topic_key": key,
 238:                "query_as_stored": spec["query_as_stored"],
 239:                "search_state": state, "search_detail": detail,
 240:                "stored_k0": spec["stored_k0"], "k0_today": len(ids),
 241:                "k0_drift": len(ids) - spec["stored_k0"],
 242:                "kUNREACHABLE": len(unreachable), "unreachable_ids": unreachable,
 243:                "old": t_old, "new": t_new,
 244:                "changed": {n: {"old": a, "new": b} for n, (a, b) in sorted(changed.items())},
 245:                "changed_evidence": {n[:-3]: roles_new[n] for n in roles_new
 246:                                     if n.endswith("_ev")},
 247:                "included_in_object": inc,
 248:                "included_that_changed_role": changed_included,
