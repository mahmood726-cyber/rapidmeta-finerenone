   1: """EXPORTER -- SSOT object  ->  the build artefact the harness detectors read.
   2: 
   3: WHY THIS EXISTS
   4:     The verification lane built 30 detectors, 20 of them artefact-decidable, and
   5:     proved they block on 13 real past defects. They caught nothing here, because
   6:     nothing produced the shape they read: `payloads_for()` extracted ZERO
   7:     payloads from our objects (41 top-level keys on ARNI, 32 on FINERENONE_CV),
   8:     and the gate then printed PASS on an artefact it could not see.
   9: 
  10:     INVOKED IS NOT SEEING. That is the join this file supplies, and it is the
  11:     fifth instance of one meta-mechanism -- the action succeeded, the effect was
  12:     never confirmed -- after push-is-not-deploy, the-repair-existing-is-not-the-
  13:     repair-arriving, a-library-no-build-invokes, and writing-is-not-preserving.
  14:     It is the first of the five caught BEFORE shipping rather than after.
  15: 
  16: THE RULE THIS FILE OBEYS ABOVE ALL OTHERS
  17:     NEVER SYNTHESISE A FIELD. Where the object does not carry what a detector
  18:     needs, the field is OMITTED, which the harness reports as NOT APPLICABLE --
  19:     a different statement from "checked and clean". A guessed `direction_of_
  20:     benefit` or an assumed `declared_class` would produce confident green on
  21:     exactly the detectors that exist to catch confident green.
  22: 
  23:     Every omission is counted and printed. An export that activates few checks
  24:     must look thin, not clean.
  25: 
  26: WHAT A FULL PASS OF THE GATE ON THESE ARTEFACTS DOES NOT ESTABLISH
  27:     - NOT that the page is correct: 10 of 30 detectors are retrieval-scoped and
  28:       cannot run against any static artefact.
  29:     - NOT that the object is complete. An absent field yields no payload, and no
  30:       payload is not a pass.
  31:     - NOT that this mapping is faithful. That is what the fixture-replay
  32:       acceptance test is for, and until a REAL past defect in a REAL object is
  33:       blocked through this exporter, the mapping is unvalidated however many
  34:       fixtures pass.
  35: """
  36: from __future__ import annotations
  37: 
  38: import argparse, io, json, os, re, sys
  39: 
  40: sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
  41: import retirement as R                                       # noqa: E402
  42: 
  43: if __name__ == "__main__":
  44:     sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
  45: 
  46: REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
  47: 
  48: # Sentinels the reader must never meet. Kept here rather than defaulted inside
  49: # the harness so the list is visible at the point of export.
  50: SENTINELS = ["NOT RECOVERABLE FROM THE PAGE", "REPLACE_ME", "__PLACEHOLDER__",
  51:              "{{", "TODO", "undefined", "NaN"]
  52: 
  53: 
  54: # THE TWO VOCABULARIES, WRITTEN DOWN. Left: what the SSOT objects say. Right:
  55: # (stored_scale, back_transform) as the harness detectors read them. Anything not
  56: # in this table is NOT mapped and the fields are omitted -- an unmappable scale
  57: # must reach the detector as "not declared", never as a guess.
  58: _SCALE_VOCAB = {
  59:     "log":      ("log", "exp"),
  60:     "linear":   ("natural", "identity"),
  61:     "natural":  ("natural", "identity"),
  62:     "identity": ("natural", "identity"),
  63: }
  64: 
  65: 
  66: def _measure_for(results, oid, trial):
  67:     """The effect MEASURE this object records for this trial-outcome, or None.
  68: 
  69:     The objects carry the measure on `results.by_outcome[oid].per_trial[]` and
  70:     usually NOT on the trial's own effect block, so reading only the effect block
  71:     left `measure` null on nine of ten rows and CHK021 returned INVALID -- ran,
  72:     saw nothing, reported nothing. This joins the two places the object records
  73:     the same fact. It is a LOOKUP, not an inference: no match, no measure.
  74:     """
  75:     tid, nct = trial.get("id"), trial.get("nct")
  76:     for row in ((results.get(oid) or {}).get("per_trial") or []):
  77:         if (nct and row.get("nct") == nct) or (tid and row.get("trial_id") == tid):
  78:             return row.get("measure")
  79:     return None
  80: 
  81: 
  82: def _visible(html):
  83:     html = re.sub(r"<(script|style)\b[^>]*>.*?</\1\s*>", " ", html, flags=re.S | re.I)
  84:     return re.sub(r"\s+", " ", re.sub(r"<[^>]+>", " ", html))
  85: 
  86: 
  87: def _pool_from_outcome(oid, res, outcome_def, omissions):
  88:     """One pool payload. Returns None when the object cannot support one."""
  89:     per = res.get("per_trial") or []
  90:     pooled = res.get("pooled") or {}
  91:     if not per:
  92:         omissions.append("%s: no per_trial rows -> no pool payload" % oid)
  93:         return None
  94: 
  95:     entries, rows = [], []
  96:     for t in per:
  97:         est = t.get("log_point")
  98:         se = t.get("log_se")
  99:         # The estimate/variance pair is what the duplicate and measure-mixing
 100:         # detectors compare. Deriving variance from a CI we already stored is a
 101:         # READ, not a guess; inventing one where no CI exists would not be.
 102:         if est is None or se is None:
 103:             omissions.append("%s/%s: no log_point+log_se -> entry omitted"
 104:                              % (oid, t.get("trial_id") or "?"))
 105:             continue
 106:         entries.append({
 107:             "id": t.get("trial_id") or t.get("nct") or "?",
 108:             "estimate": est,
 109:             "variance": se * se,
 110:             "measure": t.get("measure"),
 111:             # direction_of_benefit and intervention are NOT synthesised. The
 112:             # object records direction at OUTCOME level, so it is read from
 113:             # there; intervention is omitted unless the trial names one.
 114:             **({"direction_of_benefit": "efficacy"}
 115:                if (outcome_def or {}).get("direction_of_benefit") else {}),
 116:         })
 117:         rows.append(t)
 118: 
 119:     if not entries:
 120:         return None
 121: 
 122:     panel_rows = []
 123:     for t in per:
 124:         # A NULLED ENTRY IS NOT A CONTRIBUTING TRIAL AND MUST NOT BE COUNTED AS ONE.
 125:         # `finerenone-review` carries `NULLED:NCT01874431` in `per_trial` with a value while
 126:         # `k` is 3, so the panel showed four rows under a headline stating three --
 127:         # CHK009_POOL_IDENTITY, correctly. The entry stays on the object; it leaves the count.
 128:         if t.get("nulled") or str(t.get("trial_id") or t.get("nct") or "").startswith("NULLED:"):
 129:             continue
 130:         panel_rows.append({
 131:             "id": t.get("trial_id") or t.get("nct") or "?",
 132:             "outcome": res.get("estimand_id") or oid,
 133:             "population": t.get("population") or "randomised",
 134:             "window": "full",
 135:         })
 136: 
 137:     pool = {
 138:         "pool_id": oid,
 139:         "headline_k": res.get("k"),
 140:         "headline_outcome": res.get("estimand_id") or oid,
 141:         "panel_rows": panel_rows,
 142:         "entries": entries,
 143:     }
 144:     # declared_class is REQUIRED by the cross-agent detector and must never be
 145:     # invented: its absence is the defect that detector exists to catch.
 146:     dc = ((outcome_def or {}).get("declared_class")
 147:           or res.get("declared_class")
 148:           or (res.get("pool_uniformity") or {}).get("declared_class"))
 149:     if dc:
 150:         pool["declared_class"] = dc
 151:     else:
 152:         omissions.append("%s: no declared_class in the object -- LEFT ABSENT, "
 153:                          "which is what CHK on cross-agent pooling reads" % oid)
 154:     if pooled.get("point") is not None:
 155:         # The harness compares entry estimates on the SAME scale they are stored
 156:         # on. Our pooled point is natural-scale for ratios; the log is what the
 157:         # entries carry, so the log is what is exported.
 158:         import math
 159:         p = pooled["point"]
 160:         pool["pooled_estimate"] = (math.log(p) if (pooled.get("scale") == "log"
 161:                                                    and p > 0) else p)
 162:     return pool
 163: 
 164: 
 165: def export(obj, page_html=None):
 166:     """SSOT object -> artefact dict. Omits what the object does not carry."""
 167:     omissions = []
 168:     art = {}
 169:     art["page_id"] = obj.get("app_id") or "<unnamed>"
 170: 
 171:     bm = (obj.get("build_mode") or "").upper()
 172:     if bm:
 173:         art["build_path"] = "converted" if bm == "CONVERTED" else "author"
 174:         art["page_provenance"] = ("converted" if bm == "CONVERTED"
 175:                                   else "authored-reconciliation")
 176: 
 177:     # THE ARTEFACT CARRIES ITS OWN STATE, the same way a page carries `rapidmeta:page-state`.
 178:     # Downstream, `harness_gate.py` sees only artefacts -- it cannot open the object -- so an
 179:     # artefact from a topic that publishes no estimate looked identical to one from an adapter
 180:     # that recognised nothing. Two different states, indistinguishable, which is exactly the
 181:     # confusion this project keeps paying for. The exporter knows the difference and stamps it.
 182:     _pr = (((obj.get("results") or {}).get("by_outcome") or {}).get("primary") or {})
 183:     _pl = _pr.get("pooled") or {}
 184:     _k = _pr.get("k")
 185:     if _pl.get("point") is None and (_pl.get("withdrawn") or _pl.get("absent")
 186:                                      or (isinstance(_k, int) and _k < 2)):
 187:         art["publishes_no_estimate"] = {
 188:             "k": _k,
 189:             "because": ("withdrawn" if _pl.get("withdrawn") else
 190:                         "absent" if _pl.get("absent") else
 191:                         "k<2 -- one trial is not a meta-analysis"),
 192:             "means": ("This artefact yielding ZERO check executions is the CORRECT result, not "
 193:                       "an adapter that recognised nothing. PUBLISHES-NOTHING and UNRECOGNISED "
 194:                       "are different states and are never summed."),
 195:             "stamped_by": "scripts/export_artefact.py",
 196:         }
 197: 
 198:     trials = ((obj.get("inputs") or {}).get("trials")) or []
 199:     data_ids = [t.get("nct") or t.get("id") for t in trials if (t.get("nct") or t.get("id"))]
 200: 
 201:     results = ((obj.get("results") or {}).get("by_outcome")) or {}
 202:     engine_ids = []
 203:     for res in results.values():
 204:         for t in (res.get("per_trial") or []):
 205:             v = t.get("nct") or t.get("trial_id")
 206:             if v and v not in engine_ids:
 207:                 engine_ids.append(v)
 208: 
 209:     if data_ids and engine_ids:
 210:         art["engine_trial_ids"] = engine_ids
 211:         art["data_trial_ids"] = data_ids
 212:     else:
 213:         omissions.append("engine/data trial ids incomplete -> inert-engine check "
 214:                          "not emitted")
 215: 
 216:     outcomes = {o.get("id"): o for o in (obj.get("outcomes") or [])}
 217:     pools = []
 218:     any_pooled = None
 219:     for oid, res in results.items():
 220:         p = _pool_from_outcome(oid, res, outcomes.get(oid), omissions)
 221:         if p:
 222:             pools.append(p)
 223:         if (res.get("pooled") or {}).get("point") is not None:
 224:             any_pooled = res["pooled"]["point"]
 225:     if pools:
 226:         art["pools"] = pools
 227: 
 228:     # POOL CAPABILITY, PER OUTCOME -- AND THE FLATTENING IT REPLACES WAS A JOIN
 229:     # DEFECT, not a tuning choice.
 230:     #
 231:     # The previous version collapsed three per-outcome facts into one triple:
 232:     # engine_can_pool was ANDed across EVERY outcome, displayed_pooled_estimate
 233:     # was whichever outcome came last with a number, and engine_block_reason was
 234:     # the first outcome that said false. On SOTAGLIFLOZIN that produced a FAIL
 235:     # joining the hfcv_first pool's displayed 0.7488 to mace3_first's reason --
 236:     # "only one contributing trial reports this estimand" -- which is TRUE, of a
 237:     # DIFFERENT ESTIMAND. Two of the three fields came from outcomes the third
 238:     # had nothing to do with, and the detector had no way to know.
 239:     #
 240:     # It blocked a push, so this one failed toward ALARM. That is the rarer
 241:     # direction and the reason it was found in minutes rather than surviving a
 242:     # day feeding false assurance. It is still not the safe kind of wrong: acting
 243:     # on it would have meant withdrawing a sound estimate, and a withdrawal needs
 244:     # the same evidentiary standard as a claim.
 245:     #
 246:     # READ FROM THE OBJECT'S OWN POOLABILITY VERDICT, never from "is there a
 247:     # number": a displayed estimate on an outcome the object says cannot pool is
 248:     # precisely the orphan defect, and deriving the verdict from the presence of
 249:     # the number would make it unfindable.
 250:     caps = []
 251:     for oid, res in results.items():
 252:         if res.get("poolable") is None:
 253:             continue
 254:         can = bool(res.get("poolable"))
 255:         # A SINGLE-TRIAL RESULT IS NOT AN ORPHAN POOL.
 256:         # `poolable: false` was carrying two incompatible meanings: "this cannot
 257:         # legitimately be pooled" and "there is only one trial here". CHK020 read
 258:         # the first and blocked BEMPEDOIC_ACID, whose displayed 0.87 IS CLEAR
 259:         # Outcomes' own registered hazard ratio -- a value whose derivation is not
 260:         # missing, because nothing needed deriving. The third condition is now
 261:         # stated rather than inferred, so the check can tell "no derivation" from
 262:         # "no synthesis required". An object with poolable=false, k>1, a displayed
 263:         # value and NO single_study_ref is untouched by this and still fails, which
 264:         # is the real orphan defect.
 265:         _single = res.get("single_study_ref")
 266:         _k = res.get("k")
 267:         _is_single = bool(_single) and _k == 1
 268:         caps.append({
 269:             "outcome_id": oid,
 270:             "displayed_pooled_estimate": (res.get("pooled") or {}).get("point"),
 271:             "engine_can_pool": can or _is_single,
 272:             "single_study": _is_single,
 273:             "single_study_ref": _single if _is_single else "",
 274:             # EMIT IN BOTH STATES. This field was written only when poolability
 275:             # was FALSE, so CHK020_ORPHAN_POOLED_RESULT returned INVALID on every
 276:             # clean artefact: it could not tell "can pool" from "was never
 277:             # asked". That is an ABSENT FIELD STANDING FOR A TRUE CONDITION --
 278:             # exactly what declared_class taught, committed in the exporter
 279:             # written to avoid it. An explicit value is not a synthesised one: it
 280:             # states which branch the object recorded FOR THIS OUTCOME.
 281:             "engine_block_reason": (
 282:                 "" if (can or _is_single) else
 283:                 (res.get("poolable_reason")
 284:                  or "the object records poolable=false with no reason given")),
 285:         })
 286:     if caps:
 287:         art["pool_capability"] = caps
 288:     else:
 289:         omissions.append("no poolable verdict in the object -> orphan-pool check "
 290:                          "not emitted")
 291: 
 292:     # rows: the per-trial numbers the back-transform and precision-sample
 293:     # detectors read. Counts come from the trial's own arms, not from anywhere else.
 294:     rows = []
 295:     for t in trials:
 296:         arms = {a.get("role"): a for a in (t.get("arms") or []) if a.get("role")}
 297:         tre, con = arms.get("treatment") or {}, arms.get("control") or {}
 298:         for oid, bo in (t.get("by_outcome") or {}).items():
 299:             eff = bo.get("effect") or {}
 300:             if eff.get("point") is None:
 301:                 continue
 302:             row = {"row_id": "%s::%s" % (t.get("nct") or t.get("id") or "?", oid),
 303:                    "estimate": eff.get("point"),
 304:                    "ci_low": eff.get("ci_low"), "ci_high": eff.get("ci_high"),
 305:                    "measure": eff.get("measure") or _measure_for(results, oid, t)}
 306:             # SCALE VOCABULARY, TRANSLATED RATHER THAN PASSED THROUGH OR GUESSED.
 307:             #
 308:             # Two defects lived on this line. The objects write "linear" for a
 309:             # natural-scale difference and the detector's vocabulary is
 310:             # "natural", so EVERY difference-measure row in this corpus produced
 311:             # a false FAIL -- "MD is a difference on the natural scale but is
 312:             # stored as 'linear'" -- which is the adapter's word for exactly the
 313:             # thing the detector was asking for. A field-name contract across a
 314:             # module boundary, unstated and therefore unchecked.
 315:             #
 316:             # The worse one was the fallback: `eff.get("scale") or "log"`. An
 317:             # object that records no scale had one ASSERTED for it, and "log" is
 318:             # the assertion that makes a difference measure look like a ratio.
 319:             # That is a synthesised field in the exporter whose own first rule is
 320:             # never to synthesise a field, and it fails toward comfort -- the
 321:             # detector cannot tell a declared scale from a defaulted one.
 322:             _sc = (eff.get("scale") or "").strip().lower()
 323:             if _sc in _SCALE_VOCAB:
 324:                 row["stored_scale"], row["back_transform"] = _SCALE_VOCAB[_sc]
 325:             else:
 326:                 omissions.append(
 327:                     "%s: scale %r is not one this exporter can map -> the "
 328:                     "measure/scale check is NOT emitted for this row, which is "
 329:                     "not a pass on it" % (row["row_id"], eff.get("scale")))
 330:             if tre.get("events") is not None and con.get("events") is not None:
 331:                 row.update({"events_t": tre.get("events"), "n_t": tre.get("participants"),
 332:                             "events_c": con.get("events"), "n_c": con.get("participants")})
 333:             else:
 334:                 omissions.append("%s: no per-arm counts -> precision-sample check "
 335:                                  "cannot run on this row" % row["row_id"])
 336:             rows.append(row)
 337:     if rows:
 338:         art["rows"] = rows
 339: 
 340:     # claimed_method: read, never assumed. An NMA claim with no network is the
 341:     # defect; a pairwise object simply says pairwise.
 342:     cm = (obj.get("config") or {}).get("method_class") or obj.get("method_class")
 343:     if cm:
 344:         art["claimed_method"] = cm
 345:         art["network_edges"] = obj.get("network_edges") or []
 346:     elif results:
 347:         art["claimed_method"] = "pairwise"
 348:         art["network_edges"] = []
 349: 
 350:     if page_html:
 351:         art["reader_text"] = _visible(page_html)[:200000]
 352:         art["sentinels"] = SENTINELS
 353:         art["numeric_fields"] = [
 354:             {"field_id": "raw-%d" % i, "raw": m,
 355:              "naive_value": float(re.sub(r"[^0-9.\-]", "", m) or 0)}
 356:             for i, m in enumerate(re.findall(r"&minus;\s*[\d.]+|&#8722;\s*[\d.]+",
 357:                                              page_html)[:40])]
 358:         if not art["numeric_fields"]:
 359:             art.pop("numeric_fields")
 360:     else:
 361:         omissions.append("no page HTML given -> sentinel-leak and unicode-minus "
 362:                          "checks not emitted")
 363: 
 364:     return art, omissions
 365: 
 366: 
 367: def selftest():
 368:     """REPLAYS THE JOIN DEFECT ON THE OBJECT THAT PRODUCED IT.
 369: 
 370:     Not a fixture. SOTAGLIFLOZIN carries three outcomes -- two pooled at k=2 and
 371:     one reported from a single trial with poolable=false -- which is the exact
 372:     shape that made the flattened export attach mace3_first's reason to
 373:     hfcv_first's displayed 0.7488 and block a push over a defect that did not
 374:     exist. The old join is recomputed here so the test can show it failing; a
 375:     test that only exercises the new code proves the fix runs, not that it fixes
 376:     anything.
 377:     """
 378:     ok = True
 379:     p = os.path.join(REPO, "ssot", "sotagliflozin-hf", "sotagliflozin-hf.json")
 380:     if not os.path.exists(p):
 381:         print("  fixture absent: sotagliflozin-hf -- NOT PROVEN")
 382:         return 1
 383:     obj = json.loads(open(p, encoding="utf-8").read())
 384:     results = (obj.get("results") or {}).get("by_outcome") or {}
 385: 
 386:     # THE OLD JOIN, recomputed exactly as it was.
 387:     old_can = all(bool(r.get("poolable")) for r in results.values()
 388:                   if r.get("poolable") is not None)
 389:     old_shown = None
 390:     for r in results.values():
 391:         if (r.get("pooled") or {}).get("point") is not None:
 392:             old_shown = r["pooled"]["point"]
 393:     old_would_fail = old_shown is not None and not old_can
 394:     print("  POSITIVE the flattened join on this object -> orphan FAIL: %-5s %s"
 395:           % (old_would_fail, "correct -- this is the defect" if old_would_fail
 396:              else "the replay proved nothing: the object no longer has the shape"))
 397:     ok &= old_would_fail
 398: 
 399:     art, _ = export(obj)
 400:     caps = art.get("pool_capability") or []
 401:     print("  per-outcome capability entries: %d" % len(caps))
 402:     bad = [c for c in caps
 403:            if c.get("displayed_pooled_estimate") is not None
 404:            and not c.get("engine_can_pool")]
 405:     for c in caps:
 406:         print("      %-14s displayed=%-8s can_pool=%-5s %s"
 407:               % (c["outcome_id"], c["displayed_pooled_estimate"],
 408:                  c["engine_can_pool"], (c["engine_block_reason"] or "")[:46]))
 409:     print("  NEGATIVE per-outcome, on the same object -> orphan FAIL: %-5s %s"
 410:           % (bool(bad), "correct" if not bad else "WRONG"))
 411:     ok &= not bad
 412:     ok &= len(caps) >= 2
 413: 
 414:     # A REASON MUST BELONG TO ITS OWN OUTCOME. A capability that can pool must
 415:     # carry no block reason at all -- that is what stops a reason migrating
 416:     # across estimands the way the flattened version let it.
 417:     stray = [c for c in caps if c["engine_can_pool"] and c["engine_block_reason"]]
 418:     print("  NEGATIVE a poolable outcome carrying a block reason: %-5s %s"
 419:           % (bool(stray), "correct" if not stray else "WRONG"))
 420:     ok &= not stray
 421: 
 422:     # SCALE VOCABULARY, replayed on the object that exposed it. IV iron carries a
 423:     # mean difference stored as "linear"; the detector's word is "natural", and
 424:     # the mismatch produced a FAIL saying the row was not on the scale it was
 425:     # already on. The second half matters more: an object with NO scale must
 426:     # yield NO scale fields, because the old `or "log"` default asserted the one
 427:     # value that makes a difference measure look like a ratio.
 428:     p2 = os.path.join(REPO, "ssot", "iv-iron-hf", "iv-iron-hf.json")
 429:     if os.path.exists(p2):
 430:         iv = json.loads(open(p2, encoding="utf-8").read())
 431:         art2, _ = export(iv)
 432:         rows = {r["row_id"]: r for r in (art2.get("rows") or [])}
 433:         md = rows.get("NCT01453608::six_min_walk_24w") or {}
 434:         good = (md.get("measure") == "MD" and md.get("stored_scale") == "natural"
 435:                 and md.get("back_transform") == "identity")
 436:         ok &= good
 437:         print("  NEGATIVE a mean difference stored as 'linear' -> %r/%r %s"
 438:               % (md.get("stored_scale"), md.get("back_transform"),
 439:                  "correct" if good else "WRONG -- the false FAIL is back"))
 440:         named = sum(1 for r in art2.get("rows") or [] if r.get("measure"))
 441:         ok &= named == len(art2.get("rows") or [])
 442:         print("  NEGATIVE every row carries the measure the object records: %d/%d %s"
 443:               % (named, len(art2.get("rows") or []),
 444:                  "correct" if named == len(art2.get("rows") or []) else "WRONG"))
 445: 
 446:         stripped = json.loads(json.dumps(iv))
 447:         for t in stripped["inputs"]["trials"]:
 448:             for bo in (t.get("by_outcome") or {}).values():
 449:                 (bo.get("effect") or {}).pop("scale", None)
 450:         art3, om3 = export(stripped)
 451:         leaked = [r for r in (art3.get("rows") or []) if "stored_scale" in r]
 452:         ok &= not leaked
 453:         print("  POSITIVE an object with no scale recorded -> scale asserted on "
 454:               "%d row(s) %s" % (len(leaked), "correct" if not leaked else
 455:                                 "WRONG -- the exporter is inventing a scale"))
 456:     else:
 457:         print("  fixture absent: iv-iron-hf -- NOT PROVEN"); ok = False
 458: 
 459:     print("\nWHAT A FAILURE WOULD LOOK LIKE: a displayed estimate paired with a "
 460:           "reason that is true of a different estimand, blocking a push and "
 461:           "arguing for the withdrawal of a sound number; or a scale the object "
 462:           "never recorded, asserted by the adapter and checked as though it had.")
 463:     print("-> SELFTEST PASS" if ok else "-> SELFTEST FAILED")
 464:     return 0 if ok else 1
 465: 
 466: 
 467: def main():
 468:     if "--selftest" in sys.argv:
 469:         return selftest()
 470:     ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
 471:     ap.add_argument("objects", nargs="+", help="ssot/<app>/<app>.json files")
 472:     ap.add_argument("--outdir", default=os.path.join(REPO, "build-artefacts"))
 473:     ap.add_argument("--page", default="", help="optional built HTML for one object")
 474:     a = ap.parse_args()
 475:     os.makedirs(a.outdir, exist_ok=True)
 476:     sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
 477:     from nafis_harness.artefact import payloads_for
 478: 
 479:     total_payloads = 0
 480:     retired = []
 481:     for src in a.objects:
 482:         obj = json.loads(open(src, encoding="utf-8").read())
 483:         # A RETIRED TOPIC IS NOT AN UNRECOGNISED ONE, and folding the two together would make
 484:         # this gate refuse every merge for the rest of the project's life.
 485:         #
 486:         # A tombstone deliberately holds no `results` and no top-level `inputs.trials` -- it
 487:         # holds the object it replaced, nested, plus who absorbed it and when. So the exporter
 488:         # correctly produces zero payloads for it, and the "nothing checkable" refusal below
 489:         # correctly fires on a corpus of nothing BUT tombstones. The two states are distinct:
 490:         #   UNRECOGNISED  the exporter looked and could not read the object -- a real failure
 491:         #   RETIRED       the object declares itself retired -- there is nothing to check, and
 492:         #                 that is the correct and intended state
 493:         # Counted separately, and a run consisting only of tombstones is reported as such rather
 494:         # than as an exporter that recognised nothing.
 495:         # RETIREMENT IS DECIDED BY `state` ALONE -- see scripts/retirement.py. This test read
 496:         # `state == RETIRED **and** o.get("absorbed_by")`, which made the successor field a
 497:         # PRECONDITION for seeing a tombstone at all. A topic retired by SPLIT records
 498:         # `split_into`, so it was not recognised as retired and fell through to the live path.
 499:         if R.is_retired(obj):
 500:             retired.append((os.path.basename(src), R.successor_label(obj)))
 501:             print("%-34s -> RETIRED, succeeded by %-26s  no payload BY DESIGN"
 502:                   % (os.path.basename(src), R.successor_label(obj)))
 503:             continue
 504:         html = None
 505:         if a.page and os.path.exists(a.page):
 506:             html = open(a.page, encoding="utf-8", errors="replace").read()
 507:         art, omissions = export(obj, html)
 508:         n = len(payloads_for(art))
 509:         total_payloads += n
 510:         out = os.path.join(a.outdir, (obj.get("app_id") or "unnamed") + ".json")
 511:         with open(out, "w", encoding="utf-8") as fh:
 512:             json.dump(art, fh, indent=1)
 513:         print("%-34s -> %-46s %2d check payload(s)"
 514:               % (os.path.basename(src), os.path.relpath(out, REPO), n))
 515:         for o in omissions[:6]:
 516:             print("      omitted: %s" % o)
 517:         if len(omissions) > 6:
 518:             print("      omitted: ... and %d more" % (len(omissions) - 6))
 519:     if retired:
 520:         print("\n%d of the %d object(s) are RETIRED TOMBSTONES and produce no payload by "
 521:               "design: %s" % (len(retired), len(a.objects),
 522:                               ", ".join("%s -> %s" % r for r in retired)))
 523:     if total_payloads == 0:
 524:         if retired and len(retired) == len(a.objects):
 525:             print("EVERY object in this run is a retired tombstone. There is nothing to check "
 526:                   "and that is the CORRECT state, not an exporter that recognised nothing. "
 527:                   "RETIRED and UNRECOGNISED are different states and are never summed.")
 528:             return 0
 529:         # A THIRD LEGITIMATE STATE, and the third instrument to have lacked the concept. The
 530:         # tombstone case above was encoded when the merge gates refused a retired page. This is
 531:         # the same missing idea one state along: A LIVE REVIEW THAT PUBLISHES NO ESTIMATE has
 532:         # nothing to check either. `mavacamten-ohcm-review` holds ONE trial -- no per-trial
 533:         # rows, no poolable verdict, no pool -- so every detector correctly declines, and the
 534:         # run then read as an exporter that recognised nothing.
 535:         #
 536:         # ENCODED, NOT EXEMPTED. The object must SAY it publishes nothing: `pooled.point` is
 537:         # None AND the pool is explicitly `withdrawn` or `absent`, or k < 2. An object that
 538:         # simply FAILED to produce a payload -- one that claims a pool and yields no rows --
 539:         # still fails, which is the case this gate exists for.
 540:         declares_nothing, undecided = [], []
 541:         for src in a.objects:
 542:             with open(src, "r", encoding="utf-8") as fh:
 543:                 o = json.load(fh)
 544:             if str(o.get("state") or "").upper() == "RETIRED":
 545:                 continue
 546:             pr = (((o.get("results") or {}).get("by_outcome") or {}).get("primary") or {})
 547:             pl = pr.get("pooled") or {}
 548:             k = pr.get("k")
 549:             if pl.get("point") is None and (pl.get("withdrawn") or pl.get("absent")
 550:                                             or (isinstance(k, int) and k < 2)):
 551:                 declares_nothing.append("%s (k=%s, %s)" % (
 552:                     o.get("app_id"), k,
 553:                     "withdrawn" if pl.get("withdrawn") else
 554:                     "absent" if pl.get("absent") else "k<2"))
 555:             else:
 556:                 undecided.append(o.get("app_id"))
 557:         if declares_nothing and not undecided:
 558:             print("\nEVERY live object in this run DECLARES THAT IT PUBLISHES NO ESTIMATE: %s. "
 559:                   "There is nothing to check and that is the CORRECT state, not an exporter "
 560:                   "that recognised nothing. PUBLISHES-NOTHING and UNRECOGNISED are different "
 561:                   "states and are never summed." % ", ".join(declares_nothing))
 562:             return 0
 563:         print("\nNO CHECK PAYLOADS PRODUCED AT ALL. That is not a clean export; "
 564:               "it is an exporter that recognised nothing.")
 565:         if undecided:
 566:             print("These object(s) do NOT declare that they publish nothing, so producing no "
 567:                   "payload is a failure rather than a design: %s" % ", ".join(undecided))
 568:         return 2
 569:     return 0
 570: 
 571: 
 572: if __name__ == "__main__":
 573:     sys.exit(main())

