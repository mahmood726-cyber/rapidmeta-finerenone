# The two trials with results that report NO recurrent-VTE outcome at any rank, carried so the
# eight is visible as eight rather than as the six that happened to be poolable.
NO_SUCH_OUTCOME = {
    "NCT02585713": "acute cancer-associated VTE, apixaban vs dalteparin, n=300",
    "NCT03590743": "isolated calf DVT, apixaban vs placebo, TERMINATED at n=5",
}


# ==========================================================================================
# THE COHERENCE SCREEN. Three axes, each with its own verdict, so a trial that leaves the pool
# leaves it for a NAMED reason and the reason is not "heterogeneity".
# ==========================================================================================
def coherence(nct, row):
    """(verdict, [reasons]) -- EVERY failing axis, not the first. P15."""
    fails = []
    if not row.get("vte_alone_available"):
        fails.append(
            "ESTIMAND: posts no recurrent-VTE measure without a death term at ANY of its "
            "registered ranks. Its every recurrence outcome carries a mortality component.")
    if row["measures"].get("vte_alone", {}).get("read") == "DERIVED":
        fails.append(
            "READ: its recurrent-VTE result is posted as a PERCENTAGE and the arm-level counts "
            "would have to be derived from it. A derived count does not enter a reported pool.")
    if "CLASS against a CLASS" in row["randomised"]:
        fails.append(
            "INTERVENTION: what was randomised is a DRUG CLASS, not apixaban. Apixaban is one "
            "of four permitted drugs in the intervention arm, so the posted contrast is a "
            "class effect and attributing it to apixaban would be a claim the trial cannot "
            "support.")
    if row["phase"] != "ACUTE":
        fails.append(
            "CLINICAL PHASE: extended anticoagulation after completed treatment, not treatment "
            "of the acute event. Eligible under this review's boundary rule and a different "
            "clinical question, with a different event horizon.")
    if row["comparator_class"] == "PLACEBO":
        fails.append(
            "COMPARATOR: randomised against PLACEBO, not against another anticoagulant. The "
            "quantity estimated is not the same quantity.")
    return ("IN_POOL" if not fails else "NOT_POOLED"), fails


# ==========================================================================================
# ARITHMETIC. Log risk ratio; Paule-Mandel between-study variance (the house rule refuses
# DerSimonian-Laird below k=10); Knapp-Hartung interval with the Q/(k-1) floor and t on k-1 df.
# DL + Wald is computed alongside as the sensitivity and because it is what the PROPHYLAXIS
# half of this pair reported -- so the two halves can be compared on a common estimator.
# ==========================================================================================
def logrr(e_a, n_a, e_c, n_c):
    """(y, v, corrected) -- 0.5 continuity ONLY if a cell is zero (rules/advanced-stats)."""
    corrected = (e_a == 0 or e_c == 0)
    a, c = (e_a + 0.5, e_c + 0.5) if corrected else (e_a, e_c)
    na, nc = (n_a + 1, n_c + 1) if corrected else (n_a, n_c)
    y = math.log((a / na) / (c / nc))
    v = 1.0 / a - 1.0 / na + 1.0 / c - 1.0 / nc
    return y, v, corrected


def pool(rows, label):
    """rows: [(name, e_a, n_a, e_c, n_c)]. Returns the full pooled record."""
    ys, vs, per = [], [], []
    for name, ea, na, ec, nc in rows:
        y, v, corr = logrr(ea, na, ec, nc)
        ys.append(y)
        vs.append(v)
        se = math.sqrt(v)
        per.append({"trial": name, "events_apixaban": ea, "n_apixaban": na,
                    "events_comparator": ec, "n_comparator": nc,
                    "continuity_corrected": corr,
                    "rr": round(math.exp(y), 4),
                    "ci_low": round(math.exp(y - Z * se), 4),
                    "ci_high": round(math.exp(y + Z * se), 4)})
    k = len(ys)
    wf = [1.0 / v for v in vs]
    mf = sum(w * y for w, y in zip(wf, ys)) / sum(wf)
    q = sum(w * (y - mf) ** 2 for w, y in zip(wf, ys))
    i2 = max(0.0, (q - (k - 1)) / q) * 100.0 if q > 0 else 0.0
    out = {"label": label, "k": k, "q": round(q, 4), "df": k - 1, "i2_pct": round(i2, 1),
           "per_trial": per,
           "n_participants": sum(r[2] + r[4] for r in rows)}
    for how in ("PM", "DL"):
        t2 = HG._tau2(ys, vs, how)
        w = [1.0 / (v + t2) for v in vs]
        sw = sum(w)
        mu = sum(a * b for a, b in zip(w, ys)) / sw
        se = math.sqrt(1.0 / sw)
        rec = {"tau2": round(t2, 5), "rr": round(math.exp(mu), 4),
               "ci_low": round(math.exp(mu - Z * se), 4),
               "ci_high": round(math.exp(mu + Z * se), 4),
               "interval": "Wald, normal"}
        if how == "PM":
            # HKSJ, with the floor the house rule requires: when Q < k-1 the uncorrected
            # Knapp-Hartung variance NARROWS the interval below the random-effects one, which
            # is the wrong direction for a small-k correction.
            qh = sum(wi * (y - mu) ** 2 for wi, y in zip(w, ys)) / (k - 1) if k > 1 else None
            if qh is not None:
                qf = max(1.0, qh)
                seh = math.sqrt(qf / sw)
                tc = T.get(k - 1)
                rec["hksj"] = {
                    "q_hksj": round(qh, 4), "floored_to": round(qf, 4),
                    "floor_applied": qf > qh + 1e-12,
                    "t_df": k - 1, "t_crit": tc,
                    "rr": round(math.exp(mu), 4),
                    "ci_low": round(math.exp(mu - tc * seh), 4),
                    "ci_high": round(math.exp(mu + tc * seh), 4),
                    "interval": "Knapp-Hartung-Sidik-Jonkman, t on k-1 df, floor max(1, Q/(k-1))",
                }
        out[how] = rec
    return out


def main():
    sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")

    # ---- the coherence screen, every axis reported -----------------------------------
    screen = {}
    for nct, row in READS.items():
        v, why = coherence(nct, row)
        screen[nct] = {"acronym": row["acronym"], "verdict": v, "failing_axes": why,
                       "phase": row["phase"], "comparator_class": row["comparator_class"],
                       "randomised": row["randomised"]}
    in_pool = [n for n, s in screen.items() if s["verdict"] == "IN_POOL"]

    print("THE COHERENCE SCREEN -- eight trials with posted results, every failing axis named")
    for nct, s in screen.items():
        print("  %-12s %-26s %s" % (nct, s["acronym"], s["verdict"]))
        for w in s["failing_axes"]:
            print("        - %s" % w.split(":")[0])
    print("  IN POOL: %d of %d" % (len(in_pool), len(READS)))

    # ---- the pool this review reports ------------------------------------------------
    rows = [(READS[n]["acronym"],
             READS[n]["measures"]["vte_alone"]["e_apx"],
             READS[n]["measures"]["vte_alone"]["n_apx"],
             READS[n]["measures"]["vte_alone"]["e_ctl"],
             READS[n]["measures"]["vte_alone"]["n_ctl"]) for n in in_pool]
    reported = pool(rows, "recurrent symptomatic VTE, no death term -- acute treatment, "
                          "apixaban randomised individually, active anticoagulant comparator")

    print("\nTHE POOL THIS REVIEW REPORTS")
    for p in reported["per_trial"]:
        print("   %-28s %3d/%-5d vs %3d/%-5d  RR %.3f (%.3f-%.3f)%s"
              % (p["trial"], p["events_apixaban"], p["n_apixaban"], p["events_comparator"],
                 p["n_comparator"], p["rr"], p["ci_low"], p["ci_high"],
                 "  [0.5 continuity]" if p["continuity_corrected"] else ""))
    h = reported["PM"]["hksj"]
    print("   POOLED k=%d  n=%d  RR %.4f (%.4f to %.4f)  PM tau2 %.5f  Q %.2f df %d  I2 %.1f%%"
          % (reported["k"], reported["n_participants"], h["rr"], h["ci_low"], h["ci_high"],
             reported["PM"]["tau2"], reported["q"], reported["df"], reported["i2_pct"]))
    print("   (HKSJ t interval on %d df; DL+Wald sensitivity %.4f (%.4f to %.4f))"
          % (h["t_df"], reported["DL"]["rr"], reported["DL"]["ci_low"],
             reported["DL"]["ci_high"]))

    # ---- leave-one-out, because at k=3 one trial can be the whole answer -------------
    loo = []
    for i in range(len(rows)):
        sub = [r for j, r in enumerate(rows) if j != i]
        s = pool(sub, "leave out %s" % rows[i][0])
        h2 = s["PM"]["hksj"]
        loo.append({"omitted": rows[i][0], "k": s["k"], "point": h2["rr"],
                    "ci_low": h2["ci_low"], "ci_high": h2["ci_high"],
                    "i2_pct": s["i2_pct"]})
    loo_span = (min(a["point"] for a in loo), max(a["point"] for a in loo))

    # ---- declined pool 1: the name match, which is what eight trials looked like ------
    name_rows = []
    for nct, row in READS.items():
        m = row["measures"].get("vte_alone") or row["measures"].get(
            "vte_or_vte_related_death") or row["measures"].get("vte_or_all_cause_death")
        name_rows.append((row["acronym"], m["e_apx"], m["n_apx"], m["e_ctl"], m["n_ctl"]))
    declined_name = pool(name_rows, "whatever each trial posts under a recurrent-VTE NAME -- "
                                    "the pool a reviewer matching endpoints by name computes")

    # ---- declined pool 2: estimand SHARED, comparator NOT ----------------------------
    prog_rows = [
        ("AMPLIFY", 59, 2609, 71, 2635),
        ("AMPLIFY-EXT", 61, 1653, 92, 829),
    ]
    declined_prog = pool(prog_rows, "recurrent VTE or VTE-related death -- AMPLIFY and "
                                    "AMPLIFY-EXT, an estimand they DO share")
    prog_noimp = pool([("AMPLIFY", 59, 2609, 71, 2635), ("AMPLIFY-EXT", 28, 1653, 73, 829)],
                      "the same pool with AMPLIFY-EXT's WITHOUT-IMPUTATION analysis")

    print("\nTHE POOLS THIS REVIEW DECLINES")
    print("   name-matched, k=%d      RR %.4f (%.4f to %.4f)  Q %.2f  I2 %.1f%%"
          % (declined_name["k"], declined_name["DL"]["rr"], declined_name["DL"]["ci_low"],
             declined_name["DL"]["ci_high"], declined_name["q"], declined_name["i2_pct"]))
    print("   AMPLIFY + AMPLIFY-EXT  RR %.4f (%.4f to %.4f)  Q %.2f  I2 %.1f%%   <- estimand "
          "SHARED, comparator NOT"
          % (declined_prog["DL"]["rr"], declined_prog["DL"]["ci_low"],
             declined_prog["DL"]["ci_high"], declined_prog["q"], declined_prog["i2_pct"]))
    print("   the same, no imputation  I2 %.1f%%" % prog_noimp["i2_pct"])

    prediction = {
        "stated_before_the_run": True,
        "prediction": (
            "The estimand-COHERENT, comparator-INCOHERENT pool (AMPLIFY + AMPLIFY-EXT) will "
            "show heterogeneity AT LEAST AS HIGH as the name-matched eight-trial pool, whose "
            "estimands do not agree at all."),
        "why_this_indicator_and_not_another": (
            "P32: name a quantity that could not move for another reason. A high I2 on the "
            "name-matched pool would be consistent with the estimands disagreeing AND with "
            "ordinary clinical variation, so it tests nothing on its own. The COMPARISON is "
            "the test: if the pool where the estimand IS shared is the more heterogeneous, "
            "then I2 is not tracking estimand coherence, and it cannot be doing so by "
            "coincidence in the direction that favours us."),
        "i2_name_matched_pct": declined_name["i2_pct"],
        "i2_estimand_coherent_pct": declined_prog["i2_pct"],
        "outcome": ("HELD" if declined_prog["i2_pct"] >= declined_name["i2_pct"]
                    else "REFUTED"),
        "what_it_does_NOT_establish": (
            "Nothing about whether either pool is coherent. P36 stands unchanged: the "
            "coherence judgements in this file were made by reading definitions and would be "
            "identical if every I2 came out zero."),
    }
    print("\nPREDICTION stated before the run: %s" % prediction["outcome"])
    print("   name-matched I2 %.1f%%   vs   estimand-coherent I2 %.1f%%"
          % (declined_name["i2_pct"], declined_prog["i2_pct"]))

    out = {
        "topic": "apixaban-vte-treatment",
        "repooled_utc": "2026-08-19",
        "what_the_withholding_question_found_and_what_it_did_not": (
            "The withholding question found EIGHT trials with posted results reporting an "
            "outcome named for recurrent VTE. Reading what each one COUNTS takes the poolable "
            "set to THREE. The prophylaxis half of this pair ran the identical discipline and "
            "its poolable set went 3 -> 8. THE METHOD DOES NOT HAVE A DIRECTION; asking is not "
            "a way of finding more trials, it is a way of finding out."),
        "coherence_screen": screen,
        "trials_with_results_and_no_such_outcome_at_any_rank": NO_SUCH_OUTCOME,
        "estimand_reported": {
            "definition": ("recurrent symptomatic venous thromboembolism -- nonfatal deep vein "
                           "thrombosis or nonfatal pulmonary embolism -- with NO death term"),
            "restriction": ("acute treatment of the index event, apixaban randomised as a drug "
                            "rather than as a member of a class, against another anticoagulant"),
            "rank_in_each_trial": "PRIMARY in one, SECONDARY in two",
            "titles_read": {n: READS[n]["measures"]["vte_alone"]["title"] for n in in_pool},
            "sources_read": {n: READS[n]["measures"]["vte_alone"]["source"] for n in in_pool},
            "leave_one_out": {
                "analyses": loo,
                "decision_under_test": (
                    "Does the reported estimate depend on any one of the three trials? At k=3 "
                    "that is not a formality: the largest contributor is more than seven times "
                    "the size of the other two together."),
                "authority": (
                    "Cochrane Handbook 10.14: sensitivity analyses ask whether the conclusions "
                    "are robust to decisions made during the review. Here the decision under "
                    "test is the inclusion of each individual trial, not the estimator -- the "
                    "estimator comparison is reported separately at "
                    "`estimator_sensitivity`, because they are different questions and "
                    "presenting them in one table would let a stable point estimate under one "
                    "read as stability under the other."),
                "conclusion": (
                    "AT k=3 THE POOL IS LARGELY ONE TRIAL. CARAVAGGIO contributes %d of the "
                    "%d events in this pool; its two companions contribute %d between them. "
                    "Omitting it moves the point estimate from %.3f to %.3f, and the span "
                    "across all three leave-one-out fits is %.3f to %.3f. All three intervals "
                    "span the null, so no single trial is holding the conclusion up -- and "
                    "none is holding it down either. The honest reading is that this estimate "
                    "is a description of CARAVAGGIO with two small trials attached."
                    % (sum(rows[i][1] + rows[i][3] for i in range(len(rows))
                           if rows[i][0] == "CARAVAGGIO"),
                       sum(r[1] + r[3] for r in rows),
                       sum(r[1] + r[3] for r in rows if r[0] != "CARAVAGGIO"),
                       reported["PM"]["hksj"]["rr"],
                       next(a["point"] for a in loo if a["omitted"] == "CARAVAGGIO"),
                       loo_span[0], loo_span[1])),
                "interval_method": ("Paule-Mandel with a floored Knapp-Hartung interval on k-1 "
                                    "df, the same as the pool itself. At k=2 that is t on ONE "
                                    "degree of freedom, whose critical value is 12.7 -- which "
                                    "is why these intervals are enormous and why they should "
                                    "be."),
            },
            **reported},
        "estimand_declined_name_matched": {
            "why": ("This is the pool obtained by matching endpoints on the NAME 'recurrent "
                    "VTE'. Two of its eight rows count a death; six do not; one is a class "
                    "effect and one is derived from a percentage. It is computed so that the "
                    "number a name-matching reviewer would have published is visible beside "
                    "the one this review reports."),
            **declined_name},
        "estimand_declined_shared_but_comparator_not": {
            "why": ("AMPLIFY and AMPLIFY-EXT DO share this estimand -- primary in one, "
                    "secondary in the other, same sponsor, same programme. They are still not "
                    "pooled: one randomises apixaban against enoxaparin followed by warfarin "
                    "and the other against PLACEBO. ESTIMAND COHERENCE IS NECESSARY AND NOT "
                    "SUFFICIENT, and this is the pool that shows it -- the estimand agrees "
                    "and the quantity still is not the same quantity."),
            **declined_prog},
        "the_same_pool_under_the_other_analysis_population": prog_noimp,
        "estimand_declined_each_trials_own_primary": {
            "computed": False,
            "refused_because": (
                "THREE OF THE EIGHT REGISTER A BLEEDING ENDPOINT AS THEIR PRIMARY -- COBRRA, "
                "COVET and the Japanese study. Pooling 'each trial's own primary' would "
                "average a HARM against a BENEFIT, and the pooled quantity would have no "
                "direction: a risk ratio below one would mean fewer thromboses in five trials "
                "and fewer bleeds in three. This is the only declined pool in this file that "
                "is refused as INCOMPUTABLE rather than computed and set aside, and the "
                "reason is stated so a reader can check that it is a reason and not a "
                "preference."),
            "which_three": {"NCT03266783": "The Rate of Adjudicated Clinically Relevant "
                                           "Bleeding (CRB) Events",
                            "NCT03196349": "Number of Subjects With Clinically Relevant "
                                           "Bleeding Events (one of two co-primaries)",
                            "NCT01780987": "Number of Participants With Major Bleeding Events "
                                           "[ISTH] or Clinically Relevant Non-major Bleeding"},
        },
        "derivation_refused_with_its_arithmetic": {
            "what_was_refused": ("reconstructing a recurrent-VTE-alone estimand for AMPLIFY "
                                 "and AMPLIFY-EXT by summing the components they post "
                                 "separately"),
            "amplify_components": READS["NCT00643201"]["components_posted_separately"],
            "amplify_sums": {"apixaban": 22 + 27 + 12, "comparator": 35 + 25 + 16},
            "amplify_posted_composite": {"apixaban": 59, "comparator": 71},
            "why_refused": (
                "The components sum to 61 and 76 against a posted composite of 59 and 71. A "
                "composite counts a participant's FIRST event; its components count "
                "participants. Summing them would have manufactured 2 and 5 events that the "
                "trial's own adjudication does not record, and the manufactured events fall "
                "in the comparator arm at more than twice the rate they fall in the apixaban "
                "arm -- so the derivation is not merely imprecise, it is biased in the "
                "direction that flatters the drug."),
            "amplify_ext_components": READS["NCT00633893"]["components_posted_separately"],
            "amplify_ext_note": (
                "The same check on AMPLIFY-EXT gives a much larger discrepancy -- placebo "
                "components 72 + 37 + 26 = 135 against a posted composite of 92 -- which "
                "first-event counting alone does not explain. No explanation is offered here "
                "because none was read; the refusal does not depend on having one."),
        },
        "the_duplicate_a_text_match_cannot_settle": {
            "trial": "NCT00633893 AMPLIFY-EXT",
            "what": ("Its primary composite is posted TWICE, typed PRIMARY both times, under "
                     "the same registered name, differing only in the trailing 'Randomized "
                     "Population With Imputation' / 'Without Imputation'."),
            "with_imputation": "32, 34, 96 events (apixaban 2.5 mg, 5 mg, placebo)",
            "without_imputation": "19, 14, 77 events",
            "why_it_matters": (
                "P35 says match the registered text and never the position. Here the text "
                "matches TWO posted measures and the values differ by more than half again on "
                "the treatment arms. CHOOSING AMONG MATCHES BY POSITION IS P35's OWN DEFECT "
                "ONE LEVEL DOWN, and nothing in the payload is malformed."),
            "how_it_was_settled": (
                "By reading the descriptions, not the order: the WITHOUT-imputation record "
                "states 'No imputation was done for these endpoints', marking it as the "
                "sensitivity analysis, and the WITH-imputation record names the imputed counts "
                "in its own population description. The with-imputation analysis is used, the "
                "choice is applied to every measure taken from this trial, and both pools are "
                "computed so the choice's cost is visible rather than asserted to be small."),
        },
        "prediction": prediction,
        "estimator_note": (
            "Paule-Mandel between-study variance with a Knapp-Hartung interval on k-1 degrees "
            "of freedom, floored at max(1, Q/(k-1)). The house rule refuses DerSimonian-Laird "
            "below k=10 and this pool is k=3. DL+Wald is carried alongside because it is what "
            "the PROPHYLAXIS half of this pair reported at k=4 -- SO THAT HALF IS NOW OWED THE "
            "SAME CORRECTION, and this note is the record of the debt rather than a silent "
            "divergence between two pages built the same night."),
        "what_this_replaces": (
            "NOTHING. This review did not previously exist as an object: `apixaban-vte` was "
            "split in two and the treatment half was registered with k=1 -- RAMBLE, n=19, "
            "whose registered primary is a pictorial menstrual blood-loss chart and which "
            "cannot contribute to this estimand. There is no previous pooled estimate to "
            "compare against and none is manufactured for the sake of a delta."),
    }
    with io.open(DEST, "w", encoding="utf-8") as fh:
        fh.write(json.dumps(out, indent=1))
    print("\nwrote %s" % DEST)
    return 0


def selftest():
    """Known answers, on REAL registry instances from this corpus -- never a synthetic fixture.

    Each case is a fact about a trial in this review, and each would have failed under a
    specific defect this file exists to refuse.
    """
    sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
    fails = []

    def check(name, got, want, tol=1e-4):
        ok = abs(got - want) <= tol
        print("  %-58s %s  (%.6f vs %.6f)" % (name, "ok" if ok else "FAIL", got, want))
        if not ok:
            fails.append(name)

    # CARAVAGGIO's posted counts give a risk ratio computable by hand: (32/576)/(46/579).
    y, v, corr = logrr(32, 576, 46, 579)
    check("CARAVAGGIO log RR", math.exp(y), (32.0 / 576) / (46.0 / 579))
    assert not corr, "CARAVAGGIO has no zero cell and must not be continuity-corrected"

    # The Japanese study HAS a zero cell and MUST be corrected -- and the correction must not
    # fire on the trial above. A correction applied unconditionally biases the ratio toward 1.
    y0, v0, corr0 = logrr(0, 38, 1, 40)
    if not corr0:
        fails.append("zero-cell correction did not fire on NCT01780987")
    print("  %-58s %s" % ("zero-cell continuity fires on NCT01780987, not CARAVAGGIO",
                          "ok" if corr0 and not corr else "FAIL"))

    # The coherence screen must EXCLUDE CANVAS on the intervention axis and must NOT exclude
    # CARAVAGGIO on anything. A guard that only ever passes is not a guard.
    vc, whyc = coherence("NCT02744092", READS["NCT02744092"])
    vg, whyg = coherence("NCT03045406", READS["NCT03045406"])
    ok = (vc == "NOT_POOLED" and any("INTERVENTION" in w for w in whyc) and vg == "IN_POOL")
    print("  %-58s %s" % ("screen refuses CANVAS on INTERVENTION, admits CARAVAGGIO",
                          "ok" if ok else "FAIL"))
    if not ok:
        fails.append("coherence screen polarity")

    # And it must report EVERY failing axis, not the first: AMPLIFY-EXT fails three.
    va, whya = coherence("NCT00633893", READS["NCT00633893"])
    ok = va == "NOT_POOLED" and len(whya) == 3
    print("  %-58s %s (%d axes)" % ("AMPLIFY-EXT fails THREE axes and all three are reported",
                                    "ok" if ok else "FAIL", len(whya)))
    if not ok:
        fails.append("short-circuiting screen")

    # AMPLIFY's components must not sum to its posted composite. If they ever did, the
    # derivation this file refuses would be legitimate and the refusal would need rewriting.
    c = READS["NCT00643201"]["components_posted_separately"]
    s_a = sum(v[0] for v in c.values())
    s_c = sum(v[2] for v in c.values())
    ok = (s_a, s_c) != (59, 71)
    print("  %-58s %s (%d vs 59, %d vs 71)"
          % ("AMPLIFY components do NOT sum to its posted composite",
             "ok" if ok else "FAIL", s_a, s_c))
    if not ok:
        fails.append("component sum")

    print("\n%s" % ("ALL KNOWN ANSWERS HELD" if not fails else "FAILED: %s" % fails))
    return 1 if fails else 0


if __name__ == "__main__":
    sys.exit(selftest() if "--selftest" in sys.argv else main())

