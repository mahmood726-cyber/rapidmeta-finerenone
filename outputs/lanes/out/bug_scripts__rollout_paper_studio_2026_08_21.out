 198:                 print("%3d/%d %-46s no paper panel" % (n, len(todo), page[:46]))
 199:                 continue
 200:             r = subprocess.run([sys.executable, "build_tabbed.py", objp,
 201:                                 os.path.join("..", page)], cwd=SSOT,
 202:                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
 203:             out = r.stdout.decode("utf-8", "replace")
 204:             if r.returncode != 0:
 205:                 results[page] = {"state": "BUILD REFUSED", "tail": out[-300:]}
 206:                 print("%3d/%d %-46s BUILD REFUSED" % (n, len(todo), page[:46]))
 207:                 json.dump(led, io.open(LEDGER, "w", encoding="utf-8"), indent=1)
 208:                 continue
 209:             after = measure(full)
 210: 
 211:             v = {
 212:                 "1_nothing_lost": (set(before["ncts"]) <= set(after["ncts"])
 213:                                    and set(before["estimates"]) <= set(after["estimates"])),
 214:                 # EVERY stored transcript must appear character for character in the
 215:                 # delivered bytes AFTER the move -- checked against the object, on every page,
 216:                 # never on a sample.
 217:                 "2_transcript_byte_identical": all(t in after["text"] for t in want),
 218:                 "3_first_sentence_earlier": after["first_sentence_at"] <= before["first_sentence_at"],
 219:                 "4_not_byte_identical": before["bytes"] != after["bytes"],
 220:                 "5_refusals_kept": after["refusals"] >= before["refusals"],
 221:             }
 222:             results[page] = {
 223:                 "state": "ok" if all(v.values()) else "PREDICTION FAILED",
 224:                 "checks": v,
 225:                 "first_sentence": [before["first_sentence_at"], after["first_sentence_at"]],
 226:                 "refusals": [before["refusals"], after["refusals"]],
 227:                 "transcripts": len(want),
 228:                 "lost_ncts": sorted(set(before["ncts"]) - set(after["ncts"])),
 229:                 "lost_estimates": sorted(set(before["estimates"]) - set(after["estimates"])),
 230:             }
 231:             bad = [k for k, ok in v.items() if not ok]
 232:             print("%3d/%d %-46s %s  first-sentence %d->%d  refusals %d->%d  transcripts %d"
 233:                   % (n, len(todo), page[:46], "ok" if not bad else "FAILED " + ",".join(bad),
 234:                      before["first_sentence_at"], after["first_sentence_at"],
 235:                      before["refusals"], after["refusals"], len(want)))
 236:             json.dump(led, io.open(LEDGER, "w", encoding="utf-8"), indent=1)
