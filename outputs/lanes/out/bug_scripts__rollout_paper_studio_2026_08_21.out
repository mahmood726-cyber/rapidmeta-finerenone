 239:         fail = [p for p, v in results.items() if v.get("state") == "PREDICTION FAILED"]
 240:         ref = [p for p, v in results.items() if v.get("state") == "BUILD REFUSED"]
 241:         print("\nbuilt ok %d | prediction failed %d | build refused %d | ledger %s"
 242:               % (ok, len(fail), len(ref), os.path.relpath(LEDGER, REPO)))
 243:         for p in fail[:10]:
 244:             print("   FAILED %-44s %s" % (p, results[p]["checks"]))
