 148: def build_yf():
 149:     FILE = Path("YELLOW_FEVER_FRACTIONAL_REVIEW.html")
 150:     text = FILE.read_text(encoding="utf-8")
 151:     text = replace_or_die(text,
 152:         "<title>RapidMeta Cardiology | SGLT2-HF Ultra-Precision v12.0</title>",
 153:         "<title>RapidMeta Vaccinology | Fractional-Dose 17DD Yellow Fever Vaccine v0.1 (Casey 2019 Kinshasa, post-2016)</title>")
 154:     text = replace_or_die(text,
 155:         "const AUTO_INCLUDE_TRIAL_IDS = new Set(['NCT03036124', 'NCT03057977', 'NCT03057951', 'NCT03619213', 'NCT03521934']);",
 156:         "const AUTO_INCLUDE_TRIAL_IDS = new Set(['LEGACY-NONNCT-CASEY-2019-YF']);")
 157:     text = replace_or_die(text,
 158:         "protocol: { pop: 'Adults with heart failure across ejection fraction spectrum', int: 'SGLT2 or dual SGLT1/2 inhibitor therapy (dapagliflozin, empagliflozin, or sotagliflozin)', comp: 'Placebo + guideline-directed therapy', out: 'CV Death or Worsening Heart Failure Composite', subgroup: 'EF phenotype (HFrEF vs HFpEF), drug class member, diabetes status', query: '', rctOnly: true, post2015: true },",
 159:         "protocol: { pop: 'Children >=2 years and non-pregnant adults receiving fractional-dose yellow fever vaccine during the 2016 Kinshasa preemptive campaign â€” declared response to the 2016 Angola/DRC outbreak that depleted global YF vaccine supply. Sub-study sampled across 4 age strata (2-12y, 13-17y, 18-39y, 40+y) at 6 vaccination sites', int: 'Fractional 1/5 dose 17DD yellow fever vaccine (0.1 mL intramuscular) â€” single dose', comp: 'Pre-vaccination baseline (within-participant, single-arm field study)', out: '1-month seroconversion in baseline-seronegatives (PRNT50 titre >=10 + 4-fold rise) â€” primary; 1-year seropositive durability; immune response in baseline-seropositives', subgroup: 'Age stratum, baseline PRNT titre, sex', query: '', rctOnly: false, post2015: true },")
 160:     text = replace_or_die(text,
 161:         "{ 'DAPA-HF': 'Dapagliflozin', 'DELIVER': 'Dapagliflozin', 'EMPEROR-Reduced': 'Empagliflozin', 'EMPEROR-Preserved': 'Empagliflozin', 'SOLOIST-WHF': 'Sotagliflozin' }",
 162:         "{ 'Casey 2019 Kinshasa (1/5 fractional 17DD)': 'Fractional 1/5 dose 17DD yellow fever vaccine' }")
 163:     text = replace_or_die(text,
 164:         "'NCT03036124': 'DAPA-HF',\n\n\n                'NCT03057977': 'EMPEROR-Reduced',\n\n\n                'NCT03057951': 'EMPEROR-Preserved',\n\n\n                'NCT03619213': 'DELIVER',\n\n\n                'NCT03521934': 'SOLOIST-WHF'",
 165:         "'LEGACY-NONNCT-CASEY-2019-YF': 'Casey 2019 Kinshasa Fractional 17DD'")
 166:     text = replace_realdata(text, YF_BODY)
 167:     text = text.replace("SGLT2-HF v1.0", "Yellow Fever Frac v0.1")
 168:     text = text.replace("SGLT2 Inhibitors for Heart Failure Outcomes: A Living Systematic Review and Meta-Analysis of Randomized Controlled Trials",
 169:                         "Fractional 17DD Yellow Fever Vaccine During Outbreak Response: Single-Study Pre/Post Seroconversion Review (Casey 2019 Kinshasa, post-2016)")
 170:     text = text.replace("SGLT2 Inhibitors in Heart Failure", "Fractional-Dose YF Vaccine for Outbreak Response")
 171:     text = text.replace('value="Adults with heart failure"', 'value="Children/adults during 2016 Angola-DRC YF outbreak (Kinshasa)"')
 172:     text = text.replace("value=\"Heart Failure\"", "value=\"Yellow Fever\"")
 173:     FILE.write_text(text, encoding="utf-8")
 174:     print(f"  Yellow Fever: {FILE.stat().st_size:,}")
