 succeeded in 1627ms:
   1: """Stamp each pooled block with the DEFINITION its ambiguous fields carry.
   2: 
   3: WHERE THE FIX BELONGS, corrected after looking. `scripts/project_index_cards.py` does not
   4: reference i2 or tau2 at all -- the projector never carries heterogeneity, so there is no
   5: projector code to change. The ambiguity lives in the OBJECTS, and that is where the
   6: declaration has to go.
   7: 
   8: THE FIX DIFFERS BY FIELD, because their ambiguity has different causes:
   9: 
  10:   tau2   ITS DEFINITION IS ALREADY RECOVERABLE. `estimator` sits beside it and is declared
  11:          on all 35 pooled blocks -- 21 REML, 13 DerSimonian-Laird. The defect is that a
  12:          reader must know to look at the neighbour. The fix is to name the neighbour in
  13:          place: tau2_estimator, copied from the declared estimator, NEVER inferred.
  14:   i2     ITS DEFINITION IS NOT RECOVERABLE from anything stored. It is decided here by
  15:          RECOMPUTING BOTH from the object's own per-trial inputs and seeing which the
  16:          stored value matches -- so the declaration is DERIVED EVIDENCE, not an assertion.
  17:          Where I-squared is 0 and Q < df both definitions give 0 and the object CANNOT be
  18:          classified; those are stamped UNDECIDABLE rather than guessed.
  19: 
  20: NO VALUE MOVES. Every number is left exactly as it stands. What changes is that a reader
  21: recomputing the quantity from the definition the NAME implies will no longer conclude we
  22: are wrong -- which was the whole defect, and it was a defect specifically against the only
  23: reader we claim to serve.
  24: 
  25: Recorded under `display_change_announced` because the meaning is being made explicit while
  26: no value moves, which is precisely the case that property exists for.
  27: """
  28: from __future__ import annotations
  29: import io
  30: import json
  31: import math
  32: import os
  33: import sys
  34: 
  35: sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
  36: if __name__ == "__main__":
  37:     sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
  38: from rebuild_guard import guard_write  # noqa: E402
  39: 
  40: REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
  41: Z = 1.959963985
  42: RATIO = {"HR", "RR", "OR", "IRR", "RATE_RATIO", "RISK_RATIO", "ODDS_RATIO",
  43:          "HAZARD_RATIO"}
  44: 
  45: HIGGINS = ("Higgins I-squared = (Q - df) / Q, clamped at 0. Cochrane Handbook 6.5 "
  46:            "section 10.10.2.")
  47: METAFOR = ("REML/metafor I-squared = tau-squared / (tau-squared + typical within-study "
  48:            "variance), where the typical variance is the Higgins-Thompson s-squared. This "
  49:            "is what metafor's rma() reports and it is NOT (Q - df) / Q.")
  50: UNDEC = ("UNDECIDABLE from this object. I-squared is 0 and Q is below the degrees of "
  51:          "freedom, where the Higgins form is negative-and-clamped and the REML/metafor "
  52:          "form is exactly zero -- BOTH DEFINITIONS GIVE 0 and nothing here distinguishes "
  53:          "them. Recorded as undecidable rather than guessed.")
  54: 
  55: 
  56: def both_i2(blk, measure):
  57:     log = (measure or "").upper() in RATIO
  58:     v = []
  59:     for t in blk.get("per_trial") or []:
  60:         p, lo, hi = t.get("point"), t.get("ci_low"), t.get("ci_high")
  61:         ls = t.get("log_se") or t.get("se") or t.get("se_log_rr")
  62:         if ls:
  63:             v.append(ls * ls)
  64:         elif None not in (p, lo, hi):
  65:             if log and min(p, lo, hi) > 0:
  66:                 v.append(((math.log(hi) - math.log(lo)) / (2 * Z)) ** 2)
  67:             elif not log:
  68:                 v.append(((hi - lo) / (2 * Z)) ** 2)
  69:             else:
  70:                 return None
  71:         else:
  72:             return None
  73:     k = len(v)
  74:     het = blk.get("heterogeneity") or {}
  75:     q, t2 = het.get("q"), het.get("tau2")
  76:     if k < 2 or q in (None, 0) or t2 is None:
  77:         return None
  78:     W = [1 / x for x in v]
  79:     SW, SW2 = sum(W), sum(x * x for x in W)
  80:     if SW * SW - SW2 <= 0:
  81:         return None
  82:     s2 = (k - 1) * SW / (SW * SW - SW2)
  83:     return ((q - (k - 1)) / q * 100, (t2 / (t2 + s2) * 100) if (t2 + s2) else 0.0)
  84: 
  85: 
  86: def main() -> int:
  87:     ss = os.path.join(REPO, "ssot")
  88:     touched, counts = 0, {"higgins": 0, "metafor": 0, "undecidable": 0, "no_i2": 0}
  89:     for d in sorted(os.listdir(ss)):
  90:         f = os.path.join(ss, d, d + ".json")
  91:         if not os.path.exists(f):
  92:             continue
  93:         try:
  94:             o = json.load(io.open(f, encoding="utf-8"))
  95:         except Exception:
  96:             continue
  97:         changed = False
  98:         for name, blk in ((o.get("results") or {}).get("by_outcome") or {}).items():
  99:             if not isinstance(blk, dict) or (blk.get("pooled") or {}).get("point") is None:
 100:                 continue
 101:             het = blk.get("heterogeneity")
 102:             if not isinstance(het, dict):
 103:                 continue
 104:             est = blk.get("estimator") or blk.get("estimator_used")
 105:             if het.get("tau2") is not None and est:
 106:                 het["tau2_estimator"] = (
 107:                     "%s -- copied from this block's declared `estimator`, which is the "
 108:                     "authoritative record of how the pool was computed. NOT inferred: an "
 109:                     "object that declared no estimator would be left undeclared here, "
 110:                     "because the absence is itself the finding." % est)
 111:                 changed = True
 112:             stored = het.get("i2") if het.get("i2") is not None else het.get("i2_percent")
 113:             if stored is None:
 114:                 counts["no_i2"] += 1
 115:                 continue
 116:             got = both_i2(blk, (blk.get("pooled") or {}).get("measure") or blk.get("measure"))
 117:             if not got:
 118:                 het["i2_definition"] = UNDEC.replace("I-squared is 0 and Q is below the "
 119:                                                     "degrees of freedom, where", "The "
 120:                                                     "per-trial inputs on this object do "
 121:                                                     "not permit the recomputation that "
 122:                                                     "would decide it. Where")
 123:                 counts["undecidable"] += 1
 124:             else:
 125:                 hg, mf = got
 126:                 if abs(stored) < 0.05:
 127:                     het["i2_definition"] = UNDEC
 128:                     counts["undecidable"] += 1
 129:                 elif abs(stored - hg) < 0.05:
 130:                     het["i2_definition"] = HIGGINS
 131:                     het["i2_definition_evidence"] = (
 132:                         "Decided by recomputing BOTH definitions from this object's own "
 133:                         "per-trial inputs: Higgins gives %.4f and REML/metafor gives "
 134:                         "%.4f against the stored %.4f." % (hg, mf, stored))
 135:                     counts["higgins"] += 1
 136:                 elif abs(stored - mf) < 0.05:
 137:                     het["i2_definition"] = METAFOR
 138:                     het["i2_definition_evidence"] = (
 139:                         "Decided by recomputing BOTH definitions from this object's own "
 140:                         "per-trial inputs: REML/metafor gives %.4f and Higgins gives "
 141:                         "%.4f against the stored %.4f. THIS OBJECT CARRIES THE MINORITY "
 142:                         "DEFINITION IN THIS CORPUS -- 10 blocks carry Higgins and this is "
 143:                         "the only decidable block carrying the other." % (mf, hg, stored))
 144:                     counts["metafor"] += 1
 145:                 else:
 146:                     het["i2_definition"] = (
 147:                         "NEITHER standard definition reproduces the stored value: Higgins "
 148:                         "gives %.4f, REML/metafor gives %.4f, stored is %.4f. THIS IS A "
 149:                         "FINDING AND NOT A DECLARATION." % (hg, mf, stored))
 150:             changed = True
 151:         if changed:
 152:             o.setdefault("display_change_announced", []).append({
 153:                 "date": "2026-08-18", "change": "definition declared on ambiguous fields",
 154:                 "values_moved": "NONE",
