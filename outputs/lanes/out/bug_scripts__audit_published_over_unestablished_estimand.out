import json, glob, os, collections, math
root='.'
vals=collections.Counter(); files=0; blocks=0; skipped=[]; noncanon=[]; false=[]; null=[]; absent=[]; true=[]; other=[]; withdrawn_vals=collections.Counter(); point_types=collections.Counter(); badjson=[]
for path in sorted(glob.glob(os.path.join(root,'ssot','*','*.json'))):
    topic=os.path.basename(os.path.dirname(path))
    if os.path.basename(path)"'!=topic+'"'.json':
        noncanon.append(path); continue
    try:
        obj=json.load(open(path,encoding='utf-8'))
    except Exception as e:
        badjson.append((path,type(e).__name__,str(e)[:80])); continue
    files+=1
    by=((obj.get('results') or {}).get('by_outcome') or {})
    if not isinstance(by, dict):
        other.append((path,'by_outcome_type',type(by).__name__)); continue
    for name, blk in by.items():
        if not isinstance(blk,dict): continue
        p=blk.get('pooled')
        if not isinstance(p,dict): continue
        point_types[type(p.get('point')).__name__]+=1
        withdrawn_vals[repr(p.get('withdrawn'))]+=1
        if p.get('point') is None or p.get('withdrawn'): continue
        blocks+=1
        if 'estimand_established' in blk:
            v=blk.get('estimand_established')
            vals[(type(v).__name__,repr(v))]+=1
        else:
            vals[('MISSING','MISSING')]+=1
print('files',files,'blocks',blocks,'badjson',len(badjson),'noncanon',len(noncanon))
print('flag vals')
for k,c in vals.most_common(): print(c,k)
print('withdrawn vals', withdrawn_vals.most_common(20))
print('point types', point_types)
print('badjson', badjson[:5])
print('noncanon sample', noncanon[:20])
