 147:         if body.lstrip().startswith(q):
 148:             end = body.find(q, body.find(q) + 3)
 149:             if end > 0:
 150:                 body = body[end + 3:]
 151:             break
 152:     if NONZERO.search(body):
 153:         return True
 154:     # A CALL TO require_controls IS A REACHABLE NON-ZERO EXIT. It raises ControlFailed,
 155:     # which subclasses SystemExit -- so a file that fails ONLY through its controls was
 156:     # scored "cannot fail" by the regex, which is the same blindness that scored a pytest
 157:     # file with fourteen assertions as unable to fail. Both are now recognised.
 158:     if re.search(r"require_controls\s*\(", body):
 159:         return True
 160:     # A PYTEST FILE FAILS THROUGH `assert`, NOT THROUGH sys.exit. The first version of this
 161:     # check scored scripts/test_apply_reml_guard.py -- fourteen proofs, two of which SKIP
 162:     # rather than pass when unrun -- as unable to fail. A mechanisation audit that cannot
 163:     # see the one mechanism already in place is the defect it was written to measure.
 164:     if not os.path.basename(rel).startswith("test_"):
 165:         return False
 166:     return re.search(r"^\s*assert\s|self\.assert\w+\(", body, re.M) is not None
 167: 
 168: 
 169: def hooked(rel):
 170:     name = os.path.basename(rel)
 171:     for h in HOOKS:
 172:         if os.path.exists(h):
 173:             if name in io.open(h, encoding="utf-8", errors="replace").read():
 174:                 return True
 175:     return False
 176: 
 177: 
 178: def fired(rel, marker):
 179:     if not marker:
 180:         return False
 181:     path = os.path.join(REPO, rel)
 182:     if not os.path.exists(path):
 183:         return False
 184:     return marker in io.open(path, encoding="utf-8", errors="replace").read()
 185: 
 186: 
 187: def main():
 188:     gate = "--gate" in sys.argv
 189:     rows = []
 190:     for cls, name, cmd, marker, note in CLASSES:
 191:         if not cmd:
 192:             rows.append((cls, name, "", False, False, False, "DOCUMENTED", note))
 193:             continue
 194:         exists = os.path.exists(os.path.join(REPO, cmd))
 195:         cf = exists and can_fail(cmd)
 196:         hk = exists and hooked(cmd)
 197:         fr = exists and fired(cmd, marker)
 198:         # PROVEN is Mahmood's question exactly: a command that FAILS when this recurs, and
 199:         # HAS BEEN SHOWN to fail on a real instance. `hooked` is reported beside it because
 200:         # a gate nobody runs is a gate, but it is not what was asked -- and hooking a
 201:         # reporting sweep would be the wrong fix for the wrong column.
 202:         if cf and fr:
 203:             state = "PROVEN"
 204:         elif cf:
 205:             state = "UNPROVEN"
 206:         else:
 207:             state = "DOCUMENTED"
 208:         rows.append((cls, name, cmd, cf, hk, fr, state, note))
 209: 
 210:     print("CAN TONIGHT'S CLASSES REFUSE? -- %d classes opened 2026-08-20" % len(rows))
 211:     print("")
 212:     print("%-4s %-6s %-9s %-7s %-7s %s" % ("cls", "fails", "hooked", "fired", "state",
 213:                                            "command"))
 214:     print("-" * 100)
 215:     for cls, name, cmd, cf, hk, fr, state, note in rows:
 216:         print("%-4s %-6s %-9s %-7s %-7s %s"
 217:               % (cls, "yes" if cf else "NO", "yes" if hk else "no",
 218:                  "yes" if fr else "no", state, cmd or "(none)"))
 219:         print("       %s" % name)
 220:         if note:
 221:             print("       -- %s" % note)
 222: 
 223:     counts = {}
 224:     for r in rows:
 225:         counts[r[6]] = counts.get(r[6], 0) + 1
 226:     print("")
 227:     print("MECHANISED AND PROVEN   %d" % counts.get("PROVEN", 0))
 228:     print("MECHANISED AND UNPROVEN %d" % counts.get("UNPROVEN", 0))
 229:     print("DOCUMENTED ONLY         %d" % counts.get("DOCUMENTED", 0))
 230:     print("")
 231:     print("A CLASS IN THE THIRD BUCKET IS RECORDED, NOT CONTROLLED. Its control is a person")
 232:     print("remembering, and that control has already failed nine times in this repository.")
 233: 
 234:     if gate:
 235:         undone = [r for r in rows if r[6] == "DOCUMENTED" and r[2]]
 236:         if undone:
 237:             print("")
 238:             print("REFUSED: %d class(es) name a command that cannot fail." % len(undone))
 239:             for r in undone:
 240:                 print("    class %s -> %s" % (r[0], r[2]))
 241:             sys.exit(1)
 242: 
 243: 
 244: if __name__ == "__main__":
 245:     main()

