 161:     fams = sorted({f for r in rows for f in r["comparator_families"]})
 162:     prims = {norm(r["primary"]) for r in rows if r["primary"]}
 163: 
 164:     if len(conds) > 3 and len(rows) > 1:
 165:         return ("SPLIT", None,
 166:                 "the registrations code %d distinct conditions across %d trials; that is a P21 "
 167:                 "decision about how many questions this topic is, not a restatement"
 168:                 % (len(conds), len(rows)))
 169:     if not conds:
 170:         return "PACKET", None, "no registration codes a condition"
 171: 
 172:     # THE INTERVENTION MUST BE THE TOPIC'S OWN. Match coded intervention names against the words
 173:     # the topic is named for; a placebo or comparator arm will not match and cannot be selected.
 174:     iv_hits = [v for k, v in ivs.items()
 175:                if any(t in k for t in toks) and not comparator_family(v)]
 176:     if not iv_hits:
 177:         return ("PACKET", None,
 178:                 "no coded intervention matches the topic's own words, so the intervention "
 179:                 "cannot be identified from source. %d intervention(s) are coded: %s. Guessing "
 180:                 "one would repeat the shortest-string defect this function was built to remove."
 181:                 % (len(ivs), ", ".join(sorted(ivs.values())[:6])))
 182:     iv = sorted(iv_hits, key=len)[0]
 183: 
 184:     # THE CONDITION GETS THE SAME RULE AS THE INTERVENTION. The first fix left a shortest-string
 185:     # FALLBACK here, and it survived to derive "In adults with stroke" for `warfarin-af`. A
 186:     # fallback that picks arbitrarily is the defect, not a mitigation of it.
 187:     cond_hits = [v for k, v in conds.items() if any(t in k for t in toks)]
 188:     if not cond_hits:
 189:         return ("PACKET", None,
 190:                 "no coded condition matches the topic's own words, so the population cannot be "
 191:                 "identified from source. %d condition(s) are coded: %s. The first version fell "
 192:                 "back to the shortest string and derived 'In adults with stroke' for warfarin-af."
 193:                 % (len(conds), ", ".join(sorted(conds.values())[:6])))
 194:     cond = sorted(cond_hits, key=len)[0]
 195: 
 196:     who = population_word(rows)
 197:     if not who:
 198:         return ("PACKET", None,
 199:                 "no registration declares stdAges, so the population cannot be stated from "
 200:                 "source. 'Adults' was hardcoded in the first version and derived 'In adults "
 201:                 "with HIV infection' for pediatric-hiv-art.")
 202: 
 203:     comp = fams[0] if len(fams) == 1 else None
 204:     q = "In %s with %s, does %s" % (who, cond.lower(), iv)
 205:     q += (" compared with %s" % comp) if comp else          " compared with the comparator each trial randomised"
 206:     if len(prims) == 1:
 207:         q += " affect %s?" % list(prims)[0].rstrip("?.").lower()
 208:     else:
 209:         q += (" affect the outcome each trial registered as its primary, which differ across "
 210:               "the %d trials here?" % len(rows))
 211:     return "RESTATED", q, {
 212:         "n_trials_read": len(rows),
 213:         "population_from_stdAges": who,
 214:         "condition_chosen": cond,
 215:         "condition_matched_the_topic_name": bool(cond_hits),
 216:         "intervention_chosen": iv,
 217:         "intervention_matched_the_topic_name": True,
 218:         "conditions_coded": sorted(conds.values()),
 219:         "interventions_coded": sorted(ivs.values()),
 220:         "comparator_families": fams,
 221:         "n_distinct_registered_primaries": len(prims),
 222:         "clauses_left_out_because_source_did_not_support_them":
 223:             ([] if comp else ["a single comparator -- the trials do not share one"])
 224:             + ([] if len(prims) == 1 else ["a single primary outcome"]),
 225:         "read_utc": "2026-08-19",
 226:     }
 227: 
 228: 
 229: def run(apply_it):
 230:     audit = json.load(io.open(AUDIT, encoding="utf-8"))
 231:     targets = [r for r in audit["rows"] if r["state"] in ("TEMPLATED", "TITLE_ECHO")]
 232:     print("templated or title-echo topics: %d\n" % len(targets))
 233: 
 234:     out, counts = [], {"RESTATED": 0, "SPLIT": 0, "PACKET": 0}
 235:     for r in targets:
 236:         topic = r["topic"]
 237:         p = os.path.join(REPO, "ssot", topic, topic + ".json")
 238:         if not os.path.exists(p):
 239:             continue
 240:         obj = json.load(io.open(p, encoding="utf-8"))
 241:         if R.is_retired(obj):
 242:             continue
 243:         state, q, detail = derive(topic, obj)
 244:         counts[state] += 1
 245:         out.append({"topic": topic, "was_state": r["state"], "was_question": r.get("question"),
 246:                     "outcome": state, "new_question": q, "detail": detail})
 247:         print("  %-9s %-42s %s" % (state, topic, (q or detail)[:70] if isinstance(q or detail, str)
 248:                                    else ""))
 249:         if state == "RESTATED" and apply_it:
 250:             obj["question"] = q
 251:             obj["question_restated_2026_08_19"] = {
 252:                 "was": r.get("question"),
 253:                 "why": ("The previous question was %s -- it named no population, no comparator "
 254:                         "and no outcome, so every question-based check read a field with no "
 255:                         "content in it. Restated from THIS TOPIC'S OWN registrations' coded "
 256:                         "fields." % r["state"]),
 257:                 "derived_from": detail,
 258:                 "what_this_is_not": ("NOT a P21 decision. The registrations resolve to one "
 259:                                      "question; where they had not, this topic would have been "
 260:                                      "left for a split rather than restated."),
 261:             }
 262:             with io.open(p, "w", encoding="utf-8", newline="") as fh:
 263:                 fh.write(json.dumps(obj, indent=1, ensure_ascii=False))
 264: 
 265:     print("\n  RESTATED %d   SPLIT %d   PACKET %d" % (counts["RESTATED"], counts["SPLIT"],
 266:                                                       counts["PACKET"]))
 267:     doc = {"run_utc": "2026-08-19", "counts": counts,
 268:            "what_the_ratio_means": (
 269:                "RESTATED means the topic's own registrations resolved to exactly one question "
 270:                "and the field had simply never been filled from them. SPLIT means the topic is "
 271:                "genuinely several questions and needs a P21 decision. PACKET means nothing in "
 272:                "the object can support a question at all. The ratio is a finding about how "
 273:                "these objects were made, not about the topics."),
 274:            "the_restated_form": (
 275:                "A PICO sentence: population, intervention, comparator, outcome, each clause "
 276:                "filled from the registrations' own coded fields and different for every topic. "
 277:                "A template of FORM is not a template of CONTENT -- the defect being fixed is a "
 278:                "question with no content. Where a clause cannot be filled from source it is "
 279:                "LEFT OUT rather than guessed, and the omission is recorded."),
 280:            "rows": out}
 281:     if apply_it:
 282:         with io.open(OUT, "w", encoding="utf-8", newline="") as fh:
 283:             fh.write(json.dumps(doc, indent=1, ensure_ascii=False))
 284:         print("wrote %s" % os.path.relpath(OUT, REPO))
 285:     else:
 286:         print("DRY RUN -- nothing written.")
 287:     return 0
 288: 
 289: 
 290: if __name__ == "__main__":
 291:     sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
 292:     sys.exit(run("--apply" in sys.argv))

codex
Defects found:

- Line 59, NEGATION DROPPED / selector substring: `comparator_family("uncontrolled hypertension")` returns `"usual care"` because `"control"` is inside `"uncontrolled"`; consequence: a non-comparator disease/arm label can be counted as a usual-care comparator.

- Line 113, SELECTOR KEYED TO A FORM THE CORPUS DOES NOT USE: `topic_tokens("pediatric-hiv-art", {"title": "Pediatric HIV ART"})` returns `set()` because `HIV` and `ART` are length 3 and `pediatric` is generic; consequence: coded fields like `"HIV infection"` and `"Antiretroviral Therapy"` cannot match, so a restatable topic becomes `PACKET`.

- Lines 111 and 182, instrument/name vs binding defect: with `topic="pitavastatin"`, title `"Pitavastatin versus Simvastatin in hypercholesterolemia"`, conditions `["Hypercholesterolemia"]`, interventions `["Pitavastatin", "Simvastatin"]`, primary `"LDL-C"`, ages `["ADULT"]`, both drug names are topic tokens and line 182 chooses shortest, `"Simvastatin"`; consequence: the comparator can be restated as the intervention.

- Lines 161 and 203, ZERO/ABSENT CONFLATED: input rows after `read`: `[{"comparator_families":["placebo"]}, {"comparator_families":[]}]` gives `fams == ["placebo"]` and `comp == "placebo"`; consequence: a missing comparator family in one trial is treated as agreement that all trials share placebo.

- Line 82, OFF-BY-ONE tabulation: a registration with `primaryOutcomes=[{"measure":"Mortality"},{"measure":"Hospitalization"}]` is read as `"primary": "Mortality"` only; consequence: the question and `n_distinct_registered_primaries` can omit registered primary outcomes.

- Lines 238-239 plus 287, CHECK CANNOT FAIL / wrapper status: audit input `{"rows":[{"state":"TEMPLATED","topic":"missing","question":"x"}]}` with no `ssot/missing/missing.json` reaches `continue` and then `return 0`; consequence: a targeted topic disappears from counts while the process reports success.

No finding in the pasted file: CRLF/LF text comparison; merged-cell handling; idempotency guard satisfied by its own comment or marker.
