 248: 
 249: def main():
 250:     ok = fail = 0
 251:     for target_name, spec in SPECS.items():
 252:         source = ROOT / spec["source"]
 253:         target = ROOT / target_name
 254:         if not source.exists():
 255:             print(f"FAIL {target_name}: source missing")
 256:             fail += 1
 257:             continue
 258:         r = clone_app(source, target, spec)
 259:         print(r)
 260:         if r.startswith("OK"):
 261:             ok += 1
 262:         else:
 263:             fail += 1
 264:     print(f"\nTier 4 batch B: {ok} ok / {fail} fail")
