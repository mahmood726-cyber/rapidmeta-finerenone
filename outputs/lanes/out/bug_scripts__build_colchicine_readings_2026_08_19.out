 413: PAGE = """<!doctype html>
 414: <html lang="en"><head>
 415: <meta charset="utf-8">
 416: <meta name="viewport" content="width=device-width,initial-scale=1">
 417: <title>{title}</title>
 418: <meta name="rapidmeta:page-state" content="LIVE">
 419: <meta name="rapidmeta:pooled-estimate" content="NONE">
 420: <meta name="rapidmeta:split-from" content="colchicine-cvd-review">
 421: <meta name="description" content="{desc}">
 422: <style>{css}</style>
 423: </head><body>
 424: <span class="tag">No pooled estimate</span>
 425: <h1>{title}</h1>
 426: <p class="sub">One of seven reviews created by splitting <code>colchicine-cvd-review</code> on
 427: its 137 screened registrations. {own}</p>
 428: 
 429: <div class="q"><strong>Question.</strong> {question}</div>
 430: 
 431: <h2>Why this review publishes no pooled estimate</h2>
 432: <div class="why">{reason}</div>
 433: {absentnote}
 434: {limbs}
 435: 
 436: <h2>The {k} eligible trial(s), of which {kr} posted results TO THE REGISTRY</h2>
 437: <div class="wrap"><table>
 438: <thead><tr><th>Registration</th><th>Acronym</th><th>Enrolment</th><th>Comparator</th>
 439: <th>Registered primary</th><th>Results</th></tr></thead>
 440: <tbody>
 441: {rows}
 442: </tbody></table></div>
 443: 
 444: <h2>What was and was not searched</h2>
 445: <ul>
 446:  <li><b>{surfaced}</b> registrations surfaced on ClinicalTrials.gov and all <b>{surfaced}</b>
 447:      screened; <b>{rem}</b> left unscreened.</li>
 448:  <li>Reading precedence: <code>{prec}</code></li>
 449:  <li><b>{notsearched}</b></li>
 450: </ul>
 451: 
 452: <h2>What this review does not establish</h2>
 453: <p>{notestab}</p>
 454: 
 455: <h2>The other reviews from this split</h2>
 456: <p>{sibs}</p>
 457: 
 458: <footer>
 459: Built 2026-08-19 by <code>scripts/build_colchicine_readings_2026_08_19.py</code> from
 460: <code>ssot/{topic}/{topic}.json</code>. Every figure is read from that object; none is typed
 461: into the page. Primary publications are <b>not resolved</b> for this topic and are reported as
 462: unresolved rather than approximated.
 463: </footer>
 464: </body></html>
 465: """
 466: 
 467: 
 468: def page_html(spec, o, disp, siblings):
 469:     pr = o["results"]["by_outcome"]["primary"]
 470:     limbs = "".join("<div class='why'><b>%s</b> &mdash; %s</div>"
 471:                     % (esc(f["property"]), esc(f["finding"]))
 472:                     for f in pr["failing_limbs"])
 473:     nothing = pr["estimand_screen_verdict"] == "NO_ESTIMATE_POSSIBLE_NOTHING_HAS_REPORTED"
 474:     sibs = "".join('<a class="go" href="%s">%s &rarr;</a>' % (p, esc(t))
 475:                    for p, t in siblings)
 476:     return PAGE.format(
 477:         css=CSS, title=esc(o["title"]), desc=esc(o["question"][:150]),
 478:         own=esc(o["why_this_is_its_own_question"]), question=esc(o["question"]),
 479:         reason=esc(pr["poolable_reason"]),
 480:         absentnote=(("<div class='why'><b>Absent is not zero.</b> %s</div>"
 481:                      % esc(pr["absent_is_not_zero"])) if nothing else ""),
 482:         limbs=limbs, k=pr["k"], kr=pr["k_with_posted_results"],
 483:         rows=rows_html(o, disp),
 484:         surfaced=o["screening"]["surfaced"], rem=o["screening"]["unscreened_remainder"],
 485:         prec=esc(o["screening"]["precedence"]),
 486:         notsearched=esc(o["screening"]["registries_and_limbs_not_searched"]),
 487:         notestab=esc(pr["what_this_verdict_does_not_establish"]),
 488:         sibs=sibs, topic=esc(spec["topic"]))
 489: 
 490: 
 491: def run(apply_it):
 492:     with io.open(SCREEN, "r", encoding="utf-8") as fh:
 493:         scr = json.load(fh)
 494:     disp = {r["nct"]: r["disposition"] for r in scr["rows"]}
 495: 
 496:     objs, record = {}, {"built_utc": "2026-08-19", "readings": {}}
 497:     for reading, spec in READINGS.items():
 498:         ncts = sorted(r["nct"] for r in scr["rows"]
 499:                       if r["reading"] == reading and r["disposition"].startswith("ELIGIBLE"))
 500:         rows = [read_registration(n) for n in ncts]
 501:         reported = [n for n in ncts if disp.get(n) == "ELIGIBLE_WITH_RESULTS"]
 502:         v = assess(reading, rows, reported)
 503:         shared = shared_at_any_rank(rows, reported)
 504:         o = build_object(reading, spec, rows, reported, scr, v, shared)
 505:         objs[spec["topic"]] = (spec, o)
 506:         record["readings"][reading] = {
 507:             "topic": spec["topic"], "verdict": v["verdict"], "k_eligible": v["k_eligible"],
 508:             "k_with_posted_results": v["k_with_posted_results"],
 509:             "n_shared_at_any_rank": len(shared)}
 510:         print("  %-14s %-38s k=%-3d reported=%-2d shared=%-2d  %s"
 511:               % (reading, spec["topic"], v["k_eligible"], v["k_with_posted_results"],
 512:                  len(shared), v["verdict"]))
 513: 
 514:     sib_all = [(READINGS[r]["page"], READINGS[r]["title"]) for r in READINGS]
 515:     pages = {}
 516:     for topic, (spec, o) in objs.items():
 517:         sibs = [(p, t) for p, t in sib_all if p != spec["page"]]
 518:         pages[spec["page"]] = page_html(spec, o, disp, sibs)
 519: 
 520:     # THE OVERWRITE GUARD. A builder must never write over a page it did not create.
 521:     clash = [p for p in pages if os.path.exists(os.path.join(REPO, p))]
 522:     if clash:
 523:         print("\nREFUSED -- these pages already exist and would be OVERWRITTEN:")
 524:         for c in clash:
 525:             print("   %-46s %d bytes" % (c, os.path.getsize(os.path.join(REPO, c))))
 526:         return 1
 527: 
 528:     bad = []
 529:     for p, h in pages.items():
 530:         if "No pooled estimate" not in h:
 531:             bad.append("%s: does not say so where a reader sees it" % p)
 532:         if not re.search(r"NCT\d{8}", h):
 533:             bad.append("%s: names no trial" % p)
 534:     if bad:
 535:         print("\nREFUSED -- would fail the regression check: %s" % bad)
 536:         return 1
 537:     print("\n  %d page(s) satisfy the no-pool review definition" % len(pages))
 538: 
 539:     if not apply_it:
 540:         print("\nDRY RUN -- nothing written. Re-run with --apply.")
 541:         return 0
 542: 
 543:     for topic, (spec, o) in objs.items():
 544:         d = os.path.join(REPO, "ssot", topic)
 545:         if not os.path.isdir(d):
 546:             os.makedirs(d)
 547:         with io.open(os.path.join(d, topic + ".json"), "w", encoding="utf-8",
 548:                      newline="") as fh:
 549:             fh.write(json.dumps(o, indent=1, ensure_ascii=False))
 550:     for p, h in pages.items():
 551:         with io.open(os.path.join(REPO, p), "w", encoding="utf-8", newline="") as fh:
 552:             fh.write(h)
 553:     pm = os.path.join(REPO, "ssot", "PAGE_MAP.json")
 554:     with io.open(pm, "r", encoding="utf-8") as fh:
 555:         pmap = json.load(fh)
 556:     for topic, (spec, o) in objs.items():
 557:         pmap[spec["page"]] = "ssot/%s/%s.json" % (topic, topic)
 558:     with io.open(pm, "w", encoding="utf-8", newline="") as fh:
 559:         fh.write(json.dumps(pmap, indent=1, ensure_ascii=False, sort_keys=True))
 560:     with io.open(OUT, "w", encoding="utf-8", newline="") as fh:
 561:         fh.write(json.dumps(record, indent=1, ensure_ascii=False))
 562:     print("\nwrote %d object(s) and %d page(s); PAGE_MAP updated" % (len(objs), len(pages)))
 563:     return 0
