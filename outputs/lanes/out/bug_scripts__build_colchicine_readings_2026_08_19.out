 260: 
 261: def build_object(reading, spec, rows, reported, scr, verdict, shared):
 262:     return {
 263:         "app_id": spec["topic"],
 264:         "schema_version": "2-authored-from-source",
 265:         "build_mode": "AUTHORED",
 266:         "built": "2026-08-19T00:00Z",
