 245: 
 246: def shared_at_any_rank(rows, reported):
 247:     seen = {}
 248:     by = {r["nct"]: r for r in rows}
 249:     for n in reported:
 250:         r = by.get(n) or {}
 251:         if r.get("state") != "READ":
 252:             continue
 253:         for k in ("registered_primaries", "registered_secondaries",
 254:                   "registered_other_outcomes"):
 255:             for t in r.get(k) or []:
 256:                 if norm(t):
 257:                     seen.setdefault(norm(t), {})[n] = k.replace("registered_", "")
 258:     return {t: v for t, v in seen.items() if len(v) >= 2}
