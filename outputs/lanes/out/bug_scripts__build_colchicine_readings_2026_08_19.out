 353: CSS = """
 354:  :root{color-scheme:light dark;--fg:#111;--bg:#fff;--mut:#555;--line:#d8d8d8;--warn:#8a4b00}
 355:  @media (prefers-color-scheme:dark){:root{--fg:#eee;--bg:#111;--mut:#aaa;--line:#333;
 356:    --warn:#e2a45c}}
 357:  *{box-sizing:border-box}
 358:  body{font:16px/1.62 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;max-width:56rem;
 359:       margin:0 auto;padding:2.5rem 1.25rem 5rem;background:var(--bg);color:var(--fg)}
 360:  h1{font-size:1.5rem;line-height:1.28;margin:.4rem 0 .2rem}
 361:  h2{font-size:1.05rem;margin:2.4rem 0 .6rem;padding-bottom:.3rem;
 362:     border-bottom:1px solid var(--line)}
 363:  .tag{display:inline-block;font:600 .7rem/1 system-ui;letter-spacing:.09em;
 364:       text-transform:uppercase;padding:.4rem .6rem;border:1px solid currentColor;
 365:       border-radius:.25rem;opacity:.8;color:var(--warn)}
 366:  .q{font-size:1.06rem;margin:1rem 0;padding:1rem 1.1rem;border-left:3px solid currentColor}
 367:  .sub{color:var(--mut);font-size:.94rem}
 368:  .wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;margin:.8rem 0}
 369:  table{border-collapse:collapse;width:100%;min-width:44rem;font-size:.9rem}
 370:  th,td{text-align:left;padding:.5rem .6rem;border-bottom:1px solid var(--line);
 371:        vertical-align:top}
 372:  th{font-weight:600;white-space:nowrap}
 373:  td.n{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
 374:  .why{margin:.9rem 0;padding:.85rem 1rem;border:1px solid var(--line);border-radius:.3rem}
 375:  a.go{display:inline-block;margin:.4rem .6rem .4rem 0;padding:.6rem 1rem;
 376:       border:1px solid currentColor;border-radius:.3rem;text-decoration:none;font-weight:600}
 377:  footer{margin-top:3rem;padding-top:1rem;border-top:1px solid var(--line);
 378:         color:var(--mut);font-size:.86rem}
 379:  code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.9em}
 380: """
 381: 
 382: 
 383: def esc(s):
 384:     return (str(s if s is not None else "")
 385:             .replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
 386:             .replace('"', "&quot;"))
 387: 
 388: 
 389: def num(v):
 390:     return "{:,}".format(v) if isinstance(v, int) else "&mdash;"
 391: 
 392: 
 393: def rows_html(o, disp):
 394:     out = []
 395:     for t in o["inputs"]["trials"]:
 396:         if t["state"] != "READ":
 397:             out.append("<tr><td><code>%s</code></td><td colspan='5'>%s &mdash; %s</td></tr>"
 398:                        % (esc(t["nct"]), esc(t["state"]), esc(t.get("why"))))
 399:             continue
 400:         d = disp.get(t["nct"], "")
 401:         out.append(
 402:             "<tr><td><code>%s</code></td><td>%s</td><td class='n'>%s</td><td>%s</td>"
 403:             "<td>%s</td><td>%s</td></tr>"
 404:             % (esc(t["nct"]), esc(t.get("acronym_the_registration_declares") or ""),
 405:                num(t.get("enrollment")),
 406:                ", ".join(t.get("comparator_families_present") or []) or "&mdash;",
 407:                esc(t.get("registered_primary_title") or "(none registered)"),
 408:                "<b>reported</b>" if d == "ELIGIBLE_WITH_RESULTS" else
 409:                esc(d.replace("ELIGIBLE_", "").replace("_", " ").lower())))
 410:     return "\n".join(out)
