 216:     distinct = len({norm(t) for t in titles.values() if norm(t)})
 217: 
 218:     fails = []
 219:     if fused:
 220:         fails.append({"property": "P45",
 221:                       "finding": ("%d trial(s) register a primary whose TITLE fuses a bleeding "
 222:                                   "component with the efficacy construct." % len(fused)),
 223:                       "trials": [n for n, _ in fused]})
 224:     if len(fams) > 1:
 225:         fails.append({"property": "P38",
 226:                       "finding": ("The reading holds %d DIFFERENT COMPARATOR FAMILIES: %s. A "
 227:                                   "shared estimand would not make these poolable."
 228:                                   % (len(fams), ", ".join(sorted(fams)))),
 229:                       "families": fams})
 230:     if distinct > 1:
 231:         fails.append({"property": "P37",
 232:                       "finding": ("%d DISTINCT registered-primary titles across %d trials, "
 233:                                   "compared on their verbatim text." % (distinct, len(read))),
 234:                       "titles": titles})
 235:     return {
 236:         "verdict": "POOL_NOT_ADMISSIBLE" if fails else "NO_BARRIER_FOUND_BY_THESE_THREE_TESTS",
 237:         "k_eligible": len(read), "k_with_posted_results": len(reported),
 238:         "failing_limbs": fails, "all_failing_limbs_reported": True,
 239:         "endpoints_needing_a_human_read": needs,
 240:         "note_if_clean": (None if fails else
 241:                           "These three tests found no barrier. That is NOT a finding that the "
 242:                           "trials pool: no estimate is computed here."),
 243:     }
