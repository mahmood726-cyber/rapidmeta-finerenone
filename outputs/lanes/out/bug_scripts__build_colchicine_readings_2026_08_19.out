 121: def comparator_family(label):
 122:     lo = (label or "").lower()
 123:     for fam, terms in (("PLACEBO", PLACEBO), ("USUAL_CARE_OR_NO_TREATMENT", USUAL),
 124:                        ("ACTIVE_COMPARATOR", ACTIVE)):
