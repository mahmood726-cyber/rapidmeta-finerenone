 228: def apply_edit(src, old, new, label, sentinel=None):
 229:     """Apply edit only if old still present and the unique sentinel isn't.
 230: 
 231:     Some edits' OLD anchors are prefixes of their NEW replacement (e.g. edit5
 232:     keeps the original Plotly call line), which would re-fire on every run if
 233:     we only checked `old in src`. Pass a `sentinel` string from NEW that does
 234:     NOT appear in the original file - if present, the edit is already done.
 235:     """
 236:     if sentinel is not None and sentinel in src:
 237:         return src, 'SKIP_already_applied'
 238:     if new in src and old not in src:
 239:         return src, 'SKIP_already_applied'
 240:     if old not in src:
 241:         return src, 'SKIP_anchor_not_found'
 242:     if src.count(old) > 1:
 243:         return src, f'SKIP_anchor_ambiguous ({src.count(old)} matches)'
 244:     return src.replace(old, new, 1), 'APPLIED'
