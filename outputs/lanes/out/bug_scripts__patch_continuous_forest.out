 296:             tag = 'CHANGED' if changed else 'unchanged'
 297:             print(f'\n[{tag}] {fname}')
 298:             for line in log:
 299:                 print(line)
 300:             summary['changed' if changed else 'unchanged'] += 1
 301:         except Exception as e:
 302:             print(f'\n[ERROR] {fname}: {e}')
 303:             summary['errors'] += 1
 304:     print(f'\nSummary: {summary}')
 305:     return 0 if summary['errors'] == 0 else 1
