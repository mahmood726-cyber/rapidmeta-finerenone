    "                Plotly.newPlot('plot-forest-nyt', [trace], layout, { displayModeBar: false, responsive: true });\n\n\n"
    "            },\n\n\n"
    "            // Headline forest plot for CONTINUOUS (mean-difference) outcomes.\n"
