 284:     ap.add_argument('--dry-run', action='store_true')
 285:     args = ap.parse_args()
 286:     print(f'Mode: {"DRY-RUN" if args.dry_run else "APPLY"}')
 287:     summary = {'changed': 0, 'unchanged': 0, 'errors': 0}
 288:     for fname in TARGETS:
 289:         path = os.path.join(ROOT, fname)
 290:         if not os.path.exists(path):
 291:             print(f'\n[ERROR] {fname}: not found')
 292:             summary['errors'] += 1
 293:             continue
