    "            renderAnnotatedForestMD(r, included, zCrit, ciPct) {\n"
    "                const studies = (r.plotData ?? []).map(d => {\n"
    "                    const md = d.md;\n"
    "                    const se = d.se;\n"
    "                    const lo = md - zCrit * se;\n"
    "                    const hi = md + zCrit * se;\n"
    "                    const w  = 1 / (se * se);\n"
    "                    return { name: d.name ?? d.id, year: d.year ?? '', md, lo, hi, w };\n"
