 256: def patch_file(path, dry=False):
 257:     src = open(path, 'r', encoding='utf-8').read()
 258:     original = src
 259:     log = []
 260:     # Sentinel strings unique to each NEW that aren't in the original template.
 261:     # Used for idempotency when OLD is a prefix of NEW (edit5).
 262:     edits = [
 263:         (EDIT1_OLD, EDIT1_NEW, 'plotData alias',     'd.logOR = d.md'),
 264:         (EDIT2_OLD, EDIT2_NEW, 'pool() return shape','pLogOR: pMD, pSE: pSE, zCrit: zCrit'),
 265:         (EDIT3_OLD, EDIT3_NEW, 'Math.exp() bug',     'pLogOR ?? c.or'),
 266:         (EDIT4_OLD, EDIT4_NEW, 'forest routing',     'r && r.isContinuous'),
 267:         (EDIT5_OLD, EDIT5_NEW, 'forestMD function',  'renderAnnotatedForestMD(r, included, zCrit, ciPct) {'),
 268:         (EDIT6_OLD, EDIT6_NEW, 'helpers',            'continuousAxisLabel(outcomeKey) {'),
 269:     ]
 270:     for i, (old, new, label, sentinel) in enumerate(edits, start=1):
 271:         src, status = apply_edit(src, old, new, label, sentinel=sentinel)
 272:         log.append(f'  edit{i} ({label}): {status}')
 273:     src, status = apply_edit_re(src, EDIT7_RE, EDIT7_NEW, 'caption')
 274:     log.append(f'  edit7 (caption): {status}')
 275: 
 276:     changed = src != original
 277:     if changed and not dry:
 278:         open(path, 'w', encoding='utf-8').write(src)
 279:     return changed, log
