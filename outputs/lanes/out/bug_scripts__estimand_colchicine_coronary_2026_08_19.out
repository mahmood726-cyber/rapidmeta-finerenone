 th=[math.log(m.TRIALS[n]['hr']) for n in names]; se=[m.se_of(m.TRIALS[n]['lci'], m.TRIALS[n]['uci']) for n in names]; v=[s*s for s in se]; df=len(th)-1
 def q(tau):
