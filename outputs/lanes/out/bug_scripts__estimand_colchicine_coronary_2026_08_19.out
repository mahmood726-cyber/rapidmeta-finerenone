  62:             "100 person-years; hazard ratio, 0.69; 95% confidence interval [CI], 0.57 to 0.83; "
  63:             "P<0.001)"),
  64:         "hr": 0.69, "lci": 0.57, "uci": 0.83,
  65:         "n_treatment": 2762, "n_control": 2760, "n_total": 5522,
  66:         "follow_up_verbatim": "The median duration of follow-up was 28.6 months",
  67:         "components": ["cv_death", "spontaneous_nonprocedural_myocardial_infarction",
  68:                        "ischaemic_stroke", "ischaemia_driven_revascularisation"],
  69:         "key_secondary_verbatim": ("a composite of cardiovascular death, spontaneous myocardial "
  70:                                    "infarction, or ischemic stroke"),
  71:         "key_secondary_hr": 0.72, "key_secondary_lci": 0.57, "key_secondary_uci": 0.92,
  72:     },
  73:     "CLEAR SYNERGY": {
  74:         "nct": "NCT03048825", "pmid": "39555823", "doi": "10.1056/NEJMoa2405922",
  75:         "journal": "N Engl J Med", "year": 2024,
  76:         "population_verbatim": "patients who had myocardial infarction",
  77:         "primary_verbatim": (
  78:             "a composite of death from cardiovascular causes, recurrent myocardial infarction, "
  79:             "stroke, or unplanned ischemia-driven coronary revascularization, evaluated in a "
  80:             "time-to-event analysis"),
  81:         "effect_verbatim": (
  82:             "A primary-outcome event occurred in 322 of 3528 patients (9.1%) in the colchicine "
  83:             "group and 327 of 3534 patients (9.3%) in the placebo group over a median follow-up "
  84:             "period of 3 years (hazard ratio, 0.99; 95% confidence interval [CI], 0.85 to 1.16; "
  85:             "P = 0.93)"),
  86:         "hr": 0.99, "lci": 0.85, "uci": 1.16,
  87:         "n_treatment": 3528, "n_control": 3534, "n_total": 7062,
  88:         "follow_up_verbatim": "a median follow-up period of 3 years",
  89:         "components": ["cv_death", "recurrent_myocardial_infarction", "stroke",
  90:                        "unplanned_ischaemia_driven_revascularisation"],
  91:         "N_DISAGREES_WITH_ITS_OWN_REGISTRATION": (
  92:             "The publication randomised 7,062 (3,528 + 3,534). The ClinicalTrials.gov record "
  93:             "declares an enrolment of 7,264. THE DIFFERENCE IS 202 AND THIS FILE DOES NOT "
  94:             "RECONCILE IT: the registration's enrolment field counts the 2x2 factorial's full "
  95:             "randomised population and the colchicine report counts the colchicine comparison, "
  96:             "which is a PLAUSIBLE explanation and is not evidence. The published figure is used "
  97:             "because it is the denominator of the effect estimate beside it."),
  98:     },
  99: }
 100: 
 101: # THE COMPARISON P37 DEMANDS: component SETS, not names.
 102: CANONICAL = {
 103:     "cv_death": "cardiovascular death",
 104:     "resuscitated_cardiac_arrest": "resuscitated cardiac arrest",
 105:     "myocardial_infarction": "myocardial infarction, ANY",
 106:     "spontaneous_nonprocedural_myocardial_infarction": "myocardial infarction, SPONTANEOUS ONLY",
 107:     "recurrent_myocardial_infarction": "myocardial infarction, RECURRENT",
 108:     "stroke": "stroke, ANY TYPE",
 109:     "ischaemic_stroke": "stroke, ISCHAEMIC ONLY",
 110:     "urgent_hospitalisation_for_angina_leading_to_revasc":
 111:         "revascularisation, REQUIRING URGENT HOSPITALISATION FOR ANGINA",
 112:     "ischaemia_driven_revascularisation": "revascularisation, ISCHAEMIA-DRIVEN",
 113:     "unplanned_ischaemia_driven_revascularisation":
 114:         "revascularisation, UNPLANNED AND ISCHAEMIA-DRIVEN",
 115: }
 116: 
 117: 
 118: def se_of(lo, hi):
 119:     return (math.log(hi) - math.log(lo)) / (2 * Z95)
 120: 
 121: 
 122: def pool(names, tau2_method="PM"):
 123:     """Inverse-variance pool with Paule-Mandel tau-squared and a floored Knapp-Hartung interval.
 124: 
 125:     DL IS NOT USED AND THE REASON IS THE HOUSE RULE: DerSimonian-Laird is biased below k=10.
 126:     The Knapp-Hartung interval carries the standard floor -- when Q is below its degrees of
 127:     freedom the raw factor NARROWS the interval below the normal one, which is not what
 128:     Knapp-Hartung is for.
 129:     """
 130:     th = [math.log(TRIALS[n]["hr"]) for n in names]
 131:     se = [se_of(TRIALS[n]["lci"], TRIALS[n]["uci"]) for n in names]
 132:     k = len(th)
 133:     v = [s * s for s in se]
 134:     tau2 = 0.0
 135:     for _ in range(200):                       # Paule-Mandel, by fixed-point iteration
 136:         w = [1.0 / (vi + tau2) for vi in v]
 137:         mu = sum(wi * ti for wi, ti in zip(w, th)) / sum(w)
 138:         q = sum(wi * (ti - mu) ** 2 for wi, ti in zip(w, th))
 139:         if k <= 1:
 140:             break
 141:         new = tau2 + (q - (k - 1)) / sum(w)
 142:         new = max(0.0, new)
 143:         if abs(new - tau2) < 1e-12:
 144:             tau2 = new
 145:             break
 146:         tau2 = new
 147:     w = [1.0 / (vi + tau2) for vi in v]
 148:     tot = sum(w)
 149:     mu = sum(wi * ti for wi, ti in zip(w, th)) / tot
 150:     # Q and I-squared are reported at tau-squared = 0, which is what they mean.
 151:     w0 = [1.0 / vi for vi in v]
 152:     mu0 = sum(wi * ti for wi, ti in zip(w0, th)) / sum(w0)
 153:     Q = sum(wi * (ti - mu0) ** 2 for wi, ti in zip(w0, th))
 154:     df = k - 1
 155:     i2 = max(0.0, (Q - df) / Q) * 100 if Q > 0 else 0.0
 156:     hk = max(1.0, sum(wi * (ti - mu) ** 2 for wi, ti in zip(w, th)) / df) / tot if df else None
 157:     se_hk = math.sqrt(hk) if hk else math.sqrt(1.0 / tot)
 158:     tq = {1: 12.706205, 2: 4.302653, 3: 3.182446, 4: 2.776445}.get(df, Z95)
 159:     return {
 160:         "k": k, "trials": list(names),
 161:         "point": math.exp(mu),
 162:         "ci_low": math.exp(mu - tq * se_hk), "ci_high": math.exp(mu + tq * se_hk),
 163:         "tau2": tau2, "Q": Q, "df": df, "i2": i2,
 164:         "estimator": "Paule-Mandel tau-squared, Knapp-Hartung t interval on %d df with the "
 165:                      "variance-inflation floor at 1" % df,
 166:         "n_total": sum(TRIALS[n]["n_total"] for n in names),
 167:     }
 168: 
 169: 
 170: def component_analysis():
 171:     names = list(TRIALS)
 172:     sets = {n: set(TRIALS[n]["components"]) for n in names}
 173:     shared = set.intersection(*sets.values())
 174:     allc = set.union(*sets.values())
 175:     rows = []
 176:     for c in sorted(allc):
 177:         holders = sorted(n for n in names if c in sets[n])
 178:         rows.append({"component": c, "canonical": CANONICAL.get(c, c),
 179:                      "in_trials": holders, "in_all_three": len(holders) == len(names)})
 180:     return {"shared_by_all_three": sorted(shared), "union": sorted(allc), "by_component": rows}
 181: 
 182: 
 183: def main():
 184:     ca = component_analysis()
 185:     name_matched = pool(["COLCOT", "LoDoCo2", "CLEAR SYNERGY"])
 186:     mi_only = pool(["COLCOT", "CLEAR SYNERGY"])
 187:     out = {
 188:         "topic": "colchicine-cvd-coronary",
 189:         "computed_utc": "2026-08-19",
 190:         "source_standard": "Every endpoint definition and every effect estimate below is VERBATIM "
 191:                            "from the trial's own abstract as PubMed prints it. According to "
 192:                            "PubMed. Each carries its PMID and DOI.",
 193:         "trials": TRIALS,
 194:         "component_analysis": ca,
 195: 
 196:         "THE_FINDING": (
 197:             "ALL THREE ARE CALLED A MAJOR ADVERSE CARDIOVASCULAR EVENT COMPOSITE AND NO TWO OF "
 198:             "THEM DEFINE IT THE SAME WAY. Only ONE component -- cardiovascular death -- appears "
 199:             "in all three with the same definition. Every other component differs by a "
 200:             "qualifier that changes which events count, and one whole component is present in "
 201:             "one trial and absent from the other two:\n"
 202:             "  RESUSCITATED CARDIAC ARREST is in COLCOT and in neither of the others.\n"
 203:             "  MYOCARDIAL INFARCTION is ANY in COLCOT, SPONTANEOUS (NONPROCEDURAL) ONLY in "
 204:             "LoDoCo2, and RECURRENT in CLEAR SYNERGY. LoDoCo2's qualifier is not cosmetic: it "
 205:             "EXCLUDES procedural infarction, and this is a literature in which a large fraction "
 206:             "of infarctions are periprocedural.\n"
 207:             "  STROKE is ANY TYPE in COLCOT and CLEAR SYNERGY and ISCHAEMIC ONLY in LoDoCo2. "
 208:             "THAT ONE MATTERS MORE THAN IT LOOKS: colchicine's effect in INTRACEREBRAL "
 209:             "HAEMORRHAGE is an open question with its own reading in this split, so a trial "
 210:             "that counts only ischaemic strokes and a trial that counts all strokes are "
 211:             "measuring the drug against different risks.\n"
 212:             "  REVASCULARISATION requires URGENT HOSPITALISATION FOR ANGINA in COLCOT, is "
 213:             "ISCHAEMIA-DRIVEN in LoDoCo2, and is UNPLANNED AND ISCHAEMIA-DRIVEN in CLEAR "
 214:             "SYNERGY."),
 215: 
 216:         "pools": {
 217:             "name_matched_k3": dict(
 218:                 name_matched,
 219:                 what_it_is="WHAT A NAME-MATCHING REVIEWER PUBLISHES. Computed and reported so "
 220:                            "its cost is measured rather than asserted, exactly as the apixaban "
 221:                            "topics did. IT IS NOT THIS PAGE'S ANSWER.",
 222:                 why_it_is_not_reported_as_the_result="The three primaries differ by a whole "
 223:                            "component and by three qualifiers. Averaging them produces a number "
 224:                            "for a quantity no trial measured."),
 225:             "mi_population_k2": dict(
 226:                 mi_only,
 227:                 what_it_is="COLCOT and CLEAR SYNERGY -- the two whose population is AFTER "
 228:                            "MYOCARDIAL INFARCTION, so the population axis is coherent.",
 229:                 why_it_is_still_not_reported="THE POPULATION MATCHING DOES NOT FIX THE ESTIMAND. "
 230:                            "COLCOT counts resuscitated cardiac arrest and CLEAR SYNERGY does "
 231:                            "not; COLCOT's revascularisation limb requires an urgent "
 232:                            "hospitalisation for angina and CLEAR SYNERGY's requires only that "
 233:                            "the revascularisation be unplanned and ischaemia-driven. A shared "
 234:                            "population is NECESSARY and it is NOT SUFFICIENT -- the same shape "
 235:                            "as P38, one axis down."),
 236:         },
 237: 
 238:         "THE_WITHHOLDING_QUESTION_ASKED_AND_ITS_ANSWER_RECORDED": (
 239:             "Before concluding that nothing pools, the question is put at every rank the sources "
 240:             "reach. LoDoCo2 publishes a KEY SECONDARY -- 'a composite of cardiovascular death, "
 241:             "spontaneous myocardial infarction, or ischemic stroke', HR 0.72 (0.57 to 0.92) -- "
 242:             "which drops revascularisation and is the closest thing to a common estimand in "
 243:             "these three papers. NEITHER COLCOT NOR CLEAR SYNERGY REPORTS THAT COMPOSITE IN ITS "
 244:             "ABSTRACT. COLCOT does publish every component of its own primary separately, and "
 245:             "CLEAR SYNERGY says only that 'the incidence of individual components of the primary "
 246:             "outcome appeared to be similar in the two groups' WITHOUT NUMBERS. "
 247:             "SO THE ANSWER IS NOT 'NOTHING POOLS'. It is that a component-level or "
 248:             "key-secondary-level pool WOULD REQUIRE THE FULL TEXTS, which this pass did not "
 249:             "read. That is OWED WORK, recorded as owed, and it is NOT a negative finding -- an "
 250:             "absence of a reading is not a reading of absence."),
 251: 
 252:         "what_this_file_does_NOT_hold": [
 253:             "Component-level event counts for any trial. COLCOT's component hazard ratios are in "
 254:             "its abstract and are NOT transcribed here, because a component pool needs the same "
 255:             "component from every trial and two of the three do not print one.",
 256:             "Analysis populations, per-protocol sets, or any subgroup.",
 257:             "Any trial without a published primary result. The CORONARY reading holds 42 "
 258:             "ELIGIBLE registrations and THREE published primaries; the other 39 are named in "
 259:             "the screen and contribute nothing here.",
 260:             "LoDoCo2's registration record. It is on ANZCTR, which no search in this session "
 261:             "reached, so its arms and endpoints are read from the publication ALONE.",
 262:         ],
 263:     }
 264:     with io.open(DEST, "w", encoding="utf-8") as fh:
 265:         fh.write(json.dumps(out, indent=1, ensure_ascii=False))
 266: 
 267:     print("COMPONENT SETS -- P37's comparison, made\n")
 268:     for r in ca["by_component"]:
 269:         mark = "ALL THREE" if r["in_all_three"] else " ".join(r["in_trials"])
 270:         print("  %-56s %s" % (r["canonical"], mark))
 271:     print("\n  shared by all three: %s" % ca["shared_by_all_three"])
 272:     print("\nPOOLS COMPUTED AND NOT REPORTED AS THE ANSWER")
 273:     for key in ("name_matched_k3", "mi_population_k2"):
 274:         p = out["pools"][key]
 275:         print("  %-18s k=%d  n=%-6d  HR %.4f (%.4f to %.4f)   tau2 %.4f  Q %.3f df %d  I2 %.1f%%"
 276:               % (key, p["k"], p["n_total"], p["point"], p["ci_low"], p["ci_high"],
 277:                  p["tau2"], p["Q"], p["df"], p["i2"]))
 278:     print("\nwrote %s" % os.path.relpath(DEST, REPO))
 279:     return 0
 280: 
 281: 
 282: def selftest():
 283:     fails = []
 284: 
 285:     def ck(name, got, want):
 286:         ok = got == want
 287:         print("  %-68s %s  %r" % (name, "ok" if ok else "FAIL", got))
 288:         if not ok:
 289:             fails.append(name)
 290: 
 291:     print("1. THE COMPONENT COMPARISON IS BY SET, NOT BY NAME (P37):")
 292:     ca = component_analysis()
 293:     ck("exactly ONE component is shared by all three", ca["shared_by_all_three"], ["cv_death"])
 294:     ck("and the union is larger than any one trial's set", len(ca["union"]), 10)
 295:     ck("resuscitated cardiac arrest is in COLCOT alone",
 296:        [r["in_trials"] for r in ca["by_component"]
 297:         if r["component"] == "resuscitated_cardiac_arrest"], [["COLCOT"]])
 298: 
 299:     print("\n2. THE THREE MI DEFINITIONS ARE THREE DIFFERENT COMPONENTS, not one:")
 300:     mis = [r["component"] for r in ca["by_component"] if "myocardial_infarction" in r["component"]]
 301:     ck("three distinct myocardial-infarction components", len(mis), 3)
 302: 
 303:     print("\n3. THE POOL REPRODUCES ITS OWN INPUTS -- a k=1 'pool' is the trial itself:")
 304:     p1 = pool(["COLCOT"])
 305:     ck("k=1 point is COLCOT's own hazard ratio", round(p1["point"], 4), 0.77)
 306: 
 307:     print("\n4. AND A k=2 POOL LIES INSIDE THE HULL OF ITS TWO TRIALS:")
 308:     p2 = pool(["COLCOT", "CLEAR SYNERGY"])
 309:     ck("0.77 <= pooled <= 0.99", 0.77 <= p2["point"] <= 0.99, True)
 310: 
 311:     print("\n5. EVERY EFFECT ESTIMATE IS ACCOMPANIED BY THE SENTENCE IT WAS READ FROM:")
 312:     for n, t in TRIALS.items():
 313:         ck("%s carries a verbatim effect sentence" % n,
 314:            str(t["hr"]) in t["effect_verbatim"], True)
 315:         ck("%s carries a PMID and a DOI" % n, bool(t["pmid"] and t["doi"]), True)
 316: 
 317:     print("\n6. THE ARITHMETIC OF EACH TRIAL'S OWN ARMS RECONCILES WITH ITS TOTAL:")
 318:     for n, t in TRIALS.items():
 319:         ck("%s: %d + %d == %d" % (n, t["n_treatment"], t["n_control"], t["n_total"]),
 320:            t["n_treatment"] + t["n_control"], t["n_total"])
 321: 
 322:     print("\n%s" % ("SELFTEST FAILED: %s" % fails if fails else "SELFTEST PASSED"))
 323:     return 1 if fails else 0
 324: 
 325: 
 326: if __name__ == "__main__":
 327:     sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
 328:     sys.exit(selftest() if "--selftest" in sys.argv else main())

