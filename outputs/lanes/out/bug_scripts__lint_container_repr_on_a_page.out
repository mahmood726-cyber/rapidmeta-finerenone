"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import re
REPR_IN_TEXT = re.compile(r\"\\{&#x27;|\\{'|&#x27;: &#x27;|': '|\\[\\{|&quot;: &quot;|\\{&quot;\\w+&quot;: \")
STRIP = (re.compile(r\"(?is)<script.*?</script>\"), re.compile(r\"(?is)<style.*?</style>\"), re.compile(r\"(?is)<pre["'^>]*>.*?</pre>"), re.compile(r"(?is)<code[''^>]*>.*?</code>"))
def rendered_text(raw):
    t=raw
    for r in STRIP:
        t=r.sub('"' ', t)
    t=re.sub(r\"<["'^>]+>", '"' ', t)
    return t
cases = [
(\"scalar_list\", \"<p>Outcomes: ['mortality', 'hospitalization']</p>\"),
(\"decimal_entities\", \"<p>{&#39;domain&#39;: &#39;risk_of_bias&#39;}</p>\"),
(\"apos_entities\", \"<p>{&apos;domain&apos;: &apos;risk_of_bias&apos;}</p>\"),
(\"false_positive\", \"<p>The glossary has 'dose': 'not recorded' as a phrase.</p>\"),
]
for name,s in cases:
    print(name, bool(REPR_IN_TEXT.search(rendered_text(s))), REPR_IN_TEXT.search(rendered_text(s)).group(0) if REPR_IN_TEXT.search(rendered_text(s)) else None)
