 306: def main() -> int:
 307:     if not FILE.exists():
 308:         print(f"ERROR: {FILE} not found", file=sys.stderr)
 309:         return 1
 310:     text = FILE.read_text(encoding="utf-8")
 311:     edits = []
 312:     for desc, old, new in [
 313:         ("title", OLD_TITLE, NEW_TITLE),
 314:         ("AUTO_INCLUDE_TRIAL_IDS", OLD_AUTO, NEW_AUTO),
 315:         ("protocol", OLD_PROTO, NEW_PROTO),
 316:         ("nctAcronyms", OLD_ACRO, NEW_ACRO),
 317:     ]:
 318:         if old in text:
 319:             text = text.replace(old, new, 1)
 320:             edits.append(desc)
 321: 
 322:     real_data_marker = "realData: {"
 323:     start = text.find(real_data_marker)
 324:     if start < 0:
 325:         print("ERROR: realData not found", file=sys.stderr)
 326:         return 1
 327:     body_start = text.find("{", start)
 328:     depth = 0
 329:     i = body_start
 330:     while i < len(text):
 331:         c = text[i]
 332:         if c == "{":
 333:             depth += 1
 334:         elif c == "}":
 335:             depth -= 1
 336:             if depth == 0:
 337:                 body_end = i
 338:                 break
 339:         i += 1
 340:     text = text[: body_start] + NEW_REAL_DATA_BODY + text[body_end + 1 :]
 341:     edits.append("realData")
 342: 
 343:     FILE.write_text(text, encoding="utf-8")
 344:     print(f"Edits: {', '.join(edits)}")
 345:     print(f"Size: {FILE.stat().st_size:,} bytes")
 346:     return 0
 347: 
 348: 
 349: if __name__ == "__main__":
 350:     sys.exit(main())

