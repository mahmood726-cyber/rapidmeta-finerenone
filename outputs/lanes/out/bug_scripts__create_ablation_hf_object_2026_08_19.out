        "inputs": {"trials": trials},
        "screening": {
            "eligibility_provenance": {
                "state": "DERIVED_POST_HOC",
                "predefined": False,
                "post_hoc": True,
                "derived": True,
                "predefined_is_false_because": (
                    "These criteria were written on 2026-08-19, when the parent topic was "
