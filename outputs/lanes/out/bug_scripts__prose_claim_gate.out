 307:     d2 = json.loads(json.dumps(base))
 308:     d2["manuscript"] = {"d": "One trial establishes this benefit"}
 309:     cases.append(("'establishes this benefit' against the same interval", d2,
 310:                   FAIL))
 311:     d3 = json.loads(json.dumps(base))
 312:     d3["manuscript"] = {"d": "the pooled interval includes no difference and is "
 313:                              "compatible with no effect"}
