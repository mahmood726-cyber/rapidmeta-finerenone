   1: """Validate the SENTENCES against the object, the way the values already are.
   2: 
   3: The specification is a line from an independent review of this paper:
   4: 
   5:     "Your guard rails are checking the numbers; nothing is checking the
   6:      sentences."
   7: 
   8: Every projected number reconciled against its quoted metafor output. No
   9: arithmetic error was found. And in the same document the Discussion opened
  10: "sacubitril/valsartan reduced the hazard" and the Conclusions ended "One trial
  11: establishes this benefit" -- against a pooled interval containing the null; the
  12: Methods said the search was not reproducible while the executed query strings sat
  13: in the object; and three sections said no comparison with published syntheses was
  14: attempted while that comparison was a major section with three tables.
  15: 
  16: Not one of those is a wrong number. Every one is a wrong sentence, and a numeric
  17: gate cannot see any of them.
  18: 
  19: THREE CLASSES, because these are the three ways a sentence goes wrong here:
  20: 
  21:   DIRECTION   a claim of benefit, reduction or superiority made against an
  22:               interval that includes the null.
  23:   EXISTENCE   a claim that something was not done, or is not recorded, when the
  24:               object contains it.
  25:   COUNT       a claim about how many studies, checked by k_consistency_gate.
  26: 
  27: Usage:
  28:   python prose_claim_gate.py <object.json>
  29:   python prose_claim_gate.py --selftest
  30: """
  31: import io
  32: import json
  33: import os
  34: import re
  35: import sys
  36: 
  37: sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
  38: HERE = os.path.dirname(os.path.abspath(__file__))
  39: sys.path.insert(0, HERE)
  40: from verdict import Verdict, PASS, FAIL, INVALID, summarise  # noqa: E402
  41: 
  42: # Wording that asserts the intervention worked. Hedged forms are deliberately
  43: # NOT here: "may reduce", "is compatible with a reduction" and "favours" state
  44: # a direction without asserting it was established.
  45: DIRECTION = [
  46:     r"\breduced the (?:hazard|risk|rate)\b",
  47:     r"\bestablishes? (?:this|the) benefit\b",
  48:     r"\bwas (?:effective|superior)\b",
  49:     r"\bdemonstrat\w+ (?:a )?(?:benefit|reduction|superiority)\b",
  50:     r"\bconfers? a benefit\b",
  51:     r"\bimproves? (?:survival|outcomes)\b",
  52:     r"\bsignificantly (?:reduced|lowered|improved)\b",
  53: ]
  54: 
  55: # Claims that something is absent. Each carries a probe into the object; if the
  56: # probe finds the thing, the sentence is false.
  57: EXISTENCE = [
  58:     (r"no executed query string is recorded",
  59:      lambda d: any((db.get("query_as_executed") or "").strip()
  60:                    for db in (d.get("search") or {}).get("databases") or []),
  61:      "search.databases[].query_as_executed"),
  62:     (r"not reproducible from this document",
  63:      lambda d: any((db.get("query_as_executed") or "").strip()
  64:                    for db in (d.get("search") or {}).get("databases") or []),
  65:      "search.databases[].query_as_executed"),
  66:     (r"does not attempt a formal comparison with previous syntheses",
  67:      lambda d: bool((d.get("published_comparison") or {}).get("checks")),
  68:      "published_comparison.checks"),
  69:     (r"no per-domain RoB-2 assessment exists",
  70:      lambda d: bool((d.get("rob2") or {}).get("trials")),
  71:      "rob2.trials"),
  72:     (r"no risk-of-bias assessment (?:was|has been) (?:performed|done)",
  73:      lambda d: bool((d.get("rob2") or {}).get("trials")),
  74:      "rob2.trials"),
  75:     (r"identification counts .{0,40}(?:unrecoverable|not recorded)",
  76:      lambda d: any(re.search(r"\d", str(db.get("records_retrieved") or ""))
  77:                    for db in (d.get("search") or {}).get("databases") or []),
  78:      "search.databases[].records_retrieved"),
  79: ]
  80: 
  81: 
  82: def walk(o, p=""):
  83:     if isinstance(o, dict):
  84:         for k, v in o.items():
  85:             yield from walk(v, p + "." + str(k))
  86:     elif isinstance(o, list):
  87:         for i, v in enumerate(o):
  88:             yield from walk(v, p + "[%d]" % i)
  89:     elif isinstance(o, str):
  90:         yield p, o
  91: 
  92: 
  93: # Only this review's own voice. Quoted sources, screening records and the
  94: # correction log all legitimately contain sentences we do not assert.
  95: SKIP = (".screening", ".sources", ".rob2", ".citations", ".claims_corrected",
  96:         ".published_comparison.checks", ".reconciliation", "_corrected",
  97:         ".methodological_authority", "decision_corrected", "quote")
  98: 
  99: 
 100: # ANY `by_outcome.<oid>.` segment, not only the one under `results`.
 101: #
 102: # The first version matched `^results.by_outcome.<oid>.` alone and therefore could not
 103: # attribute a string living at `inputs.trials[0].by_outcome.hfh_cvd_recurrent.
 104: # trial_level_significance` -- which names its outcome perfectly well. It reported that
 105: # claim as unattributable on iv-iron-hf and returned INVALID.
 106: #
 107: # THAT IS THE SAME DEFECT THIS FIX EXISTS TO REMOVE, COMMITTED INSIDE THE FIX: looking in
 108: # ONE place and reporting what is not there as absent. The claim was attributable, to an
 109: # outcome whose interval EXCLUDES the null, so the correct verdict was PASS.
 110: OUTCOME_PATH = re.compile(r"(?:^|\.)by_outcome\.([^.\[]+)\.")
 111: 
 112: 
 113: def _pooled_outcomes(d):
 114:     """Every outcome publishing an interval, keyed by id. Never 'the first one'."""
 115:     out = {}
 116:     for oid, blk in ((d.get("results") or {}).get("by_outcome") or {}).items():
 117:         p = (blk or {}).get("pooled") or {}
 118:         if p.get("ci_low") is not None and p.get("ci_high") is not None:
 119:             out[oid] = p
 120:     return out
 121: 
 122: 
 123: def check(d):
 124:     """Direction claims are matched to THE OUTCOME THEY ARE ABOUT, or refused.
 125: 
 126:     THIS GATE PREVIOUSLY TOOK THE FIRST OUTCOME'S INTERVAL AND JUDGED EVERY SENTENCE ON
 127:     THE OBJECT AGAINST IT:
 128: 
 129:         for res in (...).values():
 130:             pooled = res.get("pooled") or {}
 131:             break
 132: 
 133:     `sglt2-hf` publishes THREE pooled outcomes. A benefit claim about the three-component
 134:     composite was tested against whichever interval dict ordering put first, and passing
 135:     that is a coincidence rather than a check. EVERY PASS THIS GATE EVER ISSUED ON A
 136:     MULTI-OUTCOME OBJECT IS UNEARNED, and its history over that population is UNMEASURED
 137:     rather than clean.
 138: 
 139:     Same family as reading `outcomeMeasures[0]` as the primary: the object declares which
 140:     outcome a sentence is about, in the sentence's own path, and a consumer that cannot
 141:     attribute must REFUSE rather than pick one.
 142: 
 143:     AND IT DOES NOT FALL BACK TO "the only one" WITHOUT VERIFYING THERE IS ONLY ONE. Where
 144:     exactly one outcome publishes an interval, an unattributable claim is judged against it
 145:     and the witness SAYS that the singleness was checked. Where several do, the claim is
 146:     INVALID -- not passed, not failed.
 147:     """
 148:     out = []
 149:     pooled_by_oid = _pooled_outcomes(d)
 150:     if not pooled_by_oid:
 151:         return [Verdict("pooled interval available", INVALID,
 152:                         detail="no pooled interval, so a direction claim cannot "
 153:                                "be judged either way")]
 154: 
 155:     strings = [(p, t) for p, t in walk(d)
 156:                if not any(s in p for s in SKIP)]
 157: 
 158:     # Attribute every direction hit to an outcome, by the PATH it was found at.
 159:     attributed = {}          # oid -> [(path, matched text)]
 160:     unattributed = []
 161:     for p, t in strings:
 162:         for pat in DIRECTION:
 163:             m = re.search(pat, t, re.I)
 164:             if not m:
 165:                 continue
 166:             mo = OUTCOME_PATH.search(p)
 167:             oid = mo.group(1) if mo else None
 168:             if oid in pooled_by_oid:
 169:                 attributed.setdefault(oid, []).append((p, m.group(0)))
 170:             else:
 171:                 unattributed.append((p, m.group(0)))
 172:             break
 173: 
 174:     # A claim that names no outcome is judged only where there is exactly one to name.
 175:     if unattributed:
 176:         if len(pooled_by_oid) == 1:
 177:             only = list(pooled_by_oid)[0]
 178:             attributed.setdefault(only, []).extend(unattributed)
 179:             unattributed = []
 180:             singleton_note = ("attributed to %r because this object publishes exactly one "
 181:                               "pooled interval, which was CHECKED and not assumed" % only)
 182:         else:
 183:             singleton_note = None
 184:             out.append(Verdict(
 185:                 "direction claims are attributable to an outcome", INVALID,
 186:                 detail="%d benefit claim(s) name no outcome, and this object publishes %d "
 187:                        "pooled intervals (%s). A claim that cannot be attributed is NOT "
 188:                        "judged against whichever interval comes first: %s"
 189:                        % (len(unattributed), len(pooled_by_oid),
 190:                           ", ".join(sorted(pooled_by_oid)),
 191:                           "; ".join("%s: %r" % (a.split(".")[-1], b)
 192:                                     for a, b in unattributed[:4]))))
 193:     else:
 194:         singleton_note = None
 195: 
 196:     # Now judge each outcome against ITS OWN interval.
 197:     for oid in sorted(pooled_by_oid):
 198:         p = pooled_by_oid[oid]
 199:         lo, hi = p["ci_low"], p["ci_high"]
 200:         crosses = lo <= 1.0 <= hi
 201:         hits = attributed.get(oid, [])
 202:         label = "direction claims for %s" % oid
 203:         if crosses and hits:
 204:             out.append(Verdict(
 205:                 label, FAIL,
 206:                 detail="pooled %.3f (%.3f to %.3f) INCLUDES 1, but %d claim(s) assert "
 207:                        "benefit: %s%s"
 208:                        % (p.get("point", float("nan")), lo, hi, len(hits),
 209:                           "; ".join("%s: %r" % (a.split(".")[-1], b) for a, b in hits[:4]),
 210:                           "  [%s]" % singleton_note if singleton_note else "")))
 211:         elif crosses:
 212:             out.append(Verdict(
 213:                 label, PASS,
 214:                 witness="pooled %.3f (%.3f to %.3f) includes 1; scanned %d review-voice "
 215:                         "strings against %d benefit patterns and none attributed to this "
 216:                         "outcome matched"
 217:                         % (p.get("point", float("nan")), lo, hi, len(strings),
 218:                            len(DIRECTION)),
 219:                 failure_would_be="a sentence asserting benefit for THIS outcome while its "
 220:                                  "own interval contains no effect"))
 221:         else:
 222:             out.append(Verdict(
 223:                 label, PASS,
 224:                 witness="pooled %.3f (%.3f to %.3f) excludes 1, so a benefit claim about "
 225:                         "this outcome is supported; %d present"
 226:                         % (p.get("point", float("nan")), lo, hi, len(hits)),
 227:                 failure_would_be="n/a while this outcome's interval excludes the null"))
 228:     # EXISTENCE
 229:     for pat, probe, where in EXISTENCE:
 230:         said = [(p, t) for p, t in strings if re.search(pat, t, re.I)]
 231:         if not said:
 232:             continue
 233:         try:
 234:             exists = bool(probe(d))
 235:         except Exception:                                 # noqa: BLE001
 236:             out.append(Verdict("existence claim %r" % pat[:38], INVALID,
 237:                                detail="probe into %s raised" % where))
 238:             continue
 239:         if exists:
 240:             out.append(Verdict("existence claim %r" % pat[:38], FAIL,
 241:                                detail="the paper says this is absent, but %s is "
 242:                                       "populated. Stated at %s"
 243:                                       % (where, said[0][0])))
 244:         else:
 245:             out.append(Verdict("existence claim %r" % pat[:38], PASS,
 246:                                witness="claim made at %s and %s is indeed empty"
 247:                                        % (said[0][0], where),
 248:                                failure_would_be="the object containing what the "
 249:                                                 "sentence says it does not"))
 250:     return out
