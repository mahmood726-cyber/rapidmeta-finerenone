   1: #!/usr/bin/env python3
   2: """THE ESTIMAND SCREEN FOR `dabigatran-vte-review`, on the four readings the P21 decision fixed.
   3: 
   4: WHAT THIS DECIDES AND WHAT IT DOES NOT. It decides, for each reading, whether the trials that
   5: ACTUALLY REPORT share a quantity that could be pooled. It does NOT decide the pool -- no
   6: estimate is computed here and none is written.
   7: 
   8: THE THREE TESTS, each a P-property, applied in order and all three of which must pass:
   9: 
  10:   P37  COMPOSITE NAMES ARE NOT DEFINITIONS. Two endpoints both called a "composite of recurrent
  11:        VTE" are compared on their VERBATIM component list, never on their titles.
  12: 
  13:   P38  A SHARED ESTIMAND IS NOT A SHARED COMPARATOR. Even if two trials measure the identical
  14:        quantity, `dabigatran versus warfarin` and `dabigatran versus placebo` are different
  15:        contrasts. The comparator is read from the registration's own arm labels.
  16: 
  17:   P45  THE CONSTRUCT IS NOT THE MEASURABLE ENDPOINT. "Efficacy" is a construct; a registered
  18:        primary that fuses recurrent thrombosis WITH major bleeding measures neither efficacy nor
  19:        safety and cannot join either.
  20: 
  21: AND ONE FACT ABOUT THE EXISTING OBJECT, which is why this screen was owed. The object's four
  22: trials land in THREE DIFFERENT READINGS and one that is in no reading at all. Its withdrawn
  23: estimate did not have an estimand problem that a better endpoint choice would fix; it pooled
  24: across three different questions.
  25: 
  26: USAGE
  27:     python scripts/estimand_screen_dabigatran_vte_2026_08_19.py
  28:     python scripts/estimand_screen_dabigatran_vte_2026_08_19.py --selftest
  29: """
  30: import io
  31: import json
  32: import os
  33: import sys
  34: 
  35: REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
  36: sys.path.insert(0, os.path.join(REPO, "ssot"))
  37: import ctgov_transport as X                                             # noqa: E402
  38: 
  39: EV = os.path.join(REPO, "evidence", "2026-08-19-batch1")
  40: SCREEN = os.path.join(EV, "dabigatran_vte_screening.json")
  41: OUT = os.path.join(EV, "dabigatran_vte_estimand_screen.json")
  42: 
  43: # The object's own four trials, and which reading each falls in. Fixed here BEFORE the screen
  44: # runs so the claim "three different readings" is asserted, not observed after the fact.
  45: OBJECT_TRIALS = {
  46:     "NCT00329238": "EXTENDED",     # RE-MEDY
  47:     "NCT02913326": "CEREBRAL",     # RE-SPECT CVT
  48:     "NCT00168805": "SURGICAL",     # RE-MODEL -- and it was MISSED by the search
  49:     "NCT01505881": "NOT_A_VTE_TRIAL",   # RE-ALIGN follow-on, mechanical heart valve
  50: }
  51: 
  52: # Comparator families. A label is classified by reading it, never by position in the arm list.
  53: PLACEBO = ("placebo",)
  54: VKA = ("warfarin", "vitamin k antagonist", "acenocoumarol", "coumarin", "vka")
  55: LMWH = ("enoxaparin", "dalteparin", "tinzaparin", "heparin", "fondaparinux")
  56: DOAC = ("rivaroxaban", "apixaban", "edoxaban")
  57: 
  58: 
  59: def comparator_family(label):
  60:     lo = (label or "").lower()
  61:     for fam, terms in (("PLACEBO", PLACEBO), ("VKA", VKA), ("LMWH_OR_HEPARIN", LMWH),
  62:                        ("OTHER_DOAC", DOAC)):
  63:         for t in terms:
  64:             if t in lo:
  65:                 return fam
  66:     return "UNCLASSIFIED"
  67: 
  68: 
  69: def read_registration(nct):
  70:     """Registered primary VERBATIM, arm labels, enrolment. Never a title-only read (P35)."""
  71:     st, s, detail = X.fetch_raw(nct, fields="protocolSection")
  72:     if st != X.OK:
  73:         return {"nct": nct, "state": "UNREACHABLE", "why": str(detail)[:160]}
  74:     ps = s.get("protocolSection") or {}
  75:     idm = ps.get("identificationModule") or {}
  76:     prim = ((ps.get("outcomesModule") or {}).get("primaryOutcomes") or [])
  77:     arms = ((ps.get("armsInterventionsModule") or {}).get("armGroups") or [])
  78:     des = (ps.get("designModule") or {})
  79:     labels = [a.get("label") or "" for a in arms]
  80:     fams = sorted({comparator_family(l) for l in labels} - {"UNCLASSIFIED"})
  81:     return {
  82:         "nct": nct, "state": "READ",
  83:         "acronym": idm.get("acronym"),
  84:         "brief_title": (idm.get("briefTitle") or "")[:150],
  85:         "enrollment": ((des.get("enrollmentInfo") or {}).get("count")),
  86:         "arm_labels_as_the_registry_lists_them": labels,
  87:         "comparator_families_present": fams,
  88:         "registered_primary_title": (prim[0].get("measure") if prim else None),
  89:         "registered_primary_description_verbatim": (
  90:             (prim[0].get("description") or "")[:900] if prim else None),
  91:         "registered_primary_time_frame": (prim[0].get("timeFrame") if prim else None),
  92:         "n_registered_primaries": len(prim),
  93:         "all_registered_primary_titles": [p.get("measure") for p in prim],
  94:         "read_utc": "2026-08-19",
  95:         "source_field": "protocolSection.outcomesModule.primaryOutcomes[0]",
  96:         "source_url": "https://clinicaltrials.gov/study/%s" % nct,
  97:     }
  98: 
  99: 
 100: # --- the three tests -------------------------------------------------------------------------
 101: 
 102: BLEED = ("bleed", "haemorrhag", "hemorrhag")
 103: # `vte` is here because leaving the bare abbreviation out is a recall gap in my OWN term set --
 104: # RE-COVER's description says "recurrent VTEs" and nothing else thrombotic, so without it the
 105: # description read as mentioning bleeding alone and the trial was passed silently instead of
 106: # flagged. Substring risk is nil: no English or medical word contains the sequence `vte`.
 107: THROMB = ("thromboem", "thrombosis", "thrombotic", "deep vein", "pulmonary embol", " dvt",
 108:           " pe ", "vte")
 109: 
 110: 
 111: def fuses_efficacy_and_safety(row):
 112:     """P45. A primary that names BOTH a thrombotic component and a bleeding component AS
 113:     COMPONENTS measures neither construct and can join neither.
 114: 
 115:     THE FIRST VERSION OF THIS FUNCTION MANUFACTURED TWO FALSE FINDINGS, and the fix is the
 116:     lesson. It scanned title AND description as one bag of words. RE-COVER I and RE-COVER II
 117:     register the purely efficacy primary "Recurrent Symptomatic VTE and Deaths Related to VTE",
 118:     and the word `bleeding` appears in their description ONLY here:
 119: 
 120:         "All suspected recurrent VTEs and all deaths and bleeding events were evaluated by an
 121:          independent central adjudication committee"
 122: 
 123:     That sentence says what the COMMITTEE ADJUDICATED. It does not declare a component of the
 124:     endpoint. Two of the three P45 firings in the first live run were this sentence, and a check
 125:     that invents failures is worse than no check.
 126: 
 127:     THE RULE NOW: THE TITLE ESTABLISHES, THE DESCRIPTION ONLY CONFIRMS. An endpoint that fuses
 128:     two constructs is NAMED that way by the registry -- NCT02913326 registers "Composite of
 129:     Venous Thrombotic Event (VTE) **or** Major Bleeding Event (MBE)". That is P35 one level
 130:     down: read the thing itself, do not infer it from adjacent text. Where the description
 131:     suggests fusion the title does not carry, the answer is NEEDS_HUMAN_READ -- which is neither
 132:     a pass nor a failure.
 133:     """
 134:     title = (row.get("registered_primary_title") or "").lower()
 135:     desc = (row.get("registered_primary_description_verbatim") or "").lower()
 136:     tb, tt = any(t in title for t in BLEED), any(t in title for t in THROMB)
 137:     db, dt = any(t in desc for t in BLEED), any(t in desc for t in THROMB)
 138:     detail = {"title_names_a_bleeding_component": tb,
 139:               "title_names_a_thrombotic_component": tt,
 140:               "description_mentions_bleeding": db,
 141:               "description_mentions_thrombosis": dt,
 142:               "established_by": None}
 143:     if tb and tt:
 144:         detail["established_by"] = "THE REGISTERED TITLE ITSELF"
 145:         return True, detail
 146:     if db and dt:
 147:         detail["established_by"] = "NOT_ESTABLISHED -- the description mentions both but the " \
 148:             "registered TITLE does not fuse them. A mention is not a component declaration " \
 149:             "(the RE-COVER adjudication sentence is the case this rule exists for). " \
 150:             "NEEDS_HUMAN_READ, which is neither a pass nor a failure."
 151:         detail["needs_human_read"] = True
 152:     return False, detail
 153: 
 154: 
 155: def assess_reading(name, rows):
 156:     """Returns a verdict for one reading. NEVER a pool -- only whether one is admissible."""
 157:     read = [r for r in rows if r["state"] == "READ"]
 158:     if len(read) < 2:
 159:         return {"reading": name, "verdict": "NOT_ASSESSABLE",
 160:                 "why": ("Fewer than two registrations could be read (%d of %d). Absent is not "
 161:                         "zero and not a failure; it is unassessed." % (len(read), len(rows))),
 162:                 "trials": rows}
 163: 
 164:     judged = {r["nct"]: fuses_efficacy_and_safety(r) for r in read}
 165:     fused = [(n, d) for n, (ok, d) in judged.items() if ok]
 166:     needs_read = {n: d for n, (ok, d) in judged.items()
 167:                   if not ok and d.get("needs_human_read")}
 168:     fams = {}
 169:     for r in read:
 170:         for f in r["comparator_families_present"]:
 171:             fams.setdefault(f, []).append(r["nct"])
 172:     titles = {r["nct"]: r["registered_primary_title"] for r in read}
 173:     distinct_titles = len({(t or "").strip().lower() for t in titles.values()})
 174: 
 175:     fails = []
 176:     if fused:
 177:         fails.append({
 178:             "property": "P45",
 179:             "finding": ("%d trial(s) register a primary that fuses a THROMBOTIC and a BLEEDING "
 180:                         "component in one endpoint. That measures neither efficacy nor safety, "
 181:                         "so it cannot join either." % len(fused)),
 182:             "trials": [n for n, _ in fused],
 183:             "detail": {n: d for n, d in fused},
 184:         })
 185:     if len(fams) > 1:
 186:         fails.append({
 187:             "property": "P38",
 188:             "finding": ("The reading holds %d DIFFERENT COMPARATOR FAMILIES: %s. A shared "
 189:                         "estimand would not make these poolable -- the contrast differs, not "
 190:                         "just the measurement." % (len(fams), ", ".join(sorted(fams)))),
 191:             "families": fams,
 192:         })
 193:     if distinct_titles > 1:
 194:         fails.append({
 195:             "property": "P37",
 196:             "finding": ("%d DISTINCT registered-primary titles across %d trials. Compared on "
 197:                         "their verbatim text, not on the word 'composite'."
 198:                         % (distinct_titles, len(read))),
 199:             "titles": titles,
 200:         })
 201: 
 202:     # A READING THAT DOES NOT POOL WHOLE MAY STILL HOLD A POOLABLE SUBSET, and refusing the
 203:     # reading without naming that subset would hide it. Restriction is by ONE NAMED AXIS at a
 204:     # time -- the comparator family -- and the subset is reported, never pooled here.
 205:     subsets = []
 206:     for fam, ncts in sorted(fams.items()):
 207:         members = [r for r in read if fam in r["comparator_families_present"]
 208:                    and r["nct"] not in dict(fused)]
 209:         if len(members) < 2:
 210:             continue
 211:         tt = {}
 212:         for r in members:
 213:             tt.setdefault((r["registered_primary_title"] or "").strip().lower(), []).append(
 214:                 r["nct"])
 215:         biggest = max(tt.values(), key=len)
 216:         by_nct = {r["nct"]: r for r in read}
 217:         reported = [n for n in biggest
 218:                     if by_nct.get(n, {}).get("disposition") == "ELIGIBLE_WITH_RESULTS"]
 219:         subsets.append({
 220:             "restricted_on": "comparator family = %s" % fam,
 221:             "k_sharing_the_comparator": len(members),
 222:             "members": sorted(r["nct"] for r in members),
 223:             "k_ALSO_sharing_one_registered_primary_title": len(biggest),
 224:             "those_members": sorted(biggest),
 225:             # THIS FIELD IS THE ONE THAT MATTERS. A subset of trials that have not reported is
 226:             # not a pool of k=2, it is a pool of k=0 -- and a subset line without it would read
 227:             # as though something were poolable when nothing has been published.
 228:             "k_of_those_WITH_POSTED_RESULTS": len(reported),
 229:             "the_ones_that_have_reported": sorted(reported),
 230:             "the_shared_title": [t for t, v in tt.items() if v is biggest][0][:160],
 231:             "status": ("A NAMED-AXIS SUBSET, reported not pooled. Sharing a comparator and a "
 232:                        "title is necessary, not sufficient -- the components still have to be "
 233:                        "read, and no estimate is computed here."),
 234:             "caveat_on_the_title_grouping": (
 235:                 "Titles are grouped by EXACT text, so this count is a LOWER BOUND. NCT00168818 "
 236:                 "registers 'Total Venous Thromboembolic Event and All-cause Mortality During "
 237:                 "Treatment Period' while NCT00152971 and NCT00657150 register the same words "
 238:                 "prefixed 'Number of Participants With'. Loosening the match would be comparing "
 239:                 "endpoints on their titles, which is the exact error P37 names -- so the "
 240:                 "grouping stays exact and the components are read by a human instead."),
 241:         })
 242: 
 243:     return {
 244:         "reading": name,
 245:         "n_trials_read": len(read),
 246:         "verdict": "POOL_NOT_ADMISSIBLE" if fails else "NO_BARRIER_FOUND_BY_THESE_THREE_TESTS",
 247:         "failing_limbs": fails,
 248:         "endpoints_needing_a_human_read": needs_read,
 249:         "restricted_subsets_that_survive_the_named_axis": subsets,
 250:         "all_failing_limbs_reported": True,
 251:         "note_if_clean": (None if fails else
 252:                           "These three tests found no barrier. That is NOT a finding that the "
 253:                           "trials pool: other properties have not been applied and no estimate "
 254:                           "is computed here."),
 255:         "trials": read,
 256:     }
 257: 
 258: 
 259: def run():
 260:     with io.open(SCREEN, "r", encoding="utf-8") as fh:
 261:         scr = json.load(fh)
 262: 
 263:     want = {}
 264:     for r in scr["rows"]:
 265:         if r["reading"] != "NONE" and str(r["disposition"]).startswith("ELIGIBLE"):
 266:             want.setdefault(r["reading"], []).append(r["nct"])
 267: 
 268:     out = {"topic": "dabigatran-vte-review", "screened_utc": "2026-08-19",
 269:            "what_this_decides": ("Whether each reading holds a poolable quantity. It does NOT "
 270:                                  "compute a pool and does not write one."),
 271:            "tests": ["P37 composite names are not definitions",
 272:                      "P38 a shared estimand is not a shared comparator",
 273:                      "P45 the construct is not the measurable endpoint"],
 274:            "readings": {}}
 275: 
 276:     disp = {r["nct"]: r["disposition"] for r in scr["rows"]}
 277:     for name in ("TREATMENT", "EXTENDED", "SURGICAL", "CEREBRAL"):
 278:         rows = []
 279:         for n in sorted(want.get(name, [])):
 280:             r = read_registration(n)
 281:             r["disposition"] = disp.get(n)
 282:             rows.append(r)
 283:         v = assess_reading(name, rows)
 284:         out["readings"][name] = v
 285:         print("\n== %-10s %d eligible read   ->  %s" % (name, v.get("n_trials_read", 0),
 286:                                                         v["verdict"]))
 287:         for r in [x for x in rows if x["state"] == "READ"]:
 288:             print("   %-12s %-14s n=%-7s %s"
 289:                   % (r["nct"], (r["acronym"] or "-")[:14], r["enrollment"],
