THE MODULE UNDER REVIEW: scripts/lint_refusal_contradicted_by_its_own_section.py

--- THE FILE, IN FULL ---
#!/usr/bin/env python3
"""A REFUSAL CONTRADICTED BY THE CONTENT BENEATH IT -- the detector, and the repair.

THE DEFECT. Three delivered pages open their search tab with:

    "Not held in this object. No search record is held in this object. The included set was
     reconciled against published syntheses rather than produced by a database search, so no
     query, date or yield can be shown. Treat the included set as a convenience sample, not a
     systematic one."

and then, in the same section, print the executed query, its date and its yield. The denial came
first, so a reader who stops at the first paragraph is told the review is a convenience sample
when its object holds a two-database executed search screened to zero.

  `colchicine-cvd-coronary` IS ONE OF THEM AND IT WAS BUILT TODAY, from a search I ran across
  137 registrations. The stale refusal was never removed when the search was added.

THE DISTINCTION THE CORPUS DID NOT HAVE. "Not held in this object" is a REFUSAL when true and a
GAP when false, and it reads identically either way. A third state was missing: HELD ELSEWHERE
AND NOT PROJECTED. This lint does not try to detect that third state from outside -- it detects
the sharpest and least arguable case, where THE SECTION'S OWN BYTES REFUTE ITS OWN OPENING
SENTENCE.

  DELIBERATELY NARROW. A wider rule would flag `pn-report`, whose denial ("no GRADE assessment
  is held, so certainty has not been rated") is followed by a summary-of-findings table with the
  certainty column rendered as an em dash. THAT IS HONEST: the refusal is about GRADE and the
  table says so in the cell. 38 sections have a denial followed by substantial content and only
  3 are contradictions. A rule that flagged all 38 would be the arbitrary-selection class again,
  and would train a reader to ignore it.

THE REPAIR removes ONLY the denial paragraph, byte for byte, and leaves everything else
untouched. The file must shrink by exactly the length of the removed text and by nothing else.

USAGE
    python scripts/lint_refusal_contradicted_by_its_own_section.py          # detect, exit 1 if any
    python scripts/lint_refusal_contradicted_by_its_own_section.py --repair
"""
import glob
import io
import json
import os
import re
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# (the denial's claim, the proof it is false)
CONTRADICTIONS = [
    {"section": "pn-search",
     "denial_claims": "no query, date or yield can be shown",
     "refuted_by": "query as executed",
     "why": "the section prints the executed query immediately below the sentence denying it"},
]

# THE EXACT MARKUP, read from a page rather than guessed. The first version looked for a <p>
# wrapper and matched nothing, so the repair REFUSED on every page -- which is the correct
# behaviour for a locator that cannot locate, and is why nothing was removed by approximation.
DENIAL = re.compile(
    r'<div class="absent-state" role="note"><strong>Not held in this object\.</strong>'
    r'[^<]{0,600}?not a systematic one\.</div>\s*', re.S)


def sec(html, sid):
    m = re.search(r'<section[^>]*id="%s".*?</section>' % sid, html, re.S)
    return m


def _yield_table_is_empty(block):
    """True when the panel prints a query but its results table has no rows."""
    for m in re.finditer(r"<table>(.*?)</table>", block, re.S):
        body = re.sub(r"<caption>.*?</caption>", "", m.group(1), flags=re.S)
        if re.search(r"<t[rdh][\s>]", body):
            return False
    return True


def scan():
    out = []
    for p in sorted(glob.glob(os.path.join(REPO, "*_REVIEW.html"))):
        try:
            with io.open(p, "rb") as fh:
                html = fh.read().decode("utf-8", "replace")
        except Exception:
            continue
        for c in CONTRADICTIONS:
            m = sec(html, c["section"])
            if not m:
                continue
            block = m.group(0)
            txt = re.sub(r"\s+", " ", re.sub("<[^>]+>", " ", block)).lower()
            # AND THE YIELD MUST ACTUALLY BE SHOWN. Firing on a panel that prints a query above
            # an EMPTY yield table demands a removal that leaves the panel unexplained -- the
            # regression check catches that instantly as `ssot_empty_panel`, so this lint and
            # that gate would contradict each other on seven pages. THE DENIAL'S CLAIM ABOUT THE
            # YIELD IS TRUE THERE; only its claim about the query is false, and a wording fix
            # belongs in the builder, not in a page patch. Those panels are PARTIALLY HELD and
            # are recorded as owed rather than forced through by a lint that cannot see the
            # difference.
            if _yield_table_is_empty(block):
                continue
            if c["denial_claims"] in txt and c["refuted_by"] in txt:
                out.append({"page": os.path.basename(p), "section": c["section"],
                            "why": c["why"]})
    return out


def repair(hits):
    fixed, refused = [], []
    for h in hits:
        p = os.path.join(REPO, h["page"])
        with io.open(p, "rb") as fh:
            raw = fh.read()
        html = raw.decode("utf-8", "replace")
        m = sec(html, h["section"])
        block = m.group(0)
        d = DENIAL.search(block)
        if not d:
            refused.append(dict(h, why="the denial paragraph could not be located exactly; "
                                       "NOT removed by approximation"))
            continue
        removed = d.group(0)
        # BYTE-LEVEL. Never decode-and-rewrite a page; the banner pass destroyed 466KB that way.
        rb = removed.encode("utf-8")
        if raw.count(rb) != 1:
            refused.append(dict(h, why="the denial paragraph appears %d times in the file; "
                                       "refusing an ambiguous removal" % raw.count(rb)))
            continue
        new = raw.replace(rb, b"")
        if len(raw) - len(new) != len(rb):
            refused.append(dict(h, why="removal changed the file by an unexpected amount"))
            continue
        with io.open(p, "wb") as fh:
            fh.write(new)
        with io.open(p, "rb") as fh:
            back = fh.read()
        if back != new:
            with io.open(p, "wb") as fh:
                fh.write(raw)
            refused.append(dict(h, why="post-write byte check failed; REVERTED"))
            continue
        fixed.append(dict(h, bytes_removed=len(rb),
                          removed_text=re.sub(r"\s+", " ",
                                              re.sub("<[^>]+>", " ", removed)).strip()[:200]))
    return fixed, refused


def run(do_repair):
    hits = scan()
    print("sections whose own content refutes their opening refusal: %d" % len(hits))
    for h in hits:
        print("   %-40s %-12s %s" % (h["page"][:40], h["section"], h["why"]))
    if not hits:
        print("OK -- no page denies something it then prints.")
        return 0
    if not do_repair:
        print("\nNot a pass. Re-run with --repair to remove the contradicted denial only.")
        return 1
    fixed, refused = repair(hits)
    print("\n  repaired %d, refused %d" % (len(fixed), len(refused)))
    for f in fixed:
        print("     %-40s -%d bytes" % (f["page"][:40], f["bytes_removed"]))
    for r in refused:
        print("     REFUSED %-34s %s" % (r["page"][:34], r["why"]))
    with io.open(os.path.join(REPO, "evidence", "2026-08-19-batch1",
                              "contradicted_refusals.json"), "w",
                 encoding="utf-8", newline="") as fh:
        fh.write(json.dumps({"run_utc": "2026-08-19", "fixed": fixed, "refused": refused,
                             "rule": CONTRADICTIONS,
                             "deliberately_narrow": (
                                 "38 sections carry a denial followed by substantial content; "
                                 "only 3 are contradictions. pn-report denies a GRADE rating and "
                                 "then shows a summary-of-findings table whose certainty column "
                                 "is an em dash -- that is honest. A rule flagging all 38 would "
                                 "train a reader to ignore it.")},
                            indent=1, ensure_ascii=False))
    return 1 if refused else 0


if __name__ == "__main__":
    sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
    sys.exit(run("--repair" in sys.argv))

