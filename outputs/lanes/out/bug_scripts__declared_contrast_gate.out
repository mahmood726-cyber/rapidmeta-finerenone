 200:     print("NOTE ON THE BERSON ROW: it returns UNCHECKABLE rather than FAIL, and that is "
 201:           "correct and worth keeping. Its stored labels ('Atorvastatin (Q2W)') are the "
 202:           "PROTOCOL arm titles while the registry's RESULTS groups are named 'Placebo Q2W', "
 203:           "so the two cannot be matched. The gate refuses rather than guessing -- and a "
 204:           "reader is told the row could not be cleared, which is the honest state.")
 205:     print("-> SELFTEST PASS" if ok else "-> SELFTEST FAILED")
 206:     return 0 if ok else 1
 207: 
 208: 
 209: def fetch_into(path):
 210:     import urllib.request
 211:     obj = json.load(open(path, encoding="utf-8"))
 212:     n = 0
 213:     for t in (obj.get("inputs") or {}).get("trials") or []:
 214:         nct = (t.get("nct") or "").upper()
 215:         if not nct.startswith("NCT"):
 216:             continue
 217:         url = ("https://clinicaltrials.gov/api/v2/studies/%s?fields="
 218:                "protocolSection.armsInterventionsModule,resultsSection" % nct)
 219:         req = urllib.request.Request(url, headers={"User-Agent": "rapidmeta-registry-read"})
 220:         with urllib.request.urlopen(req, timeout=90) as r:
 221:             d = json.loads(r.read().decode("utf-8"))
 222:         ps = d.get("protocolSection") or {}
 223:         arms = ((ps.get("armsInterventionsModule") or {}).get("armGroups") or [])
 224:         t["registration_arm_count"] = len(arms)
 225:         decl, seen = [], set()
 226:         om = ((d.get("resultsSection") or {}).get("outcomeMeasuresModule") or {})
 227:         for o in om.get("outcomeMeasures", []):
 228:             gm = {g.get("id"): g.get("title") for g in (o.get("groups") or [])}
 229:             for a in (o.get("analyses") or []):
 230:                 gids = a.get("groupIds") or []
 231:                 if len(gids) != 2:
 232:                     continue
 233:                 pair = tuple(sorted(gm.get(g, "") for g in gids))
 234:                 if all(pair) and pair not in seen:
 235:                     seen.add(pair)
 236:                     decl.append(list(pair))
 237:         if decl:
 238:             t["registration_declared_contrasts"] = decl
 239:         t["registration_contrasts_read_utc"] = "2026-08-18"
 240:         n += 1
 241:     json.dump(obj, open(path, "w", encoding="utf-8"), ensure_ascii=False, indent=1)
 242:     print("read declared contrasts for %d trial(s) in %s" % (n, os.path.basename(path)))
 243:     return 0
 244: 
 245: 
 246: def main() -> int:
 247:     if len(sys.argv) < 2 or sys.argv[1] == "--selftest":
 248:         return selftest()
 249:     if sys.argv[1] == "--fetch":
 250:         rc = 0
 251:         for p in sys.argv[2:]:
 252:             rc |= fetch_into(p)
 253:         return rc
 254:     worst = 0
 255:     for p in sys.argv[1:]:
 256:         if not os.path.exists(p):
 257:             print("declared_contrast: %s does not exist. NOT RUN." % p, file=sys.stderr)
 258:             worst = max(worst, 2)
 259:             continue
 260:         v, notes = check(json.load(open(p, encoding="utf-8")))
 261:         print(os.path.basename(p))
 262:         for n in notes:
 263:             print(n)
 264:         print("  -> %s" % v)
 265:         worst = max(worst, {"NOT_APPLICABLE": 0, "PASS": 0, "UNCHECKABLE": 2,
 266:                             "FAIL": 1}.get(v, 2))
 267:     return worst
 268: 
 269: 
 270: if __name__ == "__main__":
 271:     sys.exit(main())

codex
Defects found:

- **STATUS CODE REPORTING THE WRAPPER** — line 247.  
  Exact input: `python scripts/declared_contrast_gate.py` with no object paths.  
  Consequence: it runs `selftest()` and can exit 0 while checking no object at all.

- **CHECK CANNOT FAIL / EMPTY WORKSET PASSES** — lines 249-253.  
  Exact input: `python scripts/declared_contrast_gate.py --fetch` with no paths.  
  Consequence: the refresh step returns 0 after processing zero files, so a missing target list is reported as success.

- **ZERO / OFF-BY-ONE COUNT CONFLATED WITH TWO-ARM NOT-APPLICABLE** — line 82.  
  Exact input:
  ```json
  {"inputs":{"trials":[{"name":"Z","nct":"NCT0","arms":[{"role":"treatment","label":"A"},{"role":"control","label":"B"}],"registration_arm_count":0,"registration_declared_contrasts":null}]}}
  ```
  Consequence: an impossible or failed arm count is reported as `NOT_APPLICABLE` with exit 0 instead of `UNCHECKABLE`.

- **SELECTOR OVER-NORMALIZES DISTINCT DOSES** — lines 67 and 98.  
  Exact input to `assess`:
  ```json
  {"name":"Dose","nct":"NCT1","arms":[{"role":"treatment","label":"Drug 1.0 mg"},{"role":"control","label":"Placebo"}],"registration_arm_count":3,"registration_declared_contrasts":[["Drug 10 mg","Placebo"]]}
  ```
  Consequence: `Drug 1.0 mg` and `Drug 10 mg` both normalize to `drug10mg`, so an undeclared dose contrast returns `PASS`.

- **DIFFERENT COPY / STALE FIELD SURVIVES FETCH** — line 237.  
  Exact input state: a file already containing `"registration_declared_contrasts":[["A","B"]]`, plus a fetched study response with three `armGroups` and no `outcomeMeasures`.  
  Consequence: `--fetch` updates `registration_arm_count` but leaves the old declared contrasts in place, allowing later checks to read stale declarations.

