 188:         good = v == want
 189:         ok &= good
 190:         print("  %-64s -> %-15s (want %-15s) %s"
 191:               % (label[:64], v, want, "correct" if good else "WRONG"))
 192:         if not good:
 193:             print("        " + why[:160])
 194: 
 195:     print("\nWHAT A FAILURE WOULD LOOK LIKE: the Hua Tuo founding row passing. It compares "
 196:           "a FORTNIGHTLY placebo arm against a MONTHLY drug arm on a 2x2 trial that only "
 197:           "ever compared like with like, and it produced -70.8 -- a number that is neither "
 198:           "registered comparison and not the difference between any two of the four arm "
