 206:                if ((json.loads(open(p, encoding="utf-8", errors="replace").read())
 207:                     .get("canonical") or {}).get("result") or {}).get("reported", {}).get("logEffect") is not None)
 208:     print(f"L2 pooled-on-unverifiable-inputs: {len(_r)}/{_all} pooled objects "
 209:           f"have >=1 contributing trial with NO arm counts")
 210:     _full = [x for x in _r if x[1] == x[2]]
 211:     print(f"   of which {len(_full)} have NO counts on ANY contributing trial "
 212:           f"(the pooled value rests on nothing extractable)")
 213:     for pg, noc, n, k in sorted(_r, key=lambda x: -x[1])[:25]:
 214:         print(f"     {pg[:50]:50s} {noc}/{n} trials without counts (reported k={k})")

