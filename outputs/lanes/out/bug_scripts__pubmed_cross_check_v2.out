  82:     "CRYPTOCOCCAL_MENINGITIS": {"cryptococcal", "amphotericin", "flucytosine", "fluconazole", "ambisome"},
  83:     "PREGNANCY_HIV": {"pregnancy", "hiv", "dolutegravir", "efavirenz"},
  84: }
  85: 
  86: 
  87: def derive_topic_keywords(filename: str) -> set[str]:
  88:     """Match filename against TOPIC_KEYWORDS and union all matched keyword sets."""
  89:     name_upper = filename.upper().replace("_REVIEW.HTML", "")
  90:     out = set()
  91:     for substr, kws in TOPIC_KEYWORDS.items():
  92:         if substr in name_upper:
  93:             out.update(kws)
  94:     return out
  95: 
  96: 
  97: def title_mentions_topic(title: str, keywords: set[str]) -> bool:
  98:     title_lower = title.lower()
  99:     return any(kw.lower() in title_lower for kw in keywords)
 100: 
 101: 
 102: def main():
 103:     # Reuse PMID data from prior run via the v1 CSV
 104:     if not PRIOR_CSV.exists():
 105:         print(f"Prior CSV missing: {PRIOR_CSV}")
 106:         return
 107:     rows = list(csv.DictReader(PRIOR_CSV.open(encoding="utf-8")))
 108:     print(f"Loaded {len(rows)} prior findings from v1 CSV")
 109: 
 110:     out_rows = []
 111:     for r in rows:
 112:         verdict = r["verdict"]
 113:         if verdict == "OK":
 114:             out_rows.append({**r, "v2_verdict": "OK", "topic_match": "", "v2_notes": ""})
 115:             continue
 116:         if "PMID_NOT_FOUND" in verdict:
 117:             out_rows.append({**r, "v2_verdict": "PMID_NOT_FOUND", "topic_match": "", "v2_notes": "PMID not in PubMed"})
 118:             continue
 119: 
 120:         # For TRIAL_PMID_MISALIGNED + YEAR_MISMATCH: refine using topic-area keyword
 121:         topic_kws = derive_topic_keywords(r["file"])
 122:         title = r["pubmed_title"]
 123:         topic_ok = title_mentions_topic(title, topic_kws)
 124: 
 125:         v2_verdict = "OK"
 126:         notes = []
 127:         if "YEAR_MISMATCH" in verdict:
 128:             try:
 129:                 yd = int(r["year_diff"])
 130:                 if abs(yd) > 1:
 131:                     v2_verdict = "YEAR_MISMATCH"
 132:                     notes.append(f"year diff {yd}")
 133:             except (ValueError, TypeError):
 134:                 pass
 135:         if "TRIAL_PMID_MISALIGNED" in verdict and not topic_ok:
 136:             # Truly off-topic â€” likely wrong PMID
 137:             v2_verdict = "WRONG_PMID" if v2_verdict == "OK" else v2_verdict + "+WRONG_PMID"
 138:             notes.append(f"PubMed title doesn't mention any of: {sorted(topic_kws)[:5]}")
 139: 
 140:         out_rows.append({
 141:             **r,
 142:             "v2_verdict": v2_verdict,
 143:             "topic_match": "YES" if topic_ok else "NO",
 144:             "v2_notes": "; ".join(notes),
 145:         })
 146: 
 147:     OUT_CSV.parent.mkdir(parents=True, exist_ok=True)
 148:     with OUT_CSV.open("w", newline="", encoding="utf-8") as f:
 149:         w = csv.DictWriter(f, fieldnames=list(out_rows[0].keys()))
 150:         w.writeheader()
 151:         w.writerows(out_rows)
 152: 
 153:     by_v2: dict[str, int] = {}
 154:     for r in out_rows:
 155:         by_v2[r["v2_verdict"]] = by_v2.get(r["v2_verdict"], 0) + 1
 156:     print(f"\n=== v2 verdict counts (n={len(out_rows)}) ===")
 157:     for k in sorted(by_v2.keys()):
 158:         print(f"  {k:30s} {by_v2[k]}")
 159: 
 160:     real = [r for r in out_rows if r["v2_verdict"] not in ("OK",)]
 161:     print(f"\n=== {len(real)} real defects ===\n")
 162:     for r in real:
 163:         print(f"  [{r['v2_verdict']:30s}] {r['file']:50s} {r['key']:18s} pmid={r['pmid']}")
 164:         print(f"     claim: {r['claim_name'][:50]:50s} year={r['claim_year']}")
 165:         print(f"     pubmed: {r['pubmed_title'][:80]}")
 166:         print(f"     {r['v2_notes']}")
 167:         print()
 168: 
 169: 
 170: if __name__ == "__main__":
 171:     main()

