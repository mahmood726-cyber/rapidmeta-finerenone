  98: def normalize_tokens(s: str) -> set[str]:
  99:     if not s:
 100:         return set()
 101:     raw = re.split(r"[^a-z0-9]+", s.lower())
 102:     return {t for t in raw if len(t) >= 3 and t not in STOPWORDS}
 103: 
 104: 
 105: def load_aact_studies() -> dict[str, dict]:
 106:     db = {}
 107:     studies_path = AACT_DIR / "studies.txt"
 108:     with studies_path.open(encoding="utf-8", errors="replace") as f:
 109:         next(f)
 110:         for line in f:
 111:             cols = line.rstrip("\n").split("|")
 112:             if len(cols) <= COL_ENROLLMENT:
 113:                 continue
 114:             nct = cols[COL_NCT].strip()
 115:             if not nct.startswith("NCT"):
 116:                 continue
 117:             try:
 118:                 enroll = int(cols[COL_ENROLLMENT]) if cols[COL_ENROLLMENT].strip() else None
 119:             except ValueError:
 120:                 enroll = None
 121:             db[nct] = {
 122:                 "brief_title": cols[COL_BRIEF_TITLE],
 123:                 "official_title": cols[COL_OFFICIAL_TITLE],
 124:                 "phase": cols[COL_PHASE],
 125:                 "enrollment": enroll,
 126:             }
 127:     return db
 128: 
 129: 
 130: def load_aact_brief_summaries() -> dict[str, str]:
 131:     db: dict[str, str] = {}
 132:     path = AACT_DIR / "brief_summaries.txt"
 133:     with path.open(encoding="utf-8", errors="replace") as f:
 134:         next(f)
 135:         for line in f:
 136:             cols = line.rstrip("\n").split("|", 3)
 137:             if len(cols) < 3:
 138:                 continue
 139:             nct = cols[1].strip()
 140:             description = cols[2] if len(cols) > 2 else ""
 141:             if nct.startswith("NCT"):
 142:                 db[nct] = description
 143:     return db
 144: 
 145: 
 146: def load_aact_facility_countries() -> dict[str, set[str]]:
 147:     """Per-NCT set of countries from facilities.txt column 8."""
 148:     db: dict[str, set[str]] = {}
 149:     path = AACT_DIR / "facilities.txt"
 150:     with path.open(encoding="utf-8", errors="replace") as f:
 151:         next(f)
 152:         for line in f:
 153:             cols = line.rstrip("\n").split("|")
 154:             if len(cols) < 8:
 155:                 continue
 156:             nct = cols[1].strip()
 157:             country = cols[7].strip()
 158:             if not nct.startswith("NCT") or not country:
 159:                 continue
 160:             db.setdefault(nct, set()).add(country)
 161:     return db
 162: 
 163: 
 164: # Same regex as v1
 165: NCT_BLOCK_RE = re.compile(
 166:     r"'(NCT\d+(?:_[A-Za-z0-9]+)?|LEGACY-[A-Za-z0-9-]+)'\s*:\s*\{[^}]*?"
 167:     r"name:\s*'([^']+?)'[^}]*?"
 168:     r"tN:\s*(\d+)\s*,\s*cE:\s*\d+\s*,\s*cN:\s*(\d+)",
 169:     re.DOTALL,
 170: )
 171: 
 172: 
 173: def extract_trials_from_html(path: Path) -> list[dict]:
 174:     text = path.read_text(encoding="utf-8", errors="replace")
 175:     out = []
 176:     for m in NCT_BLOCK_RE.finditer(text):
 177:         key = m.group(1)
 178:         name = m.group(2)
 179:         tN = int(m.group(3))
 180:         cN = int(m.group(4))
 181:         block_start = m.start()
 182:         block_end = text.find("},", m.end())
 183:         if block_end == -1:
 184:             block_end = m.end() + 4000
 185:         block = text[block_start:min(block_end, block_start + 4000)]
 186:         gm = re.search(r"group:\s*'([^']+)'", block, re.DOTALL)
 187:         group_text = gm.group(1) if gm else ""
 188:         out.append({
 189:             "key": key,
 190:             "name": name,
 191:             "tN": tN,
 192:             "cN": cN,
 193:             "row_total": tN + cN,
 194:             "group": group_text,
 195:         })
 196:     return out
 197: 
 198: 
 199: COUNTRIES_OF_INTEREST = [
 200:     "South Africa", "Uganda", "Kenya", "Tanzania", "Malawi", "Zambia", "Zimbabwe",
 201:     "Botswana", "Nigeria", "Ghana", "Mali", "Burkina Faso", "Niger", "Cameroon",
 202:     "Mozambique", "DRC", "Senegal", "Ethiopia", "Rwanda", "Cote d'Ivoire", "CÃ´te d'Ivoire",
 203:     "Gabon", "Egypt", "Sudan", "USA", "United States", "Brazil", "Argentina",
 204:     "Canada", "UK", "United Kingdom", "France", "Germany", "Spain", "Italy",
 205:     "India", "Thailand", "Vietnam", "China", "Japan", "Australia", "Cambodia",
 206:     "Pakistan", "Bangladesh", "Belarus", "Uzbekistan", "Russia", "Mexico",
 207:     "Peru", "Chile", "Romania", "Bulgaria", "Sweden", "Greece", "Israel",
 208:     "Singapore", "Indonesia", "Hong Kong", "Belgium", "Netherlands", "Denmark",
 209:     "Norway", "Switzerland", "Austria", "Portugal", "Ireland", "Finland",
 210:     "Korea", "Czechia", "Poland", "Slovakia", "Hungary", "Lithuania", "Estonia",
 211:     "Croatia", "Slovenia", "Latvia", "Madagascar", "Iran", "Saudi Arabia",
 212:     "Turkey", "Lebanon", "Jordan", "UAE", "Iraq", "Morocco", "Tunisia",
 213:     "Algeria", "Liberia", "Sierra Leone", "Angola", "Namibia",
 214:     "Lesotho", "Eswatini", "Burundi", "Chad", "Republic of the Congo",
 215:     "Georgia", "Kazakhstan", "Moldova",
 216: ]
 217: 
 218: COUNTRY_SYNONYMS = {
 219:     "USA": {"United States"},
 220:     "United States": {"United States"},
 221:     "UK": {"United Kingdom"},
 222:     "United Kingdom": {"United Kingdom"},
 223:     "DRC": {"Democratic Republic of the Congo", "Congo, The Democratic Republic of the"},
 224:     "Hong Kong": {"China", "Hong Kong"},
 225:     "Cote d'Ivoire": {"CÃ´te d'Ivoire"},
 226:     "CÃ´te d'Ivoire": {"CÃ´te d'Ivoire"},
 227:     "Republic of the Congo": {"Republic of the Congo", "Congo"},
 228: }
 229: 
 230: 
 231: def scan_countries_in_snippet(snippet: str) -> set[str]:
 232:     found = set()
 233:     for c in COUNTRIES_OF_INTEREST:
 234:         if re.search(r"\b" + re.escape(c) + r"\b", snippet, re.IGNORECASE):
 235:             found.add(c)
 236:     return found
 237: 
 238: 
 239: def country_in_aact(claim: str, aact_set: set[str]) -> bool:
 240:     """True if my snippet country claim is satisfied by AACT facilities set."""
 241:     if claim in aact_set:
 242:         return True
 243:     syns = COUNTRY_SYNONYMS.get(claim, set())
 244:     return bool(syns & aact_set)
 245: 
 246: 
 247: def main():
 248:     print("Loading AACT studies.txt ...")
 249:     studies = load_aact_studies()
 250:     print(f"  {len(studies):,} NCTs")
 251:     print("Loading AACT brief_summaries.txt ...")
 252:     summaries = load_aact_brief_summaries()
 253:     print(f"  {len(summaries):,} brief_summaries")
 254:     print("Loading AACT facilities.txt ...")
 255:     facilities = load_aact_facility_countries()
 256:     print(f"  facility countries for {len(facilities):,} NCTs")
 257: 
 258:     review_files = sorted(REPO_DIR.glob("*_REVIEW.html"))
 259:     print(f"\nScanning {len(review_files)} *_REVIEW.html files ...\n")
 260: 
 261:     findings = []
 262:     for hp in review_files:
 263:         for t in extract_trials_from_html(hp):
 264:             key = t["key"]
 265:             base_match = re.match(r"(NCT\d+)", key)
 266:             if not base_match:
 267:                 findings.append({
 268:                     "file": hp.name, "key": key, "claim_name": t["name"], "claim_n": t["row_total"],
 269:                     "verdict": "ISRCTN_ONLY", "aact_brief_title": "", "aact_enrollment": "",
 270:                     "n_ratio": "", "title_overlap": "", "country_issues": "", "exempt": "", "notes": "",
 271:                 })
 272:                 continue
 273:             base_nct = base_match.group(1)
 274:             row = studies.get(base_nct)
 275:             exempt_flag = "EXEMPT" if (hp.name, base_nct) in EXEMPT else ""
 276: 
 277:             if not row:
 278:                 findings.append({
 279:                     "file": hp.name, "key": key, "claim_name": t["name"], "claim_n": t["row_total"],
 280:                     "verdict": "AACT_NOT_FOUND", "aact_brief_title": "", "aact_enrollment": "",
 281:                     "n_ratio": "", "title_overlap": "", "country_issues": "", "exempt": exempt_flag,
 282:                     "notes": "NCT absent from AACT â€” likely wrong NCT",
 283:                 })
 284:                 continue
 285: 
 286:             # Title-token comparison: union of brief_title + official_title + summary
 287:             claim_tokens = normalize_tokens(t["name"])
 288:             aact_text = " ".join([
 289:                 row["brief_title"], row["official_title"], summaries.get(base_nct, "")
 290:             ])
 291:             aact_tokens = normalize_tokens(aact_text)
 292:             overlap = len(claim_tokens & aact_tokens)
 293:             title_ok = (overlap >= 1) if claim_tokens else True
 294: 
 295:             # N comparison
 296:             aact_n = row["enrollment"]
 297:             ratio = (t["row_total"] / aact_n) if (aact_n and aact_n > 0) else None
 298:             if ratio is None or exempt_flag:
 299:                 n_ok = True
 300:             elif 0.20 <= ratio <= 1.30:
 301:                 n_ok = True
 302:             else:
 303:                 n_ok = False
 304: 
 305:             # Country comparison
 306:             aact_countries = facilities.get(base_nct, set())
 307:             snippet_countries = scan_countries_in_snippet(t["group"])
 308:             country_issues = []
 309:             if aact_countries:  # only check if AACT has facility data
 310:                 for c in snippet_countries:
 311:                     if not country_in_aact(c, aact_countries):
 312:                         country_issues.append(c)
 313: 
 314:             # Determine verdict
 315:             verdicts = []
 316:             if not n_ok:
 317:                 verdicts.append("N_OUTLIER")
 318:             if country_issues:
 319:                 verdicts.append("COUNTRY_NOT_IN_AACT")
 320:             if not title_ok:
 321:                 verdicts.append("TITLE_LOW_OVERLAP")
 322:             verdict = "+".join(verdicts) if verdicts else "OK"
 323: 
 324:             findings.append({
 325:                 "file": hp.name,
 326:                 "key": key,
 327:                 "claim_name": t["name"],
 328:                 "claim_n": t["row_total"],
 329:                 "verdict": verdict,
 330:                 "aact_brief_title": row["brief_title"][:80],
 331:                 "aact_enrollment": aact_n if aact_n else "",
 332:                 "n_ratio": f"{ratio:.2f}" if ratio is not None else "",
 333:                 "title_overlap": overlap,
 334:                 "country_issues": ",".join(country_issues),
 335:                 "exempt": exempt_flag,
 336:                 "notes": "",
 337:             })
 338: 
 339:     OUT_CSV.parent.mkdir(parents=True, exist_ok=True)
 340:     with OUT_CSV.open("w", newline="", encoding="utf-8") as f:
 341:         w = csv.DictWriter(f, fieldnames=list(findings[0].keys()))
 342:         w.writeheader()
 343:         w.writerows(findings)
 344: 
 345:     by_verdict: dict[str, int] = {}
 346:     for f in findings:
 347:         by_verdict[f["verdict"]] = by_verdict.get(f["verdict"], 0) + 1
 348:     print(f"=== Verdict counts (n={len(findings)}) ===")
 349:     for k in sorted(by_verdict.keys()):
 350:         print(f"  {k:50s} {by_verdict[k]}")
 351: 
 352:     # Focus on real defects
 353:     real = [f for f in findings if f["verdict"] not in ("OK", "ISRCTN_ONLY", "TITLE_LOW_OVERLAP")]
 354:     print(f"\n=== {len(real)} non-title defects (real issues to fix) ===\n")
 355:     for f in real:
 356:         print(f"  [{f['verdict']:30s}] {f['file']:50s} {f['key']:18s}")
 357:         print(f"     claim: {f['claim_name']:40s} n={f['claim_n']}")
 358:         print(f"     aact:  {f['aact_brief_title']:60s} n={f['aact_enrollment']}  ratio={f['n_ratio']}")
 359:         if f["country_issues"]:
 360:             print(f"     countries claimed but not in AACT facilities: {f['country_issues']}")
 361:         if f["notes"]:
 362:             print(f"     notes: {f['notes']}")
 363:         print()
 364: 
 365:     print(f"Written: {OUT_CSV}")
 366: 
 367: 
 368: if __name__ == "__main__":
 369:     main()

codex
Defects found:

- ZERO CONFLATED WITH ABSENT, line 297: AACT `enrollment = 0`; HTML block `'NCT00000001': { name: 'Drug X', tN: 50, cE: 0, cN: 50 }`. Consequence: `ratio` becomes `None`, line 298 sets `n_ok = True`, and a 100-vs-0 mismatch is not reported as `N_OUTLIER`.

- SELECTOR KEYED TO WRONG FORM, line 166: `'ISRCTN12345678': { name: 'Drug X', tN: 50, cE: 0, cN: 50 }`. Consequence: actual ISRCTN keys are not matched at all, so the line-266 `ISRCTN_ONLY` path cannot fire for the form it names.

- SELECTOR KEYED TO FIELD ORDER, line 168: `'NCT00000001': { name: 'Drug X', tN: 50, cN: 50, cE: 0 }`. Consequence: the trial is silently omitted because the regex requires `tN, cE, cN` order.

- NEGATION DROPPED, line 234: `group = "Not Kenya; sites in Uganda"` with AACT countries `{"Uganda"}`. Consequence: `Kenya` is treated as a claimed country and produces a false `COUNTRY_NOT_IN_AACT`.

- DIFFERENT COPY THAN REQUESTED, lines 38-43: environment `AACT_ROOT=F:\intended_snapshot` where that directory lacks `studies.txt`, while `Path.home()/AACT/2026-04-12/studies.txt` exists. Consequence: the script reads the home snapshot instead of failing on the explicitly requested snapshot.

- EMPTY-EXTRACTION CRASH, line 341: no `*_REVIEW.html` files, or only a file containing the ISRCTN input above. Consequence: `findings[0]` raises `IndexError`, so no CSV or verdict summary is produced.

No probe keyed to string a fix removes found.  
No idempotency guard satisfied by its own comment/marker found.  
No CRLF-vs-LF text comparison defect found.  
No merged-cell/off-by-one tabulation defect found.  
No subprocess/wrapper status-code defect found.
