 222: 
 223: def expand_review_name(rv_name: str) -> set[str]:
 224:     """Tokenize + expand a review name. Handle multi-part keys like
 225:     'ALDO_SYNTHASE' by looking for any acronym dict key that's a substring
 226:     of the review name."""
 227:     name = rv_name.replace("_REVIEW", "").replace("_NMA", "")
 228:     tokens = set()
 229:     # First: substring match against all dict keys
 230:     name_u = name.upper()
 231:     for key, expansion in ACRONYM_EXPAND.items():
 232:         # Match if key appears as a token boundary (between _ or at start/end)
 233:         if (f"_{key}_" in f"_{name_u}_" or
 234:             name_u.startswith(key + "_") or
 235:             name_u.endswith("_" + key) or
 236:             name_u == key):
 237:             tokens.update(t.lower() for t in expansion)
 238:     # Then: literal parts
 239:     parts = name.split("_")
 240:     for part in parts:
 241:         u = part.upper()
 242:         if u in ACRONYM_EXPAND:
 243:             tokens.update(t.lower() for t in ACRONYM_EXPAND[u])
 244:         if len(part) >= 3:
 245:             tokens.add(part.lower())
 246:     return tokens
 247: 
 248: 
 249: # Collect target trials
 250: scores = json.loads((OUT / "fabrication_risk_scores.json").read_text(encoding="utf-8"))
 251: # All non-quarantined
 252: target_reviews = {r["review"] for r in scores if not r["already_quarantined"]}
 253: 
 254: target_trials = []
 255: for json_p in sorted(DATA.glob("*.json")):
 256:     if json_p.name.startswith("_"): continue
 257:     rv = json_p.stem
 258:     if rv not in target_reviews: continue
 259:     try: d = json.loads(json_p.read_text(encoding="utf-8"))
 260:     except: continue
 261:     rd = d.get("realData") or {}
 262:     if not isinstance(rd, dict): continue
 263:     for nct, t in rd.items():
 264:         if not isinstance(t, dict): continue
 265:         if nct.startswith("NULLED:"): continue
 266:         if not re.match(r"^NCT\d{8}$", nct): continue
 267:         target_trials.append({"review": rv, "nct": nct, **t})
 268: 
 269: target_ncts = sorted({t["nct"] for t in target_trials})
 270: print(f"Target: {len(target_trials)} trials / {len(target_ncts)} unique NCTs")
 271: 
 272: # Load AACT minimal
 273: def load_aact(filename, key_col, want_cols, filter_set):
 274:     out = defaultdict(list)
 275:     with open(AACT / filename, "r", encoding="utf-8", errors="replace") as f:
 276:         reader = csv.DictReader(f, delimiter="|")
 277:         for row in reader:
 278:             k = (row.get(key_col) or "").strip().upper()
 279:             if k in filter_set:
 280:                 out[k].append({c: (row.get(c) or "").strip() for c in want_cols})
 281:     return out
 282: 
 283: target_set = set(target_ncts)
 284: print("Loading AACTâ€¦")
 285: studies = load_aact("studies.txt", "nct_id", ["brief_title", "official_title", "enrollment"], target_set)
 286: conds = load_aact("conditions.txt", "nct_id", ["downcase_name"], target_set)
 287: intvs = load_aact("interventions.txt", "nct_id", ["name"], target_set)
 288: 
 289: STOPWORDS = {"a","an","the","of","for","in","to","with","and","or","vs","vs.",
 290:               "versus","study","trial","randomized","placebo","controlled","phase",
 291:               "patients","adult","subjects","new","extension","week","month","year"}
 292: 
 293: def tokenize(s):
 294:     return {t for t in re.findall(r"[a-z]+", (s or "").lower())
 295:              if len(t) >= 4 and t not in STOPWORDS}
 296: 
 297: 
 298: # Verify: for each trial, expanded review tokens vs AACT condition+title tokens
 299: findings = []
 300: for t in target_trials:
 301:     rv = t["review"]; nct = t["nct"]
 302:     s = studies.get(nct, [])
 303:     if not s: continue
 304:     aact = s[0]
 305:     aact_title = (aact.get("brief_title", "") + " " + aact.get("official_title", "")).lower()
 306:     aact_conds = " ".join({c["downcase_name"] for c in conds.get(nct, [])}).lower()
 307:     aact_blob = aact_title + " " + aact_conds
 308: 
 309:     expanded_review = expand_review_name(rv)
 310:     if not expanded_review: continue
 311:     aact_words = tokenize(aact_blob)
 312:     overlap = expanded_review & aact_words
 313:     if not overlap:
 314:         # Strong signal: expanded review terms have ZERO overlap with AACT
 315:         # Additional check: intv must also not match
 316:         aact_intvs = [i["name"] for i in intvs.get(nct, [])]
 317:         aact_intvs_text = " ".join(aact_intvs).lower()
 318:         # Drug-name check from trial.group
 319:         group = (t.get("group") or "").lower()
 320:         drug_in_aact = False
 321:         for w in re.findall(r"[a-z]+", group):
 322:             if len(w) >= 6 and w not in STOPWORDS and w in aact_intvs_text:
 323:                 drug_in_aact = True; break
 324:         if not drug_in_aact:
 325:             findings.append({
 326:                 "review": rv, "nct": nct,
 327:                 "expanded_review_tokens": sorted(expanded_review)[:8],
 328:                 "aact_words_sample": sorted(aact_words)[:8],
 329:                 "fix": "NULL_KEY",
 330:             })
 331: 
 332: print(f"Expanded-MeSH mismatches with no AACT-intv backup: {len(findings)}")
 333: 
 334: 
 335: def find_block(txt, nct):
 336:     key_pat = re.compile(r'(["\'])' + re.escape(nct) + r'\1\s*:\s*\{')
 337:     m = key_pat.search(txt)
 338:     if not m: return None
 339:     start = m.end(); depth = 1; i = start; in_str = None
 340:     while i < len(txt) and depth > 0:
 341:         ch = txt[i]
 342:         if in_str:
 343:             if ch == "\\": i += 2; continue
 344:             if ch == in_str: in_str = None
 345:         else:
 346:             if ch in ('"', "'"): in_str = ch
 347:             elif ch == "{": depth += 1
 348:             elif ch == "}":
 349:                 depth -= 1
 350:                 if depth == 0: return (m.start(), i+1, start, i)
 351:         i += 1
 352:     return None
 353: 
 354: 
 355: def null_key(txt, nct):
 356:     nulled = f"NULLED:{nct}"
 357:     if nulled in txt: return txt, 0
 358:     pat = re.compile(r'(["\'])(' + re.escape(nct) + r')(\1)(\s*:)')
 359:     new_txt, n = pat.subn(
 360:         lambda m: f'{m.group(1)}NULLED:{m.group(2)}{m.group(3)}{m.group(4)}', txt)
 361:     return new_txt, n
 362: 
 363: 
 364: applied = []
 365: n_fix = 0
 366: seen = set()
 367: for f in findings:
 368:     key = (f["review"], f["nct"])
 369:     if key in seen: continue
 370:     seen.add(key)
 371:     html_path = HERE / f"{f['review']}.html"
 372:     if not html_path.exists(): continue
 373:     txt = html_path.read_text(encoding="utf-8")
 374:     new_txt, n = null_key(txt, f["nct"])
 375:     if n > 0:
 376:         if not DRY: html_path.write_text(new_txt, encoding="utf-8")
 377:         applied.append({**f, "status": "NULLED_KEY"})
 378:         n_fix += 1
 379:     elif f"NULLED:{f['nct']}" in txt:
 380:         applied.append({**f, "status": "ALREADY_NULLED"})
 381: 
 382: out_p = OUT / "r22_mesh_matching.json"
 383: out_p.write_text(json.dumps({"findings": findings, "applied": applied,
 384:                               "summary": {"nct_key_nulls": n_fix}},
 385:                              indent=2, ensure_ascii=False), encoding="utf-8")
 386: print(f"\n{'DRY-RUN ' if DRY else ''}MeSH-expansion NCT nulls: {n_fix}")

codex
- **Selector keyed to a form the corpus does not use**: line 205.  
  Input: `expand_review_name("GnRH_ANTAGONISTS_GYN_REVIEW")`.  
  Consequence: the mixed-case key is never matched by the uppercase lookup path, so `endometriosis`/`fibroid` are omitted and valid trials can be false-flagged.

- **Selector keyed to a form the corpus does not use**: line 217.  
  Input: `expand_review_name("HoFH_LIPID_REVIEW")`.  
  Consequence: `HoFH_LIPID` is missed for the same case-normalization reason, so `homozygous`/`familial` are omitted.

- **Selector keyed to a form the corpus does not use**: line 295.  
  Input: review `HIV_PREP_REVIEW`, AACT title/condition text `HIV PrEP`.  
  Consequence: both `hiv` and `prep` are dropped by `len(t) >= 4`, so an on-topic HIV/PrEP trial can appear to have zero overlap.

- **Idempotency guard satisfied by its own marker/comment**: line 357.  
  Input to `null_key`: `txt='// NULLED:NCT00000001\nvar realData={"NCT00000001":{}};'`, `nct='NCT00000001'`.  
  Consequence: the real key is left unmodified because an unrelated marker string makes the function return early.

- **Instrument reading/changing a name rather than its binding**: line 358.  
  Input: `txt='const labels={"NCT00000001":"x"}; const realData={"NCT00000001":{}};'`, `nct='NCT00000001'`.  
  Consequence: `null_key` rewrites every quoted matching key, not the intended `realData` binding only.

- **Check cannot fail / status code reports wrapper**: line 260.  
  Input: `fabrication_risk_scores.json` includes `{"review":"HF_REVIEW","already_quarantined":false}` and `data/HF_REVIEW.json` contains `{`.  
  Consequence: corrupt review input is silently skipped and the script can still exit 0.

- **Check cannot fail / status code reports wrapper**: line 372.  
  Input: a finding for `{"review":"HF_REVIEW","nct":"NCT00000001"}` with no `HF_REVIEW.html`.  
  Consequence: a detected defect is not applied and not failed.

