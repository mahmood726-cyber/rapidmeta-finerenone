  11: def replace_realdata(text, new_body):
  12:     start = text.find("realData: {")
  13:     body_start = text.find("{", start)
  14:     depth = 0; i = body_start; body_end = body_start
  15:     while i < len(text):
  16:         c = text[i]
  17:         if c == "{": depth += 1
  18:         elif c == "}": depth -= 1
  19:         if depth == 0 and i > body_start: body_end = i; break
  20:         i += 1
  21:     return text[:body_start] + "{" + new_body + text[body_end+1:]
