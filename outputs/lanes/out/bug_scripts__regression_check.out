 522:                     (a, pool_clean or "empty"))
 523:             else:
 524:                 _why = []
 525:                 if not _decl:
 526:                     _why.append("no withdrawal declared where a reader sees it")
 527:                 if not _reason:
 528:                     _why.append("no reason given for the absence")
 529:                 if not _names_trial:
 530:                     _why.append("names no trial")
 531:                 signals["pool_broken"].append(
 532:                     (a, (pool_clean or "empty") + " -- " + "; ".join(_why)))
