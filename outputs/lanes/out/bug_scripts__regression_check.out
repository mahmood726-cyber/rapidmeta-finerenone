 267:             # correct in its own terms and still blocked the right action: it
 268:             # cannot tell a forward BUILD from a RESTORATION, which is the one
 269:             # case it was not designed to classify. The revert needed an
 270:             # authorised --no-verify, and a lane overriding a gate it hardened
 271:             # hours earlier is exactly how gates rot.
 272:             #
 273:             # So a restore is now a first-class concept rather than an afterthought.
 274:             # Content byte-identical to a preservation-archive snapshot is a state
 275:             # we PREVIOUSLY PUBLISHED, so it passes. Anything else -- including a
 276:             # forward build missing the readiness verdict -- still fails.
 277:             #
 278:             # The signals are still REPORTED for a restore, never silently dropped:
 279:             # an exemption that hides what it exempted is how the next blind spot
 280:             # gets built.
 281:             if _fired and _is_restoration(a, _src):
 282:                 _arc = _is_restoration(a, _src)
 283:                 print("  [restore-exempt] %s matches archive %s byte for byte; "
 284:                       "signals reported, not blocking: %s"
 285:                       % (a, _arc, ", ".join(sorted(_fired))))
 286:                 signals["fully_ok"].append(a)
 287:                 continue
 288:             if _fired:
 289:                 for _k, _why in _fired.items():
 290:                     signals.setdefault("ssot_" + _k, []).append((a, _why))
 291:             else:
 292:                 signals["fully_ok"].append(a)
 293:             continue
 294:         # A RETIRED PAGE IS NOT A BROKEN REVIEW. It carries no RapidMeta app because there is
 295:         # no review left on it, so every app-level probe below would report a page error for a
 296:         # page that is behaving exactly as intended. It is checked for what it IS instead: it
 297:         # must declare its state, name its absorber, and link to a page that exists.
 298:         _src = (ROOT / f"{a}.html").read_text(encoding="utf-8", errors="replace")
 299:         if 'name="rapidmeta:page-state" content="RETIRED"' in _src:
 300:             import re as _re
 301:             # A TOPIC CAN BE RETIRED BY MERGE **OR** BY SPLIT, and this test read only the merge
 302:             # spelling. `absorbed-by` names one survivor; `split-into` names several. The first
 303:             # topic retired by split failed here as "declares RETIRED and names no absorber" --
 304:             # a correct tombstone reported as a broken page, because the checker knew one word
 305:             # for successor. IDENTICAL to the `absorbed_by` / `split_into` miss in
 306:             # project_dashboard_index.py the same hour, which makes it class 25 twice over in
 307:             # two instruments. Read EITHER, and check EVERY link rather than the first.
 308:             _m = (_re.search(r'name="rapidmeta:absorbed-by" content="([^"]+)"', _src)
 309:                   or _re.search(r'name="rapidmeta:split-into" content="([^"]+)"', _src))
 310:             _links = _re.findall(r'class="go" href="([^"]+)"', _src)
 311:             _bad = []
 312:             if not _m:
 313:                 _bad.append("declares RETIRED and names neither an absorber nor a split target")
 314:             if not _links:
 315:                 _bad.append("declares RETIRED and offers no link to a surviving review")
 316:             for _href in _links:
 317:                 if not (ROOT / _href).exists():
 318:                     _bad.append("links to %s, which does not exist -- a reader would 404"
 319:                                 % _href)
 320:             if _bad:
 321:                 signals["page_errors"].append((a, "; ".join(_bad)))
 322:             else:
 323:                 signals["fully_ok"].append(a)
 324:             continue
 325: 
 326:         # A REVIEW THAT PUBLISHES NO POOLED ESTIMATE IS NOT A BROKEN DASHBOARD EITHER. It
 327:         # carries no RapidMeta app because there is no pool to render, so every app-level probe
 328:         # below would report a page error for a page behaving exactly as intended -- the same
 329:         # missing concept that made the checker reject the tombstone, one state along.
 330:         #
 331:         # ENCODE THE DISTINCTION RATHER THAN EXEMPT THE FILE. It is checked for what it IS: it
 332:         # must DECLARE that it publishes nothing, SAY so where a reader sees it rather than only
 333:         # in a meta tag, name at least one trial, and every link it offers must resolve. A page
 334:         # that quietly rendered nothing would still fail all four.
 335:         if 'name="rapidmeta:pooled-estimate" content="NONE"' in _src:
 336:             import re as _re
 337:             _links = _re.findall(r'class="go" href="([^"]+)"', _src)
 338:             _bad = []
 339:             if "No pooled estimate" not in _src:
 340:                 _bad.append("declares no pooled estimate in a meta tag but nowhere a reader "
 341:                             "would see it")
 342:             if not _re.search(r"NCT\d{8}", _src):
 343:                 _bad.append("publishes no estimate AND names no trial -- there is nothing on "
 344:                             "this page")
 345:             for _href in _links:
 346:                 if not (ROOT / _href).exists():
 347:                     _bad.append("links to %s, which does not exist -- a reader would 404"
 348:                                 % _href)
 349:             if _bad:
 350:                 signals["page_errors"].append((a, "; ".join(_bad)))
 351:             else:
 352:                 signals["fully_ok"].append(a)
 353:             continue
 354:         pg_errors = []
 355:         pg.on('pageerror', lambda e: pg_errors.append(str(e)[:100]))
 356:         try:
 357:             pg.goto(f'http://localhost:{_PORT}/{a}.html', wait_until='load', timeout=60000)
 358:             pg.wait_for_timeout(1500)
 359:             pg.evaluate('localStorage.clear()')
 360:             pg.goto(f'http://localhost:{_PORT}/{a}.html', wait_until='load', timeout=60000)
 361:             pg.wait_for_timeout(2200)
 362:         except Exception as e:
 363:             signals["page_errors"].append((a, f"load: {e}"))
 364:             continue
 365: 
 366:         if pg_errors:
 367:             signals["page_errors"].append((a, pg_errors[:2]))
 368: 
 369:         try:
 370:             trials = pg.evaluate('RapidMeta?.state?.trials?.length ?? -1')
 371:             # TWO READS ACROSS THE SETTLE WINDOW. One read cannot tell "this review
 372:             # includes no studies" from "this review has not finished rendering
 373:             # them yet", and the old single read at ~2.2s reported the second as
 374:             # the first. Measured 2026-08-17: 0 at 2.5s, 0 at 6s, 7 at 12s on a
 375:             # cold load, and 7 offline (faster -- the fetches fail fast instead of
 376:             # hanging), so this is LOCAL settling, not third-party success.
 377:             incl = pg.evaluate(_INCL_JS)
 378:             # CONDITIONAL SETTLE WINDOW. The defect is "a reader sees a review
 379:             # with no studies in it". If the first read is NON-ZERO that reader
 380:             # never occurs, so the window buys nothing on this page. If it is
 381:             # ZERO we cannot tell "still settling" from "genuinely empty", and
 382:             # that is exactly where the window must be spent. The property is
 383:             # preserved; only the cost is dropped.
 384:             #
 385:             # WHAT THIS NO LONGER MEASURES, stated because it is a real gap:
 386:             # a page rendering N studies at 2.2s and a DIFFERENT non-zero N at
 387:             # 12.2s now passes unexamined. Churn among a non-empty set is
 388:             # invisible here. It is narrower than the gap it replaces -- an
 389:             # empty render is the reader-facing defect -- but it is not nothing.
 390:             #
 391:             # Why the conditional and not a shorter window: shortening it would
 392:             # have removed the detection while looking like optimisation, which
 393:             # is the shape of every mechanism in gate_integrity.py.
 394:             if incl < 1:
 395:                 settle_used.append(a)
 396:                 pg.wait_for_timeout(_SETTLE_MS)
 397:                 incl_settled = pg.evaluate(_INCL_JS)
 398:             else:
 399:                 incl_settled = incl
 400:             settle_profile[a] = {"at_sample_ms": 2200, "at_sample": incl,
 401:                                  "at_settle_ms": 2200 + _SETTLE_MS,
 402:                                  "at_settle": incl_settled}
 403:             banner_txt = pg.evaluate('document.getElementById("rob-status-banner")?.innerText || ""') or ""
 404:             proto_href = pg.evaluate('document.querySelector(\'a[href*="protocols/"][href*="_protocol_v1"]\')?.getAttribute("href") || ""') or ""
 405:             webr_tag = pg.evaluate('!!document.querySelector("script[src=\\"webr-validator.js\\"]")')
 406:             # Switch to analysis tab and read pool
 407:             pg.evaluate('try { RapidMeta.switchTab("analysis") } catch(e){}')
 408:             pg.wait_for_timeout(800)
 409:             pool = pg.evaluate('document.getElementById("res-or")?.innerText || ""') or ""
 410:         except Exception as e:
 411:             signals["page_errors"].append((a, f"eval: {e}"))
 412:             continue
 413: 
 414:         if trials < 1:
 415:             signals["no_trials"].append((a, trials))
 416:         # FLAKY, AND THE CAUSE IS THE CORPUS-WIDE ONE (measured 2026-08-17).
 417:         # `incl` counts trials whose status arrives from data the page FETCHES AT
 418:         # LOAD. On 2026-08-17 ANTI_CD20_MS fired this signal 1 of 2 runs on the
 419:         # UNEDITED page and 0 of 3 on the edited one, and blocked a good push.
 420:         # 19 of 21 sampled pages issue third-party requests on load and every one
 421:         # of them was getting HTTP 429 from api.openalex.org in the same window.
 422:         # SO THIS GATE'S VERDICT DEPENDS ON A THIRD PARTY'S RATE LIMITER. A gate
 423:         # that is non-deterministic teaches people to re-run it until it is green,
 424:         # which is a bypass that leaves no trace in any log. Recorded here rather
 425:         # than softened: the fix is self-containment (v1 property), not a retry.
 426:         # THREE-STATE VERDICT. PASS / FAIL / NONDETERMINISTIC.
 427:         #
 428:         # RENAMED, because the old name asserted what it did not measure. It was
 429:         # zero_included -- "this review includes no studies" -- and what it
 430:         # observed was "no studies were rendered within the sampling window".
 431:         # Third time today that a check reported something other than what it
 432:         # measured (no_rob_banner tests a disclosure element and reads as an
 433:         # assessment; the raw-HTML rule counted script source as page content).
 434:         #
 435:         # NONDETERMINISTIC BLOCKS, exactly as FAIL does. It is not a softer
 436:         # verdict: not knowing what a page shows a reader is not a passing state,
 437:         # and the same reasoning already makes INVALID distinct from PASS. What
 438:         # it must NOT become is a longer wait until the number goes green -- that
 439:         # would hide a genuine reader-facing defect rather than report it, and a
 440:         # reader who looks in the first few seconds really does see zero studies.
 441:         if incl < 1 and incl_settled < 1:
 442:             signals["no_studies_rendered"].append((a, "0 at both %dms and %dms"
 443:                                                    % (2200, 2200 + _SETTLE_MS)))
 444:         elif incl != incl_settled:
 445:             signals["nondeterministic_render"].append(
 446:                 (a, "%d at %dms -> %d at %dms" % (incl, 2200, incl_settled,
 447:                                                   2200 + _SETTLE_MS)))
 448:         if "Provisional RoB-2 and GRADE" not in banner_txt:
 449:             signals["no_rob_banner"].append((a, banner_txt[:60]))
 450:         # CLASS 52 ACCOUNTING, AT THE SITE OF TWO OF ITS THREE INSTANCES. This signal
 451:         # keys on the marker `arni_hf_protocol` and has reported 0 on every run this
 452:         # project has ever made -- because the marker appears on NO page in the corpus,
 453:         # not because no page has the defect. A zero from a search whose term does not
 454:         # exist is NOT_ASSESSABLE, and until now it was read as clean AND it sat in the
 455:         # BLOCKING set. Every page is now asked whether the marker occurs at all, so the
 456:         # zero can state which of its two readings it is.
 457:         if "arni_hf_protocol" in proto_href:
 458:             marker_seen["arni_hf_protocol"] = marker_seen.get("arni_hf_protocol", 0) + 1
 459:         if a != "ARNI_HF_REVIEW" and "arni_hf_protocol" in proto_href:
 460:             signals["wrong_protocol_link"].append((a, proto_href))
 461:         if not webr_tag:
 462:             signals["no_webr_tag"].append((a,))
 463:         # A POOL CAN BE ABSENT FOR TWO REASONS AND THIS SIGNAL KNEW ONLY ONE.
 464:         #
 465:         # THREE STATES, NOT TWO: rendered, WITHDRAWN-WITH-REASON, failed.
 466:         #
 467:         # Until 2026-08-20 an empty or "--" pooled display was `pool_broken`, full stop.
 468:         # But a page that WITHDRAWS its estimate deliberately renders exactly that, and
 469:         # withdrawing is a behaviour this project has spent the week increasing. So the
 470:         # check was scoring our most careful pages as our most broken ones, and every plan
 471:         # built on its output inherited the inversion.
 472:         #
 473:         # TIRZEPATIDE_ARDS_AUTO_FULL_REVIEW opens with "IDENTITY CORRECTED -- THIS IS A
 474:         # REVIEW OF ANDEXANET ALFA. Pooled: 0 trials, Quarantined: 3, Pooled estimate:
 475:         # withdrawn", explains that the figure it used to show was computed from arm sizes
 476:         # mistaken for event counts, and records a result it declines to pool. It was
 477:         # scored identically to a page whose renderer fell over.
 478:         #
 479:         # THE SAME BIAS, ONE LAYER UP, PRODUCED A FALSE REPORT THE SAME NIGHT: a regex
 480:         # matched the numerals inside that withdrawal notice and reported them as what the
 481:         # page serves. A CHECKER THAT READS A DISCLOSURE AS THE DEFECT IT DISCLOSES
 482:         # PENALISES A PAGE IN PROPORTION TO HOW HONESTLY IT DOCUMENTS ITSELF.
 483:         #
 484:         # There was already a declared-absent path here, keyed on
 485:         # `rapidmeta:pooled-estimate content="NONE"`. MEASURED 2026-08-20: ZERO pages in
 486:         # the corpus carry that meta tag, so that branch had never executed once -- a
 487:         # three-state mechanism that had never reached its third state. The declaration is
 488:         # therefore read from what the page SHOWS A READER, which is where 99 pages
 489:         # currently put it, and the meta tag remains as a stronger form.
 490:         #
 491:         # AND READING WHAT THE PAGE SHOWS IS RIGHT FOR A SECOND REASON, INDEPENDENT OF
 492:         # WHETHER ANY PAGE EMITS THE TAG. A withdrawal declared ONLY in metadata would
 493:         # satisfy a meta-tag check while telling the reader nothing -- the check would pass
 494:         # on a page whose reader still sees an unexplained "--". That is the same principle
 495:         # as verifying SERVED BYTES rather than a hash: the artefact a reader receives is
 496:         # the thing under test, and a marker they cannot see is not a disclosure.
 497:         pool_clean = pool.strip()
 498:         _absent = False
 499:         try:
 500:             pool_f = float(pool_clean)
 501:             if pool_f in (0.0,):
 502:                 _absent = True
 503:         except (TypeError, ValueError):
 504:             if pool_clean in ("", "--", "NaN"):
 505:                 _absent = True
 506:         if _absent:
 507:             # Withdrawn-with-reason must be DECLARED where a reader sees it, and must
