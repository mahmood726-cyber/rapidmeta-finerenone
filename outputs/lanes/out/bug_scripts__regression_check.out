 609: # Save raw
 610: Path("/tmp/regression_results.json").write_text(json.dumps({k: v for k, v in signals.items()}, default=str), encoding='utf-8')
 611: print()
 612: print("Raw JSON saved to /tmp/regression_results.json")
 613: 
 614: # THE SETTLE PROFILE, KEPT AS DATA. Not collapsed into the verdict, because
 615: # "how long before a reader sees this review's included studies" is a
 616: # reader-facing fact and a defect in its own right, separate from the sampling
 617: # question the verdict answers. Twelve seconds is a long time to show someone an
 618: # empty review, and we cannot know how many pages are that slow without a record.
 619: if settle_profile:
 620:     _slow = {k: v for k, v in settle_profile.items()
 621:              if v["at_sample"] < 1 <= v["at_settle"]}
 622:     (ROOT / "outputs").mkdir(exist_ok=True)
 623:     with open(ROOT / "outputs" / "settle_profile.json", "w", encoding="utf-8") as _fh:
 624:         json.dump(settle_profile, _fh, indent=1)
 625:     print("settle profile: %d page(s) measured; full window spent on %d "
 626:           "(first read was zero); %d rendered NOTHING at %dms and recovered by %dms"
 627:           % (len(settle_profile), len(settle_used), len(_slow), 2200,
 628:              2200 + _SETTLE_MS))
 629:     for _k in sorted(_slow)[:8]:
 630:         print("   %-44s %d -> %d" % (_k, _slow[_k]["at_sample"], _slow[_k]["at_settle"]))
