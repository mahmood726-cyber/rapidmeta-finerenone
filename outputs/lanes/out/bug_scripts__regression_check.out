 632: # THE FAILURE PATH. This script previously had no sys.exit ANYWHERE, so it exited 0
 633: # whatever it found -- and the pre-push hook then read `$?` after a pipe, which is
 634: # `tail`'s status and also always 0. Two independent reasons the gate could never
 635: # block a push. A guard that cannot fail is not a guard, so the exit code is now
 636: # derived from the findings.
 637: # fully_ok is the SUCCESS list, not a signal. Including it here inverted the
 638: # gate: a page that passed all seven checks was added to fully_ok, which made
 639: # this dict non-empty, which blocked the push. The first push after the gate was
 640: # repaired to be able to fail was rejected with
 641: #
 642: #     REGRESSION CHECK FAILED. Signals firing:
 643: #       fully_ok: 1
 644: #
 645: # on a page whose seven defect signals were all zero. The gate went from never
 646: # failing to failing on success, which is the same defect wearing the opposite
 647: # sign, and it is why a success counter must never be read as a finding.
 648: _OK_KEYS = {"fully_ok"}
 649: # A DECLARED EXCEPTION IS REPORTED, NOT COUNTED AS A BLOCKING FINDING.
 650: # The per-page loop already decides this; the exit logic has to agree, or the
 651: # gate reports "not blocking" and then blocks -- which is exactly what the first
 652: # cut of this change did. Two places deciding the same thing independently is
 653: # how the fully_ok inversion above happened too, so the waiver is applied here
 654: # by REMOVING the waived (page, signal) pairs, leaving any OTHER page's failure
 655: # of the same signal fully intact.
 656: _WAIVABLE = ("no_rob_banner", "no_webr_tag")
 657: _waived_pairs = 0
 658: for _k in _WAIVABLE:
 659:     _kept = []
 660:     for _row in signals[_k]:
 661:         _app = _row[0] if isinstance(_row, tuple) else _row
 662:         if _exception_registered(_app) and _has_exception_banner(
 663:                 (ROOT / (_app + ".html")).read_text(encoding="utf-8", errors="replace")
 664:                 if (ROOT / (_app + ".html")).exists() else ""):
 665:             _waived_pairs += 1
 666:             continue
 667:         _kept.append(_row)
 668:     signals[_k] = _kept
 669: if _waived_pairs:
 670:     print("\n%d signal(s) waived under STANDARD_EXCEPTIONS.json -- these pages "
 671:           "are BELOW STANDARD and say so on their face. Waived is not fixed and the "
 672:           "register is the backlog." % _waived_pairs)
 673: _fail = {k: v for k, v in signals.items() if v and k not in _OK_KEYS}
 674: if _fail:
 675:     print()
 676:     print("REGRESSION CHECK FAILED. Signals firing:")
 677:     for k, v in _fail.items():
 678:         print(f"  {k}: {len(v)}")
 679:     sys.exit(1)
 680: print()
 681: print("Regression check clean across the pages in scope.")
 682: sys.exit(0)

