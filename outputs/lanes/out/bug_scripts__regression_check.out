 510:             _decl = ("No pooled estimate" in _src or "no pooled estimate" in _src
 511:                      or "estimate is withdrawn" in _src
 512:                      or "Pooled estimate: withdrawn" in _src)
 513:             _reason = any(k in _src for k in
 514:                           ("withdrawn, not merely caveated", "Quarantined:",
 515:                            "why this review publishes no pooled estimate",
 516:                            "Why this review publishes no pooled estimate",
 517:                            "was withdrawn because", "is withdrawn because",
 518:                            "estimand", "not poolable", "declines to pool"))
 519:             _names_trial = bool(__import__("re").search(r"NCT\d{8}", _src))
 520:             if _decl and _reason and _names_trial:
