 118:     # different order of defect and gets counted as one.
 119:     cells = len(re.findall(r"(?is)<t[dh][ >]", panel))
 120:     panel = re.sub(r"(?is)<table.*?</table>", " ", panel)
 121:     panel = re.sub(r"(?is)<div class=.prov-block.>.*?</ol>\s*</div>", " ", panel)
 122: 
 123:     t = re.sub(r"(?is)<script.*?</script>", " ", panel)
 124:     t = re.sub(r"(?is)<style.*?</style>", " ", t)
 125:     # The provenance arrow is its own element and is counted separately, not as prose.
 126:     t = re.sub(r"(?is)<small[^>]*>\s*(?:&larr;|â†).*?</small>", " ", t)
 127:     t = re.sub(r"(?i)<h[1-6][^>]*>", "\n@@@", t)
 128:     t = re.sub(r"(?i)</h[1-6]>", "\n", t)
 129:     t = re.sub(r"(?i)<(p|div|li|tr|br)[^>]*>", "\n", t)
 130:     t = re.sub(r"<[^>]+>", " ", t)
 131:     t = htmllib.unescape(t)
 132:     t = re.sub(r"[ \t]+", " ", t)
 133: 
 134:     sections, head, buf = [], "(preamble)", []
 135:     for line in t.split("\n"):
 136:         if line.startswith("@@@"):
 137:             sections.append((head, "\n".join(buf)))
 138:             head, buf = line[3:].strip(), []
 139:         else:
 140:             if line.strip():
 141:                 buf.append(line.strip())
 142:     sections.append((head, "\n".join(buf)))
 143:     return sections, arrows + prov
 144: 
 145: 
 146: def score(text):
 147:     """-> (sentences, machine_sentences, reasons Counter-ish dict)."""
 148:     sents = [s.strip() for s in SENT.split(text) if len(s.strip()) > 25]
 149:     bad, why = 0, {}
 150:     for s in sents:
 151:         hits = []
 152:         if FIELD_PATH.search(s):
 153:             hits.append("field path")
 154:         if RAW_STATS.search(s):
 155:             hits.append("raw stats")
 156:         if NCT.search(s):
 157:             hits.append("bare NCT")
 158:         if STORAGE_DIGITS.search(s):
 159:             hits.append("storage digits")
 160:         # snake/camel, after field paths so a path is not double-counted
 161:         if not hits or "field path" not in hits:
 162:             if SNAKE.search(s) or CAMEL.search(s):
 163:                 hits.append("identifier")
 164:         if hits:
 165:             bad += 1
 166:             for h in hits:
 167:                 why[h] = why.get(h, 0) + 1
 168:     return len(sents), bad, why
 169: 
 170: 
 171: def measure(path):
 172:     raw = io.open(path, encoding="utf-8", errors="replace").read()
 173:     sections, arrows = panel_text(raw)
 174:     if sections is None:
 175:         return None
 176:     tot = mach = 0
 177:     rf_tot = rf_mach = 0
 178:     why = {}
 179:     worst = []
 180:     for head, text in sections:
 181:         h = head.lower().strip()
 182:         if any(b in h for b in BY_DESIGN):
 183:             continue
 184:         n, b, w = score(text)
 185:         tot += n
 186:         mach += b
 187:         for k, v in w.items():
 188:             why[k] = why.get(k, 0) + v
 189:         if any(r in h for r in READER_FACING):
 190:             rf_tot += n
 191:             rf_mach += b
 192:         if b:
 193:             worst.append((b, n, head))
 194:     worst.sort(reverse=True)
 195:     return {"sentences": tot, "machine": mach, "arrows": arrows, "why": why,
 196:             "reader_facing": (rf_mach, rf_tot), "worst": worst}
 197: 
 198: 
 199: def main():
 200:     target = None
 201:     for a in sys.argv[1:]:
 202:         if not a.startswith("--"):
 203:             target = a
 204:     figs = REPO   # delivered pages live at the repo root, not in figs/
 205:     paths = ([target] if target
 206:              else sorted(glob.glob(os.path.join(figs, "*_REVIEW.html"))))
 207: 
 208:     # CONTROLS. The positive is the page Mahmood read; its Paper panel demonstrably
 209:     # contains field paths, because they are visible in the delivered bytes. The negative
 210:     # is the verbatim-R section, which is machine vocabulary BY DESIGN -- if the check
 211:     # counts that, it is measuring the standard rather than a defect.
 212:     probe = os.path.join(figs, "SGLT2_HF_REVIEW.html")
 213:     if os.path.exists(probe):
 214:         m = measure(probe)
 215:         raw = io.open(probe, encoding="utf-8", errors="replace").read()
 216:         secs, _a = panel_text(raw)
 217:         # Is any "quoted verbatim" section reaching the count? It must not: that is R
 218:         # console output P46 requires, and a check that scored it would be measuring the
 219:         # standard rather than a defect. Stated as the plain question rather than the
 220:         # double negative the first version used.
 221:         secs, _a = panel_text(raw)
 222:         verbatim_sections = [h for h, _t in (secs or []) if "quoted verbatim" in h.lower()]
 223:         verbatim_counted = any(
 224:             not any(b in h.lower() for b in BY_DESIGN) for h in verbatim_sections)
 225:         require_controls(
 226:             "lint_paper_reads_as_prose",
 227:             positive=("SGLT2_HF_REVIEW's Paper panel, which a reader called computer code",
 228:                       m is not None and m["machine"] > 0, True),
 229:             negative=("the %d verbatim-R section(s), machine vocabulary BY DESIGN"
 230:                       % len(verbatim_sections), verbatim_counted, True))
 231:         # SECOND NEGATIVE CONTROL, declared for the same reason as the first. A trial
 232:         # characteristics row -- "NCT03036124 DAPA-HF dapagliflozin 10 mg once daily
 233:         # (treatment, n=2373) vs placebo (control, n=2371)" -- is an identifier in a table,
 234:         # which is where this project's own rule puts identifiers. It must NOT be counted.
 235:         _row = ("<table><tr><td>NCT03036124</td><td>DAPA-HF</td></tr></table>"
 236:                 "<p>An ordinary sentence with no machine vocabulary at all.</p>")
 237:         _secs2, _p2 = panel_text('<span id="paper"></span><h2>Paper</h2><h3>T</h3>'
 238:                                  + _row + '<div class="panel">')
 239:         _n2, _b2, _w2 = score(chr(10).join(t for _h, t in (_secs2 or [])))
 240:         require_controls(
 241:             "lint_paper_reads_as_prose/tables",
 242:             positive=("a paragraph of plain prose is still read as a sentence", _n2 > 0,
 243:                       True),
 244:             negative=("a trial-characteristics table row carrying an NCT", _b2 > 0, True))
 245: 
 246:     print("")
 247:     rows = []
 248:     for p in paths:
 249:         m = measure(p)
 250:         name = os.path.basename(p)
 251:         if m is None:
 252:             rows.append((name, None))
 253:             continue
 254:         rows.append((name, m))
 255: 
 256:     assessable = [(n, m) for n, m in rows if m]
 257:     print("PAPER PANELS MEASURED: %d; NOT_ASSESSABLE (no Paper panel): %d"
 258:           % (len(assessable), len(rows) - len(assessable)))
 259:     print("NOT_ASSESSABLE MEANS NO PANEL WAS FOUND, NOT THAT THE PROSE IS CLEAN.")
 260: 
 261:     if target or len(assessable) == 1:
 262:         for name, m in assessable:
 263:             pct = 100.0 * m["machine"] / m["sentences"] if m["sentences"] else 0
 264:             rf_m, rf_t = m["reader_facing"]
 265:             print("")
 266:             print("%s" % name)
 267:             print("    sentences in the Paper panel (verbatim-R and references excluded) %4d"
 268:                   % m["sentences"])
 269:             print("    sentences carrying machine vocabulary                            %4d"
 270:                   " (%.0f%%)" % (m["machine"], pct))
 271:             print("    of those, in the four READER-FACING sections                     %4d"
 272:                   " of %d" % (rf_m, rf_t))
 273:             print("    provenance arrows appended by the projector                      %4d"
 274:                   % m["arrows"])
 275:             for k in sorted(m["why"], key=lambda k: -m["why"][k]):
 276:                 print("        %-16s %4d" % (k, m["why"][k]))
 277:             print("    heaviest sections:")
 278:             for b, n, head in m["worst"][:8]:
 279:                 print("        %3d/%-3d  %s" % (b, n, head))
 280:         return
 281: 
 282:     tot_s = sum(m["sentences"] for _n, m in assessable)
 283:     tot_m = sum(m["machine"] for _n, m in assessable)
 284:     tot_a = sum(m["arrows"] for _n, m in assessable)
 285:     print("")
 286:     print("ACROSS THE CORPUS")
 287:     print("    sentences                    %6d" % tot_s)
 288:     print("    carrying machine vocabulary  %6d  (%.0f%%)"
 289:           % (tot_m, 100.0 * tot_m / tot_s if tot_s else 0))
 290:     print("    provenance arrows            %6d" % tot_a)
 291:     print("")
 292:     print("WORST PAGES BY PROPORTION:")
 293:     ranked = sorted(((100.0 * m["machine"] / m["sentences"] if m["sentences"] else 0,
 294:                       m["machine"], m["sentences"], n) for n, m in assessable),
 295:                     reverse=True)
 296:     for pct, b, n_, name in ranked[:12]:
 297:         print("    %5.0f%%  %4d/%-4d  %s" % (pct, b, n_, name))
 298: 
 299: 
 300: if __name__ == "__main__":
 301:     main()

codex
Defects found:

- **Check that CANNOT FAIL / probe keyed to same string**: line 223.  
  Exact input: `raw='<span id="paper"></span><h2>Paper</h2><h3>Statistical output, quoted verbatim</h3><p>tau^2 = 0.0012 and pval = 0.03.</p><div class="panel">'`  
  Consequence: `verbatim_sections` is selected only by `"quoted verbatim"`, and `BY_DESIGN` also contains `"quoted verbatim"`, so `verbatim_counted` is always false and the negative control never tests whether the scorer actually counted the R-output text.

- **Check that CANNOT FAIL when fixture is absent**: line 213.  
  Exact input: invoke with any target HTML while `SGLT2_HF_REVIEW.html` is absent from `REPO`, e.g. target file containing `<span id="paper"></span><h2>Paper</h2><p>Plain prose sentence longer than twenty-five characters.</p><div class="panel">`.  
  Consequence: all controls are skipped, so the instrument can report results without proving either positive or negative controls ran.

- **Selector keyed to too-narrow form**: line 121.  
  Exact input: `<span id="paper"></span><h2>Paper</h2><div class="prov-block extra"><ol><li><code>results.x</code></li></ol></div><p>Plain prose sentence longer than twenty-five characters.</p><div class="panel">`  
  Consequence: the provenance block is not removed because the class selector requires exactly `class="prov-block"`, so provenance field paths leak into prose scoring.

