 172: def forest_svg(trials, pool):
 173:     """Build a simple SVG forest of per-trial OR + diamond for pool."""
 174:     rows = []
 175:     for t in trials:
 176:         lor = trial_log_or(t)
 177:         if not lor:
 178:             rows.append({"acronym": t["acronym"], "missing": True})
 179:         else:
 180:             log_or, se = lor
 181:             rows.append({
 182:                 "acronym": t["acronym"], "missing": False,
 183:                 "or": math.exp(log_or),
 184:                 "lci": math.exp(log_or - 1.96*se),
 185:                 "uci": math.exp(log_or + 1.96*se),
 186:             })
 187:     if not rows:
 188:         return '<div style="color:#94a3b8;font-size:12px;">No event-count data for forest plot.</div>'
 189:     width = 760
 190:     row_h = 28
 191:     margin_l = 200
 192:     margin_r = 30
 193:     plot_w = width - margin_l - margin_r
 194:     header_h = 28
 195:     height = header_h + row_h * (len(rows) + 1) + 24
 196:     # log-scale axis: 0.1 to 10
 197:     def x_for(or_val):
 198:         log_or_val = math.log(max(min(or_val, 10.0), 0.1))
 199:         # log domain: -ln(10) to ln(10) = -2.303 to 2.303
 200:         frac = (log_or_val + math.log(10)) / (2*math.log(10))
 201:         return margin_l + frac * plot_w
 202:     null_x = x_for(1.0)
 203:     svg = [f'<svg viewBox="0 0 {width} {height}" style="width:100%;max-width:760px;background:#0a0f1f;border-radius:6px;">']
 204:     svg.append(f'<text x="20" y="20" fill="#94a3b8" font-size="11">Trial</text>')
 205:     svg.append(f'<text x="{margin_l + plot_w/2}" y="20" fill="#94a3b8" font-size="11" text-anchor="middle">log-OR (95% CI)</text>')
 206:     svg.append(f'<line x1="{null_x}" y1="{header_h}" x2="{null_x}" y2="{header_h + row_h*len(rows)}" stroke="#475569" stroke-dasharray="3,3"/>')
 207:     for i, r in enumerate(rows):
 208:         y = header_h + row_h * i + row_h/2
 209:         svg.append(f'<text x="20" y="{y+4}" fill="#e2e8f0" font-size="11">{esc(r["acronym"])[:24]}</text>')
 210:         if r["missing"]:
 211:             svg.append(f'<text x="{null_x}" y="{y+4}" fill="#64748b" font-size="11" text-anchor="middle">(no event data)</text>')
 212:         else:
 213:             x_or = x_for(r["or"]); x_lci = x_for(r["lci"]); x_uci = x_for(r["uci"])
 214:             svg.append(f'<line x1="{x_lci}" y1="{y}" x2="{x_uci}" y2="{y}" stroke="#7dd3fc" stroke-width="2"/>')
 215:             svg.append(f'<rect x="{x_or-4}" y="{y-4}" width="8" height="8" fill="#7dd3fc"/>')
 216:             label = f'{r["or"]:.2f} [{r["lci"]:.2f}, {r["uci"]:.2f}]'
 217:             svg.append(f'<text x="{margin_l + plot_w + 4}" y="{y+4}" fill="#cbd5e1" font-size="10">{label}</text>')
 218:     if pool and pool.get("k", 0) >= 1:
 219:         y = header_h + row_h * len(rows) + row_h/2
 220:         x_p = x_for(pool["hr"]); x_pl = x_for(pool["lci"]); x_pu = x_for(pool["uci"])
 221:         svg.append(f'<text x="20" y="{y+4}" fill="#fbbf24" font-size="11" font-weight="600">Pooled (k={pool["k"]})</text>')
 222:         svg.append(f'<polygon points="{x_pl},{y} {x_p},{y-6} {x_pu},{y} {x_p},{y+6}" fill="#fbbf24"/>')
 223:         label = f'OR {pool["hr"]} [{pool["lci"]}, {pool["uci"]}]'
 224:         svg.append(f'<text x="{margin_l + plot_w + 4}" y="{y+4}" fill="#fbbf24" font-size="10" font-weight="600">{label}</text>')
 225:     svg.append('</svg>')
 226:     return "\n".join(svg)
 227: 
 228: 
 229: def build_html(topic_audit):
 230:     topic = topic_audit["topic"]
 231:     stem = topic["stem"]
 232:     name = topic["name"]
 233:     drug = (topic["drug_patterns"] or ["intervention"])[0]
 234:     cond = (topic["condition_patterns"] or ["condition"])[0]
 235:     drug_label = drug.title()
 236:     cond_label = cond.title()
 237:     trials = collect_trials(topic_audit)
 238:     yi_si = [trial_log_or(t) for t in trials]
 239:     yi_si = [x for x in yi_si if x]
 240:     pool = pool_reml_hksj(yi_si) if yi_si else None
 241:     rd_engine = realdata_for_engine(trials)
 242: 
 243:     # -- Protocol tab content
 244:     primary_outcomes = sorted({t["primary_outcome"] for t in trials if t["primary_outcome"]})
 245:     primary_outcomes_html = "".join(
 246:         f"<li>{esc(po)}</li>" for po in primary_outcomes[:5]
 247:     ) or "<li>Per-trial primary outcomes (see Extraction tab)</li>"
 248: 
 249:     protocol_html = f"""
 250:     <h3 style="color:#7dd3fc;font-size:14px;margin-top:0;">PICO</h3>
 251:     <table class="kv">
 252:       <tr><td>Population</td><td>Adults randomised in trials registered on ClinicalTrials.gov for <strong>{esc(cond_label)}</strong>.</td></tr>
 253:       <tr><td>Intervention</td><td><strong>{esc(drug_label)}</strong> (AACT-verified intervention name in each trial).</td></tr>
 254:       <tr><td>Comparator</td><td>Active comparator or placebo as registered on AACT.</td></tr>
 255:       <tr><td>Outcomes</td><td>Trial-declared primary outcome (AACT <code>design_outcomes</code>); event counts harvested from AACT <code>outcome_measurements</code>.</td></tr>
 256:       <tr><td>Design</td><td>Interventional RCTs (post-2010 start date), Phase 2/3 or Phase 3/4.</td></tr>
 257:     </table>
 258: 
 259:     <h3 style="color:#7dd3fc;font-size:14px;">Eligibility (6-gate audit)</h3>
 260:     <ol style="color:#cbd5e1;font-size:12.5px;">
 261:       <li>GATE-A â€” NCT exists in AACT 2026-04-12 snapshot.</li>
 262:       <li>GATE-B â€” Drug pattern "{esc(drug)}" present in AACT <code>interventions</code> for the NCT.</li>
 263:       <li>GATE-C â€” Condition pattern "{esc(cond)}" present in AACT <code>conditions</code>.</li>
 264:       <li>GATE-D â€” Primary PMID's PubMed title or abstract mentions the drug or condition.</li>
 265:       <li>GATE-E â€” AACT <code>baseline_counts</code> reports â‰¥2 per-arm participant rows.</li>
 266:       <li>GATE-F â€” AACT <code>design_outcomes</code> declares a primary outcome with measure text.</li>
 267:     </ol>
 268:     <p style="color:#94a3b8;font-size:11.5px;">Audit verdict: <code>VIABLE</code> requires â‰¥3 trials passing all 6 gates (kâ‰¥3 â€” current standard for new audit-first builds). Older builds use kâ‰¥2.</p>
 269: 
 270:     <h3 style="color:#7dd3fc;font-size:14px;">Pre-specified primary outcomes (per trial)</h3>
 271:     <ul style="color:#cbd5e1;font-size:12.5px;">{primary_outcomes_html}</ul>
 272: 
 273:     <h3 style="color:#7dd3fc;font-size:14px;">Statistical methods</h3>
 274:     <p style="color:#cbd5e1;font-size:12.5px;">Inverse-variance random-effects pooling on the log-OR scale (Woolf estimator from AACT event counts), DerSimonian-Laird Ï„Â² with Hartung-Knapp-Sidik-Jonkman (HKSJ) variance correction and t<sub>k-1</sub> critical value (Cochrane Handbook v6.5 conventions). Single-trial entries report Wald 95% CI on the log scale.</p>
 275:     """
 276: 
 277:     # -- Search tab
 278:     search_html = f"""
 279:     <h3 style="color:#7dd3fc;font-size:14px;margin-top:0;">Search strategy</h3>
 280:     <p style="color:#cbd5e1;font-size:12.5px;">Source-of-truth: AACT 2026-04-12 snapshot from the Clinical Trials Transformation Initiative (CTTI). Auto-discovery query:</p>
 281:     <pre style="background:#0a0f1f;padding:12px;border-radius:6px;color:#bef264;font-size:12px;overflow-x:auto;">
 282: SELECT nct_id FROM interventions
 283: WHERE lower(name) LIKE '%{esc(drug)}%'
 284: INTERSECT
 285: SELECT nct_id FROM conditions
 286: WHERE lower(name) LIKE '%{esc(cond)}%'</pre>
 287:     <p style="color:#cbd5e1;font-size:12.5px;">PubMed bridge: NCBI E-utilities + idconv API to fetch primary publication PMID and abstract for each NCT.</p>
 288:     <pre style="background:#0a0f1f;padding:12px;border-radius:6px;color:#bef264;font-size:12px;overflow-x:auto;">https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi?db=pubmed&term={esc(drug)}+AND+{esc(cond)}+AND+RCT</pre>
 289:     <p style="color:#94a3b8;font-size:11.5px;">Cross-checking: every NCT that survives intersection is verified to have a primary outcome declared in AACT <code>design_outcomes</code> AND a publication whose abstract mentions the drug or condition (GATE-D).</p>
 290:     """
 291: 
 292:     # -- Screening tab (PRISMA-style summary)
 293:     n_total = len(topic_audit["trials"])
 294:     n_pass = sum(1 for t in topic_audit["trials"] if all(t["gates"].values()))
 295:     n_excl = n_total - n_pass
 296:     by_gate_failure = {}
 297:     for t in topic_audit["trials"]:
 298:         if all(t["gates"].values()): continue
 299:         for g, ok in t["gates"].items():
 300:             if not ok:
 301:                 by_gate_failure[g] = by_gate_failure.get(g, 0) + 1
 302:                 break
 303:     excl_table = "".join(
 304:         f"<tr><td>{esc(g)}</td><td style='text-align:right;'>{n}</td></tr>"
 305:         for g, n in sorted(by_gate_failure.items(), key=lambda kv: -kv[1])
 306:     ) or "<tr><td colspan='2' style='color:#94a3b8;'>No exclusions.</td></tr>"
 307: 
 308:     screening_html = f"""
 309:     <h3 style="color:#7dd3fc;font-size:14px;margin-top:0;">PRISMA-style screening</h3>
 310:     <table class="kv">
 311:       <tr><td>Records identified (AACT Ã— PubMed)</td><td style="text-align:right;font-family:JetBrains Mono,monospace;">{n_total}</td></tr>
 312:       <tr><td>Records excluded (gate failure)</td><td style="text-align:right;font-family:JetBrains Mono,monospace;color:#fca5a5;">{n_excl}</td></tr>
 313:       <tr><td>Records included (all 6 gates pass)</td><td style="text-align:right;font-family:JetBrains Mono,monospace;color:#86efac;">{n_pass}</td></tr>
 314:     </table>
 315: 
 316:     <h3 style="color:#7dd3fc;font-size:14px;">Exclusions by first failing gate</h3>
 317:     <table class="kv">
 318:       <tr><th>Gate</th><th>n</th></tr>
 319:       {excl_table}
 320:     </table>
 321:     <p style="color:#94a3b8;font-size:11.5px;">Screening is fully deterministic: every record is auto-flagged by the gate that first fails. No subjective inclusion/exclusion decisions are made â€” the 6 gates are an objective machine-checkable contract.</p>
 322:     """
 323: 
 324:     # -- Extraction tab â€” 2x2 tables per trial
 325:     ext_rows = []
 326:     for t in trials:
 327:         pm_link = (f'<a href="https://pubmed.ncbi.nlm.nih.gov/{t["pmid"]}/" target="_blank">PMID {esc(t["pmid"])}</a>'
 328:                    if t["pmid"] else "â€”")
 329:         ct_link = f'<a href="https://clinicaltrials.gov/study/{esc(t["nct"])}" target="_blank">{esc(t["nct"])}</a>'
 330:         ext_rows.append(f"""
 331:         <div style="background:#1e293b;padding:14px;border-radius:6px;margin:0.6rem 0;">
 332:           <div style="display:flex;justify-content:space-between;align-items:start;flex-wrap:wrap;gap:8px;">
 333:             <div>
 334:               <strong style="font-size:14px;">{esc(t["acronym"])}</strong>
 335:               <span style="color:#94a3b8;font-size:11px;margin-left:8px;">{ct_link} Â· {pm_link} Â· {esc(t["year"]) or "â€”"}</span>
 336:             </div>
 337:           </div>
 338:           <p style="margin:6px 0 4px;color:#cbd5e1;font-size:12px;">{esc(t["title"])}</p>
 339:           <p style="margin:0 0 6px;color:#94a3b8;font-size:11px;"><strong>Primary outcome (AACT):</strong> {esc(t["primary_outcome"])}</p>
 340:           <table class="ext2x2">
 341:             <tr><th></th><th>Events</th><th>No event</th><th>Total N</th></tr>
 342:             <tr><td><strong>Intervention</strong></td><td>{t["tE"] if t["tE"] is not None else "â€”"}</td><td>{(t["tN"]-t["tE"]) if (t["tN"] is not None and t["tE"] is not None) else "â€”"}</td><td>{t["tN"] if t["tN"] is not None else "â€”"}</td></tr>
 343:             <tr><td><strong>Control</strong></td><td>{t["cE"] if t["cE"] is not None else "â€”"}</td><td>{(t["cN"]-t["cE"]) if (t["cN"] is not None and t["cE"] is not None) else "â€”"}</td><td>{t["cN"] if t["cN"] is not None else "â€”"}</td></tr>
 344:           </table>
 345:           {(f'<p style="margin:8px 0 0;color:#bef264;font-size:12px;"><strong>Published {esc(t["published_effect_type"])}:</strong> '
 346:               f'<span style="font-family:JetBrains Mono,monospace;">{t["published_effect_size"]} '
 347:               f'[{t["published_ci_lower"]}, {t["published_ci_upper"]}]</span> '
 348:               f'<span style="color:#94a3b8;font-size:11px;">(V2 RCT extractor on PubMed abstract)</span></p>'
 349:               f'<p style="margin:4px 0 0;color:#94a3b8;font-size:10.5px;font-style:italic;">"{esc(t.get("published_source_snippet") or "")[:200]}"</p>')
 350:               if t.get("published_effect_size") is not None else ''}
 351:         </div>""")
 352:     extraction_html = "\n".join(ext_rows) or '<p style="color:#94a3b8;">No trials included.</p>'
 353: 
 354:     # -- Analysis tab â€” forest + REML pool
 355:     forest = forest_svg(trials, pool)
 356:     if pool:
 357:         pool_block = f"""
 358:         <div style="background:#1e293b;padding:16px;border-radius:6px;margin:1rem 0;">
 359:           <h3 style="margin:0 0 8px;font-size:14px;color:#7dd3fc;">Pooled estimate (REML-DL + HKSJ, Cochrane v6.5)</h3>
 360:           <div style="font-size:24px;font-weight:600;font-family:JetBrains Mono,monospace;">
 361:             OR {pool["hr"]} <span style="font-size:14px;color:#94a3b8;">[{pool["lci"]}, {pool["uci"]}]</span>
 362:           </div>
 363:           <div style="font-size:11px;color:#94a3b8;margin-top:6px;">
 364:             k = {pool["k"]} Â· method = {pool["method"]} Â· Ï„Â² = {pool.get("tau2", "â€”")} Â·
 365:             Q = {pool.get("Q", "â€”")} Â· IÂ² = {pool.get("I2_pct", "â€”")}%
 366:           </div>
 367:         </div>"""
 368:     else:
 369:         pool_block = '<p style="color:#94a3b8;font-size:12px;">Insufficient event-count data for pooled estimate.</p>'
 370: 
 371:     # Leave-one-out chips
 372:     loo_chips = []
 373:     if pool and pool["k"] >= 3:
 374:         for i, t in enumerate(trials):
 375:             sub = [trial_log_or(x) for j, x in enumerate(trials) if j != i]
 376:             sub = [x for x in sub if x]
 377:             p = pool_reml_hksj(sub) if sub else None
 378:             if p:
 379:                 loo_chips.append(
 380:                     f'<div style="display:inline-block;padding:6px 10px;margin:3px;background:#1e293b;border-radius:14px;font-size:11px;color:#cbd5e1;">'
 381:                     f'omit <strong>{esc(t["acronym"])}</strong>: OR {p["hr"]} [{p["lci"]}, {p["uci"]}]</div>'
 382:                 )
 383:     loo_html = (f'<h3 style="color:#7dd3fc;font-size:14px;">Leave-one-out</h3><div>{"".join(loo_chips)}</div>'
 384:                 if loo_chips else '')
 385: 
 386:     analysis_html = f"""
 387:     <h3 style="color:#7dd3fc;font-size:14px;margin-top:0;">Forest plot â€” per-trial OR + pooled estimate</h3>
 388:     {forest}
 389:     {pool_block}
 390:     {loo_html}
 391:     """
 392: 
 393:     # -- Statistics tab (Cochrane v6.5 sensitivity diagnostics)
 394:     # Compute additional stats from the pool
 395:     stats_panels = []
 396: 
 397:     # Panel 0: Published vs Pooled (cross-check against trial-published abstracts)
 398:     pub_trials = [t for t in trials if t.get("published_effect_size") is not None]
 399:     if pub_trials:
 400:         rows = []
 401:         for t in pub_trials:
 402:             pet = t["published_effect_type"]
 403:             rows.append(
 404:                 f'<tr><td>{esc(t["acronym"])}</td>'
 405:                 f'<td>{esc(pet)}</td>'
 406:                 f'<td style="font-family:JetBrains Mono,monospace;text-align:right;">'
 407:                 f'{t["published_effect_size"]} [{t["published_ci_lower"]}, {t["published_ci_upper"]}]</td>'
 408:                 f'<td style="text-align:right;font-size:10px;color:#94a3b8;">PMID '
 409:                 f'<a href="https://pubmed.ncbi.nlm.nih.gov/{esc(t["pmid"])}/" target="_blank">{esc(t["pmid"])}</a></td></tr>'
 410:             )
 411:         pool_str = (f'<strong>Pooled (from AACT event counts): OR {pool["hr"]} '
 412:                      f'[{pool["lci"]}, {pool["uci"]}]</strong>') if pool else ""
 413:         stats_panels.append(f"""
 414:         <div class="stat-panel" style="grid-column:1/-1;">
 415:           <h4>0. Published vs Pooled cross-check</h4>
 416:           <p style="color:#cbd5e1;font-size:12px;">
 417:             {len(pub_trials)} of {len(trials)} trials had an extractable published
 418:             effect estimate in their PubMed abstract (V2 RCT extractor; HR/OR/RR/MD).
 419:             The pooled estimate is from AACT event counts (Woolf log-OR) and is
 420:             therefore a different estimand from the trial-published HR â€” agreement
 421:             at the rank/direction level is the integrity check.
 422:           </p>
 423:           <table style="width:100%;font-size:12px;">
 424:             <tr><th>Trial</th><th>Type</th><th>Published effect (95% CI)</th><th>Source</th></tr>
 425:             {"".join(rows)}
 426:           </table>
 427:           {f'<p style="margin-top:10px;color:#fbbf24;font-size:12px;">{pool_str}</p>' if pool_str else ''}
 428:         </div>""")
 429: 
 430:     # Panel 1: Heterogeneity
 431:     if pool and pool.get("k", 0) >= 2:
 432:         I2 = pool.get("I2_pct", 0)
 433:         tau2 = pool.get("tau2", 0)
 434:         Q = pool.get("Q", 0)
 435:         df = pool["k"] - 1
 436:         # Q-profile bounds for Ï„Â² (approximation: Â±2*SE_tau2)
 437:         I2_label = ("low (<25%)" if I2 < 25 else "moderate (25-50%)" if I2 < 50
 438:                     else "substantial (50-75%)" if I2 < 75 else "considerable (>75%)")
 439:         stats_panels.append(f"""
 440:         <div class="stat-panel">
 441:           <h4>1. Heterogeneity</h4>
 442:           <table class="kv">
 443:             <tr><td>Ï„Â² (DerSimonian-Laird)</td><td><code>{tau2}</code></td></tr>
 444:             <tr><td>Q-statistic</td><td><code>{Q}</code> (df={df})</td></tr>
 445:             <tr><td>IÂ²</td><td><code>{I2}%</code> â€” {I2_label}</td></tr>
 446:             <tr><td>Method</td><td>{esc(pool['method'])}</td></tr>
 447:           </table>
 448:         </div>""")
 449:     else:
 450:         stats_panels.append('<div class="stat-panel"><h4>1. Heterogeneity</h4><p style="color:#94a3b8;font-size:12px;">Requires kâ‰¥2 trials with event data.</p></div>')
 451: 
 452:     # Panel 2: Prediction interval (Cochrane v6.5 t_{k-1})
 453:     if pool and pool.get("k", 0) >= 3:
 454:         import math as _m
 455:         log_yhat = pool["log_yhat"]
 456:         se_pool = pool["se"]
 457:         # PI: log_yhat Â± t_{k-1} * sqrt(tauÂ² + SEÂ²) â€” Cochrane v6.5 Â§10.10.4.3
 458:         t_pi = {3: 4.303, 4: 3.182, 5: 2.776, 6: 2.571, 7: 2.447, 8: 2.365, 9: 2.306, 10: 2.262}.get(pool["k"]-1, 1.96)
 459:         pi_se = _m.sqrt(pool["tau2"] + se_pool**2)
 460:         pi_lo = round(_m.exp(log_yhat - t_pi*pi_se), 3)
 461:         pi_hi = round(_m.exp(log_yhat + t_pi*pi_se), 3)
 462:         stats_panels.append(f"""
 463:         <div class="stat-panel">
 464:           <h4>2. Prediction interval (Cochrane v6.5)</h4>
 465:           <p style="font-family:JetBrains Mono,monospace;font-size:14px;color:#cbd5e1;">95% PI: <strong>{pi_lo} â€“ {pi_hi}</strong></p>
 466:           <p style="color:#94a3b8;font-size:11.5px;">t<sub>k-1</sub> = {t_pi} Â· âˆš(Ï„Â² + SEÂ²) = {round(pi_se,3)} (Cochrane Handbook v6.5, Â§10.10.4.3).</p>
 467:         </div>""")
 468:     else:
 469:         stats_panels.append('<div class="stat-panel"><h4>2. Prediction interval</h4><p style="color:#94a3b8;font-size:12px;">Requires kâ‰¥3 trials (Cochrane v6.5).</p></div>')
 470: 
 471:     # Panel 3: Egger funnel asymmetry (kâ‰¥3 lower power, kâ‰¥10 recommended)
 472:     if len(yi_si) >= 3:
 473:         # Egger's regression: SND = (yi - 0) / sei  vs  precision = 1/sei
 474:         # Slope = bias estimate
 475:         import math as _m
 476:         snds = [(y/s, 1/s) for (y, s) in yi_si]
 477:         n = len(snds)
 478:         # Simple OLS slope
 479:         mean_x = sum(x for _, x in snds)/n
 480:         mean_y = sum(y for y, _ in snds)/n
 481:         num = sum((y - mean_y)*(x - mean_x) for y, x in snds)
 482:         den = sum((x - mean_x)**2 for _, x in snds)
 483:         slope = num/den if den > 0 else 0
 484:         # SE of slope (residual SE / sqrt(sum (x - mean_x)^2))
 485:         if n > 2 and den > 0:
 486:             yhat = [slope*x + (mean_y - slope*mean_x) for _, x in snds]
 487:             resid_ss = sum((y - yh)**2 for (y,_), yh in zip(snds, yhat))
 488:             se_slope = _m.sqrt(max(resid_ss/(n-2), 0)/den)
 489:             t_egger = slope/se_slope if se_slope > 0 else 0
 490:             p_egger_label = "p<0.05 (asymmetry)" if abs(t_egger) > 2.0 else "pâ‰¥0.05 (no asymmetry)"
 491:         else:
 492:             p_egger_label = "â€”"
 493:         stats_panels.append(f"""
 494:         <div class="stat-panel">
 495:           <h4>3. Egger's funnel asymmetry test</h4>
 496:           <table class="kv">
 497:             <tr><td>Slope (bias)</td><td><code>{round(slope,3)}</code></td></tr>
 498:             <tr><td>Test verdict</td><td>{p_egger_label}</td></tr>
 499:             <tr><td>Power note</td><td>{("recommended kâ‰¥10; current k=" + str(n) + " is exploratory.") if n < 10 else "adequately powered."}</td></tr>
 500:           </table>
 501:         </div>""")
 502:     else:
 503:         stats_panels.append('<div class="stat-panel"><h4>3. Egger\'s test</h4><p style="color:#94a3b8;font-size:12px;">Requires kâ‰¥3.</p></div>')
 504: 
 505:     # Panel 4: Leave-one-out (re-render from earlier loo_chips)
