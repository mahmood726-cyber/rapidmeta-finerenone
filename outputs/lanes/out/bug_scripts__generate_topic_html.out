  21: def _arm_order(per_arm):
  22:     """Group labels ordered TREATMENT FIRST by what the label says, not by the alphabet.
  23: 
  24:     AACT's per-arm map carries no role, so the label is all there is. A label naming a control
  25:     is put SECOND explicitly. Sorting was the bug: `BG_CONTROL` < `BG_EXPERIMENTAL`, and the
  26:     effect inverts silently. See ssot/arm_roles.py.
  27:     """
  28:     import sys as _s, os as _o
  29:     _s.path.insert(0, _o.path.join(_o.path.dirname(_o.path.dirname(_o.path.abspath(__file__))),
  30:                                    "ssot"))
  31:     from arm_roles import CONTROL as _CTRL
  32:     keys = list(per_arm.keys())
  33:     ctrl = [k for k in keys if any(w in str(k).lower() for w in _CTRL)]
  34:     rest = [k for k in keys if k not in ctrl]
  35:     return rest + ctrl if ctrl else keys
  36: 
  37: 
  38: def esc(s):
  39:     return htmllib.escape(str(s)) if s is not None else ""
  40: 
  41: 
  42: def pool_reml_hksj(yi_si):
  43:     yi_si = [(y, s) for y, s in yi_si if s > 0]
  44:     k = len(yi_si)
  45:     if k == 0: return None
  46:     yis = [y for y, _ in yi_si]; sis2 = [s*s for _, s in yi_si]
  47:     if k == 1:
  48:         return {"hr": round(math.exp(yis[0]),3), "k": 1,
  49:                 "lci": round(math.exp(yis[0]-1.96*math.sqrt(sis2[0])),3),
  50:                 "uci": round(math.exp(yis[0]+1.96*math.sqrt(sis2[0])),3),
  51:                 "method": "single-trial"}
  52:     wis_fe = [1.0/s2 for s2 in sis2]; sum_w = sum(wis_fe)
  53:     yhat_fe = sum(w*y for w, y in zip(wis_fe, yis)) / sum_w
  54:     Q = sum(w*(y-yhat_fe)**2 for w, y in zip(wis_fe, yis))
  55:     df = k - 1
  56:     c = sum_w - sum(w*w for w in wis_fe) / sum_w
  57:     tau2 = max(0.0, (Q - df) / c) if c > 0 else 0.0
  58:     wis_re = [1.0/(s2+tau2) for s2 in sis2]; sum_w_re = sum(wis_re)
  59:     yhat_re = sum(w*y for w, y in zip(wis_re, yis)) / sum_w_re
  60:     if k >= 3:
  61:         rss = sum(w*(y-yhat_re)**2 for w, y in zip(wis_re, yis))
  62:         var_h = max(rss/(k-1), 1.0) / sum_w_re
  63:         se = math.sqrt(var_h)
  64:         t_crit = {2: 12.706, 3: 4.303, 4: 3.182, 5: 2.776, 6: 2.571, 7: 2.447, 8: 2.365, 9: 2.306, 10: 2.262}
  65:         t = t_crit.get(k-1, 1.96)
  66:         method = "REML-DL-HKSJ"
  67:     else:
  68:         se = math.sqrt(1.0/sum_w_re); t = 1.96
  69:         method = "DL (k<3)"
  70:     return {"hr": round(math.exp(yhat_re),3), "k": k,
  71:             "lci": round(math.exp(yhat_re-t*se),3),
  72:             "uci": round(math.exp(yhat_re+t*se),3),
  73:             "tau2": round(tau2,4), "Q": round(Q,3),
  74:             "I2_pct": round(max(0.0, 100.0*(Q-df)/Q) if Q > 0 else 0.0, 1),
  75:             "method": method,
  76:             "log_yhat": yhat_re, "se": se}
  77: 
  78: 
  79: def trial_log_or(t):
  80:     try:
  81:         tE, tN, cE, cN = int(t["tE"]), int(t["tN"]), int(t["cE"]), int(t["cN"])
  82:     except: return None
  83:     if tN <= 0 or cN <= 0: return None
  84:     if tE <= 0 or cE <= 0 or tE >= tN or cE >= cN: return None
  85:     odds_t = tE / (tN - tE); odds_c = cE / (cN - cE)
  86:     if odds_t <= 0 or odds_c <= 0: return None
  87:     log_or = math.log(odds_t / odds_c)
  88:     se = math.sqrt(1.0/tE + 1.0/cE + 1.0/(tN-tE) + 1.0/(cN-cE))
  89:     return log_or, se
  90: 
  91: 
  92: def collect_trials(topic_audit):
  93:     trials = []
  94:     for t in topic_audit["trials"]:
  95:         if not all(t["gates"].values()): continue
  96:         ex = t["extracted"]
  97:         nct = ex["nct"]
  98:         acronym = ex.get("aact_acronym") or nct
  99:         per_arm = ex.get("aact_per_arm_counts", {})
 100:         # ARM ROLE IS READ, NEVER SORTED -- see ssot/arm_roles.py.
 101:         arm_codes = _arm_order(per_arm)
 102:         tN = per_arm.get(arm_codes[0]) if arm_codes else None
 103:         cN = per_arm.get(arm_codes[1]) if len(arm_codes) > 1 else None
 104:         outcome_rows = ex.get("aact_outcome_count_rows", [])
 105:         og_vals = {}
 106:         for og, v in outcome_rows:
 107:             if og not in og_vals:
 108:                 try: og_vals[og] = int(float(v))
 109:                 except: pass
 110:             if len(og_vals) >= 2: break
 111:         # ARM ROLE IS READ, NEVER SORTED -- see ssot/arm_roles.py.
 112:         og_sorted = _arm_order(og_vals)
 113:         tE = og_vals.get(og_sorted[0]) if og_sorted else None
 114:         cE = og_vals.get(og_sorted[1]) if len(og_sorted) > 1 else None
 115:         trials.append({
 116:             "nct": nct,
 117:             "acronym": acronym,
 118:             "title": (ex.get("aact_title") or "")[:160],
 119:             "pmid": ex.get("pmid"),
 120:             "year": ex.get("pubmed_year"),
 121:             "doi": ex.get("pubmed_doi") or "",
 122:             "interventions": ex.get("aact_intvs", [])[:3],
 123:             "conditions": ex.get("aact_conditions", [])[:3],
 124:             "primary_outcome": (ex.get("aact_primary_outcome_measure") or "")[:200],
 125:             "pubmed_title": (ex.get("pubmed_title") or "")[:200],
 126:             "tN": tN, "cN": cN, "tE": tE, "cE": cE,
 127:             "published_effect_type": ex.get("published_effect_type"),
 128:             "published_effect_size": ex.get("published_effect_size"),
 129:             "published_ci_lower": ex.get("published_ci_lower"),
 130:             "published_ci_upper": ex.get("published_ci_upper"),
 131:             "published_source_snippet": ex.get("published_source_snippet"),
 132:         })
 133:     return trials
