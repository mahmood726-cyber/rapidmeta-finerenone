 137: 
 138: 
 139: def main():
 140:     sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
 141:     from collections import Counter
 142:     scr = json.load(io.open(os.path.join(REPO, "evidence", "2026-08-19-batch1",
 143:                                           "apixaban_split_screening.json"), encoding="utf-8"))
 144:     rc = 0
 145:     out = {"adjudicated_utc": "2026-08-19", "boundary_rule": (
 146:         "EXTENDED ANTICOAGULATION IN PATIENTS WHO HAVE ALREADY HAD A VTE IS TREATMENT; PRIMARY "
 147:         "PROPHYLAXIS IN PATIENTS WHO HAVE NOT IS PREVENTION. The discriminator is whether the "
 148:         "patient has already had the event, read from eligibility and description, because "
 149:         "primaryPurpose does not carry it and both registrant conventions are used for both."),
 150:         "topics": {}}
 151: 
 152:     for topic in (T, P):
 153:         need = {r["nct"] for r in scr[topic]["trials"]
 154:                 if r["verdict"] == "NEEDS_ADJUDICATION"}
 155:         mine = [(n, v, w) for (tp, n, v, w) in ROWS if tp == topic]
 156:         got = {n for n, _v, _w in mine}
 157:         missing, extra = sorted(need - got), sorted(got - need)
 158:         print("--- %s: %d to adjudicate, %d rows" % (topic, len(need), len(mine)))
 159:         if missing:
 160:             print("   REFUSED: no row for %s" % missing)
 161:             rc = 1
 162:         if extra:
 163:             print("   REFUSED: rows for trials not needing adjudication: %s" % extra)
 164:             rc = 1
 165:         tally = Counter(v for _n, v, _w in mine)
 166:         for k, v in tally.most_common():
 167:             print("   %-34s %2d" % (k, v))
 168:         out["topics"][topic] = {"n": len(mine), "tally": dict(tally),
 169:                                 "trials": [{"nct": n, "verdict": v, "why": w}
 170:                                            for n, v, w in mine]}
 171:     if rc:
 172:         return rc
 173: 
 174:     # The headline consequence, computed rather than asserted.
 175:     for topic in (T, P):
 176:         base = scr[topic]["tally"]["ELIGIBLE_POOLABLE_NOT_INCLUDED"]
 177:         added = out["topics"][topic]["tally"].get("ELIGIBLE_POOLABLE_NOT_INCLUDED", 0)
 178:         out["topics"][topic]["eligible_poolable_total"] = base + added
 179:         print("\n%s: ELIGIBLE_POOLABLE_NOT_INCLUDED %d + %d adjudicated = %d"
 180:               % (topic, base, added, base + added))
 181:     with io.open(DEST, "w", encoding="utf-8") as fh:
 182:         fh.write(json.dumps(out, indent=1))
 183:     print("\nwrote %s" % DEST)
 184:     print("\nREMAINDER AFTER ADJUDICATION: 0 on both reviews.")
 185:     return 0
 186: 
 187: 
 188: if __name__ == "__main__":
 189:     sys.exit(main())

