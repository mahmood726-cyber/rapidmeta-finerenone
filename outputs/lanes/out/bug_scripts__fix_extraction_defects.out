   1: """Master fixer for extraction-audit P0/P1 defects.
   2: 
   3: Applies four fixes in one pass per affected review HTML:
   4: 
   5:   Fix-1  QUARANTINE-SYNTHETIC: remove every trial matching the 4-of-4 LLM
   6:          synthetic fingerprint (NCT in NCT05000xxx/NCT06xxxxxxxx blocks +
   7:          empty/missing PMID + year â‰¥ 2024 + baseline.n == 2 Ã— tN).
   8: 
   9:   Fix-2  QUARANTINE-LIKELY-SYNTHETIC: remove every trial matching 3-of-4
  10:          (real-looking NCT but the other three smoking-gun fields). Agent 6
  11:          spot-check confirmed 0/8 are genuine.
  12: 
  13:   Fix-3  NULL-FAKE-PMID: set `pmid: null` for trials whose pmid matches the
  14:          fabricated /^379377[67]\\d[a-zA-Z]+$/ family.
  15: 
  16:   Fix-4  CAP-EVENTS: where tE > tN or cE > cN AND the trial is NOT in the
  17:          quarantine set (so it's a real-anchor trial with a numeric error),
  18:          cap events at the corresponding N and append an audit note.
  19: 
  20: Quarantined trials are archived to
  21:   outputs/extraction_audit/quarantine/<REVIEW_STEM>.json
  22: so the action is reversible.
  23: 
  24: Idempotent: re-running on already-fixed HTML yields zero further mutations.
  25: 
  26: Usage:
  27:   python scripts/fix_extraction_defects.py --dry-run    # report only
  28:   python scripts/fix_extraction_defects.py              # apply
  29: """
  30: from __future__ import annotations
  31: import argparse
  32: import csv
  33: import io
  34: import json
  35: import re
  36: import sys
  37: from pathlib import Path
  38: 
  39: if sys.platform == "win32" and hasattr(sys.stdout, "buffer"):
  40:     try:
  41:         sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
  42:     except Exception:
  43:         pass
  44: 
  45: # Re-use the extractor's JS-object â†’ JSON converter
  46: sys.path.insert(0, str(Path(__file__).resolve().parent))
  47: from extract_realdata import find_balanced_object, js_object_to_json, extract_var  # noqa: E402
  48: 
  49: REPO = Path(__file__).resolve().parent.parent
  50: DATA_DIR = REPO / "outputs" / "extraction_audit" / "data"
  51: QUARANTINE_DIR = REPO / "outputs" / "extraction_audit" / "quarantine"
  52: QUARANTINE_DIR.mkdir(parents=True, exist_ok=True)
  53: SWEEP_FILE = REPO / "outputs" / "synthetic_fixture_sweep.json"
  54: FINDINGS_CSV = REPO / "outputs" / "extraction_audit" / "findings.csv"
  55: FIX_REPORT = REPO / "outputs" / "extraction_audit" / "fix_report.json"
  56: 
  57: FAKE_PMID_RE = re.compile(r"^\d+[a-zA-Z]+$")  # any digits-then-letters PMID is malformed
  58:                                                 # (real PMIDs are pure integers; the
  59:                                                 # 37937770[a-z]/37937775[a-z]/37937760[a-z]
  60:                                                 # families all match this)
  61: SYNTH_NCT_5_RE = re.compile(r"^NCT05000\d{3}$")  # NCT05000xxx synthetic block
  62: SYNTH_NCT_6_RE = re.compile(r"^NCT06\d{7}$")     # NCT06xxxxxxx (only ~22 in corpus, all synth)
  63: 
  64: 
  65: def _is_finite(x) -> bool:
  66:     return isinstance(x, (int, float)) and not isinstance(x, bool)
  67: 
  68: 
  69: def trial_synthetic_fingerprint(nct: str, t: dict) -> int:
  70:     """Return how many of the 4 fingerprint criteria the trial hits.
  71:     >= 3 â†’ quarantine.
  72:     """
  73:     score = 0
  74:     # C1: synthetic NCT range
  75:     if SYNTH_NCT_5_RE.match(nct) or SYNTH_NCT_6_RE.match(nct):
  76:         score += 1
  77:     # C2: empty/null/non-numeric PMID OR fake-PMID family
  78:     pmid = t.get("pmid")
  79:     if pmid in (None, ""):
  80:         score += 1
  81:     elif isinstance(pmid, str) and FAKE_PMID_RE.match(pmid):
  82:         score += 1
  83:     elif isinstance(pmid, str) and not pmid.strip().isdigit():
  84:         score += 1
  85:     # C3: year 2024+
  86:     yr = t.get("year")
  87:     if _is_finite(yr) and yr >= 2024:
  88:         score += 1
  89:     # C4: baseline.n exactly == 2 Ã— tN (un-reconciled halving)
  90:     base = t.get("baseline") or {}
  91:     base_n = base.get("n") if isinstance(base, dict) else None
  92:     tN = t.get("tN")
  93:     if _is_finite(base_n) and _is_finite(tN) and tN > 0 and base_n == 2 * tN:
  94:         score += 1
  95:     return score
  96: 
  97: 
  98: def trial_has_fake_pmid(t: dict) -> bool:
  99:     pmid = t.get("pmid")
 100:     return isinstance(pmid, str) and bool(FAKE_PMID_RE.match(pmid))
 101: 
 102: 
 103: def trial_has_events_over_n(t: dict) -> tuple[bool, bool]:
 104:     """Returns (tE_bad, cE_bad). Bad means: tE > tN, tE < 0, or tN â‰¤ 0
 105:     (likewise for cE/cN). Negative events indicate field overload (MD
 106:     stored in the event slot)."""
 107:     tE, tN, cE, cN = (t.get(k) for k in ("tE", "tN", "cE", "cN"))
 108:     tE_bad = _is_finite(tE) and _is_finite(tN) and tN > 0 and (tE > tN or tE < 0)
 109:     cE_bad = _is_finite(cE) and _is_finite(cN) and cN > 0 and (cE > cN or cE < 0)
 110:     return tE_bad, cE_bad
 111: 
 112: 
 113: def serialize_realdata_js(rd: dict) -> str:
 114:     """Emit a clean JS object literal for the realData value.
 115:     Strategy: JSON is a subset of JS for object literals â€” JS engines parse
 116:     JSON-formatted text as a valid object literal. ensure_ascii=False keeps
 117:     non-ASCII characters readable in the source.
 118:     """
 119:     return json.dumps(rd, indent=2, ensure_ascii=False)
 120: 
 121: 
 122: def find_realdata_block(text: str) -> tuple[int, int] | None:
 123:     """Locate the value-side of `realData: { ... }` (object literal property)
 124:     or `var/const/let realData = { ... }` (declaration). Returns (start, end)
 125:     of the object literal (start at `{`, end after `}`).
 126:     """
 127:     pat_decl = re.compile(r"(?:const|var|let)\s+realData\s*=\s*(?=\{)")
 128:     m = pat_decl.search(text)
 129:     if m:
 130:         start = m.end()
 131:         end = find_balanced_object(text, start)
 132:         if end > 0:
 133:             return start, end
 134:     pat_prop = re.compile(r"(?<![\w.])realData\s*:\s*(?=\{)")
 135:     for m in pat_prop.finditer(text):
 136:         start = m.end()
 137:         end = find_balanced_object(text, start)
 138:         if end > 0:
 139:             block = text[start:end]
 140:             if "NCT" in block or "ISRCTN" in block or "LEGACY" in block or len(block) > 300:
 141:                 return start, end
 142:     return None
 143: 
 144: 
 145: def fix_review(review_stem: str, dry_run: bool) -> dict:
 146:     """Apply all four fixes to one review HTML file. Returns a per-review report."""
 147:     html_path = REPO / f"{review_stem}.html"
 148:     data_path = DATA_DIR / f"{review_stem}.json"
 149:     report = {
 150:         "review": review_stem,
 151:         "quarantined_synthetic": [],   # NCTs hard-removed (synthetic fingerprint â‰¥ 3)
 152:         "nulled_pmids": [],             # NCTs with fake PMID nulled
 153:         "capped_events": [],            # NCTs with tE/cE capped at N
 154:         "skipped_reason": None,
 155:     }
 156:     if not html_path.exists():
 157:         report["skipped_reason"] = "html missing"
 158:         return report
 159:     if not data_path.exists():
 160:         report["skipped_reason"] = "data json missing"
 161:         return report
 162: 
 163:     doc = json.loads(data_path.read_text(encoding="utf-8"))
 164:     rd = doc.get("realData")
 165:     if not isinstance(rd, dict):
 166:         report["skipped_reason"] = "realData not parsed"
 167:         return report
 168: 
 169:     # Identify trials
 170:     quarantine_keys: list[str] = []
 171:     nulled_keys: list[str] = []
 172:     cap_actions: list[tuple[str, dict, str]] = []  # (nct, action, reason)
 173: 
 174:     for nct, t in list(rd.items()):
 175:         if not isinstance(t, dict):
 176:             continue
 177:         score = trial_synthetic_fingerprint(nct, t)
 178:         if score >= 3:
 179:             quarantine_keys.append(nct)
 180:             continue
 181:         # Real-anchor trial path
 182:         if trial_has_fake_pmid(t):
 183:             nulled_keys.append(nct)
 184:         tE_bad, cE_bad = trial_has_events_over_n(t)
 185:         if tE_bad or cE_bad:
 186:             cap_actions.append((nct, t, f"tE_bad={tE_bad} cE_bad={cE_bad}"))
 187: 
 188:     if not (quarantine_keys or nulled_keys or cap_actions):
 189:         return report  # nothing to do
 190: 
 191:     # Build mutated realData
 192:     mutated = {}
 193:     quarantined_archive = {}
 194:     for nct, t in rd.items():
 195:         if nct in quarantine_keys:
 196:             quarantined_archive[nct] = t
 197:             continue
 198:         new_t = dict(t) if isinstance(t, dict) else t
 199:         if nct in nulled_keys:
 200:             new_t["pmid"] = None
 201:             note = f"(audit 2026-05-10: PMID was {t.get('pmid')!r} â€” fabricated 37937770/5 family; nulled)"
 202:             new_t.setdefault("_audit_notes", []).append(note)
 203:         # Caps
 204:         for cap_nct, cap_t, _reason in cap_actions:
 205:             if cap_nct != nct:
 206:                 continue
 207:             tE, tN, cE, cN = (new_t.get(k) for k in ("tE", "tN", "cE", "cN"))
 208:             cap_note_parts = []
 209:             if _is_finite(tE) and _is_finite(tN) and tN > 0:
 210:                 if tE < 0:
 211:                     cap_note_parts.append(f"tE {tE}â†’null (negative â€” field-overload MD)")
 212:                     new_t["tE"] = None
 213:                 elif tE > tN:
 214:                     cap_note_parts.append(f"tE {tE}â†’{tN}")
 215:                     new_t["tE"] = tN
 216:             if _is_finite(cE) and _is_finite(cN) and cN > 0:
 217:                 if cE < 0:
 218:                     cap_note_parts.append(f"cE {cE}â†’null (negative â€” field-overload MD)")
 219:                     new_t["cE"] = None
 220:                 elif cE > cN:
 221:                     cap_note_parts.append(f"cE {cE}â†’{cN}")
 222:                     new_t["cE"] = cN
 223:             if cap_note_parts:
 224:                 note = "(audit 2026-05-10: events>N capped â€” " + ", ".join(cap_note_parts) + ")"
 225:                 new_t.setdefault("_audit_notes", []).append(note)
 226:         mutated[nct] = new_t
 227: 
 228:     # Locate the realData block in HTML and replace
 229:     text = html_path.read_text(encoding="utf-8", errors="replace")
 230:     block = find_realdata_block(text)
 231:     if block is None:
 232:         report["skipped_reason"] = "realData block not found in HTML"
 233:         return report
 234:     start, end = block
 235:     new_block = serialize_realdata_js(mutated)
 236:     new_text = text[:start] + new_block + text[end:]
 237: 
 238:     report["quarantined_synthetic"] = quarantine_keys
 239:     report["nulled_pmids"] = nulled_keys
 240:     report["capped_events"] = [n for n, _, _ in cap_actions]
 241: 
 242:     if dry_run:
 243:         return report
 244: 
 245:     # Archive quarantined trials
 246:     if quarantined_archive:
 247:         qpath = QUARANTINE_DIR / f"{review_stem}.json"
 248:         existing = {}
 249:         if qpath.exists():
 250:             try:
 251:                 existing = json.loads(qpath.read_text(encoding="utf-8"))
 252:             except Exception:
 253:                 existing = {}
 254:         existing.update(quarantined_archive)
 255:         qpath.write_text(json.dumps(existing, indent=2, ensure_ascii=False), encoding="utf-8")
 256:     # Write modified HTML
 257:     html_path.write_text(new_text, encoding="utf-8")
 258:     return report
 259: 
 260: 
 261: def main() -> None:
 262:     ap = argparse.ArgumentParser()
 263:     ap.add_argument("--dry-run", action="store_true", help="don't write any files")
 264:     ap.add_argument("--limit", type=int, default=0, help="only process N reviews (debug)")
 265:     args = ap.parse_args()
 266: 
 267:     index = json.loads((DATA_DIR / "_index.json").read_text(encoding="utf-8"))
 268:     targets = [e for e in index if e.get("has_realData")]
 269:     if args.limit:
 270:         targets = targets[: args.limit]
 271:     print(f"Targets: {len(targets)} reviews{' (DRY RUN)' if args.dry_run else ''}")
 272:     reports: list[dict] = []
 273:     n_quarantined_trials = 0
 274:     n_nulled_pmids = 0
 275:     n_capped = 0
 276:     n_reviews_touched = 0
 277:     n_reviews_skipped = 0
 278:     for entry in targets:
 279:         try:
 280:             r = fix_review(entry["stem"], args.dry_run)
 281:         except Exception as e:
