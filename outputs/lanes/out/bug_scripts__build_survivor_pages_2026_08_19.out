  82:  body{font:16px/1.62 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;max-width:56rem;
  83:       margin:0 auto;padding:2.5rem 1.25rem 5rem;background:var(--bg);color:var(--fg)}
  84:  h1{font-size:1.5rem;line-height:1.28;margin:.4rem 0 .2rem}
  85:  h2{font-size:1.05rem;margin:2.4rem 0 .6rem;padding-bottom:.3rem;
  86:     border-bottom:1px solid var(--line)}
  87:  .tag{display:inline-block;font:600 .7rem/1 system-ui;letter-spacing:.09em;
  88:       text-transform:uppercase;padding:.4rem .6rem;border:1px solid currentColor;
  89:       border-radius:.25rem;opacity:.8;color:var(--warn)}
  90:  .q{font-size:1.06rem;margin:1rem 0;padding:1rem 1.1rem;border-left:3px solid currentColor}
  91:  .sub{color:var(--mut);font-size:.94rem}
  92:  .wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;margin:.8rem 0}
  93:  table{border-collapse:collapse;width:100%;min-width:38rem;font-size:.9rem}
  94:  th,td{text-align:left;padding:.5rem .6rem;border-bottom:1px solid var(--line);
  95:        vertical-align:top}
  96:  th{font-weight:600;white-space:nowrap}
  97:  td.n{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
  98:  .why{margin:.9rem 0;padding:.85rem 1rem;border:1px solid var(--line);border-radius:.3rem}
  99:  a.go{display:inline-block;margin:.4rem .6rem .4rem 0;padding:.6rem 1rem;
 100:       border:1px solid currentColor;border-radius:.3rem;text-decoration:none;font-weight:600}
 101:  footer{margin-top:3rem;padding-top:1rem;border-top:1px solid var(--line);
 102:         color:var(--mut);font-size:.86rem}
 103:  code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.9em}
 104: """
 105: 
 106: 
 107: def esc(s):
 108:     return (str(s if s is not None else "")
 109:             .replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
 110:             .replace('"', "&quot;"))
 111: 
 112: 
 113: def load(topic):
 114:     with io.open(os.path.join(REPO, "ssot", topic, topic + ".json"),
 115:                  "r", encoding="utf-8") as fh:
 116:         return json.load(fh)
 117: 
 118: 
 119: def num(v):
 120:     return "{:,}".format(v) if isinstance(v, int) else "&mdash;"
 121: 
 122: 
 123: def primary_of(t):
 124:     for k in ("outcome_definition", "registered_primary_title"):
 125:         if t.get(k):
 126:             return t[k]
 127:     ps = t.get("registered_primaries") or []
 128:     return ps[0] if ps else None
 129: 
 130: 
 131: def trials_table(o):
 132:     rows = []
 133:     for t in (o.get("inputs") or {}).get("trials") or []:
 134:         sec = t.get("registered_secondaries")
 135:         rows.append(
 136:             "<tr><td><code>%s</code></td><td>%s</td><td class='n'>%s</td><td>%s</td>"
 137:             "<td class='n'>%s</td></tr>"
 138:             % (esc(t.get("nct") or t.get("id")),
 139:                esc(t.get("name") or ""),
 140:                num((t.get("analysed") or {}).get("treatment")
 141:                    if isinstance(t.get("analysed"), dict) else t.get("enrollment")),
 142:                esc(primary_of(t) or "(not recorded on this object)"),
 143:                len(sec) if isinstance(sec, list) else "&mdash;"))
 144:     return "\n".join(rows)
 145: 
 146: 
 147: def page(topic, spec, o):
 148:     pr = ((o.get("results") or {}).get("by_outcome") or {}).get("primary") or {}
 149:     pl = pr.get("pooled") or {}
 150:     sup = pr.get("pooled_superseded")
 151:     trials = (o.get("inputs") or {}).get("trials") or []
 152: 
 153:     withdrawn = ""
 154:     if pl.get("withdrawn") and sup:
 155:         withdrawn = (
 156:             "<h2>The estimate that was withdrawn</h2>"
 157:             "<div class='why'><p>This review served "
 158:             "<code>%s %.4g (%.4g&ndash;%.4g)</code> at k=%s, computed with "
 159:             "<code>%s</code>. It is <strong>withdrawn</strong> and kept on the object under "
 160:             "<code>pooled_superseded</code> rather than deleted &mdash; what a reader saw is "
 161:             "the evidence for the withdrawal, not something to tidy away.</p>"
 162:             "<p class='sub'>%s</p></div>"
 163:             % (esc(sup.get("measure") or "OR"), sup.get("point"), sup.get("ci_low"),
 164:                sup.get("ci_high"), pr.get("k"), esc(pr.get("estimator") or "unrecorded"),
 165:                esc(pr.get("pooled_superseded_because") or pl.get("withdrawn_reason") or "")))
 166: 
 167:     verbatim = ""
 168:     cmp_ = pr.get("registered_primaries_compared_verbatim")
 169:     if cmp_:
 170:         items = "".join("<li><code>%s</code><br>%s</li>" % (esc(k), esc(v))
 171:                         for k, v in cmp_.items() if k.startswith("NCT"))
 172:         verbatim = ("<h2>The registered primaries, verbatim</h2>"
 173:                     "<p>Read from ClinicalTrials.gov on %s, from "
 174:                     "<code>%s</code>. Compared on their components, not on their names.</p>"
 175:                     "<ul>%s</ul>" % (esc(cmp_.get("read_utc")), esc(cmp_.get("source")), items))
 176: 
 177:     notestab = pr.get("what_this_verdict_does_not_establish") or (
 178:         "NOT that any trial here is poor, and NOT that no poolable question exists in this "
 179:         "area. Only that this review does not publish a pooled estimate as it stands.")
 180: 
 181:     return """<!doctype html>
 182: <html lang="en"><head>
 183: <meta charset="utf-8">
 184: <meta name="viewport" content="width=device-width,initial-scale=1">
 185: <title>{title}</title>
 186: <meta name="rapidmeta:page-state" content="LIVE">
 187: <meta name="rapidmeta:pooled-estimate" content="NONE">
 188: <meta name="description" content="{desc}">
 189: <style>{css}</style>
 190: </head><body>
 191: <span class="tag">No pooled estimate</span>
 192: <h1>{title}</h1>
 193: <p class="sub">{headline}</p>
 194: 
 195: <div class="q"><strong>Question.</strong> {question}</div>
 196: 
 197: <h2>Why this review publishes no pooled estimate</h2>
 198: <div class="why">{why}</div>
 199: {withdrawn}
 200: {verbatim}
 201: 
 202: <h2>The {k} trial(s) in this review</h2>
 203: <div class="wrap"><table>
 204: <thead><tr><th>Registration</th><th>Trial</th><th>Analysed / enrolled</th>
 205: <th>Registered primary</th><th>Secondaries recorded</th></tr></thead>
 206: <tbody>
 207: {rows}
 208: </tbody></table></div>
 209: 
 210: <h2>What this review does not establish</h2>
 211: <p>{notestab}</p>
 212: 
 213: <footer>
 214: Built 2026-08-19 by <code>scripts/build_survivor_pages_2026_08_19.py</code> from
 215: <code>ssot/{topic}/{topic}.json</code>. Every figure on this page is read from that object;
 216: none is typed into the page. This review is the surviving topic of a merge with
 217: <code>{retires}</code>, and this page exists so that the merge does not retire a page-bearing
 218: topic in favour of one with no page.
 219: </footer>
 220: </body></html>
 221: """.format(css=CSS, title=esc(o.get("title") or topic),
 222:            desc=esc((o.get("question") or "")[:150]),
 223:            headline=esc(re.sub("<[^>]+>", "", spec["headline"])),
 224:            question=esc(o.get("question") or "(no question is recorded on this object)"),
 225:            why=esc(spec["why"]), withdrawn=withdrawn, verbatim=verbatim,
 226:            k=len(trials), rows=trials_table(o), notestab=esc(notestab),
 227:            topic=esc(topic), retires=esc(spec["retires"]))
 228: 
 229: 
 230: def run(apply_it):
 231:     built = {}
 232:     for topic, spec in sorted(SURVIVORS.items()):
 233:         o = load(topic)
 234:         if R.is_retired(o):
 235:             print("REFUSED: %s is already RETIRED; it cannot be a survivor." % topic)
 236:             return 1
 237:         html = page(topic, spec, o)
 238:         built[spec["page"]] = html
 239:         k = len((o.get("inputs") or {}).get("trials") or [])
 240:         print("  %-40s %6d bytes  k=%d  <- retires %s"
 241:               % (spec["page"], len(html.encode("utf-8")), k, spec["retires"]))
 242: 
 243:     # THE DEFINITION regression_check.py HOLDS, asserted here rather than discovered at push.
 244:     bad = []
 245:     for pg, html in built.items():
 246:         if "No pooled estimate" not in html:
 247:             bad.append("%s: does not say so where a reader sees it" % pg)
 248:         if not re.search(r"NCT\d{8}", html):
 249:             bad.append("%s: names no trial" % pg)
 250:         for href in re.findall(r'class="go" href="([^"]+)"', html):
 251:             if not os.path.exists(os.path.join(REPO, href)):
 252:                 bad.append("%s: links to %s which does not exist" % (pg, href))
 253:     if bad:
 254:         print("\nREFUSED -- these would fail the regression check:")
 255:         for b in bad:
 256:             print("   %s" % b)
 257:         return 1
 258:     print("\n  all pages satisfy the no-pool review definition")
 259: 
 260:     # THE GUARD THAT WOULD HAVE PREVENTED A DESTRUCTIVE OVERWRITE. A page this builder is about
 261:     # to write must NOT already exist. Acting on a deferral that said "THE SURVIVOR HAS NO
 262:     # PAGE", this script wrote a 7.6 KB stub over a 722 KB live dashboard and took the RETIREE's
 263:     # live URL for the survivor. Both were reverted from HEAD. No amount of care in the template
 264:     # protects against writing to the wrong filename -- only refusing to overwrite does.
 265:     clash = [pg for pg in built if os.path.exists(os.path.join(REPO, pg))]
 266:     if clash:
 267:         print("\nREFUSED -- these pages already exist and would be OVERWRITTEN:")
 268:         for c in clash:
 269:             print("   %-44s %d bytes" % (c, os.path.getsize(os.path.join(REPO, c))))
 270:         print("   A builder must never write over a page it did not create. Choose a name that "
 271:               "collides with nothing, or MAP the existing page instead of rebuilding it.")
 272:         return 1
 273: 
 274:     if not apply_it:
 275:         print("\nDRY RUN -- nothing written. Re-run with --apply.")
 276:         return 0
 277: 
 278:     for pg, html in sorted(built.items()):
 279:         with io.open(os.path.join(REPO, pg), "w", encoding="utf-8", newline="") as fh:
 280:             fh.write(html)
 281:     pmp = os.path.join(REPO, "ssot", "PAGE_MAP.json")
 282:     with io.open(pmp, "r", encoding="utf-8") as fh:
 283:         pmap = json.load(fh)
 284:     for topic, spec in SURVIVORS.items():
 285:         pmap[spec["page"]] = "ssot/%s/%s.json" % (topic, topic)
 286:     # A CORRECTION, NOT A BUILD. Two survivors' pages existed on disk and were simply absent
 287:     # from PAGE_MAP, which is why the executor reported them as having no page at all.
 288:     for topic, pg in MAP_ONLY.items():
 289:         if not os.path.exists(os.path.join(REPO, pg)):
 290:             print("REFUSED: %s would be mapped to %s, which is not on disk." % (topic, pg))
 291:             return 1
 292:         pmap[pg] = "ssot/%s/%s.json" % (topic, topic)
 293:         print("  mapped (EXISTING page, not rebuilt)  %-38s -> %s" % (pg, topic))
 294:     with io.open(pmp, "w", encoding="utf-8", newline="") as fh:
 295:         fh.write(json.dumps(pmap, indent=1, ensure_ascii=False, sort_keys=True))
 296:     print("\nwrote %d page(s); PAGE_MAP updated" % len(built))
 297:     return 0
 298: 
 299: 
 300: def selftest():
 301:     fails = []
 302: 
 303:     def ck(n, got, want):
 304:         ok = got == want
 305:         print("  %-64s %s  %r" % (n, "ok" if ok else "FAIL", got))
 306:         if not ok:
 307:             fails.append(n)
 308: 
 309:     print("1. ESCAPING AND ABSENCE:")
 310:     ck("markup cannot be injected from a registry string",
 311:        esc("<b>x</b>"), "&lt;b&gt;x&lt;/b&gt;")
 312:     ck("an absent count is a dash, not a zero", num(None), "&mdash;")
 313: 
 314:     print("\n2. THE k=1 PAGE SAYS SO, rather than rendering an interval of one:")
 315:     o = load("mavacamten-ohcm-review")
 316:     h = page("mavacamten-ohcm-review", SURVIVORS["mavacamten-ohcm-review"], o)
 317:     ck("one trial", len((o.get("inputs") or {}).get("trials") or []), 1)
 318:     ck("and the page states a meta-analysis needs two",
 319:        "at least two studies" in h, True)
 320:     ck("...and declares it publishes nothing", 'content="NONE"' in h, True)
 321: 
 322:     print("\n3. THE WITHDRAWN ESTIMATE IS SHOWN AS WITHDRAWN, not hidden:")
 323:     o = load("pcsk9-inhibitors-cv-review")
 324:     h = page("pcsk9-inhibitors-cv-review", SURVIVORS["pcsk9-inhibitors-cv-review"], o)
 325:     ck("the old value appears on the page", "0.844" in h, True)
 326:     ck("labelled withdrawn", "withdrawn</strong>" in h, True)
 327:     ck("and both composites are quoted verbatim", "Revascularization" in h, True)
 328:     ck("...with the trial that does NOT count it named",
 329:        "NCT01663402" in h, True)
 330: 
 331:     print("\n4. EVERY PAGE MEETS THE NO-POOL REVIEW DEFINITION:")
 332:     for t, s in sorted(SURVIVORS.items()):
 333:         hh = page(t, s, load(t))
 334:         ck("%s says it where a reader sees it" % t, "No pooled estimate" in hh, True)
 335:         ck("%s names a trial" % t, bool(re.search(r"NCT\d{8}", hh)), True)
 336: 
 337:     print("\n%s" % ("SELFTEST FAILED: %s" % fails if fails else "SELFTEST PASSED"))
 338:     return 1 if fails else 0
 339: 
 340: 
 341: if __name__ == "__main__":
 342:     sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
 343:     if "--selftest" in sys.argv:
 344:         sys.exit(selftest())
 345:     sys.exit(run("--apply" in sys.argv))

