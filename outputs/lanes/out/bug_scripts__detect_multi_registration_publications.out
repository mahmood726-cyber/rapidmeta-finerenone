 227:             "the_rest_are_shared_citations": len(hits) - len(informative),
 228:             "classified_PARENT_AND_SUBSTUDY": len(infl),
 229:             "classified_TWO_TRIALS_ONE_REPORT": len(twot),
 230:             "UNCLASSIFIED": len(unkn),
 231:             "k_inflation_confirmed_so_far": len(infl),
 232:         },
 233:         "hits_informative_stratum": informative,
 234:         "hits_all": hits,
 235:         "status": "LOWER BOUND -- see blind_spot_NAMED.",
 236:     }
 237:     print("")
 238:     print("publications listed by MORE THAN ONE registration: %d" % len(hits))
 239:     print("   of which TWO OR MORE call it their OWN report (RESULT/DERIVED): %d" % len(informative))
 240:     print("   the rest are shared citations (BACKGROUND): %d" % (len(hits) - len(informative)))
 241:     print("")
 242:     print("THE INFORMATIVE STRATUM:")
 243:     for h in informative:
 244:         print("   PMID %-9s %-30s %s"
 245:               % (h["pmid"], ",".join(h["registrations_listing_it"]),
 246:                  h["classification"]["shape"]))
 247:     print("")
 248:     print("   PARENT_AND_SUBSTUDY (k inflated) : %d" % len(infl))
 249:     print("   TWO_TRIALS_ONE_REPORT (k correct): %d" % len(twot))
 250:     print("   UNCLASSIFIED (needs a read)      : %d" % len(unkn))
 251: 
 252:     if apply_it:
 253:         with io.open(OUT, "w", encoding="utf-8", newline="") as fh:
 254:             fh.write(json.dumps(doc, indent=1, ensure_ascii=False))
 255:         print("wrote %s" % os.path.relpath(OUT, REPO))
 256:     return 0
 257: 
 258: 
 259: if __name__ == "__main__":
