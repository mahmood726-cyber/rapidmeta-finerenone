 517: # ==========================================================================
 518: # Returning-visitor safety: purge quarantined rows from PERSISTED state.
 519: #
 520: # Emptying realData stops a FRESH visitor pooling the withdrawn rows, but the
 521: # app persists state.trials to localStorage. A reader who opened this page
 522: # before the fix keeps the old auto-seeded rows and would still be shown a
 523: # pooled estimate computed from them - verified in the browser: a stale profile
 524: # still rendered RR 0.03 (0.00-0.52) after realData was emptied.
 525: #
 526: # Added as a normal guarded migration, matching the app's existing chain. The
 527: # row's data is MOVED to _quarantinedData, not destroyed - quarantine, never
 528: # delete - and the row is excluded with a stated reason.
 529: # ==========================================================================
 530: MIG_ANCHOR = ('if(this.state.trials?.length&&!this.state._migrated_v120_phase2_exclusion){')
 531: MIGRATION = (
 532:     'if(this.state.trials?.length&&!this.state._migrated_v123_quarantine_purge){'
 533:     'let mutated=!1;'
 534:     'const QIDS=new Set(Object.keys(window.__quarantinedTrials||{}));'
 535:     'this.state.trials.forEach(t=>{'
 536:     'if(!QIDS.has(String(t?.id??"").toUpperCase()))return;'
 537:     'if(t.data){t._quarantinedData=t.data;t.data=null;mutated=!0}'
 538:     'if("exclude"!==String(t?.status??"").toLowerCase()){t.status="exclude";mutated=!0}'
 539:     't.verified=!1;t.screenReview=null;'
 540:     't.reason="Quarantined 2026-07-30: registry verification could not support this row. '
 541:     'Its stored values are retained in _quarantinedData and described in '
 542:     'window.__quarantinedTrials.";'
 543:     '}),this.state._migrated_v123_quarantine_purge=!0,mutated&&this.save()}'
 544: )
 545: 
 546: s, bom = read(F1)
 547: before = len(s)
 548: assert s.count(MIG_ANCHOR) == 1, f"migration anchor count = {s.count(MIG_ANCHOR)}"
 549: s = s.replace(MIG_ANCHOR, MIGRATION + MIG_ANCHOR, 1)
 550: write(F1, s, bom)
 551: print()
 552: print(f"{F1}: {before} -> {len(s)} chars")
 553: print("  - migration _migrated_v123_quarantine_purge added: returning visitors with stale")
