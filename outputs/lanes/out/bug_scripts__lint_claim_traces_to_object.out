 197:     #     A GUARD THAT REPORTS SUCCESS WHILE UNABLE TO MATCH ANYTHING IS THE EXACT FAILURE
 198:     #     THIS WHOLE FILE EXISTS TO PREVENT, AND IT HAPPENED INSIDE IT.
 199:     # Caught only because the known-answer test replayed the REAL contamination.
 200:     vocab_re = re.compile(r"\b(%s)\b"
 201:                           % "|".join(re.escape(a) for a in sorted(vocab, key=len, reverse=True)))
 202: 
 203:     hits, scanned, claims_seen = [], 0, 0
 204:     for d in sorted(os.listdir(SSOT)):
 205:         p = os.path.join(SSOT, d, d + ".json")
 206:         if not os.path.exists(p):
 207:             continue
 208:         try:
 209:             with io.open(p, encoding="utf-8") as fh:
 210:                 obj = json.load(fh)
 211:         except (ValueError, OSError):
 212:             continue
 213:         scanned += 1
 214:         mine = {t.get("nct") for t in ((obj.get("inputs") or {}).get("trials") or [])
 215:                 if t.get("nct")}
 216:         for path, block in walk_blocks(obj):
 217:             if any(seg in path for seg in EXTERNAL_BY_DESIGN):
 218:                 continue
 219:             text = json.dumps(block, ensure_ascii=False)
 220:             if SKIP_TOKEN in text:
 221:                 continue
 222:             claims = list(CLAIM.finditer(text))
 223:             if not claims:
 224:                 continue
 225:             claims_seen += len(claims)
 226:             # CASE-EXACT, AND IT REPLACES A STOPWORD LIST. Uppercasing the text made ordinary
 227:             # prose match registry acronyms that are also English words -- "usual care" hit
 228:             # CARE, "pivotal trial" hit PIVOTAL. A stopword list is a permanent argument; case
 229:             # is a fact. The registry publishes CARE and prose writes care.
 230:             for g in vocab_re.finditer(text):
 231:                 owners = vocab.get(g.group(1)) or set()
 232:                 if owners & mine:
 233:                     continue                  # this object's own trial: correct attribution
 234:                 hits.append((d, path, claims[0].group(0), g.group(1), sorted(owners)[:2],
 235:                              " ".join(text.split())[:130]))
 236:                 break
 237: 
 238:     for d, path, claim, acr, owners, excerpt in hits:
 239:         print("%s  %s" % (d, path))
 240:         print("      claims %r attributed to %r -- a trial this object does NOT include"
 241:               % (claim, acr))
 242:         print("      %s belongs to %s" % (acr, owners))
 243:         print("      ...%s..." % excerpt)
 244:     print()
 245:     print("topic objects scanned            %d" % scanned)
 246:     print("numeric effect claims examined   %d" % claims_seen)
 247:     print("acronym vocabulary               %d registry-published acronyms" % len(vocab))
 248:     print("claims attributed to a FOREIGN trial %d" % len(hits))
 249:     if hits:
 250:         print()
 251:         print("REFUSED: %d numeric claim(s) name a trial their own object does not include."
 252:               % len(hits))
 253:         print("A result attributed to another topic's trial did not come from this review.")
 254:         print("Deliberate exception: %s on the line." % SKIP_TOKEN)
 255:         return 1
 256:     print()
 257:     print("no numeric effect claim is attributed to a trial its object does not include.")
 258:     print("NOT CHECKED, and named: a contaminating claim that names NO trial; one naming a")
 259:     print("trial with no registry acronym; and whether a correctly-attributed number is right.")
 260:     print("published_comparison and its neighbours are excluded -- naming other syntheses'")
 261:     print("trials is what those sections are FOR.")
 262:     return 0
 263: 
 264: 
 265: if __name__ == "__main__":
 266:     sys.exit(main())

