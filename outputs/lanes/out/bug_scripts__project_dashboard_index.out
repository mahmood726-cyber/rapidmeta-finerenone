 163:             "are uncheckable, never clean, and they are why any count here is a FLOOR."),
 164:     }
 165:     return tally, changed
 166: 
 167: 
 168: def run(apply_changes=False):
 169:     with io.open(SNAP, "r", encoding="utf-8") as fh:
 170:         snap = json.load(fh)
 171:     with io.open(PMAP, "r", encoding="utf-8") as fh:
 172:         pmap = json.load(fh)
 173:     before = sum(1 for r in snap.get("rows") or []
 174:                  if isinstance(r, dict) and isinstance(r.get("pooled_OR"), (int, float)))
 175:     tally, changed = project(snap, pmap)
 176:     after = sum(1 for r in snap.get("rows") or []
 177:                 if isinstance(r, dict) and isinstance(r.get("pooled_OR"), (int, float)))
 178: 
 179:     print("snapshot generated %s   rows %d" % (snap.get("generated"), len(snap.get("rows") or [])))
 180:     print("rows with a numeric pooled_OR: %d -> %d\n" % (before, after))
 181:     for k in sorted(tally, key=lambda x: -tally[x]):
 182:         print("   %-18s %4d" % (k, tally[k]))
 183:     print("\n   values withdrawn from display: %d" % changed)
 184:     print("   objects fingerprint: %s" % snap["projection"]["objects_fingerprint"][:16])
 185:     if apply_changes:
 186:         with io.open(SNAP, "w", encoding="utf-8") as fh:
 187:             fh.write(json.dumps(snap, indent=1, ensure_ascii=False))
 188:         print("\nwrote %s" % os.path.relpath(SNAP, REPO))
 189:     else:
 190:         print("\nDRY RUN -- nothing written. Re-run with --apply.")
 191:     return 0
 192: 
 193: 
 194: def selftest():
 195:     fails = []
 196: 
 197:     def ck(name, got, want):
 198:         ok = got == want
 199:         print("  %-66s %s  %r" % (name, "ok" if ok else "FAIL", got))
 200:         if not ok:
 201:             fails.append(name)
 202: 
 203:     with io.open(PMAP, "r", encoding="utf-8") as fh:
 204:         pmap = json.load(fh)
 205: 
 206:     print("1. THE STATES ARE DISTINGUISHED ON REAL OBJECTS IN THIS REPOSITORY:")
 207:     ck("a topic retired by MERGE (carries `absorbed_by`)",
 208:        object_state("OMECAMTIV_HF_AUTO_FULL_REVIEW.html", pmap)[0], RETIRED)
 209:     # THE REGRESSION FOR THE DEFECT THIS TEST DID NOT HAVE. A topic retired by SPLIT carries
 210:     # `split_into` instead, and the old `state == RETIRED and absorbed_by` test reported it as
 211:     # NO_POOL -- a topic that no longer exists, shown as merely unpooled. Both retirement
 212:     # routes are now asserted, so neither can regress without the other noticing.
 213:     ck("a topic retired by SPLIT (carries `split_into`)",
 214:        object_state("DABIGATRAN_VTE_AUTO_FULL_REVIEW.html", pmap)[0], RETIRED)
 215:     ck("...and its successors are named rather than left blank",
 216:        "dabigatran-vte-treatment" in
 217:        (object_state("DABIGATRAN_VTE_AUTO_FULL_REVIEW.html", pmap)[1] or ""), True)
 218:     ck("a withdrawn topic", object_state("COLCHICINE_CVD_REVIEW.html", pmap)[0], WITHDRAWN)
 219:     ck("a live pool", object_state("SGLT2_HF_REVIEW.html", pmap)[0], LIVE)
 220:     ck("a page with no object", object_state("NO_SUCH_PAGE.html", pmap)[0], UNMAPPED)
 221: 
 222:     print("\n2. THE PROJECTION NULLS A NOT-LIVE VALUE AND KEEPS IT, never deletes it:")
 223:     fake = {"rows": [{"file": "COLCHICINE_CVD_REVIEW.html", "pooled_OR": 0.86,
 224:                       "ci_low": 0.7, "ci_high": 1.0}]}
 225:     project(fake, pmap)
 226:     r = fake["rows"][0]
 227:     ck("the live value is nulled", r["pooled_OR"], None)
 228:     ck("and the old value is kept", r["pooled_OR_superseded"], 0.86)
 229:     ck("with the reason attached", "WITHDRAWN" in r["superseded_because"], True)
 230: 
 231:     print("\n3. A LIVE ROW IS LEFT ALONE:")
 232:     fake2 = {"rows": [{"file": "SGLT2_HF_REVIEW.html", "pooled_OR": 0.76}]}
 233:     project(fake2, pmap)
 234:     ck("a live topic keeps its value", fake2["rows"][0]["pooled_OR"], 0.76)
 235:     ck("and gains no superseded field", "pooled_OR_superseded" in fake2["rows"][0], False)
 236: 
 237:     print("\n4. THE FINGERPRINT MOVES WHEN A WITHDRAWAL CHANGES -- and only then:")
 238:     f1 = fingerprint(pmap)
 239:     f2 = fingerprint(pmap)
 240:     ck("it is stable across two runs on unchanged objects", f1 == f2, True)
 241:     smaller = {k: v for k, v in list(pmap.items())[:-1]}
 242:     ck("and it MOVES when the object set changes", fingerprint(smaller) != f1, True)
 243: 
 244:     print("\n5. AN UNMAPPED ROW IS NEVER SILENTLY CLEANED:")
 245:     fake3 = {"rows": [{"file": "NO_SUCH_PAGE.html", "pooled_OR": 1.23}]}
 246:     t, c = project(fake3, pmap)
 247:     ck("it keeps its value", fake3["rows"][0]["pooled_OR"], 1.23)
 248:     ck("and is labelled UNMAPPED", fake3["rows"][0]["ssot_state"], UNMAPPED)
 249:     ck("and is not counted as changed", c, 0)
 250: 
 251:     print("\n%s" % ("SELFTEST FAILED: %s" % fails if fails else "SELFTEST PASSED"))
 252:     return 1 if fails else 0
 253: 
 254: 
 255: if __name__ == "__main__":
 256:     sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
 257:     if "--selftest" in sys.argv:
 258:         sys.exit(selftest())
 259:     sys.exit(run("--apply" in sys.argv))

