    ],
    "NCT02545049": [  # FIGARO-DKD
        {"outcome": "CV composite (primary)",
         "ref": "Pitt NEJM 2021 PMID 34449181",
         "tE": 458, "tN": 3686, "cE": 519, "cN": 3666,
