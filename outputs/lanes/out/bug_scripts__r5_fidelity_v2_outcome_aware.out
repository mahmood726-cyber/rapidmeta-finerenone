    ],
    "NCT04435626": [  # FINEARTS-HF
        {"outcome": "CV death + total worsening HF events (primary)",
         "ref": "Solomon NEJM 2024 PMID 39213776",
         "tE": 624, "tN": 3003, "cE": 719, "cN": 2998,
