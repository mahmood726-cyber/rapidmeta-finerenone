    ],
    "NCT02540993": [  # FIDELIO-DKD
        {"outcome": "Renal composite (primary)",
         "ref": "Bakris NEJM 2020 PMID 33053267",
         "tE": 504, "tN": 2833, "cE": 600, "cN": 2841,
