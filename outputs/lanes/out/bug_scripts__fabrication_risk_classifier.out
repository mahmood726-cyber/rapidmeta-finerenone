 183:             "M_unverifiable_published": round(m_score, 3),
 184:         },
 185:         "raw_counts": {
 186:             "m11_no_ev": m11_no_ev.get(rv, 0),
 187:             "null_pmid": n_null_pmid,
 188:             "nulled_nct": n_nulled_nct,
 189:             "cross_review_flags": n_cross,
 190:             "single_arm_with_HR": n_single_arm,
 191:             "generic_names": n_generic_name,
 192:             "agent_flag_weight": agent_flags.get(rv, 0),
 193:             "trials_with_abstract": n_with_abstract,
 194:             "unverifiable_with_abstract": n_unverifiable,
 195:         },
 196:     })
 197: 
 198: results.sort(key=lambda r: -r["score"])
 199: 
 200: # Write outputs
 201: (OUT / "fabrication_risk_scores.json").write_text(
 202:     json.dumps(results, indent=2, ensure_ascii=False), encoding="utf-8")
 203: 
 204: with open(OUT / "fabrication_risk_table.csv", "w", encoding="utf-8", newline="") as f:
 205:     w = csv.writer(f)
 206:     w.writerow(["review", "n_trials", "score", "classification", "already_quarantined",
 207:                 "E_no_ev", "P_null_pmid", "N_nulled_nct", "A_agent", "C_cross", "V_sa", "X_generic"])
 208:     for r in results:
 209:         c = r["components"]
 210:         w.writerow([r["review"], r["n_trials"], r["score"], r["classification"],
 211:                     r["already_quarantined"],
 212:                     c["E_no_evidence"], c["P_null_pmid"], c["N_nulled_nct"],
 213:                     c["A_agent_flag_density"], c["C_cross_review"],
 214:                     c["V_residual_single_arm"], c["X_generic_name"]])
 215: 
 216: # Print top tier
 217: print(f"Total reviews scored: {len(results)}")
 218: print()
 219: print("Classification counts:")
 220: from collections import Counter
 221: cc = Counter(r["classification"] for r in results)
 222: for k in ["QUARANTINE", "MANUAL_REVIEW", "LOW_CONCERN", "OK"]:
 223:     print(f"  {k}: {cc.get(k, 0)}")
 224: 
 225: print()
 226: print("Top 25 by fabrication risk:")
 227: for r in results[:25]:
 228:     flag = "[Q]" if r["already_quarantined"] else "   "
 229:     print(f"  {flag} {r['score']:.3f}  {r['classification']:15s}  "
 230:           f"({r['n_trials']:3d}t)  {r['review']}")
 231: 
 232: newly_quarantine = [r for r in results
 233:                      if r["classification"] == "QUARANTINE" and not r["already_quarantined"]]
 234: print(f"\nNEWLY-FLAGGED for quarantine (not yet quarantined): {len(newly_quarantine)}")
 235: for r in newly_quarantine:
 236:     print(f"  {r['score']:.3f}  {r['review']}")

