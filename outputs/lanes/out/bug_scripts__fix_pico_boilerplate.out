 112:     "UPADACITINIB_CD_REVIEW.html":         ("Adults with moderate-to-severe Crohn's disease",                      "Upadacitinib",                         "Placebo",                                    "Clinical remission at induction"),
 113:     "VENETOCLAX_AML_REVIEW.html":          ("Adults with newly-diagnosed AML ineligible for intensive chemo",      "Venetoclax + azacitidine",             "Placebo + azacitidine",                      "Overall survival"),
 114: }
 115: 
 116: 
 117: def apply_to_file(path: pathlib.Path, pop, intv, comp, out, dry_run: bool) -> str:
 118:     raw = path.read_bytes()
 119:     crlf = b"\r\n" in raw
 120:     text = raw.decode("utf-8")
 121: 
 122:     # Each input is a one-liner with id="p-X" and value="..."
 123:     # Four substitutions per file, targeted narrowly.
 124:     replacements = [
 125:         (re.compile(r'(<input id="p-pop"[^>]*value=")[^"]*(")'),  pop),
 126:         (re.compile(r'(<input id="p-int"[^>]*value=")[^"]*(")'),  intv),
 127:         (re.compile(r'(<input id="p-comp"[^>]*value=")[^"]*(")'), comp),
 128:         (re.compile(r'(<input id="p-out"[^>]*value=")[^"]*(")'),  out),
 129:     ]
 130:     changes = 0
 131:     for pat, val in replacements:
 132:         new_text, n = pat.subn(lambda m: m.group(1) + val + m.group(2), text, count=1)
 133:         if n > 0:
 134:             changes += n
 135:             text = new_text
 136:     if changes == 0:
 137:         return f"MISS {path.name}: no PICO inputs found"
 138:     if not dry_run:
 139:         path.write_bytes(text.encode("utf-8"))
 140:     return f"OK   {path.name}: {changes}/4 inputs updated"
 141: 
 142: 
 143: def main():
 144:     ap = argparse.ArgumentParser()
 145:     ap.add_argument("--dry-run", action="store_true")
 146:     ap.add_argument("--apply", action="store_true")
 147:     args = ap.parse_args()
 148:     if not (args.dry_run or args.apply):
 149:         ap.error("pass --dry-run or --apply")
 150: 
 151:     ok = miss = 0
 152:     for name, pico in PICO.items():
 153:         p = ROOT / name
 154:         if not p.exists():
 155:             continue
 156:         r = apply_to_file(p, *pico, dry_run=args.dry_run)
 157:         if r.startswith("OK"):
 158:             ok += 1
 159:         else:
 160:             miss += 1
 161:         if miss < 10 or r.startswith("OK"):
 162:             print(r)
 163:     print(f"\n{'dry-run' if args.dry_run else 'apply'}: {ok} ok / {miss} miss")
 164: 
 165: 
 166: if __name__ == "__main__":
 167:     main()

