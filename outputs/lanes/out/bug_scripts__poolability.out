 161:     per trial, read from the registry, and must NOT be C for want of a
 162:     definition. Before 2026-08-17 both came out C for the same wrong reason.
 163:     """
 164:     ok = True
 165:     root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
 166: 
 167:     def _nodef(obj):
 168:         _v, _why = classify(obj)
 169:         return any("carry no outcome definition" in w for w in _why)
 170: 
 171:     for app, label in (("sotagliflozin-hf", "definitions read from the registry"),
 172:                        ("sglt2-hf", "definitions quoted, and they DISAGREE"),
 173:                        ("finerenone-cv", "endpoint TITLES quoted from the registry")):
 174:         p = os.path.join(root, "ssot", app, "%s.json" % app)
 175:         if not os.path.exists(p):
 176:             print("  fixture absent: %s -- NOT PROVEN" % app); ok = False; continue
 177:         n = _nodef(p)
 178:         ok &= not n
 179:         print("  NEGATIVE %-17s %-38s complaint: %-5s %s"
 180:               % (app, label[:38], n, "correct" if not n else "WRONG"))
 181: 
 182:     # POSITIVE, BY MUTATING A REAL OBJECT rather than authoring a fixture: strip
 183:     # every recorded definition from SOTAGLIFLOZIN and the complaint must fire.
 184:     # That state is not hypothetical -- it is what this object looked like this
 185:     # morning, and what SGLT2_HF looked like when it pooled two endpoints as one.
 186:     p = os.path.join(root, "ssot", "sotagliflozin-hf", "sotagliflozin-hf.json")
 187:     if os.path.exists(p):
 188:         mut = json.loads(open(p, encoding="utf-8").read())
 189:         for t in mut["inputs"]["trials"]:
 190:             for bo in (t.get("by_outcome") or {}).values():
 191:                 bo.pop("outcome_definition", None)
 192:                 (bo.get("provenance") or {}).pop("source_quotes", None)
 193:         n = _nodef(mut)
 194:         ok &= n
 195:         print("  POSITIVE %-17s %-38s complaint: %-5s %s"
 196:               % ("sotagliflozin-hf", "every definition stripped", n,
 197:                  "correct" if n else "WRONG"))
 198:     else:
 199:         print("  fixture absent: sotagliflozin-hf -- NOT PROVEN"); ok = False
 200:     print("\nWHAT A FAILURE WOULD LOOK LIKE: the no-definition complaint firing on "
 201:           "an object whose definitions were read word for word, which would argue "
 202:           "for withdrawing a sound estimate.")
 203:     print("-> SELFTEST PASS" if ok else "-> SELFTEST FAILED")
 204:     return 0 if ok else 1
 205: 
 206: 
 207: def main() -> int:
 208:     if len(sys.argv) < 2 or sys.argv[1] == "--selftest":
 209:         return selftest()
 210:     paths = sorted(glob.glob(sys.argv[1]))
 211:     if not paths:
 212:         print("no object matched %r. NOT RUN -- which is not a pass." % sys.argv[1],
 213:               file=sys.stderr)
 214:         return 2
 215:     tot = collections.Counter()
 216:     rows = []
 217:     for p in paths:
 218:         try:
 219:             v, why = classify(p)
 220:         except Exception as ex:                       # noqa: BLE001
 221:             print("  %-46s COULD NOT BE READ: %s" % (os.path.basename(p)[:46], ex))
 222:             tot["UNASSESSABLE"] += 1
 223:             continue
 224:         tot[v] += 1
 225:         rows.append((os.path.basename(p).replace(".html.canonical.json", ""), v, why))
 226:     n = sum(tot.values())
 227:     print("topics assessed: %d" % n)
 228:     for k in ("A_POOLABLE_AS_POSED", "D_WITHHELD_WITH_REASON",
 229:               "B_POOLABLE_AFTER_ADJUSTMENT", "C_NOT_POOLABLE", "UNASSESSABLE"):
 230:         print("  %-30s %4d  %5.1f%%" % (k, tot[k], 100 * tot[k] / n if n else 0))
 231:     print("\nCATEGORY C -- FOR A HUMAN DECISION, nothing removed by this script:")
 232:     for pg, v, why in rows:
 233:         if v == "C_NOT_POOLABLE":
 234:             print("  %-46s %s" % (pg[:46], why[0][:88]))
 235:     # The dump used to go to a hardcoded absolute path in a DIFFERENT project's
 236:     # gitignored outputs/ directory. It wrote fine, read back fine, and existed
 237:     # in no clone -- the durable-artefact failure exactly. It is opt-in now, and
 238:     # the caller names a path inside a repository.
 239:     for i, a in enumerate(sys.argv):
 240:         if a == "--dump" and i + 1 < len(sys.argv):
 241:             json.dump([{"page": r[0], "category": r[1], "reasons": r[2]} for r in rows],
 242:                       open(sys.argv[i + 1], "w", encoding="utf-8"), indent=1)
 243:             print("\ndump written to %s" % sys.argv[i + 1])
 244:     # THIS SCRIPT USED TO RETURN 0 WHATEVER IT FOUND. v1_coverage_audit maps the
 245:     # exit code to a property verdict, so poolable_or_withheld could only ever
 246:     # have read PASS -- a standard property watched by a check with no failure
 247:     # path. UNASSESSABLE is exit 2 (unmeasured, not a pass); category C is exit 1.
 248:     if tot["UNASSESSABLE"]:
 249:         return 2
 250:     # B IS A FAILURE OF THIS PROPERTY, NOT A SOFTER PASS. B means the question as
 251:     # posed cannot be pooled and a nearby one can -- so while the live estimate
 252:     # answers the posed question, `poolable_or_withheld` is not met. Scoring B as
 253:     # a pass is how SGLT2_HF would have kept its green.
 254:     return 1 if (tot["C_NOT_POOLABLE"] or tot["B_POOLABLE_AFTER_ADJUSTMENT"]) else 0
 255: 
 256: 
 257: if __name__ == "__main__":
 258:     sys.exit(main())

