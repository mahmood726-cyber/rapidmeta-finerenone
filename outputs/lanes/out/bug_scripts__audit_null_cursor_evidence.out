 203: def selftest():
 204:     fails = []
 205: 
 206:     def ck(name, got, want):
 207:         ok = got == want
 208:         print("  %-66s %s  %r" % (name, "ok" if ok else "FAIL", got))
 209:         if not ok:
 210:             fails.append(name)
 211: 
 212:     print("1. THE FOUR STATES, and none collapses into another:")
 213:     ck("returned == total reconciles",
 214:        classify_row({"records_returned": 137, "total_reported": 137})[0], RECONCILES)
 215:     ck("a declared shortfall is legitimate",
 216:        classify_row({"records_returned": 50, "total_reported": 439,
 217:                      "what_is_unexamined": "THE OTHER 389 ARE UNEXAMINED, NOT EXCLUDED"})[0],
 218:        DECLARED)
 219:     ck("an undeclared shortfall is a defect",
 220:        classify_row({"records_returned": 50, "total_reported": 439})[0], UNDECLARED)
 221:     ck("a row with NO total is CURSOR_ONLY, never clean",
 222:        classify_row({"records_returned": 57,
 223:                      "pagination_verified": "next_page_token null"})[0], CURSOR_ONLY)
 224: 
 225:     print("\n2. AND A NOT-EXECUTED DATABASE IS ITS OWN STATE, never a shortfall:")
 226:     ck("a row saying NOT EXECUTED",
 227:        classify_row({"tool": "NOT EXECUTED", "records_returned": None})[0], NOT_EXECUTED)
 228: 
 229:     print("\n3. A ROW STATING NEITHER NUMBER IS NOT_ASSESSABLE:")
 230:     ck("no counts at all", classify_row({"database": "PubMed"})[0], NA)
 231: 
 232:     print("\n4. THE LIVE CORPUS -- a zero here would make the audit meaningless:")
 233:     rows = collect()
 234:     ck("search rows were found to classify", len(rows) > 20, True)
 235:     run()
