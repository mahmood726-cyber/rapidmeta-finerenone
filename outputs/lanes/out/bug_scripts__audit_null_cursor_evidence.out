 191:         print("      %-42s %-38s %s" % (r.get("topic"), str(r.get("database"))[:38],
 192:                                         "BUILT PAGE" if r.get("built_page") else "evidence only"))
 193:     print("\n   UNDECLARED SHORTFALLS: %d" % len(bad))
 194:     for r in bad:
 195:         print("      %-42s %s" % (r.get("topic"), r["why"]))
 196:     print("\n   TOPICS WITH A BUILT PAGE RESTING ON AN UNPROVEN ROW: %d" % len(affected))
