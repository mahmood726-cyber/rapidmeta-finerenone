import io, sys, json, collections

sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
P = r"F:\rapidmeta-ssot-shell\ssot\arni-hfref\arni-hfref.json"
d = json.load(open(P, encoding="utf-8"), object_pairs_hook=collections.OrderedDict)
O = collections.OrderedDict


def C(**k):
    return O(k)


checks = [
 C(id="count-stated-vs-table",
   what="Stated study count against the rows of its own Table 1",
   verdict="CONFIRMED",
   detail="The abstract and Results both say nine. Table 1 carries exactly nine author "
          "rows: Bano, Desai, Li, McMurray, Pathadka, Piepoli, Tsutsui, Velazquez, Zhao. "
          "Counted from the staged full text, not taken from the abstract.",
   quote="A total of nine studies were included in this meta-analysis.",
   location="Abstract; Results, paragraph 1"),
 C(id="design-counts",
   what="Stated design mix against the Design column of Table 1",
   verdict="CONFIRMED",
