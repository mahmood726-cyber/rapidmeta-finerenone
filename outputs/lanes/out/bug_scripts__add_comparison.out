]

n = len(checks)
ver = collections.Counter(c["verdict"] for c in checks)

d["published_comparison"] = O(
 _why="Every paper this project ships carries this section. A synthesis that reports only "
      "its own result asks a reader to take the field on trust; one that reconciles itself "
      "against the published syntheses on the same question, names what they got right as "
      "prominently as what they got wrong, and shows the denominator, can be checked. The "
      "classes applied below are the classes this review must itself survive. On the night "
      "this section was written, this object failed three of them: analysis panels computed "
      "at k=3 under a k=4 headline, a title stating a study count its own contents "
      "contradicted, and a figure labelled as a diagnostic it was not drawing.",
 _how_identified="By lookup, never recall. The comparison review's identifiers were "
      "resolved through the PubMed ID converter on 2026-08-14: DOI 10.7759/cureus.48623 "
      "returns PMID 38084196 and PMCID PMC10710849. Its full text is staged in this bundle "
      "and every quotation below was read from that file.",
 reviews=[O(
   id="PM_REYAZ2023",
   citation="Reyaz I, et al. Comparison of outcomes between sacubitril/valsartan and "
            "enalapril in patients with heart failure: a systematic review and "
            "meta-analysis. Cureus 2023;15(11):e48623.",
   pmid="38084196", pmcid="PMC10710849", doi="10.7759/cureus.48623",
   identifier_provenance="Resolved by ID conversion on 2026-08-14, not from memory.",
   access="Open access; full text staged as PM_SACVAL_ENAL_PMC10710849.txt",
   their_k=9, their_search_closed="2023-09-15",
   scope="sacubitril/valsartan against enalapril in heart failure, any outcome, randomised "
         "or observational",
   how_it_differs_from_ours="Three differences, and none of them makes either review wrong. "
     "They admit observational designs and this object does not. They pool RISK RATIOS over "
     "whole follow-up; this object pools a time-to-first-event HAZARD RATIO, a different "
     "quantity. Their search closed in September 2023, before two of the four trials pooled "
     "here existed.")],
 checks=checks,
 denominator=O(
   rows_checked=n, confirmed=ver["CONFIRMED"], errors=ver["ERROR"], absent=ver["ABSENT"],
   statement="%d checks were applied to this review and %d came back clean. The denominator "
             "is stated because a list of only the failures is not a finding, it is a "
             "selection." % (n, ver["CONFIRMED"]),
   symmetry="Confirmations are listed in the same table, in the same detail, as errors. Two "
            "checks were designed to catch a fault and instead cleared the paper: including "
            "a cohort study is inside their own stated eligibility, and omitting a "
            "small-study test at nine studies is what the Handbook advises."),
 divergence_decomposed=O(
   ours="HR 0.872 (0.746 to 1.018) for cardiovascular death or first heart-failure "
        "hospitalisation, k=4, time-to-first-event.",
   theirs="RR 0.76 (0.66 to 0.86) for cardiovascular hospitalisation and RR 0.75 (0.62 to "
          "0.91) for cardiovascular mortality, reported as separate outcomes.",
   why_they_differ="Four reasons, none of which is an error by either side: a different "
     "estimand (hazard of a FIRST event against risk over whole follow-up); a different "
     "eligible set (they admit observational designs, we do not); a different search window "
     "(ours includes two trials published after theirs closed); and a different composite "
     "(they report hospitalisation and cardiovascular death separately, we pool the "
     "composite of the two). Decomposed rather than asserting ours is right: on the trials "
     "and the quantity the two reviews share, they agree."),
)
json.dump(d, open(P, "w", encoding="utf-8"), indent=1, ensure_ascii=False)
