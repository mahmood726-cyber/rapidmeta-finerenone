336:                                if before_m["sentences"] else 0.0)
337:                 rate_after = (float(m["machine"]) / m["sentences"]
338:                               if m["sentences"] else 0.0)
339:                 if before_m["sentences"] and rate_after > rate_before + 0.01:
340:                     ok = False
341:                     why.append("machine-vocabulary RATE rose %.0f%% -> %.0f%% (%d/%d -> "
342:                                "%d/%d)" % (100 * rate_before, 100 * rate_after,
343:                                            before_m["machine"], before_m["sentences"],
344:                                            m["machine"], m["sentences"]))
345:                 if fp > before_m["flow_paths"]:
346:                     ok = False
347:                     why.append("field paths in the flow rose %d -> %d"
348:                                % (before_m["flow_paths"], fp))
349:             pr = subprocess.run([sys.executable,
350:                                  os.path.join(REPO, "scripts",
351:                                               "prove_register_change_moved_no_content.py"),
352:                                  backup, page, obj],
353:                                 stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
354:             if pr.returncode != 0:
355:                 ok = False
356:                 why.append("content invariance REFUSED: %s"
357:                            % pr.stdout.decode("utf-8", "replace").strip()[-300:])
358: 
359:         if ok:
360:             os.remove(backup)
361:             led["done"][name] = {"run": RUN_ID, "machine": m["machine"], "was": before_m["machine"],
362:                                  "sentences": m["sentences"],
363:                                  "flow_paths": fp, "flow_was": before_m["flow_paths"]}
