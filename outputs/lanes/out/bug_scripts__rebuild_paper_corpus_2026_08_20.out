183: def restore(backup, page, why):
184:     """Put the old bytes back, and NEVER raise while doing it.
185: 
186:     A ROLLBACK THAT ASSUMES ITS BACKUP EXISTS CRASHES THE WHOLE BATCH. This run died on
187:     APIXABAN_VTE_TREATMENT with FileNotFoundError moving a .rollback that was not there,
188:     and took the remaining pages of the batch with it. THE RESTORE PATH IS THE LAST THING
189:     THAT SHOULD BE ABLE TO FAIL: it runs only when something has already gone wrong.
190: 
191:     Returns True if the old bytes are back, False if the file on disk is the NEW build and
192:     the caller must say so rather than implying a restore happened.
193:     """
194:     if not os.path.exists(backup):
195:         why.append("AND ITS BACKUP WAS GONE -- the file on disk is the NEW build and was "
196:                    "NOT restored. Check it by hand before pushing.")
197:         return False
198:     try:
