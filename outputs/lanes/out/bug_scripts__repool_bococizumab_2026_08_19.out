 116:                           "ci_high": r[4], "n": r[5], "outcome_title": r[6],
 117:                           "provenance": "READ from the trial's posted `analyses` block "
 118:                                         "(least-squares mean difference with its 95% CI)"}
 119:                          for r in rows]}
 120:     for how in ("REML", "PM"):
 121:         t2 = HG._tau2(ys, vs, how)
 122:         w = [1.0 / (v + t2) for v in vs]
 123:         sw = sum(w)
 124:         mu = sum(a * b for a, b in zip(w, ys)) / sw
 125:         se = math.sqrt(1.0 / sw)
 126:         rec = {"tau2": round(t2, 4), "md": round(mu, 4),
 127:                "ci_low": round(mu - Z * se, 4), "ci_high": round(mu + Z * se, 4),
 128:                "interval": "Wald, normal"}
 129:         qh = sum(wi * (y - mu) ** 2 for wi, y in zip(w, ys)) / (k - 1)
 130:         qf = max(1.0, qh)
 131:         seh = math.sqrt(qf / sw)
 132:         tc = T.get(k - 1)
 133:         rec["hksj"] = {"q_hksj": round(qh, 4), "floored_to": round(qf, 4),
 134:                        "floor_applied": qf > qh + 1e-12, "t_df": k - 1, "t_crit": tc,
 135:                        "md": round(mu, 4), "ci_low": round(mu - tc * seh, 4),
 136:                        "ci_high": round(mu + tc * seh, 4),
 137:                        "interval": "Knapp-Hartung-Sidik-Jonkman, t on k-1 df, "
 138:                                    "floor max(1, Q/(k-1))"}
 139:         out[how] = rec
 140:     return out
 141: 
 142: 
 143: def main():
 144:     sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
 145:     old = pool(INCUMBENT, "the five trials on the object -- REML, as published 2026-08-18")
 146:     new = pool(INCUMBENT + RECOVERED, "the six the executed search supports")
 147: 
 148:     print("OLD  k=%d  n=%d  MD %.4f (%.4f to %.4f)  tau2 %.3f  I2 %.1f%%"
 149:           % (old["k"], old["n_participants"], old["REML"]["md"], old["REML"]["ci_low"],
 150:              old["REML"]["ci_high"], old["REML"]["tau2"], old["i2_pct"]))
 151:     print("NEW  k=%d  n=%d  MD %.4f (%.4f to %.4f)  tau2 %.3f  I2 %.1f%%"
 152:           % (new["k"], new["n_participants"], new["REML"]["md"], new["REML"]["ci_low"],
 153:              new["REML"]["ci_high"], new["REML"]["tau2"], new["i2_pct"]))
 154:     print("     HKSJ on %d df: %.4f (%.4f to %.4f)"
 155:           % (new["REML"]["hksj"]["t_df"], new["REML"]["hksj"]["md"],
 156:              new["REML"]["hksj"]["ci_low"], new["REML"]["hksj"]["ci_high"]))
 157:     print("\nthe trial that joined:  SPIRE-FH NCT01968980  MD -54.5 (-59.5 to -49.5)  n=370")
 158:     print("not pooled, with reasons: %s" % ", ".join(sorted(DOSE_RANGING)))
 159: 
 160:     out = {
 161:         "topic": "bococizumab-lipid-review",
 162:         "repooled_utc": "2026-08-19",
 163:         "what_this_is_not": (
 164:             "NOT a correction of the estimate. The odds-ratio-from-counts was replaced on "
 165:             "2026-08-18 and that replacement stands. This checks the EVIDENCE BASE, which had "
 166:             "never been checked -- the object recorded 'search: not recorded on the page this "
 167:             "object was built from'."),
 168:         "estimand": {
 169:             "definition": "percent change from baseline in LDL-C at WEEK 12",
 170:             "and_the_timepoint_is_part_of_it": (
 171:                 "Three of the four dose-ranging trials post Day 85 or Day 113 instead, and one "
 172:                 "posts 'Week 12 and 24' combined in a single measure. A CONTINUOUS ENDPOINT "
 173:                 "HAS NO COMPONENTS TO MISMATCH, so the mismatch moves to the TIMEPOINT and the "
 174:                 "DOSE -- and 'percent change in LDL-C' is one name covering all of them. P37 "
 175:                 "is about names, not about composites."),
 176:         },
 177:         "previous": old,
 178:         "current": new,
 179:         "the_trial_that_joined": {
 180:             "nct": "NCT01968980", "name": "SPIRE-FH", "n": 370,
 181:             "why_it_joins": ("Its registered primary is the identical endpoint at the identical "
 182:                              "timepoint, and it posts a least-squares mean difference in its "
 183:                              "own `analyses` block -- the same provenance as every value "
 184:                              "already in the pool. Nothing is derived."),
 185:             "why_it_was_absent": ("This review had no executed search until 2026-08-19. Its "
 186:                                   "five trials were the five somebody put on a page."),
 187:         },
 188:         "eligible_poolable_and_NOT_pooled": {
 189:             "_why_shown": ("Each is eligible, has posted LDL results, and is absent from the "
 190:                            "pool for a stated reason with its own numbers beside it, so the "
 191:                            "cost of the refusal is inspectable rather than asserted."),
 192:             "reason": ("A DOSE-RANGING TRIAL IS NOT ONE CONTRAST. Each randomised DOSE; "
 193:                        "pooling one arm against placebo means choosing which arm, and no rule "
 194:                        "in this review chooses it. THE CHOICE WOULD BE OURS AND IT WOULD LOOK "
 195:                        "LIKE THE TRIAL'S."),
 196:             "trials": DOSE_RANGING,
 197:         },
 198:         "estimator_note": (
 199:             "REML with an inverse-variance random-effects model, unchanged from the published "
 200:             "pool so that the two are comparable on one estimator; Paule-Mandel and a floored "
 201:             "Knapp-Hartung interval are carried beside it. Standard errors are DERIVED from "
 202:             "each printed 95 per cent interval and are labelled so -- the point estimates and "
 203:             "intervals themselves are read."),
 204:         "and_what_did_NOT_move": (
 205:             "The answer. Adding a sixth trial and 370 participants moves the pooled mean "
 206:             "difference by less than half a percentage point. THAT IS THE FINDING AND IT IS "
 207:             "NOT A NULL RESULT: a review whose evidence base was never checked turned out to "
 208:             "have the right answer, and nothing about the way it was built could have told "
 209:             "anyone that. The check is what distinguishes a correct estimate from a lucky one."),
 210:     }
 211:     with io.open(DEST, "w", encoding="utf-8") as fh:
 212:         fh.write(json.dumps(out, indent=1))
 213:     print("\nwrote %s" % DEST)
 214:     return 0
 215: 
 216: 
 217: def selftest():
 218:     sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
 219:     fails = []
 220: 
 221:     def check(name, got, want, tol=1e-3):
 222:         ok = abs(got - want) <= tol if isinstance(want, float) else got == want
 223:         print("  %-58s %s  %s" % (name, "ok" if ok else "FAIL", got))
 224:         if not ok:
 225:             fails.append(name)
 226: 
 227:     # The published pool must REPRODUCE from the five stored rows. If it does not, either the
 228:     # stored value or this arithmetic is wrong, and the re-pool would be built on sand.
 229:     old = pool(INCUMBENT, "x")
 230:     check("the published MD -55.4593 reproduces from its own five rows",
 231:           old["REML"]["md"], -55.4593, 0.02)
 232:     check("...and its published I2 of 65.1%", old["i2_pct"], 65.1, 0.6)
 233:     check("...and its published tau2 of 9.3148", old["REML"]["tau2"], 9.3148, 0.15)
 234: 
 235:     # SPIRE-FH's interval must imply a standard error consistent with its posted SEM of 2.54.
 236:     check("SPIRE-FH's printed CI implies its posted standard error 2.54",
 237:           se_from_ci(-59.5, -49.5), 2.551, 0.02)
 238: 
 239:     # And the recovered trial must actually MOVE something, or adding it proves nothing.
 240:     new = pool(INCUMBENT + RECOVERED, "y")
 241:     check("k rises 5 -> 6", new["k"], 6)
 242:     check("n rises by SPIRE-FH's 370",
 243:           new["n_participants"] - old["n_participants"], 370)
 244: 
 245:     print("\n%s" % ("ALL KNOWN ANSWERS HELD" if not fails else "FAILED: %s" % fails))
 246:     return 1 if fails else 0
 247: 
 248: 
 249: if __name__ == "__main__":
 250:     sys.exit(selftest() if "--selftest" in sys.argv else main())

