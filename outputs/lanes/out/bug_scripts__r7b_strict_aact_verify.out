 202: # Apply
 203: def find_block(txt, nct):
 204:     key_pat = re.compile(r'(["\'])' + re.escape(nct) + r'\1\s*:\s*\{')
 205:     m = key_pat.search(txt)
 206:     if not m: return None
 207:     start = m.end(); depth = 1; i = start; in_str = None
 208:     while i < len(txt) and depth > 0:
 209:         ch = txt[i]
 210:         if in_str:
 211:             if ch == "\\": i += 2; continue
 212:             if ch == in_str: in_str = None
 213:         else:
 214:             if ch in ('"', "'"): in_str = ch
 215:             elif ch == "{": depth += 1
 216:             elif ch == "}":
 217:                 depth -= 1
 218:                 if depth == 0: return (m.start(), i+1, start, i)
 219:         i += 1
 220:     return None
 221: 
 222: 
 223: def null_field_in_block(txt, body_start, body_end, field):
 224:     body = txt[body_start:body_end]
 225:     new_body, n = re.subn(
 226:         r'((["\']?)' + re.escape(field) + r'\2\s*:\s*)(?:["\'][^"\']*["\']|[0-9.eE+-]+|true|false)(?=\s*[,}])',
 227:         r'\1null', body, flags=re.IGNORECASE)
 228:     if n == 0: return txt, False
 229:     return txt[:body_start] + new_body + txt[body_end:], True
 230: 
 231: 
 232: def null_key(txt, nct):
 233:     nulled = f"NULLED:{nct}"
 234:     if nulled in txt: return txt, 0
 235:     pat = re.compile(r'(["\'])(' + re.escape(nct) + r')(\1)(\s*:)')
 236:     new_txt, n = pat.subn(
 237:         lambda m: f'{m.group(1)}NULLED:{m.group(2)}{m.group(3)}{m.group(4)}', txt)
 238:     return new_txt, n
