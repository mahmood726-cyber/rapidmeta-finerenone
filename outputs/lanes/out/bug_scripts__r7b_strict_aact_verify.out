   1: """R7b â€” Strict, consistent AACT cross-verification.
   2: 
   3: Three rules â€” each fires only on UNAMBIGUOUS contradictions where no
   4: acronym-expansion is needed:
   5: 
   6: R-S1: NCT_NOT_IN_AACT_SNAPSHOT
   7:   The NCT doesn't exist at all in AACT 2026-04-12. Single signal but
   8:   deterministic â€” null PMID (preserve trial row; flag for re-extract).
   9: 
  10: R-S2: AACT_INTERVENTION_HARD_MISMATCH
  11:   The drug name from extracted `group` field doesn't appear in ANY AACT
  12:   intervention name (case-insensitive substring), AND AACT lists at least
  13:   3 interventions (so it's not an underspecified registration).
  14:   Action: null PMID + group (preserve NCT but mark provenance broken).
  15: 
  16: R-S3: TRIPLE_SIGNAL_WRONG_NCT
  17:   All three must fire:
  18:     a) Drug from group not in any AACT intervention (R-S2)
  19:     b) Enrollment is >2Ã— off between AACT and (tN+cN)
  20:     c) No drug-name word (â‰¥6 chars) from group appears in AACT brief_title
  21:   Action: NULL_KEY â€” the NCT genuinely belongs to a different trial.
  22: 
  23: R-S4: PMID_AACT_TOPIC_MISMATCH
  24:   Both:
  25:     a) PMID title+abstract contains no drug-name word from AACT interventions
  26:     b) PMID title+abstract contains none of AACT's condition tokens
  27:   Action: NULL_PMID.
  28: 
  29: This is intentionally more conservative than R7a â€” fewer false positives.
  30: """
  31: from __future__ import annotations
  32: import json, csv, re, sys, io
  33: from pathlib import Path
  34: from collections import defaultdict, Counter
  35: 
  36: if hasattr(sys.stdout, "buffer") and getattr(sys.stdout, "encoding", "").lower() != "utf-8":
  37:     sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
  38: 
  39: HERE = Path(__file__).resolve().parent.parent
  40: OUT = HERE / "outputs" / "extraction_audit"
  41: DATA = OUT / "data"
  42: PUBMED_CACHE = OUT / "pubmed_cache"
  43: AACT = Path("D:/AACT-storage/AACT/2026-04-12")
  44: DRY = "--dry-run" in sys.argv
  45: 
  46: scores = json.loads((OUT / "fabrication_risk_scores.json").read_text(encoding="utf-8"))
  47: target_reviews = {r["review"] for r in scores
  48:                    if 0.30 <= r["score"] < 0.70 and not r["already_quarantined"]}
  49: print(f"Target reviews: {len(target_reviews)}")
  50: 
  51: target_trials = []
  52: for json_p in sorted(DATA.glob("*.json")):
  53:     if json_p.name.startswith("_"): continue
  54:     rv = json_p.stem
  55:     if rv not in target_reviews: continue
  56:     try: d = json.loads(json_p.read_text(encoding="utf-8"))
  57:     except: continue
  58:     rd = d.get("realData") or {}
  59:     if not isinstance(rd, dict): continue
  60:     for nct, t in rd.items():
  61:         if not isinstance(t, dict): continue
  62:         if nct.startswith("NULLED:"): continue
  63:         if not re.match(r"^NCT\d{8}$", nct): continue
  64:         target_trials.append({"review": rv, "nct": nct, **t})
  65: 
  66: target_ncts = sorted({t["nct"] for t in target_trials})
  67: print(f"Target trials: {len(target_trials)}  unique NCTs: {len(target_ncts)}")
  68: 
  69: 
  70: def load_aact(filename, key_col, want_cols, filter_set):
  71:     out = defaultdict(list)
  72:     with open(AACT / filename, "r", encoding="utf-8", errors="replace") as f:
  73:         reader = csv.DictReader(f, delimiter="|")
  74:         for row in reader:
  75:             k = (row.get(key_col) or "").strip().upper()
  76:             if k in filter_set:
  77:                 out[k].append({c: (row.get(c) or "").strip() for c in want_cols})
  78:     return out
  79: 
  80: 
  81: target_set = set(target_ncts)
  82: print("Loading AACTâ€¦")
  83: studies = load_aact("studies.txt", "nct_id",
  84:                      ["brief_title", "official_title", "enrollment"], target_set)
  85: conds = load_aact("conditions.txt", "nct_id", ["downcase_name"], target_set)
  86: intvs = load_aact("interventions.txt", "nct_id", ["name"], target_set)
  87: print(f"  AACT resolved: {len(studies)}/{len(target_ncts)}")
  88: 
  89: STOPWORDS = {"a","an","the","of","for","in","to","with","and","or","vs","vs.",
  90:               "versus","study","trial","randomized","randomised","double-blind",
  91:               "placebo","controlled","open-label","phase","evaluation","efficacy",
  92:               "safety","treatment","patients","adult","adults","subjects",
  93:               "evaluate","effect","effects","drug","new","placebo-controlled",
  94:               "extension","monthly","daily","weekly","oral","intravenous","subcutaneous",
  95:               # Geographic / cohort descriptors
  96:               "french","brazilian","italian","spanish","european","asian","american",
  97:               "japanese","chinese","african","british","canadian","german",
  98:               "cohort","registry","real-world","singapore","argentine","russian",
  99:               "nordic","scandinavian","atlantic","pacific","mediterranean",
 100:               # Study-design descriptors
 101:               "frontline","resistant","refractory","recurrent","relapsed","advanced",
 102:               "metastatic","localized","early","late","newly","established",
 103:               "proceed","followup","follow","baseline","week","year","month",
 104:               "primary","secondary","tertiary","cluster","crossover",
 105:               # Method words
 106:               "analysis","analyses","results","outcome","outcomes",
 107:               "sensitivity","subgroup","exploratory","posthoc"}
