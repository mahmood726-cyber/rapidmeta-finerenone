 180:         if pub and pub.get("abstract"):
 181:             text = (pub.get("title", "") + " " + pub.get("abstract", "")).lower()
 182:             # AACT-derived "anchors"
 183:             aact_drugs = [re.sub(r"\W+", " ", n.lower()).strip() for n in aact_intvs]
 184:             aact_drug_words = set()
 185:             for x in aact_drugs:
