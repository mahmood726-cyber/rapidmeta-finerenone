 135:         fixes.append({"rule": "R-S1", "op": "NULL_PMID", "review": rv, "nct": nct,
 136:                        "reason": "NCT not in AACT 2026-04-12 snapshot"})
 137:         continue
 138:     aact = s[0]
 139:     aact_title = (aact.get("brief_title", "") + " " + aact.get("official_title", "")).lower()
 140:     aact_intvs = [i["name"] for i in intvs.get(nct, [])]
 141:     aact_intvs_text = " ".join(aact_intvs).lower()
 142:     aact_conditions = {c["downcase_name"] for c in conds.get(nct, [])}
 143:     try: aact_n = int(aact.get("enrollment", "") or 0)
 144:     except: aact_n = 0
 145: 
 146:     # R-S2 check
 147:     gws = drug_words(t.get("group") or "")
 148:     intv_hard_mismatch = False
 149:     if gws and len(aact_intvs) >= 3:
 150:         # Hard mismatch = NONE of top-3 drug words appear in AACT intvs
 151:         if not any(d in aact_intvs_text for d in gws[:3]):
 152:             intv_hard_mismatch = True
 153:             issue_counts["AACT_INTV_HARD_MISMATCH"] += 1
 154: 
 155:     # R-S3 check (triple)
 156:     enroll_2x_off = False
 157:     if aact_n > 0:
 158:         try:
 159:             arm_sum = int(t.get("tN") or 0) + int(t.get("cN") or 0)
 160:             if arm_sum > 0 and (arm_sum / aact_n > 2 or aact_n / max(arm_sum, 1) > 2):
 161:                 enroll_2x_off = True
 162:         except: pass
 163: 
 164:     drug_in_title = any(d in aact_title for d in gws[:3]) if gws else False
 165: 
 166:     if intv_hard_mismatch and enroll_2x_off and not drug_in_title:
 167:         issue_counts["TRIPLE_SIGNAL_WRONG_NCT"] += 1
 168:         fixes.append({"rule": "R-S3", "op": "NULL_KEY", "review": rv, "nct": nct,
 169:                        "reason": f"intv+enroll(2x)+title mismatch â€” drug {gws[:3]} not in AACT title nor any of {len(aact_intvs)} interventions; AACT N={aact_n} vs arm-sum={t.get('tN')}+{t.get('cN')}"})
 170:         continue  # NULL_KEY supersedes lesser actions
