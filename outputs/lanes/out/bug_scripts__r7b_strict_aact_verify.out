 110: def drug_words(group: str) -> list[str]:
 111:     """Words â‰¥6 chars from group field, excluding common dose/route terms."""
 112:     if not group: return []
 113:     out = []
 114:     for w in re.findall(r"[a-z]+", group.lower()):
 115:         if len(w) >= 6 and w not in STOPWORDS:
