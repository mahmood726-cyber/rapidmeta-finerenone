 459: def check_31_window_global_unset(p, txt, ctx):
 460:     """P1: file references RapidMeta but does NOT define it (broken extraction)."""
 461:     if 'RapidMeta' not in txt:
 462:         return []
 463:     if 'RapidMeta = {' in txt or 'const RapidMeta' in txt or 'window.RapidMeta=' in txt or 'window.RapidMeta =' in txt:
 464:         return []
 465:     # Else: RapidMeta is referenced but no definition exists.
 466:     if re.search(r"\bRapidMeta\.\w+", txt):
 467:         return [{"check": "31_undefined_RapidMeta", "severity": "P1", "file": p.name,
 468:                  "detail": "RapidMeta referenced without definition"}]
 469:     return []
