 115:     closes = len(re.findall(r"</div\s*>", masked, re.IGNORECASE))
 116:     if abs(opens - closes) > 0:
 117:         return [{"check": "04_div_balance", "severity": "P2", "file": p.name,
 118:                  "detail": f"open={opens} close={closes} diff={opens-closes}"}]
 119:     return []
