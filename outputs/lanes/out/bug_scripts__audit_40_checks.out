 574: def check_40_orphan_pubmed_link(p, txt, ctx):
 575:     """P2: a pubmed.ncbi.nlm.nih.gov/<n>/ link where <n> isn't a real PMID (< 100)."""
 576:     out = []
 577:     for m in PMID_LINK_RE.finditer(txt):
 578:         v = m.group(1)
 579:         if v and int(v) < 100:
 580:             out.append({"check": "40_implausible_pmid", "severity": "P2",
 581:                         "file": p.name, "detail": v})
 582:             if len(out) >= 2: break
 583:     return out
