 478: 
 479: def check_33_pmid_link_mismatch_with_realdata(p, txt, ctx):
 480:     """P1: hardcoded PMID anchor text differs from the realData pmid for the same NCT.
 481: 
 482:     Only applies to lite/audit-first pages where both forms can coexist."""
 483:     out = []
 484:     # Build NCT -> realData pmid
 485:     real_pmid = {}
 486:     for m in TRIAL_BLOCK_RE.finditer(txt):
 487:         nct = m.group(1)
 488:         mm = PMID_RE.search(m.group("body"))
 489:         if mm:
 490:             real_pmid[nct] = mm.group(1)
 491:     # Check anchor pmid links near NCT mention.
 492:     pair_re = re.compile(r'(NCT\d{7,8})</a>[^<]*<a href="https://pubmed\.ncbi\.nlm\.nih\.gov/(\d+)/"')
 493:     for m in pair_re.finditer(txt):
 494:         nct, anchor_pmid = m.group(1), m.group(2)
 495:         rp = real_pmid.get(nct)
 496:         if rp and anchor_pmid != rp:
 497:             out.append({"check": "33_pmid_anchor_realdata_mismatch", "severity": "P1",
 498:                         "file": p.name,
 499:                         "detail": f"{nct} anchor={anchor_pmid} realData={rp}"})
 500:             if len(out) >= 3: break
 501:     return out
