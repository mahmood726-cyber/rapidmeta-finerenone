  76: def check_03_unmatched_script_tag(p, txt, ctx):
  77:     """P0: a `<script>` element left unclosed at EOF (page never finishes parsing).
  78: 
  79:     Uses browser-accurate <script> semantics rather than a naive open/close count:
  80:     once inside a script element the parser ignores further `<script` substrings
  81:     (they are JS/string content) and closes ONLY on a literal `</script>`. An
  82:     escaped `<\\/script>` (the deliberate safe pattern used by sanitization
  83:     regexes such as `new RegExp("<script...<\\/script>")`) is NOT a real close,
  84:     so it no longer produces a phantom imbalance. We flag only the unambiguous
  85:     page-breaking case: a script that is still open when the document ends.
  86:     """
  87:     out = []
  88:     open_re = re.compile(r"<script\b[^>]*>", re.IGNORECASE)
  89:     close_re = re.compile(r"</script\s*>", re.IGNORECASE)
