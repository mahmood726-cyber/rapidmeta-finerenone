 339: def check_20_localStorage_key_collision(p, txt, ctx):
 340:     """P1: localStorage key looks like a stock template (e.g. 'rapid_meta_template')."""
 341:     out = []
 342:     for m in re.finditer(r"localStorage\.\w+\(['\"]([^'\"]{1,200})['\"]", txt):
 343:         k = m.group(1)
 344:         if "{{" in k or "STEM" in k or "TEMPLATE" in k or k.endswith("_undefined"):
 345:             out.append({"check": "20_localStorage_template_key", "severity": "P1",
 346:                         "file": p.name, "detail": k})
 347:             return out
 348:     return out
