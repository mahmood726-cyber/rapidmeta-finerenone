 513:     """P3: meta robots=noindex on a published page (probably unintentional)."""
 514:     if re.search(r'name="robots"\s+content="[^"]*noindex', txt, re.IGNORECASE):
 515:         return [{"check": "35_noindex_set", "severity": "P3", "file": p.name, "detail": ""}]
