 262: def check_14_invalid_pmid_format(p, txt, ctx):
 263:     """P2: pmid: 'NaN' / 'undefined' / 'null' literal as string / non-numeric."""
 264:     out = []
 265:     for m in PMID_RE.finditer(txt):
