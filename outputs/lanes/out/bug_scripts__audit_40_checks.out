 412: def check_26_inconsistent_acronyms(p, txt, ctx):
 413:     """P3: trial name in realData differs between `name:` and `snippet:`."""
 414:     out = []
 415:     for m in TRIAL_BLOCK_RE.finditer(txt):
 416:         body = m.group("body")
 417:         name_m = re.search(r"name:\s*'([^']*)'", body)
 418:         snip_m = re.search(r"snippet:\s*'NCT[^:]*:\s*([^']{4,40})", body)
 419:         # Best-effort, may not always be set; only flag when both present and clearly inconsistent.
 420:         if name_m and snip_m:
 421:             name = name_m.group(1).strip()
 422:             if name and len(name) > 3 and name not in body[:600]:
 423:                 pass  # too noisy; skip this check
 424:     return out
