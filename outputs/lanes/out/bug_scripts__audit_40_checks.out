 367: def check_23_svg_invalid_coords(p, txt, ctx):
 368:     """P1: SVG forest-plot coordinates containing NaN, Infinity, or empty."""
 369:     out = []
 370:     for m in re.finditer(r"<svg[^>]*viewBox=\"([^\"]+)\"", txt):
 371:         vb = m.group(1).split()
 372:         for v in vb:
 373:             try:
 374:                 fv = float(v)
 375:                 if fv != fv or fv == float("inf") or fv == float("-inf"):
 376:                     out.append({"check": "23_svg_bad_viewbox", "severity": "P1",
 377:                                 "file": p.name, "detail": vb})
 378:                     return out
 379:             except ValueError:
 380:                 out.append({"check": "23_svg_bad_viewbox", "severity": "P1",
 381:                             "file": p.name, "detail": vb})
 382:                 return out
 383:     # x="NaN" anywhere in <text>/<rect>/<line>
 384:     if re.search(r'\b(?:x|y|x1|x2|y1|y2|cx|cy)="(?:NaN|Infinity|-Infinity)"', txt):
 385:         out.append({"check": "23_svg_bad_coord", "severity": "P1", "file": p.name,
 386:                     "detail": "NaN/Infinity in svg attr"})
 387:     return out
