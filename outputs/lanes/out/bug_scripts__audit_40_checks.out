 305: def check_17_year_plausibility(p, txt, ctx):
 306:     """P2: year in realData < 1990 or > 2030."""
 307:     out = []
 308:     for m in TRIAL_BLOCK_RE.finditer(txt):
 309:         body = m.group("body")
 310:         mm = re.search(r"\byear:\s*(-?\d+)", body)
 311:         if mm:
 312:             y = int(mm.group(1))
 313:             if y < 1990 or y > 2030:
 314:                 out.append({"check": "17_year_implausible", "severity": "P2", "file": p.name,
 315:                             "detail": f"{m.group(1)} year={y}"})
 316:                 if len(out) >= 3: break
 317:     return out
