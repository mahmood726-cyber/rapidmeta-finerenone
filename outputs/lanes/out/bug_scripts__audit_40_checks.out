 358: def check_22_outcome_title_dupe(p, txt, ctx):
 359:     """P3: every trial has identical outcome title (likely template not substituted)."""
 360:     titles = re.findall(r"title:\s*'([^']{20,})\s*\(primary\)'", txt)
 361:     if len(titles) >= 2 and len(set(titles)) == 1:
 362:         return [{"check": "22_outcome_titles_all_identical", "severity": "P3",
 363:                  "file": p.name, "detail": titles[0][:80]}]
