 472: def check_32_no_h1(p, txt, ctx):
 473:     """P3: page has no <h1> (a11y/SEO)."""
 474:     if not re.search(r"<h1\b", txt, re.IGNORECASE):
 475:         return [{"check": "32_no_h1", "severity": "P3", "file": p.name, "detail": ""}]
 476:     return []
