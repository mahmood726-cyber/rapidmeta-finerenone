 585: 
 586: # Helper -----------------------------------------------------------------------
 587: def mask_strings(t: str, keep_template_strings: bool = True) -> str:
 588:     """Replace contents of quoted strings with blanks.
 589: 
 590:     keep_template_strings=False also blanks backtick template literals.
 591:     """
 592:     out = []
