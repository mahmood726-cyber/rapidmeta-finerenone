 560: def check_39_aria_label_missing_on_button(p, txt, ctx):
 561:     """P3: <button> with no text and no aria-label."""
 562:     out = []
 563:     for m in re.finditer(r"<button\b[^>]*>(\s*)</button>", txt):
 564:         # Inspect the button tag for aria-label
 565:         start = max(0, m.start()-200)
 566:         anchor = txt[start: m.end()]
 567:         if "aria-label" not in anchor:
 568:             out.append({"check": "39_empty_button_no_aria", "severity": "P3",
 569:                         "file": p.name, "detail": anchor[-80:]})
 570:             if len(out) >= 2: break
 571:     return out
