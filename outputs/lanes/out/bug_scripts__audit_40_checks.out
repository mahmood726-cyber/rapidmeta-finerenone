 504: def check_34_screening_template_old(p, txt, ctx):
 505:     """P2: pages still using the pre-v3 screening template (t.data?.ctgovUrl only)."""
 506:     if "${t.data?.ctgovUrl ? `<a href" in txt:
 507:         return [{"check": "34_old_screening_template", "severity": "P2", "file": p.name,
 508:                  "detail": "still uses pre-v3 ctgovUrl-only template"}]
 509:     return []
