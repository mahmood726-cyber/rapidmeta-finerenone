 284: def check_16_external_cdn_inside_csp(p, txt, ctx):
 285:     """P2: <script src= or <link href= to a host not whitelisted in CSP connect-src."""
 286:     out = []
 287:     # Find CSP if any
 288:     csp = re.search(r'http-equiv="Content-Security-Policy"\s*content="([^"]+)"', txt)
 289:     if not csp:
 290:         return out
 291:     allowed_hosts = set(re.findall(r"https?://[^\s']+", csp.group(1)))
 292:     # Check external script/link
 293:     for m in re.finditer(r"(?:src|href)=\"(https?://[^/\"]+)/", txt):
 294:         host = m.group(1)
 295:         if host.endswith(("clinicaltrials.gov", "ebi.ac.uk", "openalex.org", "r-wasm.org", "ncbi.nlm.nih.gov", "cdn.plot.ly", "cdnjs.cloudflare.com", "fonts.googleapis.com", "fonts.gstatic.com")):
 296:             continue
 297:         if host not in allowed_hosts:
 298:             # Many will trigger; report once
 299:             out.append({"check": "16_csp_off_whitelist", "severity": "P2", "file": p.name,
 300:                         "detail": host})
 301:             return out
 302:     return out
