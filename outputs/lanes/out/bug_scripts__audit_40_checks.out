 531: def check_37_inconsistent_drug_name(p, txt, ctx):
 532:     """P3: title-case 'Drug' mentioned but stem says 'OTHER_DRUG' â€” review name drift."""
 533:     stem = re.split(r"_AUTO_FULL_REVIEW|_AUTO_REVIEW|_REVIEW", p.name, 1)[0]
 534:     if not stem or "_" not in stem:
 535:         return []
 536:     first = stem.split("_")[0].lower()
 537:     if len(first) < 4 or first in {"new", "trial", "study", "all"}:
 538:         return []
 539:     # If the first stem token does not appear at all in the page, flag.
 540:     if first.lower() not in txt.lower():
 541:         return [{"check": "37_stem_not_in_page", "severity": "P3", "file": p.name,
 542:                  "detail": f"stem token '{first}' not present"}]
 543:     return []
