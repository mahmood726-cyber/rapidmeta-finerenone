 545: 
 546: def check_38_nesting_via_template_literal(p, txt, ctx):
 547:     """P0: backtick template literal containing `${` but missing closing brace."""
 548:     # Cheap heuristic: dollar-brace count balance in script content.
 549:     out = []
 550:     for m in re.finditer(r"<script\b[^>]*>([\s\S]*?)</script>", txt):
 551:         body = m.group(1)
 552:         n_open_db = body.count("${")
 553:         # Count closing braces that ARE in template-literal context â€” hard. Skip
 554:         # unless extremely lopsided (rough sanity).
 555:         if n_open_db == 0: continue
 556:         # Look for stray `${` followed by `}` mismatch is too noisy; just record gross outliers.
 557:     return out
