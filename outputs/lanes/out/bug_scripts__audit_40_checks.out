 519: def check_36_target_blank_no_noopener(p, txt, ctx):
 520:     """P2: target="_blank" without rel="noopener" (tab-napping security)."""
 521:     out = []
 522:     for m in re.finditer(r'<a[^>]*target="_blank"[^>]*>', txt):
 523:         anchor = m.group(0)
 524:         if 'rel="noopener' not in anchor and "rel='noopener" not in anchor:
 525:             out.append({"check": "36_blank_no_noopener", "severity": "P2",
 526:                         "file": p.name, "detail": anchor[:120]})
 527:             if len(out) >= 2: break
