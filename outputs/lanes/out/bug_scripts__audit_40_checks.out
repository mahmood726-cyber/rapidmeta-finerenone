 276:     """P3: outcome titles with mojibake (Ã¢â‚¬, Ã¢â‚¬â„¢, ÃƒÂ©, etc.)."""
 277:     out = []
 278:     if re.search(r"Ã¢â‚¬[\Wâ„¢]|Ãƒ[Â©Â¨ÂªÂ¢]|Ã¢â€â‚¬|Ã¢Ëœâ€¦|Ã¢â€|Ã¢â‚¬\"", txt):
 279:         out.append({"check": "15_mojibake", "severity": "P3", "file": p.name,
 280:                     "detail": "encoding-damaged unicode found"})
