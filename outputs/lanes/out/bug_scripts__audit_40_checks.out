  98:             i = m.end()
  99:         else:
 100:             m = close_re.search(txt, i)
 101:             if not m:
 102:                 # script opened but never closed before EOF -> genuinely broken
 103:                 out.append({"check": "03_unbalanced_script", "severity": "P0",
 104:                             "file": p.name, "detail": "unclosed <script> at EOF"})
 105:                 break
 106:             in_script = False
 107:             i = m.end()
 108:     return out
