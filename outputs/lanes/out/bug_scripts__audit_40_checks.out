 252: def check_13_hardcoded_local_paths(p, txt, ctx):
 253:     """P1: Windows / Unix local paths leaked into shipped HTML."""
 254:     out = []
 255:     for m in re.finditer(r'[A-Z]:\\\\?Users\\\\?[A-Za-z]+|/home/[a-z]+/', txt):
 256:         out.append({"check": "13_local_path", "severity": "P1", "file": p.name,
 257:                     "detail": m.group(0)})
 258:         if len(out) >= 3: break
 259:     return out
