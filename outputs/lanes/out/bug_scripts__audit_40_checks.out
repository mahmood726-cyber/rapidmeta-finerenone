 402: def check_25_orphan_anchor_with_no_text(p, txt, ctx):
 403:     """P3: empty anchor <a href="..."></a> visible to users as a dead spot."""
 404:     out = []
 405:     for m in re.finditer(r'<a\s+href="[^"]+"[^>]*>\s*</a>', txt):
 406:         out.append({"check": "25_empty_anchor", "severity": "P3", "file": p.name,
 407:                     "detail": m.group(0)[:120]})
 408:         if len(out) >= 2: break
