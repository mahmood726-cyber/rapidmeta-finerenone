 236: 
 237: def check_12_truncated_outcome_titles(p, txt, ctx):
 238:     """P3: outcome titles cut off mid-word (end with a partial like "Rheumat")."""
 239:     out = []
 240:     for m in re.finditer(r"title:\s*'([^']{60,200}?)\s*\(primary\)'", txt):
 241:         title = m.group(1).rstrip()
 242:         # If it ends mid-word (alphanumeric, no punctuation), flag.
 243:         if title and re.search(r"[A-Za-z]{4,}$", title) and not re.search(r"[.\):]$", title):
 244:             # heuristic: <=200 char limit suggests truncation
 245:             if len(title) >= 110:
 246:                 out.append({"check": "12_truncated_title", "severity": "P3",
 247:                             "file": p.name, "detail": title[-60:]})
 248:                 if len(out) >= 3: break
 249:     return out
