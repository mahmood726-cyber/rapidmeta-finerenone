 390: def check_24_orphan_close_tag(p, txt, ctx):
 391:     """P2: stray </body> or </html> appearing before the actual end."""
 392:     out = []
 393:     if txt.count("</body>") > 1:
 394:         out.append({"check": "24_dup_body_close", "severity": "P2", "file": p.name,
 395:                     "detail": f"</body> Ã—{txt.count('</body>')}"})
 396:     if txt.count("</html>") > 1:
 397:         out.append({"check": "24_dup_html_close", "severity": "P2", "file": p.name,
 398:                     "detail": f"</html> Ã—{txt.count('</html>')}"})
 399:     return out
