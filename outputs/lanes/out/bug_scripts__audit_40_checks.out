 136: 
 137: 
 138: def check_06_unpopulated_placeholders(p, txt, ctx):
 139:     """P1: literal {{token}} / __PLACEHOLDER__ / REPLACE_ME / $$$ leaked through."""
 140:     out = []
 141:     patterns = [r"\{\{[A-Z_][A-Z0-9_]*\}\}", r"__[A-Z_]+__", r"\bREPLACE_ME\b",
 142:                 r"<<<<+\s", r"\$\$\$+", r"\bTODO_FIXME\b"]
 143:     for pat in patterns:
 144:         for m in re.finditer(pat, txt):
 145:             # ignore inside <pre>/<code> samples
 146:             ctx_str = txt[max(0, m.start()-30): m.end()+30]
 147:             if "<pre" in ctx_str or "code" in ctx_str[:35]:
 148:                 continue
 149:             out.append({"check": "06_unpopulated_placeholder", "severity": "P1",
 150:                         "file": p.name, "detail": m.group(0) + " ctx=" + ctx_str[:80]})
 151:             if len(out) >= 3:
 152:                 return out
 153:     return out
 154: 
 155: 
 156: def check_07_empty_pmid_link(p, txt, ctx):
 157:     """P2: <a href="https://pubmed.ncbi.nlm.nih.gov//">PMID </a> with empty id."""
 158:     out = []
 159:     for m in re.finditer(r"pubmed\.ncbi\.nlm\.nih\.gov/(\d*)/", txt):
 160:         if not m.group(1):
 161:             out.append({"check": "07_empty_pmid_link", "severity": "P2", "file": p.name,
 162:                         "detail": "empty PMID in link"})
 163:             return out
 164:     return out
 165: 
 166: 
 167: def check_08_event_count_consistency(p, txt, ctx):
 168:     """P1: tE > tN or cE > cN within a realData trial block."""
 169:     out = []
 170:     for m in TRIAL_BLOCK_RE.finditer(txt):
 171:         nct = m.group(1)
 172:         body = m.group("body")
 173:         nums = {}
 174:         for fld in ("tE", "tN", "cE", "cN"):
 175:             mm = re.search(rf"\b{fld}:\s*(-?\d+|null|None)", body)
 176:             if mm:
 177:                 v = mm.group(1)
 178:                 if v in ("null", "None"):
 179:                     nums[fld] = None
 180:                 else:
 181:                     nums[fld] = int(v)
 182:         # Both arms must have valid numeric counts to compare.
 183:         if all(nums.get(k) is not None for k in ("tE", "tN", "cE", "cN")):
 184:             tE, tN, cE, cN = nums["tE"], nums["tN"], nums["cE"], nums["cN"]
 185:             if tE > tN or cE > cN or tE < 0 or cE < 0 or tN <= 0 or cN <= 0:
 186:                 out.append({"check": "08_event_count_inconsistency", "severity": "P1",
 187:                             "file": p.name,
 188:                             "detail": f"{nct} tE={tE} tN={tN} cE={cE} cN={cN}"})
 189:                 if len(out) >= 5: break
 190:     return out
 191: 
 192: 
 193: def check_09_rob_array_length(p, txt, ctx):
 194:     """P2: rob: [...] not length 5 in a trial block (RoB 2.0 needs 5 domains)."""
 195:     out = []
 196:     for m in TRIAL_BLOCK_RE.finditer(txt):
 197:         nct = m.group(1)
 198:         body = m.group("body")
 199:         mm = re.search(r"rob:\s*\[([^\]]*)\]", body)
 200:         if mm:
 201:             items = [x for x in mm.group(1).split(",") if x.strip()]
 202:             if len(items) != 5 and len(items) != 0:
 203:                 out.append({"check": "09_rob_length", "severity": "P2", "file": p.name,
 204:                             "detail": f"{nct} rob has {len(items)} items"})
 205:                 if len(out) >= 3: break
 206:     return out
 207: 
 208: 
 209: def check_10_nct_in_auto_include_vs_realdata(p, txt, ctx):
 210:     """P1: AUTO_INCLUDE set must match keys in realData."""
 211:     out = []
 212:     inc_match = re.search(r"AUTO_INCLUDE_TRIAL_IDS\s*=\s*new\s+Set\(\[([^\]]*)\]\)", txt)
 213:     if not inc_match:
 214:         return out
 215:     inc_set = set(NCT_RE.findall(inc_match.group(1)))
 216:     real_set = set(NCT_RE.findall(re.search(r"realData:\s*\{[\s\S]*?async init", txt).group(0)
 217:                                   if re.search(r"realData:\s*\{[\s\S]*?async init", txt) else ""))
 218:     extra_inc = inc_set - real_set
 219:     extra_real = real_set - inc_set
 220:     if extra_inc or extra_real:
 221:         out.append({"check": "10_nct_set_mismatch", "severity": "P1", "file": p.name,
 222:                     "detail": f"auto_include-only={sorted(extra_inc)[:3]} realData-only={sorted(extra_real)[:3]}"})
 223:     return out
 224: 
 225: 
 226: def check_11_duplicate_html_ids(p, txt, ctx):
 227:     """P2: duplicate id="..." attributes (illegal HTML, breaks JS getElementById)."""
 228:     ids = [m.group(1) for m in ID_ATTR_RE.finditer(txt)]
 229:     cnt = Counter(ids)
 230:     dupes = {k: v for k, v in cnt.items() if v > 1 and k not in ("",)}
 231:     if dupes:
 232:         return [{"check": "11_dup_html_ids", "severity": "P2", "file": p.name,
 233:                  "detail": "; ".join(f"{k}Ã—{v}" for k, v in list(dupes.items())[:3])}]
 234:     return []
