'visit-leading': obj('urgent heart failure visit', 'worsening heart failure requiring an urgent heart failure visit'),
'zero-k': {'inputs':{'trials':[{'name':'A','by_outcome':{'o':{'outcome_definition':'cardiovascular death'}}},{'name':'B','by_outcome':{'o':{'outcome_definition':'hospitalization'}}}]},'results':{'by_outcome':{'o':{'k':0,'pooled':{'point':1.0}}}}},
'missing-bo': {'inputs':{'trials':[{'name':'A','by_outcome':{'o':{'outcome_definition':'cardiovascular death'}}},{'name':'B','by_outcome':{}}]},'results':{'by_outcome':{'o':{'k':2,'pooled':{'point':1.0}}}}},
'bare-embolism-suppressed': obj('Stroke or systemic embolism', 'Stroke or systemic embolism or peripheral embolism')
}
for name,o in cases.items():
    v, notes = check(o)
    print(name, v)
    for n in notes: print(' ', n[:180])
    print()
for s in ['worsening heart failure requiring an urgent heart failure visit','Stroke or systemic embolism or embolism','Stroke or systemic embolism or peripheral embolism']:
    print(s, 'components=', _components(s), 'unread=', unrecognised_terms(s))
