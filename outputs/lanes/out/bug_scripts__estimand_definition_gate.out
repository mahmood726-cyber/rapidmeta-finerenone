from scripts.estimand_definition_gate import check,_components,unrecognised_terms

def obj(a,b):
    return {'inputs':{'trials':[{'name':'A','by_outcome':{'o':{'outcome_definition':a}}},{'name':'B','by_outcome':{'o':{'outcome_definition':b}}}]},'results':{'by_outcome':{'o':{'k':2,'pooled':{'point':1.0}}}}}
for b in ['Stroke or systemic embolism or air embolism','Stroke or systemic embolism or fat embolism','Stroke or systemic embolism or retinal embolism']:
    o=obj('Stroke or systemic embolism', b)
    print(b, check(o)[0], _components(b), unrecognised_terms(b))
