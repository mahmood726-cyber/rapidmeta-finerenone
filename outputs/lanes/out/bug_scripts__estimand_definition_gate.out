   1: """ESTIMAND DEFINITION -- was each trial's endpoint READ, or was it assumed?
   2: 
   3: WHY THIS EXISTS -- IT CAUGHT WHAT EVERYTHING ELSE MISSED
   4:     SGLT2_HF pooled four trials as one estimand and was live, carrying
   5:     HR 0.7785 (0.7296-0.8306), k=4. It passed arm_identity, identity_by_
   6:     registration, subject_match, card_matches_page, build_stamp,
   7:     no_synthesised_absence, the whole regression set and the harness gate.
   8: 
   9:     And DAPA-HF and DELIVER count "CV death, HF hospitalisation, OR URGENT HF
  10:     VISIT", while both EMPEROR trials count "CV death or HF hospitalisation"
  11:     only. Two trials counted an event class the other two did not.
  12: 
  13:     THE OBJECT RECORDED NO PER-TRIAL ENDPOINT DEFINITION AT ALL. What it carried
  14:     instead were RESULT sentences -- "the primary outcome occurred in 386 of 2373
  15:     patients (16.3%) ... hazard ratio, 0.74" -- filed as provenance.
  16: 
  17:     A QUOTE THAT SAYS WHAT HAPPENED IS NOT A QUOTE THAT SAYS WHAT WAS COUNTED.
  18:     That distinction withdrew a live four-trial estimate, and it is the only
  19:     defect so far that survived every other check in this repository, including
  20:     the ones written the same day.
  21: 
  22: WHAT A FULL PASS DOES NOT ESTABLISH -- written in advance
  23:     - NOT that the recorded definition is the trial's TRUE endpoint. It checks
  24:       that one was recorded and that the recorded ones agree; only a registry
  25:       read establishes truth, and this gate says when one is owed.
  26:     - NOT that agreeing definitions license a pool. Populations, follow-up and
  27:       analysis sets can still differ.
  28:     - NOT anything about a single-trial object: nothing to compare, UNCHECKABLE.
  29: """
  30: from __future__ import annotations
  31: import io, json, os, re, sys
  32: 
  33: if __name__ == "__main__":
  34:     sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
  35: 
  36: # A RESULT sentence reports an outcome's VALUE. A DEFINITION states what the
  37: # outcome IS. These patterns are what a result looks like; matching one where a
  38: # definition is owed is the SGLT2 defect exactly.
  39: RESULT_SENTENCE = re.compile(
  40:     r"occurred in\s+\d|hazard ratio[,:]?\s*[\d.]|"
  41:     r"\d+\s+of\s+\d+\s+patients|\(\s*\d+\.\d+\s*%\s*\)|"
  42:     r"95%\s*(?:confidence interval|CI)", re.I)
  43: 
  44: # Components that change what a composite counts. Compared as whole normalised
  45: # fields, never as fragments -- the rule this repo broke inside its own auditor.
  46: COMPONENT = re.compile(
  47:     r"urgent(?:\s+\w+){0,3}\s+visit|hospitali[sz]ation|hospitali[sz]ed|"
  48:     # A PARENTHETICAL ABBREVIATION BETWEEN THE TWO WORDS. Registries write
  49:     # "cardiovascular (CV) death" and "heart failure (HF) hospitalization", and
  50:     # the first of those matched NEITHER alternative here, so PARALLEL-HF's
  51:     # correctly-recorded endpoint read as counting hospitalisation and no death
  52:     # -- disagreeing with three trials that count exactly what it counts. The
  53:     # under-read again, and again in the direction that argues for a withdrawal.
  54:     r"cardiovascular\s*(?:\([^)]{0,12}\))?\s*death|cv death|"
  55:     r"death(?:s)? from cardiovascular causes|"
  56:     # "CV mortality" is how IRONMAN's registry writes the component that
  57:     # AFFIRM-AHF's writes as "CV Death". Neither the death nor the
  58:     # from-cardiovascular-causes alternative reaches it, so a correctly-recorded
  59:     # IRONMAN definition read as carrying NO cardiovascular-death component and
  60:     # the two trials appeared to count different things. Same family as
  61:     # "deaths from cardiovascular causes" on SOTAGLIFLOZIN: an under-read
  62:     # manufactures a disagreement exactly as an over-read manufactures an
  63:     # agreement, and the first argues for withdrawing a sound estimate.
  64:     r"(?:cardiovascular|cv) mortality|"
  65:     r"all-cause (?:death|mortality)|(?:death|mortality) from any cause|"
  66:     r"any-cause (?:death|mortality)|total mortality|"
  67:     # ABLATION_AF, 2026-08-17. CABANA's registry endpoint is "Total Mortality,
  68:     # Disabling Stroke, Serious Bleeding, or Cardiac Arrest" and this reader saw
  69:     # ONE of those four: stroke. Three whole components of a composite were
  70:     # invisible, so an object pairing CABANA with a stroke-only trial would have
  71:     # been reported as counting the same events. That is the comfortable
  72:     # direction and it was sitting in a live object.
  73:     r"serious bleeding|major bleeding|cardiac arrest|acute coronary syndrome|"
  74:     # DOAC_AF, 2026-08-18. Four registry records, four composites, every one of
  75:     # them "stroke OR systemic embolism" -- and this reader saw ONE of the two.
  76:     # Half of every composite in the topic was invisible, and the gate reported
  77:     # PASS "they agree" from a reading of the other half. Same shape as CABANA
  78:     # above and same shape as the CKD false agreement, in a third vocabulary.
  79:     # DOAC_CANCER_VTE, 2026-08-18. The hunting list correctly refused to decide
  80:     # here -- "venous thromboembolism" was unrecognised -- on a topic whose
  81:     # endpoints really do disagree: one trial counts VTE OR MAJOR BLEEDING and
  82:     # the others count VTE alone. The classifier half follows the finder half in
  83:     # the same commit, which is the rule this file has broken three times.
  84:     r"recurrent venous thromboembolism|venous thromboembolism|"
  85:     r"deep vein thrombosis|pulmonary embolism|\bvte\b|\bdvt\b|"
  86:     r"non-?cns systemic embolism|systemic embolic events?|"
  87:     r"systemic emboli[sz]ation|systemic embolism|systemic emboli|"
  88:     r"myocardial infarction|stroke|worsening heart failure", re.I)
  89: 
  90: # "WORSENING HEART FAILURE" IS USUALLY A QUALIFIER, NOT A COMPONENT.
  91: #
  92: # "hospitalisation for worsening heart failure" names ONE counted event. Read as
  93: # two matches it added a phantom component, and that alone made EMPEROR-Reduced
  94: # ("cardiovascular death or hospitalization for worsening heart failure") differ
  95: # from EMPEROR-Preserved ("cardiovascular death or hospitalization for heart
  96: # failure") -- two trials that count the same thing, separated by one word of
  97: # orthography. The same phantom separated AFFIRM-AHF from IRONMAN.
  98: #
  99: # Two shapes, and the attached one must be stripped FIRST or the umbrella
 100: # pattern swallows a parenthesis that merely mentions hospitalisations:
 101: #   attached  "<hospitalisation|admission|visit> [for|due to] worsening heart failure"
 102: #   umbrella  "worsening heart failure (<...enumerating hospitalisation or visit...>)"
 103: # Anything else -- a standalone worsening-heart-failure event, which some trials
 104: # really do count separately -- still yields its own component.
 105: _WORSENING_ATTACHED = re.compile(
 106:     r"\b(hospitali[sz]\w*|admission\w*|admitted|visits?)"
 107:     r"(?:\s+(?:for|due to|because of))?\s+worsening\s+heart\s+failure", re.I)
 108: # AND THE SAME PHRASE WITH THE WORDS THE OTHER WAY ROUND. CASTLE-AF's registry
 109: # endpoint is "worsening heart failure REQUIRING UNPLANNED HOSPITALIZATION", which
 110: # the attached pattern cannot see because the qualifier comes first. One counted
 111: # event read as two, on a live object -- the EMPEROR over-read in mirror image,
 112: # found the same day the first half was fixed.
 113: _WORSENING_LEADING = re.compile(
 114:     r"\bworsening\s+heart\s+failure\s+(?:requiring|leading to|resulting in)"
 115:     r"(?:\s+\w+){0,2}\s+(hospitali[sz]\w*|admission\w*)", re.I)
 116: _WORSENING_UMBRELLA = re.compile(
 117:     r"\bworsening\s+heart\s+failure\s*(?=\([^)]*(?:hospitali|visit))", re.I)
 118: 
 119: 
 120: def _norm(s):
 121:     return re.sub(r"[^a-z0-9 ]+", " ", re.sub(r"\s+", " ", (s or "").lower())).strip()
 122: 
 123: 
 124: # CANONICAL KEYS, not raw matched text. The first cut compared normalised match
 125: # strings and failed its own negative control, because "hospitalisation" and
 126: # "hospitalization" normalise to different tokens -- the British-spelling trap in
 127: # a new costume, and a gate that fails on everything is worth nothing. Each match
 128: # now maps to ONE key, so orthography cannot manufacture a difference and only a
 129: # real component change can.
 130: _CANON = (
 131:     (re.compile(r"urgent", re.I), "urgent_visit"),
 132:     (re.compile(r"hospitali", re.I), "hf_hospitalisation"),
 133:     # PHRASING VARIANTS MAP TO ONE KEY. "deaths from cardiovascular causes" is the
 134:     # same component as "cardiovascular death" and matched neither pattern, so a
 135:     # correctly-recorded SOTAGLIFLOZIN definition read as carrying no CV-death
 136:     # component. Under-reading manufactures disagreements exactly as over-reading
 137:     # does, and a withdrawal needs the same evidentiary standard as a claim.
 138:     # THE PARENTHETICAL HAS TO BE ALLOWED HERE TOO. COMPONENT finds the phrase
 139:     # and this table classifies it; widening one without the other means the
 140:     # match is found and then silently DROPPED, assigned to no key at all, which
 141:     # is indistinguishable from not finding it. Two places, one fact -- and the
 142:     # first fix touched only one of them.
 143:     (re.compile(r"(cardiovascular|cv)\s*(?:\([^)]{0,12}\))?\s*death|"
 144:                 r"death.{0,3} from cardiovascular", re.I), "cv_death"),
 145:     (re.compile(r"all-cause|any-cause|from any cause|total mortality", re.I),
 146:      "all_cause_death"),
 147:     (re.compile(r"serious bleeding|major bleeding", re.I), "serious_bleeding"),
 148:     (re.compile(r"cardiac arrest", re.I), "cardiac_arrest"),
 149:     (re.compile(r"acute coronary syndrome", re.I), "acs"),
 150:     (re.compile(r"(cardiovascular|cv) mortality", re.I), "cv_death"),
 151:     (re.compile(r"myocardial infarction", re.I), "mi"),
 152:     # ONE KEY FOR ALL FOUR PHRASINGS, and the reason is written down because
 153:     # this is exactly the kind of judgement that manufactures an agreement if
 154:     # it is wrong. RE-LY writes "systemic embolic event", ARISTOTLE "Systemic
 155:     # Embolism", ENGAGE "Systemic Embolic Events", ROCKET AF "non-CNS systemic
 156:     # embolism". The "non-CNS" is a clarification rather than a narrowing: an
 157:     # embolus reaching the brain is counted by all four as STROKE, which is the
 158:     # other arm of the same composite, so the non-CNS qualifier removes nothing
 159:     # the other three records count. Four descriptions, one event.
 160:     # SPLITTING THEM WOULD MANUFACTURE A DISAGREEMENT between four trials that
 161:     # count the same thing -- the destructive direction, because it argues for
 162:     # withdrawing a sound estimate.
 163:     # ONE KEY FOR THE WHOLE VTE FAMILY. CARAVAGGIO's registry description defines
 164:     # its primary as "the composite of: proximal DVT of the lower limbs
 165:     # (symptomatic or unsuspected), DVT of the upper limb (symptomatic), PE
 166:     # (symptomatic or unsuspected)" -- DVT and PE are THE CONTENTS OF THE UMBRELLA,
 167:     # not components beside it. Separate keys would read CARAVAGGIO as
 168:     # {vte, dvt, pe} against Hokusai's {vte, serious_bleeding} and manufacture a
 169:     # disagreement out of a trial spelling out what it means. That is the EMPEROR
 170:     # "hospitalisation for worsening heart failure" over-read, which this file has
 171:     # already had to fix twice.
 172:     # THIS ORDERS BEFORE systemic_embolism DELIBERATELY: "non-CNS systemic
 173:     # embolism" must not be swallowed by a VTE pattern, and it is not -- the two
 174:     # families share no matching text -- but the ordering is fixed so a later
 175:     # widening of either cannot silently reassign the other.
 176:     (re.compile(r"venous thromboembolism|deep vein thrombosis|"
 177:                 r"pulmonary embolism|\bvte\b|\bdvt\b", re.I), "vte"),
 178:     (re.compile(r"systemic embol", re.I), "systemic_embolism"),
 179:     (re.compile(r"stroke", re.I), "stroke"),
 180:     (re.compile(r"worsening heart failure", re.I), "worsening_hf"),
 181: )
 182: 
 183: 
 184: def _components(s):
 185:     s = _WORSENING_ATTACHED.sub(lambda m: m.group(1), s or "")
 186:     s = _WORSENING_LEADING.sub(lambda m: m.group(1), s)
 187:     s = _WORSENING_UMBRELLA.sub("", s)
 188:     out = set()
 189:     for m in COMPONENT.finditer(s or ""):
 190:         raw = m.group(0)
 191:         for rx, key in _CANON:
 192:             if rx.search(raw):
 193:                 out.add(key)
 194:                 break
 195:     return frozenset(out)
 196: 
 197: 
 198: # ---------------------------------------------------------------------------
 199: # THE HUNTING LIST -- and why this gate needed a SECOND list rather than a
 200: # LONGER first one.
 201: #
 202: # COMPONENT and _CANON are entirely CARDIOLOGICAL: hospitalisation, CV death,
 203: # stroke, MI, bleeding, cardiac arrest, ACS, worsening heart failure. There is
 204: # nothing renal in them, nothing infectious, nothing oncological.
 205: #
 206: # On 2026-08-18 this gate was run on SGLT2_CKD, whose three trials record three
 207: # DIFFERENT primary composites in their own registry records:
 208: #
 209: #   CREDENCE     doubling of serum creatinine, ESKD, renal or CV death
 210: #   DAPA-CKD     >=50% sustained decline in eGFR, ESRD, CV death, renal death
 211: #   EMPA-KIDNEY  kidney disease progression (ESKD, eGFR to <10, renal death,
 212: #                >=40% sustained decline in eGFR) or CV death
 213: #
 214: # ALL THREE REDUCED TO {cv_death}. Every renal component of every composite was
 215: # invisible, and the gate reported "every pooled outcome has a recorded endpoint
 216: # definition and THEY AGREE" -- a PASS, on three composites that differ on the
 217: # threshold at which kidney-function decline is counted at all.
 218: #
 219: # THIS IS THE CABANA DEFECT AND IT FAILS TOWARD COMFORT. CABANA's four-component
 220: # endpoint was read as "stroke", and that argued for pooling it with a
 221: # stroke-only trial. Here five components are read as one, and it argues for
 222: # pooling three composites that are not the same. Every other under-read in the
 223: # ledger failed toward ALARM; this one manufactures an AGREEMENT, which is the
 224: # direction that survives, because nobody investigates a green.
 225: #
 226: # LENGTHENING _CANON DOES NOT FIX IT. A recognition list over an open domain is
 227: # wrong again the first time this gate meets a specialty nobody added -- and the
 228: # whole infectious-disease set is next. So the fix is structural:
 229: #
 230: #     THE RECOGNITION LIST DECIDES PASS.
 231: #     THIS LIST DECIDES WHETHER THE GATE MAY DECIDE AT ALL.
 232: #
 233: # EVENT_LIKE is deliberately over-broad. Its failure mode is flagging a term the
 234: # recognition list actually handles, which yields UNCHECKABLE -- an alarm, and a
 235: # cheap one to investigate. A gap in THIS list is one level further back than a
 236: # gap in _CANON, and it is the only comfortable failure left in the design.
 237: EVENT_LIKE = re.compile(
 238:     r"\b(?:"
 239:     # renal -- the set that was invisible
 240:     r"creatinine|egfr|glomerular filtration|dialysis|transplantation|transplant|"
 241:     r"end[- ]stage|eskd|esrd|kidney disease progression|kidney failure|"
 242:     r"renal death|renal failure|renal replacement|albuminuria|proteinuria|"
 243:     r"nephropathy|"
 244:     # progression / decline language that names a counted event
 245:     r"doubling|sustained decline|disease progression|progression-free|"
 246:     # other specialties, so this is not merely cardiology-plus-renal
 247:     r"relapse|remission|recurrence|exacerbation|infection|bacteraemia|"
 248:     r"bacteremia|seroconversion|viral load|virologic failure|virological "
 249:     r"failure|treatment failure|fracture|amputation|blindness|visual acuity|"
 250:     r"overall survival|readmission|intubation|ventilation|transfusion|"
 251:     r"revascularisation|revascularization|graft loss|rejection|"
 252:     # the term whose absence let this list fail at the job it exists for
 253:     r"systemic embol[a-z]*|embolism|embolic|thromboembolism|"
 254:     r"venous thromboembolism|pulmonary embolism|deep vein thrombosis"
 255:     r")\b", re.I)
 256: 
 257: 
 258: def unrecognised_terms(s):
 259:     """Event-like phrases in a definition that the recognition list cannot see.
 260: 
 261:     A NON-EMPTY RESULT MEANS THE GATE MUST NOT COMPARE THIS DEFINITION. It has
 262:     read part of a composite and has no way to know whether the part it could
 263:     not read is the part that differs.
 264:     """
 265:     if not s:
 266:         return frozenset()
 267:     covered = " ".join(m.group(0) for m in COMPONENT.finditer(s)).lower()
 268:     return frozenset(m.group(0).lower() for m in EVENT_LIKE.finditer(s)
 269:                      if m.group(0).lower() not in covered)
 270: 
 271: 
 272: def definition_for(bo):
 273:     """The endpoint definition recorded on ONE trial-outcome cell, or "".
 274: 
 275:     THE ONE PLACE THIS LOGIC LIVES. `poolability` reported "N of N trials carry
 276:     no outcome definition" on every SSOT object in the repository, because it
 277:     read a field only the extraction schema has. That is a FALSE ALARM, and a
 278:     false alarm here is not the safe direction: it argues for withdrawing a
 279:     correct estimate, and a withdrawal needs the same evidentiary standard as a
 280:     claim. Rather than copy the resolution into a second gate -- two copies
 281:     diverge, and the divergence is invisible -- both callers use this.
 282: 
 283:     Order: the explicit field, then a provenance quote that is a DEFINITION
 284:     rather than a RESULT. The second half is what lets an object that quotes the
 285:     registry's outcome-measure title pass without also passing an object whose
 286:     provenance is "the primary outcome occurred in 386 of 2373 patients".
 287:     """
 288:     if not isinstance(bo, dict):
 289:         return ""
 290:     d = (bo.get("outcome_definition") or bo.get("definition")
 291:          or bo.get("endpoint_definition") or "")
 292:     if d:
 293:         # A TITLE CAN BE A LABEL RATHER THAN A DEFINITION, and then the
 294:         # DESCRIPTION is where the components live. PARALLEL-HF's registry title
 295:         # is "Number of Participants Who Had CEC Confirmed Composite Endpoints"
 296:         # -- which names no event at all -- while its description says "either
 297:         # cardiovascular (CV) death or heart failure (HF) hospitalization". Read
 298:         # from the title alone the trial appeared to count NOTHING, and a trial
 299:         # counting nothing disagrees with every trial that counts something. The
 300:         # recorded definition is both fields, because that is what was read.
 301:         desc = (bo.get("outcome_definition_source") or {}).get(
 302:             "description_verbatim")
 303:         return "%s %s" % (d, desc) if desc else d
 304:     quotes = (bo.get("provenance") or {}).get("source_quotes") or []
 305:     cand = [q for q in quotes if not RESULT_SENTENCE.search(q) and _components(q)]
 306:     return max(cand, key=len) if cand else ""
 307: 
 308: 
 309: def check(obj):
 310:     trials = ((obj.get("inputs") or {}).get("trials")) or []
 311:     results = ((obj.get("results") or {}).get("by_outcome")) or {}
 312:     if not trials or not results:
 313:         return "UNCHECKABLE", ["object carries no trials or no pooled outcome"]
 314: 
 315:     notes, bad, withdrawn_for_this = [], False, False
 316:     unreadable_for_this = False
 317:     for oid, res in results.items():
 318:         if (res.get("k") or 0) < 2:
 319:             notes.append("%s: k<2, nothing to compare" % oid)
 320:             continue
 321:         # A POOL ALREADY WITHDRAWN FOR THIS EXACT REASON IS THE PROPERTY MET.
 322:         #
 323:         # ABLATION_AF's four trials record four different primary composites, and
 324:         # its estimate is withdrawn WITH that as the stated reason. Scoring it
 325:         # FAIL made a page that found the difference and acted on it
 326:         # indistinguishable from a page that pooled straight through -- which is
 327:         # SGLT2_HF, whose object still carries a live k=4 point. A score that
 328:         # cannot tell those two apart cannot measure the thing it is for.
 329:         #
 330:         # This is NOT an escape hatch: a withdrawn pool displays no number, so
 331:         # there is nothing left for a mismatched estimand to be wrong about. A
 332:         # LIVE pool with disagreeing definitions still FAILs, which is the
 333:         # constructible failure and the SGLT2 replay.
 334:         _p = res.get("pooled") or {}
 335:         _withdrawn = (_p.get("point") is None and _p.get("withdrawn")
 336:                       and (_p.get("withdrawn_reason") or "").strip())
 337:         defs, missing, resultish, unregistered = {}, [], [], []
 338:         for t in trials:
 339:             bo = (t.get("by_outcome") or {}).get(oid)
 340:             if not bo:
 341:                 continue
 342:             name = t.get("name") or t.get("nct") or "?"
 343:             # AN ENDPOINT THAT IS NOT REGISTERED AT ALL IS A FOURTH STATE, and
 344:             # until 2026-08-18 this gate had no way to hold it. ARNI_HF pools
 345:             # ANSWER-HF's composite of cardiovascular death and heart-failure
 346:             # hospitalisation; NCT04853758 declares TWO primary outcome measures
 347:             # and EIGHTEEN secondary ones and none of the twenty is that
 348:             # composite. The quantity exists only in the publication.
 349:             #
 350:             # Recording that truthfully put the registry's ENUMERATION -- which
 351:             # is the proof of the absence -- into the definition field, where the
 352:             # vocabulary scanner met the word "creatinine", declared itself
 353:             # unable to read a definition, and returned UNCHECKABLE. The gate
 354:             # answered the strongest finding available to it with "I could not
 355:             # read this", which is the comfortable direction.
 356:             #
 357:             # The state is DECLARED by the object rather than inferred from its
 358:             # prose: a declared field beats an inferred one, the same precedence
 359:             # v1_coverage_audit had to learn three times. It is a FAIL and not an
 360:             # UNCHECKABLE, because nothing here is unreadable -- the registry was
 361:             # read in full and what it says is that the endpoint is absent.
 362:             _rank = ((bo.get("outcome_definition_source") or {})
 363:                      .get("endpoint_rank") or "")
 364:             if "not registered" in str(_rank).lower():
 365:                 unregistered.append(name)
 366:                 continue
 367:             # A QUOTE CAN BE THE DEFINITION -- that is the whole distinction, and
 368:             # it is resolved in definition_for() so poolability cannot drift from
 369:             # it. FINERENONE_CV stores each trial's endpoint TITLE, read word for
 370:             # word from the registry, in source_quotes. SGLT2_HF stores RESULT
 371:             # sentences in the same field. Failing both would mean the gate
 372:             # cannot tell the work done right from the work done wrong, which is
 373:             # the property it exists to measure.
 374:             d = definition_for(bo)
 375:             quotes = (bo.get("provenance") or {}).get("source_quotes") or []
 376:             if not d:
 377:                 missing.append(name)
 378:                 if quotes and RESULT_SENTENCE.search(" ".join(quotes)):
 379:                     resultish.append(name)
 380:             else:
 381:                 defs[name] = d
 382:         if unregistered:
 383:             if _withdrawn:
 384:                 withdrawn_for_this = True
 385:             else:
 386:                 bad = True
 387:             notes.append(
 388:                 "%s: %d of %d contributing trial(s) REGISTER NO SUCH ENDPOINT, at "
 389:                 "any rank: %s. This is not a definition that disagrees and not a "
 390:                 "definition that is missing from the object -- it is a definition "
 391:                 "that is missing from the REGISTRATION, so for this trial there is "
 392:                 "no pre-specified statement of what was counted for the pool to "
 393:                 "rest on. The remaining rows are compared to each other below and "
 394:                 "their agreement, if any, is agreement among them alone."
 395:                 % (oid, len(unregistered), len(unregistered) + len(defs) + len(missing),
 396:                    ", ".join(unregistered[:6])))
 397:         if missing:
 398:             if _withdrawn:
 399:                 withdrawn_for_this = True
 400:             else:
 401:                 bad = True
 402:             notes.append("%s: NO endpoint definition recorded for %d trial(s): %s"
 403:                          % (oid, len(missing), ", ".join(missing[:6])))
 404:             if resultish:
 405:                 notes.append("    and the provenance quote is a RESULT sentence on "
 406:                              "%d of them: %s -- what happened, never what was counted"
 407:                              % (len(resultish), ", ".join(resultish[:6])))
 408:         if len(defs) > 1:
 409:             # BEFORE COMPARING ANYTHING: can this reader read these definitions?
 410:             # A comparison of two partial readings is not a comparison of two
 411:             # definitions. If the recognition vocabulary cannot see event-like
 412:             # terms that are present in the text, the honest verdict is that the
 413:             # gate could not read them -- NOT that they agree.
 414:             blind = {n: unrecognised_terms(d) for n, d in defs.items()}
 415:             unread = {n: t for n, t in blind.items() if t}
 416:             if unread:
 417:                 unreadable_for_this = True
 418:                 notes.append(
 419:                     "%s: THIS GATE CANNOT READ %d of %d definitions. Its component "
 420:                     "vocabulary is cardiological and these name events it does not "
 421:                     "recognise, so any agreement it reported would be an agreement "
 422:                     "between two PARTIAL READINGS:" % (oid, len(unread), len(defs)))
 423:                 for n in sorted(unread):
 424:                     notes.append("    %-22s unrecognised: {%s}   recognised: {%s}"
 425:                                  % (n, ", ".join(sorted(unread[n])[:8]),
 426:                                     ", ".join(sorted(_components(defs[n]))) or "-"))
 427:                 notes.append("    Read these by hand against the registry. A PASS "
 428:                              "here would be the CABANA under-read failing toward "
 429:                              "comfort instead of toward alarm.")
 430:                 continue
 431:             comp = {n: _components(d) for n, d in defs.items()}
 432:             # A NOTE THAT PROMISES A COMPARISON MUST SHOW IT. The unregistered
 433:             # branch above says "the remaining rows are compared to each other
 434:             # below", and when they agree nothing was printed, because agreement
 435:             # is the silent path. A reader then sees an accusation and no
 436:             # acquittal -- confirmations have to be as visible as errors.
 437:             if unregistered and len(set(comp.values())) == 1:
 438:                 notes.append(
 439:                     "    and the %d trial(s) that DO register it agree with each "
 440:                     "other exactly -- %s all count {%s}. The defect is confined to "
 441:                     "the unregistered row."
 442:                     % (len(comp), ", ".join(sorted(comp)),
 443:                        ", ".join(sorted(next(iter(comp.values())))) or "-"))
 444:             if len(set(comp.values())) > 1:
 445:                 if _withdrawn:
 446:                     withdrawn_for_this = True
 447:                 else:
 448:                     bad = True
 449:                 notes.append("%s: recorded definitions DISAGREE across trials%s:"
 450:                              % (oid, " -- AND THE ESTIMATE IS WITHDRAWN, WITH THIS "
 451:                                      "AS ITS STATED REASON" if _withdrawn else ""))
 452:                 for n, c in comp.items():
 453:                     notes.append("    %-22s counts {%s}"
 454:                                  % (n, ", ".join(sorted(c)) or "-"))
 455:     if not notes:
 456:         notes = ["every pooled outcome has a recorded endpoint definition and they agree"]
 457:     if bad:
 458:         return "FAIL", notes
 459:     # UNCHECKABLE OUTRANKS WITHDRAWN AND PASS. If the gate could not read the
 460:     # definitions it cannot certify that a withdrawal was for the right reason
 461:     # either -- and a withdrawal made on an unread definition is exactly the
 462:     # destructive error this whole apparatus exists to prevent.
 463:     if unreadable_for_this:
 464:         notes.append("-> UNCHECKABLE. The gate found event terms it does not "
 465:                      "recognise and refuses to report agreement or disagreement "
 466:                      "from a partial reading. This is NOT a pass and NOT a "
 467:                      "failure of the object.")
 468:         return "UNCHECKABLE", notes
 469:     if withdrawn_for_this:
 470:         notes.append("-> the definitions do not agree and NO ESTIMATE IS DISPLAYED. "
 471:                      "The property is met by the withholding, not by agreement, and "
 472:                      "this is recorded as WITHDRAWN rather than passed.")
 473:         return "WITHDRAWN", notes
 474:     return "PASS", notes
 475: 
 476: 
 477: def selftest():
 478:     """REPLAYED AGAINST SGLT2_HF's OWN OBJECT -- four trials, two definitions,
 479:     and it was passing every other check we own."""
 480:     ok = True
 481:     root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
 482:     real = os.path.join(root, "ssot", "sglt2-hf", "sglt2-hf.json")
 483:     if os.path.exists(real):
 484:         obj = json.loads(open(real, encoding="utf-8").read())
 485:         # THE POSITIVE CONTROL IS THE STATE THIS OBJECT WAS IN, NOT THE STATE IT
 486:         # IS IN NOW. Its pool has since been withdrawn IN THE OBJECT, so the live
 487:         # object correctly returns WITHDRAWN. Restoring the point from the
 488:         # `previous_values` that the withdrawal preserved replays the exact
 489:         # historical artefact -- four trials, two endpoint definitions, a live
 490:         # k=4 estimate. Without this, remediating the defect would have quietly
 491:         # deleted the only real past defect this gate is proved against, and the
 492:         # selftest would have gone on printing PASS over a control that no longer
 493:         # controls anything.
 494:         for _res in ((obj.get("results") or {}).get("by_outcome") or {}).values():
 495:             _p = _res.get("pooled") or {}
 496:             if _p.get("withdrawn") and _p.get("previous_values"):
 497:                 _res["pooled"] = dict(_p["previous_values"][0])
 498:         v, notes = check(obj)
 499:         good = v == "FAIL"
 500:         ok &= good
 501:         print("  POSITIVE SGLT2_HF, pool restored from its own withdrawal record "
 502:               "-> %-5s %s" % (v, "correct" if good else "WRONG"))
 503:         for n in notes[:2]:
 504:             print("        %s" % n[:112])
 505:         v_now, _ = check(json.loads(open(real, encoding="utf-8").read()))
 506:         ok &= v_now == "WITHDRAWN"
 507:         print("  NEGATIVE SGLT2_HF as it stands today, pool withdrawn -> %-9s %s"
 508:               % (v_now, "correct" if v_now == "WITHDRAWN" else "WRONG"))
 509:     else:
 510:         print("  fixture absent: sglt2-hf object -- NOT PROVEN")
 511:         ok = False
 512: 
 513:     clean = {"inputs": {"trials": [
 514:         {"name": "A", "by_outcome": {"o": {"outcome_definition":
 515:          "cardiovascular death or hospitalisation for heart failure"}}},
 516:         {"name": "B", "by_outcome": {"o": {"outcome_definition":
 517:          "cardiovascular death or hospitalization for heart failure"}}}]},
 518:         "results": {"by_outcome": {"o": {"k": 2}}}}
 519:     v2, _ = check(clean)
 520:     ok &= v2 == "PASS"
 521:     print("  NEGATIVE same definition, spelling aside            -> %-5s %s"
 522:           % (v2, "correct" if v2 == "PASS" else "WRONG"))
 523: 
 524:     # THE UNREGISTERED-ENDPOINT BRANCH, WITH BOTH SIGNS. Its founding artefact is
 525:     # ARNI_HF's ANSWER-HF row. The pair matters more than either half: the two
 526:     # inputs differ ONLY in whether the third trial's registration declares the
 527:     # endpoint, and the definitions AGREE in both, so a gate that could not tell
 528:     # them apart would report PASS on a pool a quarter of which rests on nothing
 529:     # pre-specified.
 530:     unreg = json.loads(json.dumps(clean))
 531:     unreg["inputs"]["trials"].append(
 532:         {"name": "C", "by_outcome": {"o": {
 533:             "outcome_definition": "cardiovascular death or hospitalisation for "
 534:                                   "heart failure",
 535:             "outcome_definition_source": {"endpoint_rank": "SECONDARY"}}}})
 536:     unreg["results"]["by_outcome"]["o"]["k"] = 3
 537:     v3a, _ = check(unreg)
 538:     ok &= v3a == "PASS"
 539:     print("  NEGATIVE third trial registers it as a secondary    -> %-5s %s"
 540:           % (v3a, "correct" if v3a == "PASS" else "WRONG"))
 541: 
 542:     unreg2 = json.loads(json.dumps(unreg))
 543:     (unreg2["inputs"]["trials"][2]["by_outcome"]["o"]["outcome_definition_source"]
 544:      ["endpoint_rank"]) = "NOT REGISTERED AT ANY RANK"
 545:     v3b, n3b = check(unreg2)
 546:     ok &= v3b == "FAIL"
 547:     print("  POSITIVE same definition, registered at NO rank     -> %-5s %s"
 548:           % (v3b, "correct" if v3b == "FAIL" else "WRONG"))
 549:     print("        %s" % n3b[0][:112])
 550: 
 551:     mixed = json.loads(json.dumps(clean))
 552:     mixed["inputs"]["trials"][1]["by_outcome"]["o"]["outcome_definition"] = (
 553:         "cardiovascular death, hospitalisation for heart failure, or urgent "
 554:         "heart failure visit")
 555:     v3, _ = check(mixed)
 556:     ok &= v3 == "FAIL"
 557:     print("  POSITIVE one trial adds an urgent-visit component   -> %-5s %s"
 558:           % (v3, "correct" if v3 == "FAIL" else "WRONG"))
 559: 
 560:     resultish = {"inputs": {"trials": [
 561:         {"name": "A", "by_outcome": {"o": {"provenance": {"source_quotes": [
 562:             "the primary outcome occurred in 386 of 2373 patients (16.3%) "
 563:             "(hazard ratio, 0.74; 95% CI 0.65-0.85)"]}}}},
 564:         {"name": "B", "by_outcome": {"o": {"provenance": {"source_quotes": [
 565:             "a primary outcome event occurred in 361 of 1863 patients"]}}}}]},
 566:         "results": {"by_outcome": {"o": {"k": 2}}}}
 567:     v4, notes4 = check(resultish)
 568:     ok &= v4 == "FAIL" and any("RESULT sentence" in n for n in notes4)
 569:     print("  POSITIVE result sentences filed as provenance       -> %-5s %s"
 570:           % (v4, "correct" if v4 == "FAIL" else "WRONG"))
 571: 
 572:     fin = os.path.join(root, "ssot", "finerenone-cv", "finerenone-cv.json")
 573:     if os.path.exists(fin):
 574:         v6, n6 = check(json.loads(open(fin, encoding="utf-8").read()))
 575:         ok &= v6 == "PASS"
 576:         print("  NEGATIVE FINERENONE_CV: endpoint TITLES quoted -> %-5s %s"
 577:               % (v6, "correct" if v6 == "PASS" else "WRONG -- the gate cannot tell "
 578:                  "a definition quote from a result quote"))
 579: 
 580:     # THE CANON ITSELF, on real registry text. Each of these read WRONG before
 581:     # 2026-08-17 and each wrong reading manufactured a disagreement between
 582:     # trials that count the same events -- the direction that argues for
 583:     # withdrawing a sound estimate.
 584:     print("")
 585:     canon_cases = [
 586:         ("AFFIRM-AHF primary, registry",
 587:          "HF Hospitalizations and CV Death", {"cv_death", "hf_hospitalisation"}),
 588:         ("IRONMAN primary, registry -- 'CV mortality', and a qualifier not a "
 589:          "component",
 590:          "CV mortality or hospitalisation for worsening heart failure (analysis "
 591:          "will include first and recurrent hospitalisations)",
 592:          {"cv_death", "hf_hospitalisation"}),
 593:         ("EMPEROR-Reduced: 'hospitalization for WORSENING heart failure'",
 594:          "a composite of cardiovascular death or hospitalization for worsening "
 595:          "heart failure", {"cv_death", "hf_hospitalisation"}),
 596:         ("EMPEROR-Preserved: the same events, one word apart",
 597:          "a composite of cardiovascular death or hospitalization for heart "
 598:          "failure", {"cv_death", "hf_hospitalisation"}),
 599:         ("DAPA-HF: the umbrella phrase enumerates its own contents",
 600:          "a composite of worsening heart failure (hospitalization or an urgent "
 601:          "visit resulting in intravenous therapy for heart failure) or "
 602:          "cardiovascular death",
 603:          {"cv_death", "hf_hospitalisation", "urgent_visit"}),
 604:         ("a STANDALONE worsening-HF event still counts as its own component",
 605:          "a composite of cardiovascular death or a worsening heart failure event "
 606:          "treated in the outpatient setting", {"cv_death", "worsening_hf"}),
 607:         ("CONFIRM-HF: the publication's own words for the death row",
 608:          "all-cause death, analysed as time to first event", {"all_cause_death"}),
 609:         # ABLATION_AF: four endpoints that must come out DIFFERENT, and three of
 610:         # the four had components this reader could not see at all.
 611:         ("CASTLE-AF: the qualifier BEFORE the hospitalisation, not after",
 612:          "All-cause mortality or worsening heart failure requiring unplanned "
 613:          "hospitalization", {"all_cause_death", "hf_hospitalisation"}),
 614:         ("CABANA: three of its four components were invisible",
 615:          "Number of Participants With Composite of Total Mortality, Disabling "
 616:          "Stroke, Serious Bleeding, or Cardiac Arrest in Patients Warranting "
 617:          "Therapy for AF.",
 618:          {"all_cause_death", "stroke", "serious_bleeding", "cardiac_arrest"}),
 619:         ("EAST-AFNET 4: acute coronary syndrome was invisible",
 620:          "A composite of cardiovascular death, stroke and hospitalization due to "
 621:          "worsening of heart failure or due to acute coronary syndrome.",
 622:          {"cv_death", "stroke", "hf_hospitalisation", "acs"}),
 623:         ("RAFT-AF: all-cause mortality and heart failure events",
 624:          "Composite of All-cause Mortality and Heart Failure Events",
 625:          {"all_cause_death"}),
 626:     ]
 627:     for label, text, want in canon_cases:
 628:         got = set(_components(text))
 629:         good = got == want
 630:         ok &= good
 631:         print("  CANON %-62s %s" % (label[:62], "correct" if good else
 632:                                     "WRONG: %s" % sorted(got)))
 633:     print("")
 634: 
 635:     v5, _ = check({})
 636:     ok &= v5 == "UNCHECKABLE"
 637:     print("  NEGATIVE an empty object                            -> %-5s %s (not a pass)"
 638:           % (v5, "correct" if v5 == "UNCHECKABLE" else "WRONG"))
 639: 
 640:     # ---- THE REPLAY: three CKD composites this gate reported as AGREEING ----
 641:     # Real registry text, read 2026-08-18 from the ClinicalTrials.gov protocol
 642:     # records. Before the hunting list, all three reduced to {cv_death} and the
 643:     # gate returned PASS with "they agree".
 644:     print("")
 645:     ckd = {
 646:         "CREDENCE": ("Primary Composite Endpoint of Doubling of Serum Creatinine "
 647:                      "(DoSC), End-stage Kidney Disease (ESKD), and Renal or "
 648:                      "Cardiovascular (CV) Death"),
 649:         "DAPA-CKD": ("Time to the First Occurrence of Any of the Components of the "
 650:                      "Composite: >=50% Sustained Decline in eGFR or Reaching ESRD "
 651:                      "or CV Death or Renal Death."),
 652:         "EMPA-KIDNEY": ("Interventional Part: Time to First Occurrence of Kidney "
 653:                         "Disease Progression or Cardiovascular Death "
 654:                         "('as Adjudicated')"),
 655:     }
 656:     same = len({_components(v) for v in ckd.values()}) == 1
 657:     unread = {n: unrecognised_terms(v) for n, v in ckd.items()}
 658:     all_flagged = all(unread.values())
 659:     ok &= same and all_flagged
 660:     print("  REPLAY SGLT2_CKD: three DIFFERENT composites, recognition list sees")
 661:     for n, v in ckd.items():
 662:         print("        %-12s recognised={%s}  unrecognised={%s}"
 663:               % (n, ", ".join(sorted(_components(v))) or "-",
 664:                  ", ".join(sorted(unread[n])[:5])))
 665:     print("        all three reduce to one component set: %s  (that is the false "
 666:           "agreement)" % same)
 667:     print("        every one flagged as unreadable: %-5s %s"
 668:           % (all_flagged, "correct" if (same and all_flagged) else "WRONG"))
 669:     print("        the version this replaces returned PASS -- 'every pooled outcome "
 670:           "has a recorded")
 671:     print("        endpoint definition and they agree' -- on these exact strings.")
 672: 
 673:     # AND THE HUNTING LIST MUST NOT FLAG A CARDIOLOGY DEFINITION IT CAN READ.
 674:     # A gate that returns UNCHECKABLE on everything is worth nothing; this is
 675:     # the negative control for the new branch.
 676:     card = ("Cardiovascular death or hospitalization for heart failure",
 677:             "cardiovascular (CV) death or heart failure (HF) hospitalization",
 678:             "Total Mortality, Disabling Stroke, Serious Bleeding, or Cardiac Arrest")
 679:     clean = all(not unrecognised_terms(c) for c in card)
 680:     ok &= clean
 681:     # ------------------------------------------------ DOAC_AF, 2026-08-18
 682:     # SYSTEMIC EMBOLISM WAS INVISIBLE TO ALL THREE LISTS. Four registry
 683:     # composites, every one "stroke OR systemic embolism", and _components()
 684:     # returned frozenset({'stroke'}) for each -- so the gate compared HALF of
 685:     # every composite in the topic and reported that they agreed.
 686:     #
 687:     # It was not caught by EVENT_LIKE either, and that is the part that matters:
 688:     # EVENT_LIKE exists to force UNCHECKABLE whenever the recognition list meets
 689:     # a term it cannot handle, and TOOLING-QUEUE.md recorded that mechanism as
 690:     # the reason "the gate can no longer report agreement from a partial
 691:     # reading". The net had the same hole as the thing it was netting.
 692:     #
 693:     # THE WIDENING MOVED NO VERDICT ON ANY OBJECT IN THE REPOSITORY. DOAC_AF was
 694:     # PASS before and PASS after, because its four composites really do agree.
 695:     # So the only thing that can demonstrate the fix is a pair that differs ONLY
 696:     # in the half that used to be unreadable. Old gate: PASS. New gate: FAIL.
 697:     _doac = {"inputs": {"trials": [
 698:         {"name": "A", "nct": "NCT1",
 699:          "by_outcome": {"o": {"outcome_definition": "Stroke or systemic embolism"}}},
 700:         {"name": "B", "nct": "NCT2",
 701:          "by_outcome": {"o": {"outcome_definition": "Stroke"}}}]},
 702:         "results": {"by_outcome": {"o": {"k": 2, "pooled": {"point": 0.8}}}}}
 703:     _v = check(_doac)[0]
 704:     _good = _v == "FAIL"
 705:     ok &= _good
 706:     print("\n  REPLAY DOAC_AF: two composites differing ONLY in the embolism half")
 707:     for _n, _t in (("RE-LY      ", "Time to first occurrence of stroke or systemic embolic event."),
 708:                    ("ROCKET AF  ", "the first occurrence of a stroke or non-CNS systemic embolism"),
 709:                    ("ARISTOTLE  ", "First Event of Ischemic/Unspecified Stroke, Hemorrhagic Stroke, or Systemic Embolism"),
 710:                    ("ENGAGE     ", "The composite of stroke and Systemic Embolic Events (SEE)")):
 711:         print("        %s reads %s" % (_n, sorted(_components(_t))))
 712:     print("        'stroke or systemic embolism' vs 'stroke' -> %s  %s"
 713:           % (_v, "correct" if _good else "WRONG"))
 714:     print("        the version this replaces returned PASS on that pair -- it could "
 715:           "not see\n        the component that is the entire difference.")
 716: 
 717:     print("\n  NEGATIVE CONTROL cardiology definitions stay readable -> %-5s %s"
 718:           % (clean, "correct" if clean else
 719:              "WRONG: %s" % [sorted(unrecognised_terms(c)) for c in card]))
 720: 
 721:     print("\nWHAT A FAILURE WOULD LOOK LIKE: SGLT2_HF passing -- which it did on "
 722:           "every other check in this repository while pooling two different "
 723:           "endpoints as one.")
 724:     print("-> SELFTEST PASS" if ok else "-> SELFTEST FAILED")
 725:     return 0 if ok else 1
 726: 
 727: 
 728: def main():
