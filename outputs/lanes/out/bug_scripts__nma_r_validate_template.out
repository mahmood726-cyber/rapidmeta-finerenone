 153:               bt(nma$upper.random[tr, "{ref}"])))
 154: }}
 155: '''
 156: 
 157: 
 158: def extract_effects_from_config(cfg):
 159:     """For each comparison Ã— trial, pull effect + SE from realData block.
 160: 
 161:     Handles both log-scale measures (HR / OR / RR â†’ log-transform) and
 162:     linear-scale measures (MD / SMD â†’ pass through on native scale).
 163:     Scale determined by `cfg['effect_scale']`.
 164:     """
 165:     data = cfg["realData_block"]
 166:     scale = cfg.get("effect_scale", "HR").upper()
 167:     is_log_scale = scale in ("HR", "OR", "RR")
 168:     # Extract per-NCT { name, publishedHR, hrLCI, hrUCI } (signed numbers OK for MD)
 169:     pattern = re.compile(
 170:         r"'(NCT\d+[A-Z]?)':\s*\{\s*name:\s*'([^']+)'[^}]*?publishedHR:\s*(-?[\d.]+)[^}]*?hrLCI:\s*(-?[\d.]+)[^}]*?hrUCI:\s*(-?[\d.]+)",
 171:         re.DOTALL
 172:     )
 173:     trials_data = {}
 174:     for m in pattern.finditer(data):
 175:         nct, name, hr, lci, uci = m.group(1), m.group(2), float(m.group(3)), float(m.group(4)), float(m.group(5))
 176:         import math
 177:         if is_log_scale:
 178:             te = math.log(hr)
 179:             se = (math.log(uci) - math.log(lci)) / 3.92
 180:         else:
 181:             # MD / SMD â€” native scale
 182:             te = hr  # `publishedHR` stores the MD value when effect_scale is MD
 183:             se = (uci - lci) / 3.92
 184:         trials_data[nct] = {"name": name, "te": te, "se": se, "hr": hr, "lci": lci, "uci": uci}
 185: 
 186:     rows = []
 187:     for cmp in cfg["comparisons"]:
 188:         for trial_id in cmp.get("trials", []):
 189:             if trial_id not in trials_data:
 190:                 print(f"WARN: trial {trial_id} not in realData (may have CONTINUOUS scale); skipping")
 191:                 continue
 192:             td = trials_data[trial_id]
 193:             rows.append({
 194:                 "studlab": td["name"],
 195:                 "treat1": cmp["t1"],
 196:                 "treat2": cmp["t2"],
 197:                 "TE": td["te"],
 198:                 "seTE": td["se"]
 199:             })
 200:     return rows
 201: 
 202: 
 203: def generate_r_script(cfg):
 204:     rows = extract_effects_from_config(cfg)
 205:     if not rows:
 206:         raise RuntimeError("no parseable trial effects in realData_block")
 207:     # Pick reference group (last treatment by convention, or "Placebo" / "Chemoimm" / "Sham")
 208:     ref = None
 209:     for candidate in ["Placebo", "placebo", "Sham", "Chemoimmunotherapy", "Chemoimm"]:
 210:         if candidate in cfg["treatments"]:
 211:             ref = candidate
 212:             break
 213:     if ref is None:
 214:         ref = cfg["treatments"][-1]
 215: 
 216:     sm = cfg.get("effect_scale", "HR")  # HR or RR or OR
 217:     small = cfg.get("small_better", "desirable")  # "desirable" if lower HR = better
 218: 
 219:     script = R_TEMPLATE.format(
 220:         title=cfg["title"],
 221:         slug=cfg["slug"],
 222:         sm=sm,
 223:         ref=ref,
 224:         small=small,
 225:         studlab=",".join(f'"{r["studlab"]}"' for r in rows),
 226:         treat1=",".join(f'"{r["treat1"]}"' for r in rows),
 227:         treat2=",".join(f'"{r["treat2"]}"' for r in rows),
 228:         TE=",".join(f"{r['TE']:.10f}" for r in rows),
 229:         seTE=",".join(f"{r['seTE']:.10f}" for r in rows),
 230:     )
 231:     return script
 232: 
 233: 
 234: def main(cfg_path):
 235:     cfg = json.load(open(cfg_path, "r", encoding="utf-8"))
 236:     slug = cfg["slug"]
 237:     VALIDATION_DIR.mkdir(parents=True, exist_ok=True)
 238:     r_path = VALIDATION_DIR / f"{slug}_netmeta.R"
 239:     script = generate_r_script(cfg)
 240:     r_path.write_text(script, encoding="utf-8")
 241:     print(f"wrote {r_path}")
 242:     # Run it
 243:     txt_path = VALIDATION_DIR / f"{slug}_netmeta_results.txt"
 244:     print(f"running Rscript {r_path.name}...")
 245:     try:
 246:         # RSCRIPT resolution (line 19-20): env var â†’ shutil.which â†’ fallback path.
 247:         # argv-array form prevents shell injection; the env-var path is documented
 248:         # config flexibility for users with non-default R installs. An attacker
 249:         # who can set RSCRIPT in this dev-tool's env already has shell access.
 250:         result = subprocess.run(
 251:             [RSCRIPT, r_path.name],  # nosemgrep: python.lang.security.audit.dangerous-subprocess-use-tainted-env-args.dangerous-subprocess-use-tainted-env-args
 252:             cwd=VALIDATION_DIR,
 253:             capture_output=True,
 254:             text=True,
 255:             encoding='utf-8',
 256:             errors='replace',
 257:             timeout=180
 258:         )
 259:         txt_path.write_text(result.stdout + result.stderr, encoding="utf-8")
 260:         # Print key tail of output
 261:         tail = result.stdout.strip().split('\n')[-20:] if result.stdout else result.stderr.split('\n')[-10:]
 262:         print("\n".join(tail))
 263:         if result.returncode != 0:
 264:             print(f"WARN: Rscript exited {result.returncode}")
 265:     except Exception as e:
 266:         print(f"Rscript failed: {e}")
 267:     return r_path
 268: 
 269: 
 270: if __name__ == "__main__":
 271:     if len(sys.argv) != 2:
 272:         print("usage: python nma_r_validate_template.py <config.json>", file=sys.stderr)
 273:         sys.exit(1)
 274:     main(sys.argv[1])

