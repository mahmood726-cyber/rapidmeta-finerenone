 171:     # So a call resolves only when it is MODULE-QUALIFIED (`TI.locate(...)`, where the callee's
 172:     # attribute name is a function this scan found) or defined in the SAME FILE. A bare
 173:     # same-name call across files is exactly the ambiguity that produced the noise, and it is
 174:     # dropped rather than reported at low confidence.
 175:     actual = []
 176:     for path in py_files():
 177:         try:
 178:             with io.open(path, encoding="utf-8") as fh:
 179:                 src = fh.read()
 180:                 tree = ast.parse(src, filename=path)
 181:         except (SyntaxError, OSError, UnicodeDecodeError):
 182:             continue
 183:         for node in ast.walk(tree):
 184:             if not isinstance(node, ast.Call):
 185:                 continue
 186:             f = node.func
 187:             qualified = isinstance(f, ast.Attribute)
 188:             nm = f.attr if qualified else getattr(f, "id", None)
 189:             if nm is None:
 190:                 continue
 191:             if qualified:
 192:                 # Module-qualified: resolve only when the name is defined ONCE in the whole
 193:                 # repository. Ambiguity is dropped, not reported at low confidence.
 194:                 if len(all_defs.get(nm) or ()) != 1:
 195:                     continue
 196:                 where = by_name.get(nm) or []
 197:                 if len(set(where)) != 1:
 198:                     continue
 199:                 sig = by_file[where[0]].get(nm)
 200:             else:
 201:                 # Bare name: the definition in THIS file, and nowhere else.
 202:                 sig = by_file.get(path, {}).get(nm)
 203:             if sig is None:
 204:                 continue
 205:             names, tested, _g = sig
 206:             for i, arg in enumerate(node.args):
 207:                 if i >= len(names):
 208:                     break
 209:                 if names[i] in tested and isinstance(arg, ast.Constant) \
 210:                         and isinstance(arg.value, (str, bytes)):
 211:                     actual.append((os.path.relpath(path, REPO), node.lineno, nm,
 212:                                    names[i], arg.value))
 213:             for kw in node.keywords:
 214:                 if kw.arg in tested and isinstance(kw.value, ast.Constant) \
 215:                         and isinstance(kw.value.value, (str, bytes)):
 216:                     actual.append((os.path.relpath(path, REPO), node.lineno, nm,
 217:                                    kw.arg, kw.value.value))
 218:     return at_risk, actual
 219: 
 220: 
 221: def main():
 222:     sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
 223:     at_risk, actual = scan()
 224:     print("functions membership-testing an UNGUARDED parameter   %d" % len(at_risk))
 225:     for path, line, fn, p, how in at_risk[:40]:
 226:         print("   %-58s %s(%s)  %s" % ("%s:%d" % (path, line), fn, p, how))
 227:     if len(at_risk) > 40:
 228:         print("   ... and %d more, not truncated silently" % (len(at_risk) - 40))
 229:     print("\ncall sites passing a STRING LITERAL into such a parameter  %d" % len(actual))
 230:     for path, line, fn, p, val in actual:
 231:         print("   %-58s %s(%s=%r)" % ("%s:%d" % (path, line), fn, p, val))
 232:     if actual:
 233:         print("\nREFUSED: a bare string reaches a parameter that is membership-tested. It will "
 234:               "match single CHARACTERS and return complete, plausible, wrong output.")
 235:         return 1
 236:     print("\nno call site passes a string literal where a collection is membership-tested.")
 237:     print("NOT CHECKED: a string reaching such a parameter through a VARIABLE. That is what "
 238:           "topic_identity.require_terms() catches at runtime, and it is why there are two "
 239:           "defences rather than one.")
 240:     return 0
 241: 
 242: 
 243: def selftest():
 244:     """P16 four ways, and the fourth uses the call that really shipped."""
 245:     sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
 246:     sys.path.insert(0, os.path.join(REPO, "ssot"))
 247:     import topic_identity as TI
 248:     fails = []
 249: 
 250:     def check(name, got, want):
 251:         ok = got == want
 252:         print("  %-60s %s  %r" % (name, "ok" if ok else "FAIL", got))
 253:         if not ok:
 254:             fails.append(name)
 255: 
 256:     # 1. THE RUNTIME GUARD FIRES ON THE CALL THAT REALLY SHIPPED.
 257:     bare = "bococizumab"          # through a VARIABLE: the path only the runtime guard sees
 258:     try:
 259:         TI.locate({"protocolSection": {}}, bare)
 260:         check("locate(study, 'bococizumab') raises", False, True)
 261:     except TI.TermsMustBeACollection:
 262:         check("locate(study, 'bococizumab') raises", True, True)
 263: 
 264:     # 2. AND DOES NOT FIRE ON THE CORRECT CALL. A guard that always fires is not a guard.
 265:     try:
 266:         TI.locate({"protocolSection": {}}, TI.TOPIC_SYNONYMS["bococizumab"])
 267:         check("locate(study, TOPIC_SYNONYMS[...]) does NOT raise", True, True)
 268:     except TI.TermsMustBeACollection:
 269:         check("locate(study, TOPIC_SYNONYMS[...]) does NOT raise", False, True)
 270: 
 271:     # 3. Every non-string collection is accepted -- the defect is specific to str/bytes.
 272:     for coll in (["a"], ("a",), {"a"}, frozenset(["a"])):
 273:         try:
 274:             TI.require_terms(coll, "syns", "t")
 275:             ok = True
 276:         except TI.TermsMustBeACollection:
 277:             ok = False
 278:         check("require_terms accepts a %s" % type(coll).__name__, ok, True)
 279:     for bad in ("a", b"a"):
 280:         try:
 281:             TI.require_terms(bad, "syns", "t")
 282:             ok = False
 283:         except TI.TermsMustBeACollection:
 284:             ok = True
 285:         check("require_terms refuses a %s" % type(bad).__name__, ok, True)
 286: 
 287:     # 4. THE STATIC HALF FINDS THE SHAPE, not just the one call. It must report at least one
 288:     #    at-risk function -- if it reports none, its own AST matching has stopped working and
 289:     #    a clean run would mean nothing.
 290:     at_risk, actual = scan()
 291:     check("the static scan finds at-risk functions to report", len(at_risk) > 0, True)
 292:     check("and the live repository has NO string-literal call site", actual, [])
 293: 
 294:     print("\n%s" % ("ALL FOUR PROOFS HELD" if not fails else "FAILED: %s" % fails))
 295:     return 1 if fails else 0
 296: 
 297: 
 298: if __name__ == "__main__":
 299:     sys.exit(selftest() if "--selftest" in sys.argv else main())

codex
Defects found:

- **Check that cannot fail**: lines 232-240.  
  Exact input: `scripts/demo.py` containing `def f(syns): return any(s in "" for s in syns)`, then run `python scripts/lint_string_where_collection_expected.py`.  
  Consequence: the unguarded membership-tested parameter is reported, but the process exits `0`.

- **Probe keyed to a fix-removes condition**: line 291.  
  Exact input: a scanned repo where every membership-tested parameter is guarded, then run `python scripts/lint_string_where_collection_expected.py --selftest`.  
  Consequence: remediation makes `len(at_risk) > 0` false, so the selftest fails because the old hazard disappeared.

- **Idempotency guard satisfied by marker, not work**: lines 107-109.  
  Exact input: `def f(syns):\n    if False: require_terms(syns, "syns", "t")\n    return any(s in "" for s in syns)`.  
  Consequence: an unreachable guard suppresses the at-risk finding.

- **Name vs binding / different target read**: line 194.  
  Exact input: `ssot/topic_identity.py` has guarded/at-risk `locate(study, syns)`, `scripts/other.py` also defines unrelated `locate(x)`, and `scripts/call.py` calls `TI.locate({}, "bococizumab")`.  
  Consequence: the real module-qualified string call is dropped because an unrelated same-named function exists.

- **Selector misses a membership form**: line 85.  
  Exact input: `def f(syns): return "x" not in syns` plus `f("abc")`.  
  Consequence: `not in` is still string membership, but this detector never registers the parameter.

- **Selector misses string-literal form**: lines 209-215.  
  Exact input: `def f(syns): return any(s in "" for s in syns)` plus `f(f"abc")`.  
  Consequence: a constant f-string reaches the same dangerous parameter without being reported.

