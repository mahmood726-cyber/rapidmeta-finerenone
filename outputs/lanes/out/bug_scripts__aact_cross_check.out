 121: # Regex to extract trial blocks from realData
 122: NCT_BLOCK_RE = re.compile(
 123:     r"'(NCT\d+(?:_[A-Za-z0-9]+)?|LEGACY-[A-Za-z0-9-]+)'\s*:\s*\{[^}]*?"
 124:     r"name:\s*'([^']+?)'[^}]*?"
 125:     r"tN:\s*(\d+)\s*,\s*cE:\s*\d+\s*,\s*cN:\s*(\d+)",
 126:     re.DOTALL,
 127: )
 128: 
 129: 
 130: def extract_trials_from_html(path: Path) -> list[dict]:
 131:     """Extract per-NCT (key, name, tN, cN, snippet ~ first 600 chars of group) from HTML."""
 132:     text = path.read_text(encoding="utf-8", errors="replace")
 133:     out = []
 134:     for m in NCT_BLOCK_RE.finditer(text):
 135:         key = m.group(1)
 136:         name = m.group(2)
 137:         tN = int(m.group(3))
 138:         cN = int(m.group(4))
 139:         # Capture group field for country/sponsor scan
 140:         block_start = m.start()
 141:         block_end = text.find("},", m.end())
 142:         if block_end == -1:
 143:             block_end = m.end() + 2000
 144:         block = text[block_start:min(block_end, block_start + 4000)]
 145:         # Pull `group:` content
 146:         gm = re.search(r"group:\s*'([^']+)'", block, re.DOTALL)
 147:         group_text = gm.group(1) if gm else ""
 148:         out.append({
 149:             "key": key,
 150:             "name": name,
 151:             "tN": tN,
 152:             "cN": cN,
 153:             "row_total": tN + cN,
 154:             "group": group_text,
 155:         })
 156:     return out
 157: 
 158: 
 159: # Country list to look for in snippet text
 160: COUNTRIES_OF_INTEREST = [
 161:     "South Africa", "Uganda", "Kenya", "Tanzania", "Malawi", "Zambia", "Zimbabwe",
 162:     "Botswana", "Nigeria", "Ghana", "Mali", "Burkina Faso", "Niger", "Cameroon",
 163:     "Mozambique", "DRC", "Senegal", "Ethiopia", "Rwanda", "Cote d'Ivoire", "CÃ´te d'Ivoire",
 164:     "Gabon", "Egypt", "Sudan", "USA", "United States", "Brazil", "Argentina",
 165:     "Canada", "UK", "United Kingdom", "France", "Germany", "Spain", "Italy",
 166:     "India", "Thailand", "Vietnam", "China", "Japan", "Australia", "Cambodia",
 167:     "Pakistan", "Bangladesh", "Belarus", "Uzbekistan", "Russia", "Mexico",
 168:     "Peru", "Chile", "Romania", "Bulgaria", "Sweden", "Greece", "Israel",
 169:     "Singapore", "Indonesia", "Hong Kong", "Belgium", "Netherlands", "Denmark",
 170:     "Norway", "Switzerland", "Austria", "Portugal", "Ireland", "Finland",
 171:     "Korea", "Czechia", "Poland", "Slovakia", "Hungary", "Lithuania", "Estonia",
 172:     "Croatia", "Slovenia", "Latvia", "Mauritania", "Madagascar", "Iran", "Saudi Arabia",
 173:     "Turkey", "Lebanon", "Jordan", "UAE", "Iraq", "Egypt", "Morocco", "Tunisia",
 174:     "Algeria", "Yemen", "Syria", "Liberia", "Sierra Leone", "Angola", "Namibia",
 175:     "Lesotho", "Eswatini", "Swaziland", "Burundi", "Chad", "Republic of the Congo",
 176: ]
 177: 
 178: 
 179: def scan_countries_in_snippet(snippet: str) -> set[str]:
 180:     """Return set of countries mentioned in snippet text."""
 181:     found = set()
 182:     for c in COUNTRIES_OF_INTEREST:
 183:         if re.search(r"\b" + re.escape(c) + r"\b", snippet, re.IGNORECASE):
 184:             found.add(c)
 185:     return found
 186: 
 187: 
 188: def main():
 189:     print("Loading AACT studies.txt ...")
 190:     studies = load_aact_studies()
 191:     print(f"  {len(studies):,} NCTs in AACT 2026-04-12")
 192:     print("Loading AACT countries.txt ...")
 193:     countries = load_aact_countries()
 194:     print(f"  countries for {len(countries):,} NCTs")
 195:     print("Loading AACT sponsors.txt ...")
 196:     sponsors = load_aact_lead_sponsors()
 197:     print(f"  lead sponsors for {len(sponsors):,} NCTs")
 198: 
 199:     review_files = sorted(REPO_DIR.glob("*_REVIEW.html"))
 200:     print(f"\nScanning {len(review_files)} *_REVIEW.html files ...")
 201: 
 202:     findings = []
 203:     for hp in review_files:
 204:         trials = extract_trials_from_html(hp)
 205:         for t in trials:
 206:             key = t["key"]
 207:             base_nct = re.match(r"(NCT\d+)", key)
 208:             if not base_nct:
 209:                 # ISRCTN/LEGACY â€” skip (not in AACT)
 210:                 findings.append({
 211:                     "file": hp.name,
 212:                     "key": key,
 213:                     "claim_name": t["name"],
 214:                     "claim_n": t["row_total"],
 215:                     "verdict": "ISRCTN_ONLY",
 216:                     "aact_brief_title": "",
 217:                     "aact_enrollment": "",
 218:                     "title_overlap": "",
 219:                     "n_ratio": "",
 220:                     "country_mismatch": "",
 221:                     "notes": "non-AACT key",
 222:                 })
 223:                 continue
 224:             base_nct = base_nct.group(1)
 225:             row = studies.get(base_nct)
 226:             if not row:
 227:                 findings.append({
 228:                     "file": hp.name,
 229:                     "key": key,
 230:                     "claim_name": t["name"],
 231:                     "claim_n": t["row_total"],
 232:                     "verdict": "AACT_NOT_FOUND",
 233:                     "aact_brief_title": "",
 234:                     "aact_enrollment": "",
 235:                     "title_overlap": "",
 236:                     "n_ratio": "",
 237:                     "country_mismatch": "",
 238:                     "notes": "NCT not in AACT 2026-04-12 â€” likely wrong NCT",
 239:                 })
 240:                 continue
 241: 
 242:             # Title overlap
 243:             claim_tokens = normalize_tokens(t["name"])
 244:             aact_tokens = normalize_tokens(row["brief_title"]) | normalize_tokens(row["official_title"])
 245:             shared = claim_tokens & aact_tokens
 246:             overlap = len(shared)
 247:             verdict_title = "TITLE_OK" if overlap >= 1 else "TITLE_MISMATCH"
 248: 
 249:             # Enrollment ratio
 250:             aact_n = row["enrollment"]
 251:             ratio = (t["row_total"] / aact_n) if (aact_n and aact_n > 0) else None
 252:             if ratio is None:
 253:                 verdict_n = "N_NO_AACT_ENROLLMENT"
 254:             elif 0.85 <= ratio <= 1.15:
 255:                 verdict_n = "N_OK"
 256:             elif 0.20 <= ratio < 0.85:
 257:                 verdict_n = "N_MULTI_ARM_OR_MITT"
 258:             elif 1.15 < ratio <= 2.10:
 259:                 verdict_n = "N_MITT_PLUS_OR_SINGLE_ARM"
 260:             else:
 261:                 verdict_n = "N_OUTLIER"
 262: 
 263:             # Country check
 264:             aact_countries = countries.get(base_nct, set())
 265:             snippet_countries = scan_countries_in_snippet(t["group"])
 266:             # Filter to "primary" claims â€” words I claimed are countries with sites
 267:             country_mismatch = []
 268:             for c in snippet_countries:
 269:                 # Normalize Cote/CÃ´te d'Ivoire equivalence
 270:                 norm_c = c.replace("Cote d'Ivoire", "CÃ´te d'Ivoire")
 271:                 norm_aact = {ac.replace("Cote d'Ivoire", "CÃ´te d'Ivoire") for ac in aact_countries}
 272:                 if norm_c not in norm_aact:
 273:                     # Allow common synonyms
 274:                     if c in ("UK", "United Kingdom"):
 275:                         if not ({"United Kingdom"} & aact_countries):
 276:                             country_mismatch.append(c)
 277:                     elif c in ("USA", "United States"):
 278:                         if not ({"United States"} & aact_countries):
 279:                             country_mismatch.append(c)
 280:                     elif c == "DRC":
 281:                         if not ({"Republic of the Congo", "Democratic Republic of the Congo", "Congo"} & aact_countries):
 282:                             country_mismatch.append(c)
 283:                     else:
 284:                         country_mismatch.append(c)
 285: 
 286:             verdict_country = "COUNTRY_OK" if not country_mismatch else "COUNTRY_MISMATCH"
 287: 
 288:             verdict_overall = "OK"
 289:             notes = []
 290:             if verdict_title == "TITLE_MISMATCH":
 291:                 verdict_overall = "TITLE_MISMATCH"
 292:                 notes.append(f"title 0-token overlap (claim='{t['name'][:40]}' aact='{row['brief_title'][:40]}')")
 293:             if verdict_n == "N_OUTLIER":
 294:                 verdict_overall = "N_OUTLIER" if verdict_overall == "OK" else verdict_overall + "+N_OUTLIER"
 295:                 notes.append(f"row {t['row_total']} vs aact {aact_n} ratio {ratio:.2f}")
 296:             if verdict_country == "COUNTRY_MISMATCH":
 297:                 if verdict_overall == "OK":
 298:                     verdict_overall = "COUNTRY_MISMATCH"
 299:                 else:
 300:                     verdict_overall += "+COUNTRY_MISMATCH"
 301:                 notes.append(f"snippet countries not in AACT: {', '.join(country_mismatch)}")
 302: 
 303:             findings.append({
 304:                 "file": hp.name,
 305:                 "key": key,
 306:                 "claim_name": t["name"],
 307:                 "claim_n": t["row_total"],
 308:                 "verdict": verdict_overall,
 309:                 "aact_brief_title": row["brief_title"][:80],
 310:                 "aact_enrollment": aact_n if aact_n else "",
 311:                 "title_overlap": overlap,
 312:                 "n_ratio": f"{ratio:.2f}" if ratio is not None else "",
 313:                 "country_mismatch": ",".join(country_mismatch) if country_mismatch else "",
 314:                 "notes": "; ".join(notes),
 315:             })
 316: 
 317:     OUT_CSV.parent.mkdir(parents=True, exist_ok=True)
 318:     with OUT_CSV.open("w", newline="", encoding="utf-8") as f:
 319:         w = csv.DictWriter(f, fieldnames=list(findings[0].keys()))
 320:         w.writeheader()
 321:         w.writerows(findings)
 322: 
 323:     # Summary
 324:     by_verdict: dict[str, int] = {}
 325:     for f in findings:
 326:         by_verdict[f["verdict"]] = by_verdict.get(f["verdict"], 0) + 1
 327: 
 328:     print(f"\n=== Verdict counts ({len(findings)} total trial-rows) ===")
 329:     for k in sorted(by_verdict.keys()):
 330:         print(f"  {k:30s} {by_verdict[k]}")
 331: 
 332:     print(f"\n=== High-priority issues ===")
 333:     issues = [f for f in findings if f["verdict"] in ("AACT_NOT_FOUND", "TITLE_MISMATCH", "N_OUTLIER", "COUNTRY_MISMATCH") or "+" in f["verdict"]]
 334:     for f in issues[:25]:
 335:         print(f"  [{f['verdict']}] {f['file']:55s} {f['key']:30s} {f['notes']}")
 336:     if len(issues) > 25:
 337:         print(f"  ... and {len(issues) - 25} more (see {OUT_CSV})")
 338: 
 339:     print(f"\nWritten: {OUT_CSV}")
 340: 
 341: 
 342: if __name__ == "__main__":
 343:     main()

codex
- **Check that cannot fail**: line 196.  
  Exact input: `sponsors.txt` row `1|NCT00000001|INDUSTRY|lead|Novartis` plus HTML block `group:'Sponsor: Pfizer'`.  
  Consequence: sponsor mismatch is impossible to report because `sponsors` is loaded and never used.

- **Status code reports wrapper, not work**: line 339.  
  Exact input: HTML block with key `'NCT99999999': { name:'X', tN:1, cE:0, cN:1 }` absent from `studies.txt`.  
  Consequence: it prints `AACT_NOT_FOUND` but exits 0, so a CI/check wrapper passes.

- **Selector keyed to a form the corpus may not use**: line 122.  
  Exact input: `'ISRCTN12345678': { name:'X', tN:1, cE:0, cN:1 }`.  
  Consequence: despite line 17 promising ISRCTN_ONLY reporting, ISRCTN keys are not matched and vanish from findings.

- **Selector keyed to brittle field order**: line 125.  
  Exact input: `'NCT00000001': { name:'X', tN:1, cN:1, cE:0 }`.  
  Consequence: a valid block with the same fields in a different order is silently skipped.

- **Selector broken by apostrophe**: line 146.  
  Exact input: `group:'Côte d'Ivoire sites'`.  
  Consequence: `group_text` becomes `Côte d`, so the country probe misses the stated country.

- **Zero conflated with absent**: line 251.  
  Exact input: AACT enrollment column `0`, HTML `tN:1, cE:0, cN:0`.  
  Consequence: ratio becomes `None` and the row is classified as `N_NO_AACT_ENROLLMENT` instead of an enrollment outlier.

- **Zero conflated with absent**: line 310.  
  Exact input: AACT enrollment column `0`.  
  Consequence: the CSV writes blank `aact_enrollment`, making real zero indistinguishable from missing.

- **Negation dropped**: line 183.  
  Exact input: `group:'not United States sites'` with AACT countries not containing United States.  
  Consequence: denied country text is treated as a positive site claim and can create a false `COUNTRY_MISMATCH`.

No finding: string-fix-removal probe, own-comment idempotency guard, CRLF/LF text comparison, merged-cell/off-by-one tabulation.
