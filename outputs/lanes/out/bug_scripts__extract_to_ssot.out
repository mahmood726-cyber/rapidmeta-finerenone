  58:     """Every page whose live index state says we are NOT publishing a pooled value.
  59: 
  60:     THE FIRST VERSION READ GRID CARDS ONLY and the batch dry-run caught what it
  61:     missed -- three classes, each of which conversion would have resurrected:
  62: 
  63:       TABLE-ROW WITHDRAWALS. AZITHROMYCIN_CHILD_MORTALITY has no grid card; it was
  64:       withdrawn in its table row. It came back as convertible at HR 0.86, k=2 --
  65:       the DUP-1 page, where both trials carry log(0.86) so k=2 is arithmetically
  66:       k=1 and I-squared 0 is an artefact of the duplication.
  67: 
  68:       "REPORTED SEPARATELY, NOT POOLED" cards. MALARIA_VACCINE and
  69:       HIV_PREP_INJECTABLE deliberately present per-trial results and decline to
  70:       pool. Converting them would manufacture the pooled estimate their cards
  71:       exist to avoid.
  72: 
  73:       HARM-FLAGGED PAGES NEVER PUBLISHED. DABIGATRAN_AF, DABIGATRAN_STROKE and
  74:       WARFARIN_AF carry no number on the index at all, pending a decision. Absence
  75:       of a card is not permission; it is an unfinished decision.
  76: 
  77:     A page we decided not to publish a number for must not acquire one by being
  78:     rebuilt through a different pipeline.
  79:     """
  80:     out = set()
  81:     WITHHELD = re.compile(r"withdrawn|not analysable|not poolable|not pooled|"
  82:                           r"reported separately", re.I)
  83:     for m in re.finditer(r'<a href="([A-Za-z0-9_]+\.html)" class="card [^"]*">'
  84:                          r'<span class="name">[^<]*</span><span class="pub">(.*?)</span></a>',
  85:                          index_html):
  86:         if WITHHELD.search(m.group(2)):
  87:             out.add(m.group(1))
  88:     # table rows: <a href=X>label</a> ... <td>estimate cell</td>
  89:     for m in re.finditer(r'<a href="([A-Za-z0-9_]+\.html)"[^>]*>[^<]*</a></td><td>[^<]*</td>'
  90:                          r'<td[^>]*>[^<]*</td><td[^>]*>([^<]*)</td>', index_html):
  91:         if WITHHELD.search(m.group(2)):
  92:             out.add(m.group(1))
  93:     # explicitly held pending a human decision -- never inferred from the index
  94:     out |= {"DABIGATRAN_AF_AUTO_FULL_REVIEW.html",
  95:             "DABIGATRAN_STROKE_AUTO_FULL_REVIEW.html",
  96:             "WARFARIN_AF_AUTO_FULL_REVIEW.html"}
  97:     return out
  98: 
  99: 
 100: def back_transform(point, lo, hi, scale):
 101:     """exp() for log scale, identity for natural. Chosen from the record."""
 102:     if scale == "log":
 103:         return math.exp(point), math.exp(lo), math.exp(hi)
 104:     return point, lo, hi
 105: 
 106: 
 107: 
 108: 
 109: 
 110: def skeleton(template, keep):
 111:     """Structure from a template object, VALUES from nowhere.
 112: 
 113:     WHY THIS SHAPE-MATCHES INSTEAD OF GUESSING FIELD BY FIELD
 114:         The projector reads a long tail of structural keys - pool_uniformity as a
 115:         dict, handbook with a 'sections' list, and so on - and patching them one
 116:         KeyError at a time took five rounds and was still going. That is the
 117:         symptom-fix pattern this project refuses: each patch made one error go away
 118:         without making the object structurally right.
 119: 
 120:     THE DANGER, AND THE GUARD
 121:         Copying structure from another review is EXACTLY the move that put ARNI's
 122:         manuscript on four unrelated pages this morning. So every leaf is replaced:
 123:         strings become the UNREC marker, numbers become None, lists become empty.
 124:         NOTHING from the template's content survives - only the shape of its keys.
 125:         subject_match() then re-checks the finished object against this page's own
 126:         extractor output, so a leak cannot reach a build even if this is wrong.
 127:     """
 128:     if isinstance(template, dict):
 129:         return {k: (template[k] if k in keep else skeleton(template[k], keep))
 130:                 for k in template}
 131:     if isinstance(template, list):
 132:         return []
 133:     if isinstance(template, bool) or template is None:
 134:         return None
 135:     if isinstance(template, (int, float)):
 136:         return None
 137:     return UNREC
 138: 
 139: 
 140: def _per_trial(t, scale, est):
 141:     """The per-trial row the projector renders, in its own shape.
 142: 
 143:     Every displayed number here is DERIVED and says so in `derivation`. The
 144:     extractor holds an estimate and a variance on the analysis scale and nothing
 145:     else; the point and interval are computed and back-transformed. Compare the
 146:     authored objects, where `derivation` reads "the printed hazard ratio" because a
 147:     source actually printed it. The two must never be confusable.
 148:     """
 149:     import math as _m
 150:     e = t.get("effect") or {}
 151:     i = t.get("identity") or {}
 152:     est_, var = e.get("estimate"), e.get("variance")
 153:     se = _m.sqrt(var) if var else None
 154:     pt = lo = hi = None
 155:     if est_ is not None:
 156:         l = est_ - 1.959963984540054 * se if se is not None else None
 157:         h = est_ + 1.959963984540054 * se if se is not None else None
 158:         if scale == "log":
 159:             pt = _m.exp(est_); lo = _m.exp(l) if l is not None else None
 160:             hi = _m.exp(h) if h is not None else None
 161:         else:
 162:             pt, lo, hi = est_, l, h
 163:     rid = str(i.get("id") or "")
 164:     return {"trial_id": rid or (i.get("label") or "unknown"),
 165:             "nct": i.get("registry_id") if NCT.fullmatch(str(i.get("registry_id") or "")) else None,
 166:             "measure": e.get("measure") or (est or {}).get("effect_measure") or "",
 167:             "point": pt, "ci_low": lo, "ci_high": hi, "ci_level": 95,
 168:             "log_point": est_ if scale == "log" else None,
 169:             "log_se": se if scale == "log" else None,
 170:             "estimand_id": "primary",
 171:             "population": UNREC,
 172:             "derivation": ("DERIVED by conversion: the extractor recovered an estimate and a "
 173:                            "variance on the analysis scale; the point and interval are "
 174:                            "estimate +/- 1.96*sqrt(variance), back-transformed. No source "
 175:                            "printed this interval.")}
 176: 
 177: 
 178: def _trial_effect(t, scale):
 179:     """Per-trial block in the shape the projector reads: point / ci_low / ci_high.
 180: 
 181:     The extractor stores estimate + variance on the analysis scale. The projector
 182:     needs a displayed point and interval, so they are COMPUTED here as
 183:     estimate +/- 1.96*sqrt(variance) and back-transformed. That is a DERIVATION and
 184:     is labelled one: derived_from and derivation_note say so on every trial, so a
 185:     reader can never mistake a computed interval for one the source printed. This
 186:     is the same distinction the Extraction tab makes between READ and DERIVED, and
 187:     the reason it exists is MORDOR-I -- a ratio computed from a percentage
 188:     reduction and then presented as if the paper had reported it.
 189:     """
 190:     import math as _m
 191:     e = t.get("effect") or {}
 192:     est, var = e.get("estimate"), e.get("variance")
 193:     pt = lo = hi = None
 194:     if est is not None:
 195:         se = _m.sqrt(var) if var else None
 196:         l = est - 1.959963984540054 * se if se is not None else None
 197:         h = est + 1.959963984540054 * se if se is not None else None
 198:         if scale == "log":
 199:             pt = _m.exp(est)
 200:             lo = _m.exp(l) if l is not None else None
 201:             hi = _m.exp(h) if h is not None else None
 202:         else:
 203:             pt, lo, hi = est, l, h
 204:     return {
 205:         "effect": {"measure": e.get("measure"), "scale": scale,
 206:                    "point": pt, "ci_low": lo, "ci_high": hi, "ci_level": 95,
 207:                    "analysis_scale_estimate": est, "analysis_scale_variance": var,
 208:                    "derived_from": "extractor recovery from the published page",
 209:                    "derivation_note": (
 210:                        "The point estimate and interval shown here are DERIVED, not read: the "
 211:                        "extractor recovered an estimate and a variance on the analysis scale, "
 212:                        "and the interval is estimate +/- 1.96*sqrt(variance) back-transformed. "
 213:                        "No source document was consulted and no source sentence is recorded.")},
 214:         "provenance": {"tag": "RECOVERED", "source_quotes": [],
 215:                        "quote_note": ("No verbatim source sentence is held for this value. It was "
 216:                                       "recovered from the page's own embedded data, so it can be "
 217:                                       "traced to the page but NOT to a paper.")},
 218:         "source_url": None,
 219:         "analysed": {a.get("role"): a.get("n") for a in (t.get("arms") or [])},
 220:     }
 221: 
 222: 
 223: def convert(page, ex, withdrawn):
 224:     if page in withdrawn:
 225:         raise Refused("%s carries a withheld state on the live index. Its pooled value was "
 226:                       "removed because the POOLING was invalid, not because the arithmetic "
 227:                       "was wrong, so converting it would resurrect an invalid estimate in a "
 228:                       "new wrapper." % page)
 229:     c = ex.get("canonical") or {}
 230:     trials = c.get("trials") or []
 231:     if not trials:
 232:         raise Refused("no trials in the extractor object: nothing to build a review from")
 233:     est = c.get("estimand") or {}
 234:     rep = ((c.get("result") or {}).get("reported")) or {}
 235:     if rep.get("logEffect") is None:
 236:         raise Refused("no pooled result in the extractor object")
 237: 
 238:     scales = {(t.get("effect") or {}).get("scale") for t in trials}
 239:     if len(scales) > 1:
 240:         raise Refused("trials disagree on effect scale %s: the back-transform would be "
 241:                       "wrong for at least one of them" % sorted(scales))
 242:     scale = scales.pop() or "log"
 243:     pt, lo, hi = back_transform(rep["logEffect"], rep["lci"], rep["uci"], scale)
 244: 
 245:     stem = page[:-5]
 246:     app = stem.lower().replace("_", "-")
 247:     oid = "primary"
 248:     tpl = json.loads(open(os.path.join(SSOT, "ssot", "sotagliflozin-hf",
 249:                                        "sotagliflozin-hf.json"),
 250:                           encoding="utf-8", errors="replace").read())
 251:     base = skeleton(tpl, keep=set())
 252:     base.pop("results", None); base.pop("outcomes", None); base.pop("inputs", None)
 253:     base.pop("sources", None)
 254:     ssot = {**base, **{
 255:         "app_id": app,
 256:         "schema_version": "2-converted-from-extractor",
 257:         "title": est.get("outcome_definition") or stem.replace("_", " ").title(),
 258:         "question": est.get("outcome_definition") or "",
 259:         "built": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%MZ"),
 260:         "build_mode": "CONVERTED",
 261:         "conversion_note": (
 262:             "This object was CONVERTED from an extractor recovery artefact, not authored. "
 263:             "The trials, arms, effects and pooled result below were recovered from the "
 264:             "published page. Everything a review also needs -- protocol, search, screening "
 265:             "log, risk-of-bias assessment, certainty rating, sources and manuscript -- is "
 266:             "ABSENT FROM THE SOURCE and is recorded as absent. Nothing is substituted from "
 267:             "any other review."),
 268:         "sources": {},
 269:         # Fields the projector needs but the extractor never recovered are filled with
 270:         # an explicit UNRECORDED marker, never with a plausible default. "placebo" is
 271:         # the commonest comparator in this corpus and would be right most of the time,
 272:         # which is precisely why guessing it is dangerous: a wrong comparator on a page
 273:         # nobody checks reads exactly like a right one.
 274:         "outcomes": [{"id": oid,
 275:                       "name": est.get("outcome_definition") or "primary outcome",
 276:                       "definition": est.get("outcome_definition") or UNREC,
 277:                       "definition_note": UNREC,
 278:                       "measure": est.get("effect_measure") or "",
 279:                       "effect_scale": scale,
 280:                       "type": "primary",
 281:                       "estimand": {"id": oid, "family": UNREC, "model": est.get("model") or UNREC},
 282:                       "comparator": UNREC, "comparator_type": UNREC,
 283:                       "direction_of_benefit": UNREC,
 284:                       "null_value": 0 if scale == "natural" else 1}],
 285:         "inputs": {"trials": [{
 286:             "id": str((t.get("identity") or {}).get("id") or ""),
 287:             "name": (t.get("identity") or {}).get("label") or "",
 288:             "nct": (lambda i: i if NCT.fullmatch(str(i or "")) else None)(
 289:                 (t.get("identity") or {}).get("registry_id")),
 290:             "pmid": (t.get("identity") or {}).get("pmid"),
 291:             "arms": [{"label": a.get("label") or a.get("role"), "role":
 292:                       "treatment" if a.get("role") == "intervention" else "control",
 293:                       "events": a.get("events"),
 294:                       "participants": a.get("n")} for a in (t.get("arms") or [])],
 295:             "by_outcome": {oid: _trial_effect(t, scale)},
 296:         } for t in trials]},
 297:         "config": {"model": est.get("model") or "", "method": est.get("method") or "",
 298:                    "scale": scale},
 299:         "results": {"by_outcome": {oid: {
 300:             "k": rep.get("k"),
 301:             "estimand_id": oid, "estimand_id_means": UNREC,
 302:             "model": est.get("model") or UNREC,
 303:             "estimator": est.get("method") or UNREC,
 304:             "estimator_used": est.get("method") or UNREC,
 305:             # The overlay must supply EVERY key the projector reads, not a simpler
 306:             # dict of my own: replacing handbook wholesale dropped 'sections', which
 307:             # the projector joins into a string. A partial overlay over a correct
 308:             # skeleton is worse than no overlay - it looks filled and is not.
 309:             "handbook": {"decision": "NOT RECORDED - no methods decision was recoverable "
 310:                                      "from the page",
 311:                          "sections": [],
 312:                          "conformance": UNREC},
 313:             "comparator_type": UNREC,
 314:             "favours": ("treatment" if (pt is not None and ((scale=="log" and pt<1) or (scale!="log" and pt<0)))
 315:                         else "control" if pt is not None else UNREC),
 316:             "poolable": True,
 317:             "poolable_reason": ("The extractor recovered a pooled result from this page, so the "
 318:                                 "page pooled these trials. Whether they SHOULD have been pooled "
 319:                                 "is not established by conversion - several pages in this corpus "
 320:                                 "pooled harm with efficacy, or distinct agents, and their "
 321:                                 "estimates were withdrawn for that reason."),
 322:             "estimand_homogeneous_across_cohorts": None,
 323:             "pool_uniformity": {"effect_measure": ["NOT ESTABLISHED", UNREC],
 324:                                 "estimand": ["NOT ESTABLISHED", UNREC]},
 325:             "heterogeneity": {"i2": rep.get("I2"), "tau2": rep.get("tau2"), "q": rep.get("Q"),
 326:                               "df": (rep.get("k") - 1) if rep.get("k") else None},
 327:             "heterogeneity_status": UNREC,
 328:             "grade": None,
 329:             "cross_engine": None,
 330:             "sensitivity": None,
 331:             "single_study_ref": None,
 332:             "per_trial": [_per_trial(t, scale, est) for t in trials],
 333:             "pooled": {"measure": est.get("effect_measure") or "",
 334:                        "point": pt, "ci_low": lo, "ci_high": hi, "ci_level": 95},
 335:         }}},
 336:         # hard-required by the projector; each states its own absence rather than
 337:         # being omitted, so the tab renders an honest state instead of failing.
 338:         "manuscript": None,
 339:         "risk_of_bias_verdict": None,
 340:         "carried_contrasts": [],
 341:         "absent_from_source": {
 342:             "protocol": "No protocol or registration record was recoverable from the page.",
 343:             "search": "No search strategy was recoverable from the page.",
 344:             "screening": "No screening log was recoverable from the page.",
 345:             "rob2": "No risk-of-bias assessment was recoverable from the page.",
 346:             "grade": "No certainty rating was recoverable from the page.",
 347:             "sources": "No source registry was recoverable from the page, so no value on this "
 348:                        "page carries a resolvable link or a quoted source sentence.",
 349:             "manuscript": "No manuscript exists for this review."},
 350:     }}
 351:     return ssot
 352: 
 353: 
 354: def subject_match(ssot, ex):
 355:     """HARD GATE. Every registration id in the converted object must come from THIS
 356:     page's extractor object. Not a report -- a refusal."""
 357:     src = set(NCT.findall(json.dumps(ex.get("canonical") or {}, ensure_ascii=False)))
 358:     got = set(NCT.findall(json.dumps(ssot, ensure_ascii=False)))
 359:     foreign = sorted(got - src)
 360:     if foreign:
 361:         raise Refused("SUBJECT-MATCH FAILED: %s appear in the converted object but not in "
 362:                       "this page's own extractor object" % foreign[:5])
 363:     return len(got)
 364: 
 365: 
 366: def main() -> int:
 367:     page = sys.argv[1]
 368:     ex = json.loads(open(os.path.join(OBJ, page + ".canonical.json"),
 369:                          encoding="utf-8", errors="replace").read())
 370:     idx = open(os.path.join(SSOT, "index.html"), encoding="utf-8", errors="replace").read()
 371:     wd = withdrawn_pages(idx)
 372:     try:
 373:         s = convert(page, ex, wd)
 374:     except Refused as e:
 375:         print("REFUSED %s\n  %s" % (page, e))
 376:         return 2
 377:     n = subject_match(s, ex)
 378:     rep = ((ex["canonical"].get("result") or {}).get("reported")) or {}
 379:     p = s["results"]["by_outcome"]["primary"]["pooled"]
 380:     print("converted %s -> app_id=%s" % (page, s["app_id"]))
 381:     print("  scale=%s  stored logEffect=%.6f -> displayed %s %.4f (%.4f to %.4f)"
 382:           % (s["config"]["scale"], rep["logEffect"], p["measure"], p["point"],
 383:              p["ci_low"], p["ci_high"]))
 384:     print("  k=%s  trials=%d  registration ids=%d (all from this page's own object)"
 385:           % (s["results"]["by_outcome"]["primary"]["k"], len(s["inputs"]["trials"]), n))
 386:     print("  absent-from-source: %s" % ", ".join(sorted(s["absent_from_source"])))
 387:     out = sys.argv[2] if len(sys.argv) > 2 else None
 388:     if out:
 389:         os.makedirs(os.path.dirname(out), exist_ok=True)
 390:         json.dump(s, open(out, "w", encoding="utf-8"), indent=1)
 391:         print("  written: %s" % out)
 392:     return 0
 393: 
 394: 
 395: if __name__ == "__main__":
 396:     sys.exit(main())

