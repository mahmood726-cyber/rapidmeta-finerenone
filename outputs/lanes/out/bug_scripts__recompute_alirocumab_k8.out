  36:     """Two-sided upper quantile of Student t, by bisection on the CDF.
  37: 
  38:     Written out rather than imported: scipy is not a declared dependency of this repo and a
  39:     silent import failure here would produce a normal-quantile interval wearing a t label.
  40:     """
  41:     def betacf(a, b, x):
  42:         MAXIT, EPS, FPMIN = 300, 3e-16, 1e-300
  43:         qab, qap, qam = a + b, a + 1.0, a - 1.0
  44:         c, d = 1.0, 1.0 - qab * x / qap
  45:         if abs(d) < FPMIN:
  46:             d = FPMIN
  47:         d = 1.0 / d
  48:         h = d
  49:         for m in range(1, MAXIT + 1):
  50:             m2 = 2 * m
  51:             aa = m * (b - m) * x / ((qam + m2) * (a + m2))
  52:             d = 1.0 + aa * d
  53:             if abs(d) < FPMIN:
  54:                 d = FPMIN
  55:             c = 1.0 + aa / c
  56:             if abs(c) < FPMIN:
  57:                 c = FPMIN
  58:             d = 1.0 / d
  59:             h *= d * c
  60:             aa = -(a + m) * (qab + m) * x / ((a + m2) * (qap + m2))
  61:             d = 1.0 + aa * d
  62:             if abs(d) < FPMIN:
  63:                 d = FPMIN
  64:             c = 1.0 + aa / c
  65:             if abs(c) < FPMIN:
  66:                 c = FPMIN
  67:             d = 1.0 / d
  68:             de = d * c
  69:             h *= de
  70:             if abs(de - 1.0) < EPS:
  71:                 break
  72:         return h
  73: 
  74:     def betai(a, b, x):
  75:         if x <= 0.0:
  76:             return 0.0
  77:         if x >= 1.0:
  78:             return 1.0
  79:         lbeta = (math.lgamma(a + b) - math.lgamma(a) - math.lgamma(b)
  80:                  + a * math.log(x) + b * math.log(1.0 - x))
  81:         if x < (a + 1.0) / (a + b + 2.0):
  82:             return math.exp(lbeta) * betacf(a, b, x) / a
  83:         return 1.0 - math.exp(lbeta) * betacf(b, a, 1.0 - x) / b
  84: 
  85:     def cdf(t):
  86:         x = df / (df + t * t)
  87:         tail = 0.5 * betai(df / 2.0, 0.5, x)
  88:         return 1.0 - tail if t > 0 else tail
  89: 
  90:     lo, hi = 0.0, 200.0
  91:     for _ in range(200):
  92:         mid = (lo + hi) / 2.0
  93:         if cdf(mid) < p:
  94:             lo = mid
  95:         else:
  96:             hi = mid
  97:     return (lo + hi) / 2.0
  98: 
  99: 
 100: def dl(points, ses):
 101:     k = len(points)
 102:     w = [1.0 / (s * s) for s in ses]
 103:     fe = sum(wi * yi for wi, yi in zip(w, points)) / sum(w)
 104:     q = sum(wi * (yi - fe) ** 2 for wi, yi in zip(w, points))
 105:     c = sum(w) - sum(wi * wi for wi in w) / sum(w)
 106:     tau2 = max(0.0, (q - (k - 1)) / c)
 107:     return pool(points, ses, tau2, q, k)
 108: 
 109: 
 110: def reml(points, ses, iters=500):
 111:     k = len(points)
 112:     tau2 = 0.0
 113:     for _ in range(iters):
 114:         w = [1.0 / (s * s + tau2) for s in ses]
 115:         mu = sum(wi * yi for wi, yi in zip(w, points)) / sum(w)
 116:         # THE REML CORRECTION TERM IS ADDED AFTER THE DIVISION, NOT INSIDE THE NUMERATOR.
 117:         # Written the wrong way round first, the iteration diverged until every weight
 118:         # underflowed to zero and the next mean was 0/0 -- which is at least a LOUD failure.
 119:         # tau2_{n+1} = sum(w^2[(y-mu)^2 - v]) / sum(w^2)  +  1/sum(w)   (Viechtbauer 2005)
 120:         num = sum(wi ** 2 * ((yi - mu) ** 2 - s * s) for wi, yi, s in zip(w, points, ses))
 121:         den = sum(wi ** 2 for wi in w)
 122:         new = max(0.0, num / den + 1.0 / sum(w))
 123:         if abs(new - tau2) < 1e-12:
 124:             tau2 = new
 125:             break
 126:         tau2 = new
 127:     w = [1.0 / (s * s) for s in ses]
 128:     fe = sum(wi * yi for wi, yi in zip(w, points)) / sum(w)
 129:     q = sum(wi * (yi - fe) ** 2 for wi, yi in zip(w, points))
 130:     return pool(points, ses, tau2, q, k)
 131: 
 132: 
 133: def pool(points, ses, tau2, q, k):
 134:     w = [1.0 / (s * s + tau2) for s in ses]
 135:     mu = sum(wi * yi for wi, yi in zip(w, points)) / sum(w)
 136:     se_mu = math.sqrt(1.0 / sum(w))
 137:     i2 = max(0.0, (q - (k - 1)) / q) * 100.0 if q > 0 else 0.0
 138:     return {"k": k, "tau2": tau2, "q": q, "df": k - 1, "i2": i2,
 139:             "point": mu, "se": se_mu,
 140:             "ci_low": mu - Z * se_mu, "ci_high": mu + Z * se_mu}
 141: 
 142: 
 143: def i2_metafor(ses, tau2):
 144:     """metafor's I-squared: tau2 / (tau2 + s2), s2 the TYPICAL within-study variance.
 145: 
 146:     NOT the same quantity as Higgins (Q - df)/Q, and the difference is the whole reason this
 147:     function exists. Higgins is computed from Q, which uses FIXED-EFFECT weights, so it does
 148:     NOT depend on the estimator: it reads 88.0 for DL and 88.0 for REML. metafor's depends on
 149:     tau2 and therefore does: 88.0 for DL and 90.0 for REML.
 150: 
 151:     A SENSITIVITY TABLE WHOSE I-SQUARED COLUMN CANNOT MOVE IS NOT A SENSITIVITY TABLE. The
 152:     stored k=6 rows read 87.9 / 91.6 / 91.6, which only the metafor definition can produce,
 153:     so that is the definition the column has always used and it is now named rather than
 154:     assumed. The object's HEADLINE I-squared stays Higgins, where its own heterogeneity block
 155:     declares it and gives the evidence for that choice.
 156:     """
 157:     k = len(ses)
 158:     w = [1.0 / (s * s) for s in ses]
 159:     sw, sw2 = sum(w), sum(wi * wi for wi in w)
 160:     s2 = (k - 1) * sw / (sw * sw - sw2)
 161:     return 100.0 * tau2 / (tau2 + s2) if (tau2 + s2) > 0 else 0.0
 162: 
 163: 
 164: def hksj(points, ses, tau2, k):
 165:     w = [1.0 / (s * s + tau2) for s in ses]
 166:     mu = sum(wi * yi for wi, yi in zip(w, points)) / sum(w)
 167:     # HKSJ VARIANCE INFLATION, WITH THE FLOOR. Where Q < k-1 the raw factor is BELOW 1 and
 168:     # would NARROW the interval below DerSimonian-Laird, which is the opposite of what the
 169:     # method is for. Floored at 1 per this project's standing rule.
 170:     raw = sum(wi * (yi - mu) ** 2 for wi, yi in zip(w, points)) / ((k - 1) * sum(w))
 171:     var = max(raw, 1.0 / sum(w))
 172:     se = math.sqrt(var)
 173:     t = t_quantile(0.975, k - 1)
 174:     return {"point": mu, "se": se, "t": t, "df": k - 1,
 175:             "ci_low": mu - t * se, "ci_high": mu + t * se}
 176: 
 177: 
