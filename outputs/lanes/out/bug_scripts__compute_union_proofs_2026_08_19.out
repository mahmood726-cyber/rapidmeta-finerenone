 148:         "direct_payload_verbatim": direct,
 149:         "recoverable_original_verbatim": direct or nested,
 150:         "original_locations_inside_payload": payload_locations,
 151:         "recoverable_original_locations": find_equal_subtrees(survivor_obj, original_obj),
 152:     }
 153: 
 154: 
 155: def proof_for_retired(
 156:     row: dict[str, Any],
 157:     survivor_obj: dict[str, Any],
 158:     retired_topic: str,
 159: ) -> dict[str, Any]:
 160:     current_retired = load_json(topic_path(retired_topic))
 161:     original_obj, source_info = unwrap_original_payload(current_retired)
 162:     source_kind = source_info["source_kind"]
 163:     original_leaf_paths = [path for path, _ in leaves(original_obj)]
 164:     original_trials = trial_ids(original_obj)
 165:     survivor_trials = trial_ids(survivor_obj)
 166:     missing_trials = sorted(set(original_trials) - set(survivor_trials))
 167: 
 168:     current_locations = find_equal_subtrees(survivor_obj, original_obj)
 169:     absorbed = classify_absorbed_payload(survivor_obj, retired_topic, original_obj)
 170: 
 171:     simulated = copy.deepcopy(survivor_obj)
 172:     simulated.setdefault("absorbed_topics", {})[retired_topic] = {
 173:         "THE_WHOLE_OBJECT_VERBATIM": original_obj
 174:     }
 175:     simulated_locations = find_equal_subtrees(simulated, original_obj)
 176: 
 177:     tombstone_checks: dict[str, Any] = {
 178:         "is_tombstone": source_kind == "tombstone_chain_unwrapped_original",
 179:         "tombstone_depth": source_info["tombstone_depth"],
 180:     }
 181:     if source_kind == "tombstone_chain_unwrapped_original":
 182:         tombstone_checks.update(
 183:             {
 184:                 "outer_absorbed_by": source_info["outer_absorbed_by"],
 185:                 "outer_absorbed_by_matches_survivor": source_info["outer_absorbed_by"]
 186:                 == row["survivor"],
 187:                 "outer_trials_it_held_matches_original": source_info["outer_trials_it_held"]
 188:                 == original_trials,
 189:                 "chain_sha256": source_info["chain_sha256"],
 190:             }
 191:         )
 192: 
 193:     return {
 194:         "retired": retired_topic,
 195:         "source_used_for_retired_object": source_kind,
 196:         "original_object_sha256": canonical_sha256(original_obj),
 197:         "leaves_in_original_retired_object": len(original_leaf_paths),
 198:         "original_trial_ids": original_trials,
 199:         "survivor_trial_ids": survivor_trials,
 200:         "trials_not_in_survivor_inputs": missing_trials,
 201:         "current_survivor_contains_original_verbatim": bool(current_locations),
 202:         "current_original_locations": current_locations,
 203:         "absorbed_payload": absorbed,
 204:         "simulated_absorption_contains_original_verbatim": bool(simulated_locations),
 205:         "simulated_original_locations": simulated_locations,
 206:         "current_union_proven": bool(current_locations) and not missing_trials,
 207:         "simulated_union_proven": bool(simulated_locations) and not missing_trials,
 208:         "tombstone_checks": tombstone_checks,
 209:     }
 210: 
 211: 
 212: def build_report() -> dict[str, Any]:
 213:     adjudication = load_json(ADJ)
 214:     page_map = load_json(PAGE_MAP)
 215:     merge_rows = [row for row in adjudication["rows"] if row["verdict"].startswith("MERGE")]
 216:     non_merge_rows = [
 217:         {"cluster": row["cluster"], "verdict": row["verdict"]}
 218:         for row in adjudication["rows"]
 219:         if not row["verdict"].startswith("MERGE")
 220:     ]
 221: 
 222:     rows: list[dict[str, Any]] = []
 223:     for row in merge_rows:
 224:         survivor = row["survivor"]
 225:         survivor_obj = load_json(topic_path(survivor))
 226:         survivor_page = page_for(survivor, page_map)
 227:         proofs = [proof_for_retired(row, survivor_obj, retired) for retired in row["retire"]]
 228:         current_all = all(proof["current_union_proven"] for proof in proofs)
 229:         simulated_all = all(proof["simulated_union_proven"] for proof in proofs)
 230:         if current_all:
 231:             status = "CURRENT_UNION_PROVEN"
 232:         elif simulated_all:
 233:             status = "NOT_CURRENTLY_ABSORBED_BUT_SIMULATED_UNION_PROVEN"
 234:         else:
 235:             status = "UNION_PROOF_FAILED"
 236:         rows.append(
 237:             {
 238:                 "cluster": row["cluster"],
 239:                 "survivor": survivor,
 240:                 "retire": row["retire"],
 241:                 "survivor_page": survivor_page,
 242:                 "survivor_page_exists": bool(survivor_page and (REPO / survivor_page).exists()),
 243:                 "status": status,
 244:                 "proofs": proofs,
 245:             }
 246:         )
 247: 
 248:     retired_proofs = [proof for row in rows for proof in row["proofs"]]
 249:     return {
 250:         "computed_utc": DATE,
 251:         "independence_statement": (
 252:             "Computed from merge_adjudication.json plus current SSOT JSON files. "
 253:             "This script does not import or execute the merge executor."
 254:         ),
 255:         "proof_rule": (
 256:             "For each MERGE cluster, the retired object's original payload is taken from "
 257:             "THE_OBJECT_AS_IT_STOOD_AT_RETIREMENT when the topic is already a RETIRED "
 258:             "tombstone, otherwise from the live topic object. Current union is proven only "
 259:             "when that original object exists verbatim somewhere in the survivor and every "
 260:             "retired trial id is present in survivor inputs.trials. Deferred clusters also "
 261:             "get a simulated absorption check without writing files."
 262:         ),
 263:         "counts": {
 264:             "expected_merge_clusters": EXPECTED_MERGE_CLUSTERS,
 265:             "merge_clusters_checked": len(rows),
 266:             "retired_topic_proofs_checked": len(retired_proofs),
 267:             "non_merge_clusters_excluded": len(non_merge_rows),
 268:             "clusters_current_union_proven": sum(
 269:                 1 for row in rows if row["status"] == "CURRENT_UNION_PROVEN"
 270:             ),
 271:             "clusters_deferred_or_not_currently_absorbed_but_simulated_proven": sum(
 272:                 1
 273:                 for row in rows
 274:                 if row["status"] == "NOT_CURRENTLY_ABSORBED_BUT_SIMULATED_UNION_PROVEN"
 275:             ),
 276:             "clusters_failed": sum(1 for row in rows if row["status"] == "UNION_PROOF_FAILED"),
 277:             "retired_topics_current_union_proven": sum(
 278:                 1 for proof in retired_proofs if proof["current_union_proven"]
 279:             ),
 280:             "retired_topics_simulated_union_proven": sum(
 281:                 1 for proof in retired_proofs if proof["simulated_union_proven"]
 282:             ),
 283:             "absorbed_payload_direct_original": sum(
 284:                 1
 285:                 for proof in retired_proofs
 286:                 if proof["absorbed_payload"]["payload_kind"] == "direct_original"
 287:             ),
 288:             "absorbed_payload_contains_original": sum(
 289:                 1
 290:                 for proof in retired_proofs
 291:                 if proof["absorbed_payload"]["payload_kind"] == "payload_contains_original"
 292:             ),
 293:             "absorbed_payload_absent": sum(
 294:                 1 for proof in retired_proofs if proof["absorbed_payload"]["payload_kind"] == "absent"
 295:             ),
 296:         },
 297:         "expectation_checks": {
 298:             "merge_cluster_count_is_expected": len(rows) == EXPECTED_MERGE_CLUSTERS,
 299:             "no_union_proof_failures": all(
 300:                 row["status"] != "UNION_PROOF_FAILED" for row in rows
 301:             ),
 302:             "all_retired_topics_simulated_union_proven": all(
 303:                 proof["simulated_union_proven"] for proof in retired_proofs
 304:             ),
 305:         },
 306:         "hardcode_disclosure": [
 307:             {
 308:                 "item": "DATE",
 309:                 "classification": "static run stamp",
 310:                 "value": DATE,
 311:                 "reason": "The batch being audited is dated 2026-08-19.",
 312:             },
 313:             {
 314:                 "item": "EXPECTED_MERGE_CLUSTERS",
 315:                 "classification": "static guard",
 316:                 "value": EXPECTED_MERGE_CLUSTERS,
 317:                 "reason": "The user requested exactly twelve merge-cluster proofs.",
 318:             },
 319:             {
 320:                 "item": "cluster members, survivors, retired topics, object payloads, trials, pages",
 321:                 "classification": "dynamic",
 322:                 "value": "read from merge_adjudication.json, PAGE_MAP.json, and ssot/*/*.json",
 323:                 "reason": "No proof result is hardcoded.",
 324:             },
 325:         ],
 326:         "non_merge_clusters_excluded": non_merge_rows,
 327:         "rows": rows,
 328:     }
 329: 
 330: 
 331: def selftest() -> int:
 332:     original = {"app_id": "retired", "inputs": {"trials": [{"nct": "NCT1"}]}, "x": [1, None]}
 333:     survivor = {"inputs": {"trials": [{"nct": "NCT1"}]}}
 334:     row = {"survivor": "survivor"}
 335: 
 336:     simulated = copy.deepcopy(survivor)
 337:     simulated.setdefault("absorbed_topics", {})["retired"] = {
 338:         "THE_WHOLE_OBJECT_VERBATIM": original
 339:     }
 340:     checks = [
 341:         ("hash stable", canonical_sha256(original) == canonical_sha256(copy.deepcopy(original))),
 342:         ("finds inserted original", bool(find_equal_subtrees(simulated, original))),
 343:         (
 344:             "classifies direct original",
 345:             classify_absorbed_payload(simulated, "retired", original)["payload_kind"]
 346:             == "direct_original",
 347:         ),
 348:         (
 349:             "classifies payload containing original",
 350:             classify_absorbed_payload(
 351:                 {
 352:                     "absorbed_topics": {
 353:                         "retired": {
 354:                             "THE_WHOLE_OBJECT_VERBATIM": {
 355:                                 "state": "RETIRED",
 356:                                 "THE_OBJECT_AS_IT_STOOD_AT_RETIREMENT": original,
 357:                             }
 358:                         }
 359:                     }
 360:                 },
 361:                 "retired",
 362:                 original,
 363:             )["payload_kind"]
 364:             == "payload_contains_original",
 365:         ),
 366:         (
 367:             "trial ids read",
 368:             trial_ids(original) == ["NCT1"] and trial_ids({"inputs": {"trials": []}}) == [],
 369:         ),
 370:         ("row shape independent", row["survivor"] == "survivor"),
 371:     ]
 372:     failed = [name for name, ok in checks if not ok]
 373:     for name, ok in checks:
 374:         print(f"{name}: {'ok' if ok else 'FAIL'}")
 375:     if failed:
 376:         print("SELFTEST FAILED: " + ", ".join(failed))
 377:         return 1
 378:     print("SELFTEST PASSED")
 379:     return 0
 380: 
 381: 
 382: def main() -> int:
 383:     parser = argparse.ArgumentParser()
 384:     parser.add_argument("--write", action="store_true", help=f"write {DEST.relative_to(REPO)}")
 385:     parser.add_argument("--selftest", action="store_true")
 386:     args = parser.parse_args()
 387: 
 388:     if args.selftest:
 389:         return selftest()
 390: 
 391:     report = build_report()
 392:     text = json.dumps(report, indent=1, ensure_ascii=False)
 393:     if args.write:
 394:         DEST.write_text(text + "\n", encoding="utf-8")
 395:     counts = report["counts"]
 396:     print(json.dumps(counts, indent=1, ensure_ascii=False))
 397:     for row in report["rows"]:
 398:         print(f"{row['status']}: {row['survivor']} <- {', '.join(row['retire'])}")
 399:         for proof in row["proofs"]:
 400:             print(
 401:                 "  {retired}: {leaves} leaves, current={current}, simulated={simulated}, "
 402:                 "payload={payload}, missing_trials={missing}".format(
 403:                     retired=proof["retired"],
 404:                     leaves=proof["leaves_in_original_retired_object"],
 405:                     current=proof["current_union_proven"],
 406:                     simulated=proof["simulated_union_proven"],
 407:                     payload=proof["absorbed_payload"]["payload_kind"],
 408:                     missing=len(proof["trials_not_in_survivor_inputs"]),
 409:                 )
 410:             )
 411:     expectations = report["expectation_checks"]
 412:     return 1 if counts["clusters_failed"] or not all(expectations.values()) else 0
 413: 
 414: 
 415: if __name__ == "__main__":
 416:     raise SystemExit(main())

