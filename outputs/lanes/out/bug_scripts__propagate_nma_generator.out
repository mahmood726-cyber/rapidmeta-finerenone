 167: def apply_to_file(path: pathlib.Path, dry_run: bool) -> str:
 168:     text = path.read_text(encoding="utf-8", newline="")
 169:     if "function generateNMAManuscriptText()" in text:
 170:         return f"SKIP {path.name}: already-migrated"
 171:     if "const NMA_CONFIG" not in text:
 172:         return f"SKIP {path.name}: not an NMA app (no NMA_CONFIG)"
 173:     if "const NMA_CONFIG = null" in text:
 174:         return f"SKIP {path.name}: NMA_CONFIG=null (pairwise scaffold, no real network)"
 175: 
 176:     crlf = "\r\n" in text
 177:     work = text.replace("\r\n", "\n") if crlf else text
 178: 
 179:     for label, old, new in (("EDIT1-panel", EDIT1_OLD, EDIT1_NEW),
 180:                             ("EDIT2-render-hook", EDIT2_OLD, EDIT2_NEW),
 181:                             ("EDIT3-functions", EDIT3_OLD, EDIT3_NEW)):
 182:         if work.count(old) != 1:
 183:             return f"FAIL {path.name}: {label} matched {work.count(old)} times (expected 1)"
 184:         work = work.replace(old, new, 1)
 185: 
 186:     if not dry_run:
 187:         out = work.replace("\n", "\r\n") if crlf else work
 188:         path.write_text(out, encoding="utf-8", newline="")
 189:     return f"OK   {path.name}: +{len(work) - len(text.replace(chr(13)+chr(10), chr(10)) if crlf else text)} chars"
 190: 
 191: 
 192: def main():
 193:     ap = argparse.ArgumentParser()
 194:     ap.add_argument("--dry-run", action="store_true")
 195:     ap.add_argument("--apply", action="store_true")
 196:     args = ap.parse_args()
 197:     if not (args.dry_run or args.apply):
 198:         ap.error("pass --dry-run or --apply")
 199: 
 200:     targets = sorted(ROOT.glob("*_REVIEW.html"))
 201:     ok = skip = fail = 0
 202:     for p in targets:
 203:         result = apply_to_file(p, dry_run=args.dry_run)
 204:         if result.startswith("OK"): ok += 1
 205:         elif result.startswith("SKIP"): skip += 1
 206:         else: fail += 1
 207:         if not result.startswith("SKIP") or args.dry_run:
 208:             print(result)
 209:     print(f"\nSummary: {len(targets)} files | {ok} migrate | {skip} skip | {fail} fail | mode={'dry-run' if args.dry_run else 'apply'}")
 210:     if fail:
 211:         sys.exit(1)
 212: 
 213: 
 214: if __name__ == "__main__":
 215:     main()

codex
Defects found:

- **Idempotency guard satisfied by comment/marker**: line 169.  
  Exact input: a target HTML containing `const NMA_CONFIG = {treatments:['A'], comparisons:[]};` and `<!-- function generateNMAManuscriptText() TODO -->`, with none of the three edits applied.  
  Consequence: the script returns `SKIP ... already-migrated` and performs no migration.

- **Name/string read instead of binding**: line 173.  
  Exact input: a target HTML containing `// old scaffold: const NMA_CONFIG = null` and later `const NMA_CONFIG = {treatments:['A','B'], comparisons:[{t1:'A',t2:'B',trials:['T1']}]};`.  
  Consequence: a real NMA app is skipped as `NMA_CONFIG=null`.

- **Check can pass with no work done**: lines 200 and 210.  
  Exact input: run `python scripts/propagate_nma_generator.py --apply` in a tree with zero `*_REVIEW.html` files.  
  Consequence: exits 0 with `0 migrate | 0 skip | 0 fail`, so the propagation gate cannot detect a missing corpus.

- **Off-by-one/count logic misclassifies loopless networks**: line 136.  
  Exact input: generated page with `treatments=['A','B','C','D']` and comparisons `A-B`, `B-C`, `C-D`.  
  Consequence: results text takes the non-star branch and falsely says the network contains closed loops.

- **Zero conflated with absent**: line 75.  
  Exact input: `RapidMeta.realData = {T1:{tN:0,cN:50}}` with comparison trials `['T1']`.  
  Consequence: `50` real participants are omitted from `totalN`.

No proven CRLF text-comparison defect, negation-dropped sentence parse, merged-cell tabulation defect, or pipe-wrapper `$?` defect in the pasted file.
