 213:     # And the audit must FIND something, or it is not measuring.
 214:     identical, subset, overlap = analyse(sets)
 215:     check("the audit finds overlapping pairs to report",
 216:           (len(identical) + len(subset) + len(overlap)) > 0, True)
 217:     check("and a readable corpus to compute over", len(sets) > 50, True)
