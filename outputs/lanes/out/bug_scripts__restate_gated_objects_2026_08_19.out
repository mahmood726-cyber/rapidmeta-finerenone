                "hospitalisation for heart failure among its three co-primaries at one year. "
                "It is not this object's estimand -- a time-to-first CV-death-or-worsening-HF "
                "composite -- so even under a widened population it would enter on the "
                "POOLABILITY axis rather than the pool. Stated so a reader can see the cost "
                "of the boundary rather than take it on trust."),
        },
    ],
    "tally": {"EXCLUDED": 1, "ELIGIBLE_NO_RESULTS_YET": 1,
              "ELIGIBLE_NOT_POOLABLE": 0, "ELIGIBLE_POOLABLE_NOT_INCLUDED": 0,
              "k_unchanged": "k stays at 4. Neither trial is both eligible and poolable."},
    "and_one_that_was_already_screened": {
        "nct": "NCT04157751",
        "why_not_here": (
            "EMPULSE also moved background -> experimental at c5b98b329, but it is already in "
            "this object's native screening.records, EXCLUDED on population and duration. It "
            "is counted in the remainder reconciliation and is not re-screened here. Checked "
            "rather than assumed -- three records moved and only two were new."),
    },
}


def do_sglt2():
    path, obj = load("sglt2-hf")
    obj.setdefault("screening_of_remainder", {})
    obj["screening_of_remainder"]["sglt2_regate_2026_08_19"] = SGLT2_SCREENING

    kc = obj.setdefault("k_cascade", {})
    supersede(kc, "source",
              {"executed_search": "recorded at search.databases in this object",
               "cascade_recomputed_by": "scripts/regate_cascade_2026_08_19.py",
               "reproduction_across_revisions": "scripts/regate_sglt2_three_revisions.py",
               "note": ("Named as SCRIPTS THAT RE-DERIVE THE NUMBERS rather than as a file "
                        "that once held them, so the citation stays true when the classifier "
                        "next changes.")},
              "it cited evidence/2026-08-19-batch1/cascade.json, and sglt2-hf IS NOT IN THAT "
              "FILE -- that run covered eight other topics. A false provenance record on a "
              "field whose only job is provenance. iv-iron-hf is absent from the same file; "
              "its cascade carries no source key at all, which is a gap rather than a wrong "
              "citation.")
    save(path, obj)
    return path


def main():
    sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
    if not os.path.exists(RECOMPUTE):
        print("REFUSED: %s is absent. Run scripts/recompute_alirocumab_k8.py first -- it "
              "will not emit unless the stored headline reproduces, and this file must not "
              "write derived values that were never checked." % RECOMPUTE)
        return 1
    with io.open(RECOMPUTE, encoding="utf-8") as fh:
        rec = json.load(fh)
    if not rec.get("gate_reproduced"):
        print("REFUSED: the recompute did not pass its own gate.")
        return 1
    print("wrote %s" % do_alirocumab(rec))
    print("wrote %s" % do_sglt2())
    return 0


if __name__ == "__main__":
    sys.exit(main())

