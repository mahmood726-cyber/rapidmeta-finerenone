def do_alirocumab(rec):
    path, obj = load("alirocumab-lipid")
    blk = obj["results"]["by_outcome"]["ldlc_pct_change_wk24"]
    pi, dl_, reml_, hksj_ = (rec["prediction_interval"], rec["dl"], rec["reml"], rec["hksj"])

    obj.setdefault("screening_of_remainder", {})
    obj["screening_of_remainder"]["alirocumab_newly_unscreened_2026_08_19"] = ALI_SCREENING

    # --- prediction interval, recomputed at k=8 -------------------------------------------
    supersede(blk, "prediction_interval", {
        "low": round(pi["low"], 2),
        "high": round(pi["high"], 2),
        "basis": (f"t_{pi['df']}, DerSimonian-Laird tau-squared, per this project's resolved "
                  f"convention (Cochrane Handbook v6.5, matching metafor's predict). "
                  f"t_{pi['df']} = {pi['t']:.4f}."),
        "recomputed_by": "scripts/recompute_alirocumab_k8.py, gate: the stored k=8 headline "
                         "reproduces from the object's own per-trial values before anything "
                         "derived is written",
        "what_it_says": (
            "THIS IS THE NUMBER TO QUOTE, and it is not the headline. The confidence interval "
            "-60.2 to -49.4 is about where the AVERAGE lies. The prediction interval -72.8 to "
            "-36.9 is about where the effect in a NEW trial of this drug would lie, and it is "
            "over three times wider. The eight trials range from -39.1 to -64.1 with tight "
            "intervals of their own, so the spread is real and not sampling noise: dose "
            "regimen differs, as do population and background statin therapy. A single number "
            "for 'how much does alirocumab lower LDL' conceals a 25-point range."),
        "what_changed_from_k6": (
            "The k=6 interval was -74.08 to -35.23 on t_5. At k=8 it is -72.77 to -36.87 on "
            "t_7 -- NARROWER BY 3.0 POINTS, and almost all of that is the t multiplier "
            "falling from 2.5706 to 2.3646 as the degrees of freedom rise. tau-squared went "
            "UP (47.42 to 50.04). So the prediction interval narrowed while the estimated "
            "between-trial variance grew, and reporting only the narrowing would suggest the "
            "evidence became more consistent when it did not."),
    }, "computed over SIX trials on a page that pools EIGHT, with its own text calling it "
       "'the number to quote'")

    # --- estimator sensitivity, recomputed at k=8 -----------------------------------------
    i2dl, i2re = rec["i2_metafor_dl"], rec["i2_metafor_reml"]
    supersede(blk, "estimator_sensitivity", {
        "_why": (
            "What the alternative estimators give on exactly these EIGHT values. Computed "
            "from the object's own per-trial inputs; the DerSimonian-Laird row reproduces the "
            "stored headline, which is what licenses printing the others beside it. The REML "
            "row additionally reproduces metafor's result already stored on this object at "
            "recovery_2026_08_19.new_reml -- an outside known answer, not this script "
            "agreeing with itself."),
        "i2_column_definition": (
            "metafor's I-squared, tau2/(tau2 + s2) with s2 the typical within-study variance "
            "-- NOT Higgins (Q-df)/Q. Named because the two disagree here and the sentence "
            "below turns on which is meant: Higgins is computed from Q, which uses "
            "fixed-effect weights, so it CANNOT move between estimators and reads 88.0 for "
            "every row. A sensitivity column that cannot move is not a sensitivity column."),
        "rows": [
            {"estimator": "DerSimonian-Laird (as displayed)",
             "tau2": round(dl_["tau2"], 2), "i2_pct": round(i2dl, 1),
             "point": round(dl_["point"], 4),
             "ci_low": round(dl_["ci_low"], 4), "ci_high": round(dl_["ci_high"], 4)},
            {"estimator": "REML",
             "tau2": round(reml_["tau2"], 2), "i2_pct": round(i2re, 1),
             "point": round(reml_["point"], 4),
             "ci_low": round(reml_["ci_low"], 4), "ci_high": round(reml_["ci_high"], 4)},
            {"estimator": "REML with Hartung-Knapp-Sidik-Jonkman",
             "tau2": round(reml_["tau2"], 2), "i2_pct": round(i2re, 1),
             "point": round(hksj_["point"], 4),
             "ci_low": round(hksj_["ci_low"], 4), "ci_high": round(hksj_["ci_high"], 4),
             "note": f"t_{hksj_['df']} = {hksj_['t']:.4f}, not a normal quantile"},
        ],
        "what_moves": (
            "The point estimate barely moves -- 54.8 against 54.7 percent -- and no reading "
            "of the direction or the magnitude changes. THE INTERVAL MOVES: 10.8 points wide "
            "under DerSimonian-Laird, 11.8 under REML, 14.7 under REML with Hartung-Knapp. A "
            "reader who wants the most conservative statement of what eight trials establish "
            "should take the last of those."),
        "the_one_that_matters": (
            "I-SQUARED SITS EXACTLY ON THE THRESHOLD, AND WHICH SIDE DEPENDS ON THE "
            "DEFINITION AS WELL AS THE ESTIMATOR. 88.0 per cent under DerSimonian-Laird and "
            "90.0 under REML on metafor's definition; 88.0 under BOTH on Higgins's. This "
            "project's poolability screen treats 90 per cent as the point at which an average "
            "conceals more than it conveys, so at k=8 the verdict on whether these eight "
            "trials should be averaged at all lands ON the line rather than clearly either "
            "side of it. At k=6 the REML figure was 91.6 and clearly across. THE RECOVERY "
            "MOVED THIS TOWARD POOLABILITY, which is the opposite direction from the one that "
            "would flatter a decision already taken, and is stated for that reason."),
        "what_changed_from_k6": (
            "k=6 rows were DL 47.42/87.9 and REML 71.22/91.6 with HKSJ -64.13 to -44.53. Two "
            "more trials RAISED the DL tau-squared (47.42 -> 50.04) and LOWERED the REML one "
            "(71.22 -> 61.44), because REML's penalty for few studies eases as k grows. Both "
            "intervals narrowed."),
    }, "computed over SIX trials on a page that pools EIGHT")

    # --- published comparison: the k=6 estimate presented as this review's ----------------
    pc = obj["published_comparison"]
    supersede(pc["divergence_decomposed"], "ours",
              ("Mean difference -54.82 percent (-60.23 to -49.42) in calculated LDL "
               "cholesterol at week 24, k=8, random effects, DerSimonian-Laird. PREDICTION "
               "INTERVAL -72.8 to -36.9, which is the number to quote."),
              "it stated the SUPERSEDED k=6 estimate as this review's own, in the table a "
              "reader consults to compare this review against the literature. P7 requires "
              "that table to agree with the page and with the Word manuscript, and it "
              "disagreed with both. Caught by scripts/lint_ours_matches_pool.py, which exists "
              "because lint_block_contradicts_object.py scopes published_comparison out "
              "entirely as describing OTHER work -- and a field named `ours` is exactly what "
              "that block-level exclusion hides.")

    pc["_why"] = pc["_why"].replace("Six trials, one endpoint",
                                    "Eight trials, one endpoint")
    dd = pc["divergence_decomposed"]
    dd["why_they_differ"] = dd["why_they_differ"].replace(
        "six trials running from -39.1 to -64.1",
        "eight trials running from -39.1 to -64.1")
    for chk in pc["checks"]:
        for fld in ("what", "detail"):
            if fld in chk and isinstance(chk[fld], str):
                chk[fld] = (chk[fld]
                            .replace("our -54.66%", "our -54.82%")
                            .replace("our -54.66", "our -54.82")
                            .replace("these six trials", "these eight trials")
                            .replace("the six trials", "the eight trials")
                            .replace("our six trials", "our eight trials")
                            .replace("DerSimonian-Laird at k=6", "DerSimonian-Laird at k=8"))
    for rv in pc["reviews"]:
        if isinstance(rv.get("how_it_differs_from_ours"), str):
            rv["how_it_differs_from_ours"] = rv["how_it_differs_from_ours"].replace(
                "our -54.7", "our -54.8")
    pc["restated_2026_08_19_to_k8"] = (
        "This whole block was written when the pool was six trials. Every statement of what "
        "THIS review found has been moved to the k=8 values; every statement about SOMEONE "
        "ELSE'S review is untouched, because none of them changed. The superseded text is "
        "kept at divergence_decomposed.ours_superseded_2026_08_19 rather than deleted -- a "
        "slot that is overwritten loses the record that it ever said something else.")

    # --- the recovery block's own "not done" note, which is no longer true ----------------
    supersede(obj["recovery_2026_08_19"], "not_done_and_named",
              ("SUPERSEDED BY ITS OWN COMPLETION. The two recovered trials WERE promoted into "
               "inputs.trials and results.by_outcome on 2026-08-19 and the headline was "
               "restated to k=8. What was NOT carried across at that time, and is carried "
               "across now: prisma_flow.included (still 6), k_cascade.k_included_in_object "
               "(still 6), prediction_interval and estimator_sensitivity (both still computed "
               "over six), and every k=6 figure in published_comparison. A PROMOTION APPLIED "
               "TO THE HEADLINE AND NOT TO THE DERIVED BLOCKS IS HOW ONE PAGE COMES TO CARRY "
               "TWO ANSWERS."),
              "it stated that the recovered trials were not in inputs.trials, which stopped "
              "being true when they were promoted; a caveat that outlives its condition reads "
              "as a live limitation")

    save(path, obj)
    return path


