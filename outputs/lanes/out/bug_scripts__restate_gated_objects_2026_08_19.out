"""OBJECT-SIDE RESTATEMENT of the two gated topics that acquired unscreened trials.

The CASCADE COUNTS live in the builder's per-topic data and are restated there, so they
survive a rebuild. Everything in this file is the part the builder does NOT write:

  alirocumab-lipid
    * two newly-experimental trials SCREENED to a disposition
    * the k=6 numbers still sitting in published_comparison, on a page whose headline is k=8
    * prediction_interval and estimator_sensitivity, both still computed over SIX trials on a
      page that pools EIGHT -- recomputed by scripts/recompute_alirocumab_k8.py, which
      refuses to emit anything unless the STORED headline reproduces from the object's own
      per-trial values first
    * `recovery_2026_08_19.not_done_and_named`, which says the two trials are NOT in
      inputs.trials -- true when written, false since the promotion

  sglt2-hf
    * two newly-experimental trials SCREENED to a disposition
    * `k_cascade.source`, which cites a file this topic is not in

EVERY WRITE IS A MERGE AT A NAMED PATH. Nothing is written wholesale, and no superseded text
is deleted -- it moves to a `*_superseded_2026_08_19` key beside its replacement. A slot that
is overwritten loses the record that it ever said something else, and on this page that record
IS the finding.
"""
import io
import json
import os
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
RECOMPUTE = os.path.join(REPO, "evidence", "2026-08-19-batch1", "alirocumab_k8_recompute.json")


def load(topic):
    p = os.path.join(REPO, "ssot", topic, topic + ".json")
    with io.open(p, encoding="utf-8") as fh:
        return p, json.load(fh)


def save(path, obj):
    with io.open(path, "w", encoding="utf-8") as fh:
        fh.write(json.dumps(obj, indent=1, ensure_ascii=True))


def supersede(container, key, new_value, why):
    """Replace container[key], keeping the old value under a superseded key beside it."""
    old = container.get(key)
    if old is not None:
        container[key + "_superseded_2026_08_19"] = {"was": old, "superseded_because": why}
    container[key] = new_value


