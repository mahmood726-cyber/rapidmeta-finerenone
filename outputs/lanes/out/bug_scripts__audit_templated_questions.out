  47: TEMPLATE_TAIL = "on each trial's own registered primary outcome?"
  48: 
  49: 
  50: def classify(obj):
  51:     """STATES_A_QUESTION / TEMPLATED / ABSENT / TITLE_ECHO -- four states, never two."""
  52:     q = (obj.get("question") or "").strip()
  53:     t = (obj.get("title") or "").strip()
  54:     if not q:
  55:         return "ABSENT", "the object records no question at all"
  56:     if q.lower().endswith(TEMPLATE_TAIL):
  57:         return "TEMPLATED", ("the question is the title with the stock suffix %r appended"
  58:                              % TEMPLATE_TAIL)
  59:     # A question that is merely the title again, with or without a question mark, states nothing
  60:     # the title did not. Counted separately because it is a DIFFERENT generator's output and
  61:     # folding it into TEMPLATED would understate the first and overstate the second.
  62:     if t and q.rstrip("?").strip().lower() == t.rstrip("?").strip().lower():
  63:         return "TITLE_ECHO", "the question is byte-identical to the title"
  64:     return "STATES_A_QUESTION", None
  65: 
  66: 
  67: def run():
