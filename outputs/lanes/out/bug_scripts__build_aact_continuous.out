import csv,re,collections
from pathlib import Path
HERE=Path('.').resolve(); ncts=set()
for p in HERE.glob('*.html'):
    ncts.update(re.findall(r'NCT\\d{7,8}', p.read_text(encoding='utf-8', errors='replace')))
primary={}
for row in csv.DictReader(Path(r'F:\\AACT-storage\\AACT\\2026-04-12\\outcomes.txt').open(encoding='utf-8', errors='replace'), delimiter='|'):
    nct=(row.get('nct_id') or '').strip()
    if nct in ncts and nct not in primary and (row.get('outcome_type') or '').strip().lower()=='primary':
        oid=(row.get('id') or '').strip()
        if oid: primary[nct]=oid
mapkeys={
    'MEAN DIFFERENCE (FINAL VALUES)','MEAN DIFFERENCE (NET)','LS MEAN DIFFERENCE','LEAST SQUARES MEAN DIFFERENCE','ADJUSTED MEAN DIFFERENCE','HAZARD RATIO (HR)','ODDS RATIO (OR)','RISK RATIO (RR)','RISK DIFFERENCE (RD)','DIFFERENCE IN PERCENTAGE','SLOPE'
}
misses=[]
for row in csv.DictReader(Path(r'F:\\AACT-storage\\AACT\\2026-04-12\\outcome_analyses.txt').open(encoding='utf-8', errors='replace'), delimiter='|'):
    nct=(row.get('nct_id') or '').strip(); oid=(row.get('outcome_id') or '').strip(); pt=(row.get('param_type') or '').strip(); ptu=pt.upper()
    if nct in ncts and primary.get(nct)==oid and ptu not in mapkeys:
        # numeric effect + CI, common effect-ish labels
        try: float((row.get('param_value') or '').strip())
        except: continue
        if any(s in ptu for s in ['MEAN DIFFERENCE','HAZARD RATIO','ODDS RATIO','RISK RATIO','RISK DIFFERENCE']):
            misses.append({k:row.get(k) for k in ['nct_id','outcome_id','param_type','param_value','ci_lower_limit','ci_upper_limit']})
            if len(misses)>=10: break
print(len(misses))
for m in misses: print(m)
