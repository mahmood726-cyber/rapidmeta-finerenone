   1: """A2: build a per-NCT map of continuous-outcome effect sizes from AACT.
   2: 
   3: For each portfolio NCT, find the primary outcome and extract either:
   4: 
   5:   (a) A pre-computed effect from outcome_analyses.txt
   6:       (param_type in MEAN DIFFERENCE family, HAZARD RATIO, ODDS RATIO, RR,
   7:       RISK DIFFERENCE, SLOPE) + ci_lower_limit + ci_upper_limit. This is
   8:       the trial's own published headline number, which is the right value
   9:       to display.
  10: 
  11:   (b) Falling back to per-arm Mean+SD from outcome_measurements.txt with
  12:       param_type in (MEAN, MEDIAN, LEAST_SQUARES_MEAN, GEOMETRIC_MEAN). When
  13:       both arms have a numeric Mean and a dispersion (StdDev/StdErr), we
  14:       compute MD = tMean - cMean and varMD = sdT^2/nT + sdC^2/nC.
  15: 
  16: The output enables retroactive injection of `estimandType: 'MD'/'HR'/'OR'/
  17: 'RR'/'RD'` with the published effect + CI, and per-arm Mean/SD for the
  18: trial cards. Trials that previously had `tE: null, cE: null` because the
  19: outcome was continuous (and got skipped by A1) become poolable as MD/SMD.
  20: 
  21: Output: outputs/pmid_resolver/nct_continuous.json
  22:     {nct: {kind, effect, lci, uci, tMean?, tSD?, cMean?, cSD?, source}}
  23: """
  24: from __future__ import annotations
  25: import csv
  26: import json
  27: import re
  28: import sys
  29: import io
  30: from pathlib import Path
  31: from collections import defaultdict
  32: 
  33: if "pytest" not in sys.modules and hasattr(sys.stdout, "buffer"):
  34:     sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
  35: csv.field_size_limit(50_000_000)
  36: 
  37: HERE = Path(__file__).resolve().parent.parent
  38: AACT = Path(r"F:\AACT-storage\AACT\2026-04-12")
  39: OUT = HERE / "outputs" / "pmid_resolver"
  40: OUT.mkdir(parents=True, exist_ok=True)
  41: 
  42: NCT_RE = re.compile(r"NCT\d{7,8}")
  43: 
  44: # Map AACT analysis param_type -> our estimandType, with the convention that
  45: # MD-family is on the absolute scale (model on raw effect) while ratio types
  46: # (HR/OR/RR) are on the log scale (the engine handles the back-transform).
  47: ANALYSIS_KIND_MAP = {
  48:     "MEAN DIFFERENCE (FINAL VALUES)": "MD",
  49:     "MEAN DIFFERENCE (NET)": "MD",
  50:     "LS MEAN DIFFERENCE": "MD",
  51:     "LEAST SQUARES MEAN DIFFERENCE": "MD",
  52:     "ADJUSTED MEAN DIFFERENCE": "MD",
  53:     "HAZARD RATIO (HR)": "HR",
  54:     "ODDS RATIO (OR)": "OR",
  55:     "RISK RATIO (RR)": "RR",
  56:     "RISK DIFFERENCE (RD)": "RD",
  57:     "DIFFERENCE IN PERCENTAGE": "MD",  # treat as absolute %-point difference
  58:     "SLOPE": "MD",
  59: }
  60: 
  61: MEAN_PARAM_TYPES = {
  62:     "MEAN", "MEDIAN", "GEOMETRIC_MEAN", "LEAST_SQUARES_MEAN",
  63:     "GEOMETRIC_LEAST_SQUARES_MEAN", "LOG_MEAN",
  64: }
  65: 
  66: 
  67: def portfolio_ncts() -> set[str]:
  68:     ncts: set[str] = set()
  69:     for p in HERE.glob("*.html"):
  70:         if not p.is_file():
  71:             continue
  72:         ncts |= set(NCT_RE.findall(p.read_text(encoding="utf-8", errors="replace")))
  73:     return ncts
  74: 
  75: 
  76: def load_primary_outcome_ids(ncts: set[str]) -> dict[str, str]:
  77:     """Return {nct: outcome_id_of_first_primary} from outcomes.txt."""
  78:     path = AACT / "outcomes.txt"
  79:     out: dict[str, str] = {}
  80:     with path.open(encoding="utf-8", errors="replace") as f:
  81:         rd = csv.DictReader(f, delimiter="|")
  82:         for row in rd:
  83:             nct = (row.get("nct_id") or "").strip()
  84:             if nct not in ncts or nct in out:
  85:                 continue
  86:             if (row.get("outcome_type") or "").strip().lower() != "primary":
  87:                 continue
  88:             oid = (row.get("id") or "").strip()
  89:             if oid:
  90:                 out[nct] = oid
  91:     return out
  92: 
  93: 
  94: def load_pre_computed_analyses(ncts: set[str], primary_outcome: dict[str, str]) -> dict[str, dict]:
  95:     """For each NCT primary outcome, pick the first analyses row whose
  96:     param_type is in ANALYSIS_KIND_MAP."""
  97:     path = AACT / "outcome_analyses.txt"
  98:     out: dict[str, dict] = {}
  99:     with path.open(encoding="utf-8", errors="replace") as f:
 100:         rd = csv.DictReader(f, delimiter="|")
 101:         for row in rd:
 102:             nct = (row.get("nct_id") or "").strip()
 103:             if nct not in ncts or nct in out:
 104:                 continue
 105:             oid = (row.get("outcome_id") or "").strip()
 106:             # Restrict to the primary outcome when we have one.
 107:             if primary_outcome.get(nct) and oid != primary_outcome[nct]:
 108:                 continue
 109:             kind = ANALYSIS_KIND_MAP.get((row.get("param_type") or "").strip().upper())
 110:             if not kind:
 111:                 continue
 112:             try:
 113:                 eff = float((row.get("param_value") or "").strip())
 114:             except (TypeError, ValueError):
 115:                 continue
 116:             try:
 117:                 lci = float((row.get("ci_lower_limit") or "").strip())
 118:                 uci = float((row.get("ci_upper_limit") or "").strip())
 119:             except (TypeError, ValueError):
 120:                 lci = uci = None
 121:             out[nct] = {
 122:                 "kind": kind,
 123:                 "effect": eff,
 124:                 "lci": lci,
 125:                 "uci": uci,
 126:                 "source": "outcome_analyses",
 127:                 "param_type": (row.get("param_type") or "").strip(),
 128:             }
 129:     return out
 130: 
 131: 
 132: def load_per_arm_means(ncts: set[str], primary_outcome: dict[str, str]) -> dict[str, list[dict]]:
 133:     """For each NCT, return the per-arm Mean+dispersion rows on the primary outcome.
 134: 
 135:     Captures dispersion_type AND the dispersion_lower_limit/upper_limit columns
 136:     so we can convert CI-based dispersion into SD downstream.
 137:     """
 138:     path = AACT / "outcome_measurements.txt"
 139:     out: dict[str, list[dict]] = defaultdict(list)
 140:     with path.open(encoding="utf-8", errors="replace") as f:
 141:         rd = csv.DictReader(f, delimiter="|")
 142:         for row in rd:
 143:             nct = (row.get("nct_id") or "").strip()
 144:             if nct not in ncts:
 145:                 continue
 146:             oid = (row.get("outcome_id") or "").strip()
 147:             if primary_outcome.get(nct) and oid != primary_outcome[nct]:
 148:                 continue
 149:             pt = (row.get("param_type") or "").strip().upper()
 150:             if pt not in MEAN_PARAM_TYPES:
 151:                 continue
 152:             try:
 153:                 val = float((row.get("param_value") or "").strip())
 154:             except (TypeError, ValueError):
 155:                 continue
 156:             dt = (row.get("dispersion_type") or "").strip().upper()
 157:             try:
 158:                 disp = float((row.get("dispersion_value") or "").strip())
 159:             except (TypeError, ValueError):
 160:                 disp = None
 161:             try:
 162:                 lo = float((row.get("dispersion_lower_limit") or "").strip())
 163:             except (TypeError, ValueError):
 164:                 lo = None
 165:             try:
 166:                 hi = float((row.get("dispersion_upper_limit") or "").strip())
 167:             except (TypeError, ValueError):
 168:                 hi = None
 169:             out[nct].append({
 170:                 "group": (row.get("ctgov_group_code") or "").strip(),
 171:                 "mean": val,
 172:                 "disp": disp,
 173:                 "disp_type": dt,
 174:                 "disp_lo": lo,
 175:                 "disp_hi": hi,
 176:                 "outcome_id": oid,
 177:             })
 178:     return out
 179: 
 180: 
 181: def load_baseline_n(ncts: set[str]) -> dict[str, dict[str, int]]:
 182:     path = AACT / "baseline_counts.txt"
 183:     out: dict[str, dict[str, int]] = defaultdict(dict)
 184:     with path.open(encoding="utf-8", errors="replace") as f:
 185:         rd = csv.DictReader(f, delimiter="|")
 186:         for row in rd:
 187:             nct = (row.get("nct_id") or "").strip()
 188:             if nct not in ncts:
 189:                 continue
 190:             scope = (row.get("scope") or "").strip().lower()
 191:             if scope and scope != "overall":
 192:                 continue
 193:             group = (row.get("ctgov_group_code") or "").strip()
 194:             try:
 195:                 n = int(float((row.get("count") or "").strip()))
 196:             except (TypeError, ValueError):
 197:                 continue
 198:             if group and n > 0:
 199:                 out[nct][group] = n
 200:     return out
 201: 
 202: 
 203: def compute_md_from_arms(
 204:     arms: list[dict], baseline: dict[str, int]
 205: ) -> dict | None:
 206:     """Two-arm MD = tMean - cMean, var = sdT^2/nT + sdC^2/nC.
 207: 
 208:     Handles every AACT dispersion_type that can be converted to a usable SD:
 209:       STANDARD DEVIATION                  -> use as-is
 210:       STANDARD ERROR                      -> SD = SE * sqrt(N)
 211:       95% / 90% / 99% / ... CONFIDENCE    -> SD = (upper-lower)*sqrt(N) / (2*z)
 212:       INTER-QUARTILE RANGE                -> SD â‰ˆ IQR / 1.349 (Higgins+Green
 213:                                               JBI conversion for symmetric data)
 214:       anything else (FULL RANGE, GEOMETRIC
 215:         COEFFICIENT OF VARIATION)         -> None (refuse, too lossy)
 216:     Note: AACT stores the dispersion_type with SPACES (e.g. "STANDARD DEVIATION"),
 217:     NOT underscores. The original matcher used underscores and silently
 218:     returned 0 rows.
 219:     """
 220:     # First-occurrence per group, sorted by group code.
 221:     seen: dict[str, dict] = {}
 222:     for a in arms:
 223:         if a["group"] and a["group"] not in seen:
 224:             seen[a["group"]] = a
 225:     if len(seen) < 2:
 226:         return None
 227:     groups = sorted(seen.keys())
 228:     tg, cg = groups[0], groups[1]
 229:     tArm, cArm = seen[tg], seen[cg]
 230: 
 231:     # z-score for common CI levels.
 232:     Z_FOR_CI = {
 233:         "50% CONFIDENCE INTERVAL": 0.6745,
 234:         "60% CONFIDENCE INTERVAL": 0.8416,
 235:         "70% CONFIDENCE INTERVAL": 1.0364,
 236:         "80% CONFIDENCE INTERVAL": 1.2816,
 237:         "90% CONFIDENCE INTERVAL": 1.6449,
 238:         "95% CONFIDENCE INTERVAL": 1.96,
 239:         "96% CONFIDENCE INTERVAL": 2.0537,
 240:         "97.5% CONFIDENCE INTERVAL": 2.2414,
 241:         "98% CONFIDENCE INTERVAL": 2.3263,
 242:         "99% CONFIDENCE INTERVAL": 2.5758,
 243:         "99.5% CONFIDENCE INTERVAL": 2.8070,
 244:         "99.9% CONFIDENCE INTERVAL": 3.2905,
 245:     }
 246: 
 247:     def to_sd(arm, n):
 248:         disp = arm["disp"]
 249:         dtype = (arm["disp_type"] or "").upper()
 250:         lo = arm.get("disp_lo")
 251:         hi = arm.get("disp_hi")
 252:         if n is None or n <= 0:
 253:             return None
 254:         if dtype == "STANDARD DEVIATION":
 255:             return disp
 256:         if dtype == "STANDARD ERROR" and disp is not None and disp > 0:
 257:             return disp * (n ** 0.5)
 258:         if dtype in Z_FOR_CI and lo is not None and hi is not None and hi > lo:
 259:             z = Z_FOR_CI[dtype]
 260:             # SE = (hi - lo) / (2*z); SD = SE * sqrt(N)
 261:             return ((hi - lo) / (2 * z)) * (n ** 0.5)
 262:         if dtype == "INTER-QUARTILE RANGE" and disp is not None and disp > 0:
 263:             return disp / 1.349
 264:         return None
 265: 
 266:     # Match baseline N to the corresponding BG group (sorted alignment).
 267:     bg_groups = sorted(baseline.keys())
 268:     tN = baseline.get(bg_groups[0]) if bg_groups else None
 269:     cN = baseline.get(bg_groups[1]) if len(bg_groups) > 1 else None
 270:     if tN is None or cN is None:
 271:         return None
 272: 
 273:     tSD = to_sd(tArm, tN)
 274:     cSD = to_sd(cArm, cN)
 275:     if tSD is None or cSD is None or tSD <= 0 or cSD <= 0:
 276:         return None
 277: 
 278:     md = tArm["mean"] - cArm["mean"]
 279:     var_md = (tSD ** 2) / tN + (cSD ** 2) / cN
 280:     se_md = var_md ** 0.5
 281:     lci = md - 1.96 * se_md
 282:     uci = md + 1.96 * se_md
 283:     return {
 284:         "kind": "MD",
 285:         "effect": round(md, 4),
 286:         "lci": round(lci, 4),
 287:         "uci": round(uci, 4),
 288:         "tMean": round(tArm["mean"], 4),
 289:         "tSD": round(tSD, 4),
 290:         "tN": tN,
 291:         "cMean": round(cArm["mean"], 4),
 292:         "cSD": round(cSD, 4),
 293:         "cN": cN,
 294:         "source": "outcome_measurements_mean_arms",
 295:     }
 296: 
 297: 
 298: def main():
 299:     ncts = portfolio_ncts()
 300:     print(f"Portfolio NCTs: {len(ncts):,}")
 301:     print("Loading outcomes.txt for primary-outcome ids...")
 302:     primary = load_primary_outcome_ids(ncts)
 303:     print(f"  primary outcome_id known for: {len(primary):,} NCTs")
 304:     print("Loading outcome_analyses.txt (pre-computed effects)...")
 305:     pre = load_pre_computed_analyses(ncts, primary)
 306:     print(f"  pre-computed analyses: {len(pre):,}")
 307:     print("Loading outcome_measurements.txt (per-arm means)...")
 308:     arms = load_per_arm_means(ncts, primary)
 309:     print(f"  per-arm Mean rows for: {len(arms):,} NCTs")
 310:     print("Loading baseline_counts.txt...")
 311:     bn = load_baseline_n(ncts)
 312:     print(f"  baseline N for: {len(bn):,} NCTs")
 313: 
 314:     final: dict[str, dict] = {}
 315:     # 1. Use pre-computed analyses where available.
 316:     final.update(pre)
 317:     # 2. Fall back to per-arm Mean+SD compute.
 318:     n_md_from_arms = 0
 319:     for nct, rows in arms.items():
 320:         if nct in final:
 321:             continue
 322:         md = compute_md_from_arms(rows, bn.get(nct, {}))
 323:         if md:
 324:             final[nct] = md
 325:             n_md_from_arms += 1
 326: 
 327:     print(f"\nFinal continuous-outcome NCTs: {len(final):,}")
 328:     print(f"  from outcome_analyses : {sum(1 for v in final.values() if v['source']=='outcome_analyses'):,}")
 329:     print(f"  from arm Mean+SD      : {n_md_from_arms:,}")
 330:     from collections import Counter
 331:     print(f"  estimandType breakdown: {Counter(v['kind'] for v in final.values())}")
 332: 
 333:     out_path = OUT / "nct_continuous.json"
 334:     out_path.write_text(json.dumps(final), encoding="utf-8")
 335:     print(f"wrote {out_path} ({out_path.stat().st_size:,} bytes)")
 336: 
 337: 
 338: if __name__ == "__main__":
 339:     main()

