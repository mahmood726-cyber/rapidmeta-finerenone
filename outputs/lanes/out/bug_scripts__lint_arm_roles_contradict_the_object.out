 170:             treats = [str(a.get("label") or "") for a in arms
 171:                       if a.get("role") == "treatment"]
 172:             ctrls = [str(a.get("label") or "") for a in arms if a.get("role") == "control"]
 173:             if not treats or not ctrls:
 174:                 trials_unread += 1
 175:                 continue
 176: 
 177:             # A -- a treatment arm that is a placebo, and a control arm that is not.
 178:             for lab in treats:
 179:                 if PLACEBO.search(lab) and not any(PLACEBO.search(c) for c in ctrls):
 180:                     a_hits.append((topic, nct, lab, " / ".join(ctrls)))
 181: 
 182:             # B -- the name names a comparator the control arm does not carry.
 183:             for m in VS.finditer(name):
 184:                 have = set()
 185:                 for c in ctrls:
 186:                     have |= words(c)
 187:                 if PLACEBO.search(m.group(1)):
 188:                     # The name says the comparator was a placebo.
 189:                     if any(PLACEBO.search(c) for c in ctrls):
 190:                         continue
 191:                     b_hits.append((topic, nct, name, " / ".join(ctrls),
 192:                                    "a placebo, and no control arm is one"))
 193:                     break
 194:                 named = words(m.group(1))
 195:                 if not named:
 196:                     continue
 197:                 if not (named & have):
 198:                     b_hits.append((topic, nct, name, " / ".join(ctrls),
 199:                                    ", ".join(sorted(named))))
 200:                     break
 201: 
 202:             # C -- both arms name the same agent and nothing is a placebo.
 203:             if any(PLACEBO.search(x) for x in treats + ctrls):
 204:                 continue
 205:             # A DECLARED STRATEGY CONTRAST IS NOT A MISLABELLING. cryptococcal-meningitis's
 206:             # COAT row gives both arms antiretroviral therapy and says so in the label --
 207:             # "started four weeks after randomisation ... the trial's control strategy".
 208:             # The shared drug is the POINT of that comparison, not evidence against it.
 209:             if any(CARE.search(c) for c in ctrls):
 210:                 continue
 211:             shared = set()
 212:             for c in ctrls:
 213:                 for tr in treats:
 214:                     shared |= (drug_tokens(c)[0] & drug_tokens(tr)[0])
 215:             if shared:
 216:                 cs = set()
 217:                 for c in ctrls:
 218:                     cs |= drug_tokens(c)[0]
 219:                 if cs and cs <= shared:
 220:                     c_hits.append((topic, nct, " / ".join(treats), " / ".join(ctrls),
 221:                                    ", ".join(sorted(shared))))
 222: 
 223:     return a_hits, b_hits, c_hits, topics, trials_seen, trials_unread
 224: 
 225: 
 226: def collect():
 227:     """Stable keys for the ratchet: topic/nct/class."""
 228:     a, b, c, _t, _s, _u = scan()
 229:     keys = ["%s/%s/A" % (h[0], h[1]) for h in a]
 230:     keys += ["%s/%s/B" % (h[0], h[1]) for h in b]
 231:     keys += ["%s/%s/C" % (h[0], h[1]) for h in c]
 232:     return sorted(keys)
 233: 
 234: 
 235: def main():
 236:     verbose = "--verbose" in sys.argv
 237:     a_hits, b_hits, c_hits, topics, trials_seen, trials_unread = scan()
 238: 
 239:     print("ARM ROLES CONTRADICTED BY THE OBJECT'S OWN FIELDS")
 240:     print("%d topics, %d trials with both roles readable, %d UNREAD (no arms or one role "
 241:           "only)" % (topics, trials_seen, trials_unread))
 242:     print("UNREAD IS NOT CLEAN. Nothing below was asked of those %d." % trials_unread)
 243: 
 244:     print("")
 245:     print("A -- A TREATMENT ARM WHOSE LABEL IS A PLACEBO (%d)" % len(a_hits))
 246:     print("    A placebo is not an intervention. If the effect was stored in the direction")
 247:     print("    these roles imply, its SIGN IS INVERTED.")
 248:     for topic, nct, lab, ctrl in a_hits:
 249:         print("    %s  %s" % (topic, nct))
 250:         print("        treatment %r  control %r" % (lab, ctrl))
 251: 
 252:     print("")
 253:     print("B -- THE TRIAL NAME NAMES A COMPARATOR THE CONTROL ARM DOES NOT (%d)"
 254:           % len(b_hits))
 255:     for topic, nct, name, ctrl, named in b_hits:
 256:         print("    %s  %s" % (topic, nct))
 257:         print("        name    %r" % name)
 258:         print("        control %r  -- the name says %s" % (ctrl, named))
 259: 
 260:     print("")
 261:     print("C -- BOTH ARMS NAME THE SAME AGENT AND NEITHER IS A PLACEBO (%d)" % len(c_hits))
 262:     print("    A dose, schedule or duration contrast -- or a mislabelling. Either way it is")
 263:     print("    not a drug-against-comparator row and must not be pooled with ones that are.")
 264:     for topic, nct, tr, ctrl, shared in c_hits:
 265:         print("    %s  %s   [%s in both]" % (topic, nct, shared))
 266:         print("        treatment %r" % tr)
 267:         print("        control   %r" % ctrl)
 268: 
 269:     total = len(a_hits) + len(b_hits) + len(c_hits)
 270:     print("")
 271:     print("%d contradictions across %d readable trials. NOTHING IS CORRECTED HERE -- a role "
 272:           "swap" % (total, trials_seen))
 273:     print("changes what the object says a trial did, and on the sign-bearing ones that is a")
 274:     print("published-number decision.")
 275: 
 276: 
 277: if __name__ == "__main__":
 278:     if "--prove" in sys.argv:
 279:         prove()
 280:     else:
 281:         main()
 282:         ratchet(collect(), gate="--gate" in sys.argv)

codex
Defects found:

- **Merged-cell/off-by-one count**: line 169.  
  Exact input at `ssot/demo/demo.json`: `{"inputs":{"trials":[{"nct":"NCT1","arms":[{"role":"treatment","label":"Drug"}]}]}}`  
  Consequence: `scan()` returns `trials_seen=1` and `trials_unread=1`, so the printed “trials with both roles readable” count includes a trial without both roles.

- **Selector keyed to one `vs` form**: lines 66 and 183-197.  
  Exact input: `{"inputs":{"trials":[{"nct":"NCT2","name":"Trial (placebo vs DrugX)","arms":[{"role":"treatment","label":"DrugX"},{"role":"control","label":"Placebo"}]}]}}`  
  Consequence: B flags this as missing comparator `drugx` even though the control comparator is present on the left side of `vs`.

- **Negation dropped**: lines 64 and 179.  
  Exact input: `{"inputs":{"trials":[{"nct":"NCT3","arms":[{"role":"treatment","label":"not placebo DrugA"},{"role":"control","label":"DrugB"}]}]}}`  
  Consequence: A reports a placebo treatment arm even though the label explicitly negates placebo.

- **Zero conflated with absent**: line 163.  
  Exact input: `{"inputs":{"trials":[{"id":0,"arms":[{"role":"treatment","label":"Placebo"},{"role":"control","label":"DrugB"}]}]}}`  
  Consequence: the hit key becomes `topic/?/A` instead of preserving `0`, so distinct records can collapse into the same ratchet key.

COULD NOT DETERMINE for C’s drug-token selector: missing `audit_mixed_contrast_pools.real_tokens` and `CARE`.

