  82:     if n == 0: return txt, False
  83:     return txt[:body_start] + new_body + txt[body_end:], True
  84: 
  85: 
  86: def null_key(txt, nct):
  87:     nulled = f"NULLED:{nct}"
  88:     if nulled in txt: return txt, 0
  89:     pat = re.compile(r'(["\'])(' + re.escape(nct) + r')(\1)(\s*:)')
  90:     new_txt, n = pat.subn(
  91:         lambda m: f'{m.group(1)}NULLED:{m.group(2)}{m.group(3)}{m.group(4)}', txt)
  92:     return new_txt, n
  93: 
  94: 
  95: # Load all trial data
  96: all_trials = []  # list of (review, nct, trial_dict)
  97: for json_p in sorted(DATA.glob("*.json")):
  98:     if json_p.name.startswith("_"): continue
  99:     rv = json_p.stem
 100:     try: d = json.loads(json_p.read_text(encoding="utf-8"))
 101:     except: continue
 102:     rd = d.get("realData") or {}
 103:     if not isinstance(rd, dict): continue
 104:     for nct, t in rd.items():
 105:         if not isinstance(t, dict): continue
 106:         if nct.startswith("NULLED:"): continue
 107:         all_trials.append((rv, nct, t))
 108: 
 109: print(f"Total trials: {len(all_trials)}")
 110: 
 111: # Helper: numeric extraction
 112: def f(v):
 113:     try:
 114:         return float(v) if v is not None else None
 115:     except: return None
 116: 
 117: 
 118: def i(v):
 119:     try:
 120:         return int(v) if v is not None else None
 121:     except: return None
 122: 
 123: 
 124: # â”€â”€â”€â”€â”€â”€â”€ C1: Direction inconsistent â”€â”€â”€â”€â”€â”€â”€
 125: def check_c1():
 126:     findings = []
 127:     for rv, nct, t in all_trials:
 128:         et = (t.get("estimandType") or "").upper()
 129:         if et not in ("OR", "RR", "HR"): continue
 130:         tE, tN, cE, cN = (i(t.get("tE")), i(t.get("tN")),
 131:                            i(t.get("cE")), i(t.get("cN")))
 132:         hr = f(t.get("publishedHR"))
 133:         if not all(v is not None for v in (tE, tN, cE, cN, hr)): continue
 134:         if tN <= 0 or cN <= 0: continue
 135:         if cE == 0 or tE == 0: continue  # zero cells need correction; skip
 136:         if hr <= 0: continue
 137:         rate_t = tE / tN; rate_c = cE / cN
 138:         if rate_c <= 0: continue
 139:         crude_rr = rate_t / rate_c
 140:         log_crude = math.log(crude_rr); log_hr = math.log(hr)
 141:         # Both directions must be non-trivial AND opposite-signed
 142:         if abs(log_crude) > 0.10 and abs(log_hr) > 0.10:
 143:             if (log_crude > 0) != (log_hr > 0):
 144:                 findings.append({
 145:                     "check": "C1_DIRECTION_INCONSISTENT",
 146:                     "review": rv, "nct": nct,
 147:                     "crude_RR": round(crude_rr, 3),
 148:                     "publishedHR": hr,
 149:                     "log_crude": round(log_crude, 3),
 150:                     "log_hr": round(log_hr, 3),
 151:                     "fix": "NULL_HR_AND_CI",
 152:                 })
 153:     return findings
 154: 
 155: 
 156: # â”€â”€â”€â”€â”€â”€â”€ C2: Copy-paste arms â”€â”€â”€â”€â”€â”€â”€
 157: def check_c2():
 158:     findings = []
 159:     tuple_index = defaultdict(list)  # (tE,tN,cE,cN) â†’ [(rv, nct, hr)]
 160:     for rv, nct, t in all_trials:
 161:         tE, tN, cE, cN = (i(t.get("tE")), i(t.get("tN")),
 162:                            i(t.get("cE")), i(t.get("cN")))
 163:         if not all(v is not None and v > 0 for v in (tN, cN)): continue
 164:         # Require all 4 present; skip pure single-arm
 165:         if tE is None or cE is None: continue
 166:         # Skip tiny-N tuples (likely coincidence)
 167:         if tN < 30 or cN < 30: continue
 168:         tuple_index[(tE, tN, cE, cN)].append((rv, nct, f(t.get("publishedHR"))))
 169: 
 170:     for tup, occurrences in tuple_index.items():
 171:         if len(occurrences) < 2: continue
 172:         # Distinct NCTs only (multi-review for same NCT is normal)
 173:         ncts = {o[1] for o in occurrences}
 174:         if len(ncts) < 2: continue
 175:         # First (review, nct) alphabetically keeps; others flagged
 176:         occurrences.sort()
 177:         keeper = occurrences[0]
 178:         for rv, nct, hr in occurrences[1:]:
 179:             if nct == keeper[1]: continue
 180:             findings.append({
 181:                 "check": "C2_COPY_PASTE_ARMS",
 182:                 "review": rv, "nct": nct,
 183:                 "tuple": list(tup),
 184:                 "keeper": {"review": keeper[0], "nct": keeper[1]},
 185:                 "fix": "NULL_HR_AND_CI",
 186:             })
 187:     return findings
 188: 
 189: 
 190: # â”€â”€â”€â”€â”€â”€â”€ C3: Consecutive NCT runs â”€â”€â”€â”€â”€â”€â”€
 191: def check_c3():
 192:     findings = []
 193:     by_review = defaultdict(list)
 194:     for rv, nct, t in all_trials:
 195:         m = re.match(r"NCT(\d{8})$", nct)
 196:         if not m: continue
 197:         by_review[rv].append((int(m.group(1)), nct))
 198:     for rv, lst in by_review.items():
 199:         lst.sort()
 200:         # Find runs of â‰¥3 consecutive integers
 201:         run = [lst[0]] if lst else []
 202:         for j in range(1, len(lst)):
 203:             if lst[j][0] == lst[j-1][0] + 1:
 204:                 run.append(lst[j])
 205:             else:
 206:                 if len(run) >= 3:
 207:                     for _, n in run:
 208:                         findings.append({
 209:                             "check": "C3_CONSECUTIVE_NCT",
 210:                             "review": rv, "nct": n,
 211:                             "run_length": len(run),
 212:                             "fix": "NULL_PMID",
 213:                         })
 214:                 run = [lst[j]]
 215:         if len(run) >= 3:
 216:             for _, n in run:
 217:                 findings.append({
 218:                     "check": "C3_CONSECUTIVE_NCT",
 219:                     "review": rv, "nct": n,
 220:                     "run_length": len(run),
 221:                     "fix": "NULL_PMID",
 222:                 })
 223:     return findings
 224: 
 225: 
 226: # â”€â”€â”€â”€â”€â”€â”€ C4: CI asymmetry â”€â”€â”€â”€â”€â”€â”€
 227: def check_c4():
 228:     findings = []
 229:     for rv, nct, t in all_trials:
 230:         et = (t.get("estimandType") or "").upper()
 231:         if et not in ("OR", "RR", "HR"): continue
 232:         hr, lci, uci = f(t.get("publishedHR")), f(t.get("hrLCI")), f(t.get("hrUCI"))
 233:         if not all(v is not None and v > 0 for v in (hr, lci, uci)): continue
 234:         if not (lci < hr < uci): continue  # let other check handle
 235:         log_hr = math.log(hr); log_lci = math.log(lci); log_uci = math.log(uci)
 236:         upper_half = log_uci - log_hr
 237:         lower_half = log_hr - log_lci
 238:         if upper_half <= 0 or lower_half <= 0: continue
 239:         ratio = max(upper_half / lower_half, lower_half / upper_half)
 240:         if ratio > 5:
 241:             findings.append({
 242:                 "check": "C4_CI_ASYMMETRY",
 243:                 "review": rv, "nct": nct,
 244:                 "hr": hr, "lci": lci, "uci": uci,
 245:                 "log_asymmetry_ratio": round(ratio, 2),
 246:                 "fix": "NULL_CI",
 247:             })
 248:     return findings
 249: 
 250: 
 251: # â”€â”€â”€â”€â”€â”€â”€ C5: Year vs NCT era â”€â”€â”€â”€â”€â”€â”€
 252: NCT_ERA_LOWER_BOUND_YEAR = {
 253:     "01": 2009, "02": 2013, "03": 2016, "04": 2019, "05": 2022, "06": 2024,
 254: }
 255: NCT_ERA_UPPER_BOUND_YEAR = {
 256:     "01": 2018, "02": 2022, "03": 2025, "04": 2026, "05": 2026, "06": 2026,
 257: }
 258: def check_c5():
 259:     findings = []
 260:     for rv, nct, t in all_trials:
 261:         year = i(t.get("year"))
 262:         if year is None or year < 1990 or year > 2030: continue
 263:         m = re.match(r"NCT(\d{2})\d{6}$", nct)
 264:         if not m: continue
 265:         prefix = m.group(1)
 266:         lower = NCT_ERA_LOWER_BOUND_YEAR.get(prefix)
 267:         upper = NCT_ERA_UPPER_BOUND_YEAR.get(prefix)
 268:         if not lower or not upper: continue
 269:         # NCT prefix gives a registration era; publication is typically 2-7 years later
 270:         # Allow generous window: year >= lower - 1
 271:         if year < lower - 1:
 272:             findings.append({
 273:                 "check": "C5_YEAR_NCT_ERA",
 274:                 "review": rv, "nct": nct, "year": year,
 275:                 "expected_year_range": [lower, upper + 8],
 276:                 "fix": "NULL_YEAR",
 277:             })
 278:         elif year > upper + 8:
 279:             findings.append({
 280:                 "check": "C5_YEAR_NCT_ERA",
 281:                 "review": rv, "nct": nct, "year": year,
 282:                 "expected_year_range": [lower, upper + 8],
 283:                 "fix": "NULL_YEAR",
 284:             })
 285:     return findings
 286: 
 287: 
 288: # â”€â”€â”€â”€â”€â”€â”€ C6: Within-review name duplicate â”€â”€â”€â”€â”€â”€â”€
 289: def check_c6():
 290:     findings = []
 291:     by_review_name = defaultdict(list)
 292:     for rv, nct, t in all_trials:
 293:         name = (t.get("name") or "").strip()
 294:         if not name or len(name) < 3: continue
 295:         # Skip generic/placeholder names
 296:         if re.match(r"NCT\d|Study|Trial \d|Phase \d|C\d{3}|N0\d", name): continue
 297:         by_review_name[(rv, name)].append(nct)
 298:     for (rv, name), ncts in by_review_name.items():
 299:         if len(set(ncts)) < 2: continue
 300:         # Multiple NCTs same name in same review â€” suspicious
 301:         # Keep lowest-NCT, flag others
 302:         sorted_ncts = sorted(ncts)
 303:         keeper = sorted_ncts[0]
 304:         for nct in sorted_ncts[1:]:
 305:             if nct == keeper: continue
 306:             findings.append({
 307:                 "check": "C6_NAME_DUPLICATE",
 308:                 "review": rv, "nct": nct, "name": name,
 309:                 "keeper_nct": keeper,
 310:                 "fix": "NULL_KEY",
 311:             })
 312:     return findings
 313: 
 314: 
 315: # Run all checks
 316: all_findings = []
 317: for chk in [check_c1, check_c2, check_c3, check_c4, check_c5, check_c6]:
 318:     all_findings.extend(chk())
 319: 
 320: from collections import Counter
 321: by_check = Counter(f["check"] for f in all_findings)
 322: print(f"\nFindings by check:")
 323: for c, n in by_check.most_common():
 324:     print(f"  {c}: {n}")
 325: 
 326: 
 327: # Apply fixes
 328: log = []
 329: n_hr = n_pmid = n_key = n_ci = n_year = 0
 330: # dedupe per (review, nct, fix) â€” same trial may be hit by multiple checks
 331: seen = set()
 332: for finding in all_findings:
 333:     rv, nct, fix = finding["review"], finding["nct"], finding["fix"]
 334:     key = (rv, nct, fix)
 335:     if key in seen: continue
 336:     seen.add(key)
 337:     html_path = HERE / f"{rv}.html"
 338:     if not html_path.exists():
 339:         log.append({**finding, "status": "FILE_MISSING"})
 340:         continue
 341:     txt = html_path.read_text(encoding="utf-8")
 342: 
 343:     if fix == "NULL_HR_AND_CI":
 344:         block = find_block(txt, nct)
 345:         if not block:
 346:             log.append({**finding, "status": "BLOCK_NOT_FOUND"})
 347:             continue
 348:         _, _, bs, be = block
 349:         for fld in ("publishedHR", "hrLCI", "hrUCI"):
 350:             new_txt, ok = null_field_in_block(txt, bs, be, fld)
 351:             if ok:
 352:                 txt = new_txt
 353:                 block = find_block(txt, nct)
 354:                 if not block: break
 355:                 _, _, bs, be = block
 356:         if not DRY: html_path.write_text(txt, encoding="utf-8")
 357:         log.append({**finding, "status": "NULLED_HR_CI"})
 358:         n_hr += 1
 359:     elif fix == "NULL_PMID":
 360:         block = find_block(txt, nct)
 361:         if not block:
 362:             log.append({**finding, "status": "BLOCK_NOT_FOUND"})
 363:             continue
 364:         _, _, bs, be = block
 365:         new_txt, ok = null_field_in_block(txt, bs, be, "pmid")
 366:         if ok:
 367:             if not DRY: html_path.write_text(new_txt, encoding="utf-8")
 368:             log.append({**finding, "status": "NULLED_PMID"})
 369:             n_pmid += 1
 370:         else:
 371:             log.append({**finding, "status": "PMID_ALREADY_NULL"})
 372:     elif fix == "NULL_KEY":
 373:         new_txt, n = null_key(txt, nct)
 374:         if n > 0:
 375:             if not DRY: html_path.write_text(new_txt, encoding="utf-8")
 376:             log.append({**finding, "status": "NULLED_KEY"})
 377:             n_key += 1
 378:         elif f"NULLED:{nct}" in txt:
 379:             log.append({**finding, "status": "ALREADY_NULLED"})
 380:     elif fix == "NULL_CI":
 381:         block = find_block(txt, nct)
 382:         if not block:
 383:             log.append({**finding, "status": "BLOCK_NOT_FOUND"})
 384:             continue
 385:         _, _, bs, be = block
 386:         for fld in ("hrLCI", "hrUCI"):
 387:             new_txt, ok = null_field_in_block(txt, bs, be, fld)
 388:             if ok:
 389:                 txt = new_txt
 390:                 block = find_block(txt, nct)
 391:                 if not block: break
 392:                 _, _, bs, be = block
 393:         if not DRY: html_path.write_text(txt, encoding="utf-8")
 394:         log.append({**finding, "status": "NULLED_CI"})
 395:         n_ci += 1
 396:     elif fix == "NULL_YEAR":
 397:         block = find_block(txt, nct)
 398:         if not block:
 399:             log.append({**finding, "status": "BLOCK_NOT_FOUND"})
 400:             continue
 401:         _, _, bs, be = block
 402:         new_txt, ok = null_field_in_block(txt, bs, be, "year")
 403:         if ok:
 404:             if not DRY: html_path.write_text(new_txt, encoding="utf-8")
 405:             log.append({**finding, "status": "NULLED_YEAR"})
 406:             n_year += 1
 407: 
 408: out_p = OUT / "r6_internal_consistency.json"
 409: out_p.write_text(json.dumps({"findings": all_findings, "fixes": log,
 410:                               "counts": {"HR_CI_nulls": n_hr, "PMID_nulls": n_pmid,
 411:                                          "NCT_key_nulls": n_key, "CI_nulls": n_ci,
 412:                                          "year_nulls": n_year}},
 413:                              indent=2, ensure_ascii=False), encoding="utf-8")
 414: 
 415: print(f"\n{'DRY-RUN ' if DRY else ''}Fixes applied:")
 416: print(f"  HR+CI nulls (C1, C2):   {n_hr}")
 417: print(f"  PMID nulls (C3):        {n_pmid}")
 418: print(f"  NCT key nulls (C6):     {n_key}")
 419: print(f"  CI-only nulls (C4):     {n_ci}")
 420: print(f"  Year nulls (C5):        {n_year}")
 421: print(f"\nLog â†’ {out_p}")

codex
- **instrument reading a different copy than changed**: lines 97 and 337. Exact input: `outputs/extraction_audit/data/a.json` contains `{"realData":{"NCT00000001":{"estimandType":"HR","tE":20,"tN":100,"cE":5,"cN":100,"publishedHR":0.5,"hrLCI":0.3,"hrUCI":0.8}}}`, while `a.html` contains `"NCT00000001": {"publishedHR": 0.5, "hrLCI": 0.3, "hrUCI": 0.8}` but no arm counts. Consequence: the predicate is proven on JSON data but the mutation is applied to a separate HTML copy that may not contain the contradiction.

- **idempotency guard satisfied by its own marker/comment**: line 88. Exact input to `null_key`: `txt='<!-- NULLED:NCT00000002 -->\n"NCT00000002": {"publishedHR": 1.2}'`, `nct='NCT00000002'`. Consequence: it returns without renaming the live key, and line 378 can report `ALREADY_NULLED` even though the work was not done.

- **status code reporting wrapper rather than work**: lines 338-340. Exact input: the JSON above named `missing.html`’s review stem, with no corresponding `missing.html` file. Consequence: the fix failure is only logged as `FILE_MISSING`; the script still writes an audit file and exits zero.

- **status/count reporting wrapper rather than work**: lines 356-358. Exact input: JSON data triggers C1 for `NCT00000001`, but `a.html` has `"NCT00000001": {"publishedHR": null, "hrLCI": null, "hrUCI": null}`. Consequence: zero fields change, yet the log says `NULLED_HR_CI` and `HR_CI_nulls` increments.

- **check that cannot fail**: line 101. Exact input: `outputs/extraction_audit/data/bad.json` containing `{`. Consequence: a malformed extraction file is silently skipped, so the audit can report fewer or zero trials with exit zero.

No proven CRLF/LF text-compare defect.  
No proven merged-cell/off-by-one tabulation defect.  
No proven negation-dropped sentence parsing defect.  
No proven selector-keyed-to-unused-corpus-form defect without the HTML/data corpus.
