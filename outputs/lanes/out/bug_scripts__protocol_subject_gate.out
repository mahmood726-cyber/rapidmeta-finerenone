 156: 
 157: def object_vocabulary(canon) -> set:
 158:     blob = json.dumps(canon, ensure_ascii=False).lower()
 159:     return set(w.lower() for w in WORD.findall(blob))
 160: 
 161: 
 162: def page_title(html: str) -> str:
 163:     m = re.search(r"<title[^>]*>(.*?)</title>", html, re.S | re.I)
 164:     return re.sub(r"\s+", " ", m.group(1)) if m else ""
 165: 
 166: 
 167: def check(page_path: str, canon):
 168:     html = io.open(page_path, encoding="utf-8", errors="replace").read()
 169:     text = visible(html)
 170:     claims = protocol_claims(text)
 171:     if not claims:
 172:         return ("NOT_APPLICABLE",
 173:                 "this page declares no protocol subject fields, so there is no "
 174:                 "protocol prose to check. Not a pass", [])
 175: 
 176:     own = object_vocabulary(canon)
 177:     # THE PAGE'S OWN TITLE IS THE SECOND WITNESS. A thin object can lack its own
 178:     # subject word; a page's <title> does not. Contamination requires the prose to
 179:     # disagree with BOTH.
 180:     title_words = set(w.lower() for w in WORD.findall(page_title(html)))
 181:     findings, thin = [], []
 182:     for field, value in claims:
 183:         words = [w.lower() for w in WORD.findall(value)]
 184:         content = [w for w in words if w not in STOP]
 185:         foreign = [w for w in content if w not in own]
 186:         if len(content) < MIN_CONTENT:
 187:             continue
 188:         share = len(foreign) / float(len(content))
 189:         if share < FOREIGN_SHARE or len(foreign) < MIN_FOREIGN:
 190:             continue
 191:         # does the field share ANY content word with the page's own title?
 192:         shared_with_title = [w for w in content if w in title_words]
 193:         if shared_with_title:
 194:             thin.append((field, value, foreign, share, shared_with_title))
 195:         else:
 196:             findings.append((field, value, foreign, share))
 197:     if findings:
 198:         return ("FAIL",
 199:                 "a declared protocol subject field shares NO content word with this "
 200:                 "page's own title and almost none with its object -- the prose is "
 201:                 "about a different review", findings)
 202:     if thin:
 203:         return ("REVIEW",
 204:                 "the protocol prose names THIS page's subject (it agrees with the "
 205:                 "page title) but the OBJECT does not contain those words. That is a "
 206:                 "thin object, not contamination, and it is a different defect",
 207:                 [(f, v, fo, sh) for f, v, fo, sh, _ in thin])
 208:     return ("PASS",
 209:             "every declared protocol subject field shares content vocabulary with "
 210:             "this object", [])
 211: 
 212: 
 213: def _pairs():
 214:     pm_path = os.path.join(REPO, "ssot", "PAGE_MAP.json")
 215:     pairs = []
 216:     if os.path.exists(pm_path):
 217:         for page, obj in json.load(io.open(pm_path, encoding="utf-8")).items():
 218:             p, o = os.path.join(REPO, page), os.path.join(REPO, obj)
 219:             if os.path.exists(p) and os.path.exists(o):
 220:                 pairs.append((p, o))
 221:     # objects with a same-stem page but no PAGE_MAP entry are checked too: the
 222:     # contaminated page is one of those, and a screen that only reads PAGE_MAP
 223:     # would have missed the case it was built for.
 224:     for o in sorted(glob.glob(os.path.join(REPO, "ssot", "*", "*.json"))):
 225:         if os.path.basename(o)[:-5] != os.path.basename(os.path.dirname(o)):
 226:             continue
 227:         stem = os.path.basename(o)[:-5].upper().replace("-", "_")
 228:         for cand in glob.glob(os.path.join(REPO, stem + "*.html")):
 229:             if (cand, o) not in pairs and os.path.exists(cand):
 230:                 pairs.append((cand, o))
 231:     return pairs
