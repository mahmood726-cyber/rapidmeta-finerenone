 126:                     "Funding Source", "Conflicts of Interest", "Contributor Roles",
 127:                     "AI Assistance Disclosure", "Secondary Outcomes", "Subgroup Plan",
 128:                     "Criterion", "Study Design", "Database", "Phase", "Participants",
 129:                     "Publication", "Outcomes", "Follow-up")
 130: _NEXT = re.compile("|".join(re.escape(x) for x in sorted(_LABELS, key=len, reverse=True)))
 131: 
 132: 
 133: def protocol_claims(text: str):
 134:     """(field, value) for each declared subject field found in the rendered text.
 135: 
 136:     A value ends at the next LABEL, whatever its length. And a "value" that is
 137:     itself only a label is discarded: in the PICO table the four headers sit
 138:     adjacent because their values are in another row, and reading them as each
 139:     other's values is how the first cut of this screen passed a contaminated page.
 140:     """
 141:     out = []
 142:     for f in FIELDS:
 143:         m = re.search(re.escape(f) + r"\s+", text)
 144:         if not m:
 145:             continue
 146:         rest = text[m.end():m.end() + 600]
 147:         nxt = _NEXT.search(rest)
 148:         val = (rest[:nxt.start()] if nxt else rest).strip(" .;:|")
 149:         if len(val) < 4:
 150:             continue
 151:         if _NEXT.fullmatch(val.strip()):
 152:             continue                      # the value IS a label -- table layout
 153:         out.append((f, val))
 154:     return out
