import os,sys,json,io
repo=os.getcwd(); ssot=os.path.join(repo,'ssot'); sys.path.insert(0,ssot)
import paper_projector as PP
reader=('abstract','introduction','discussion','conclusions'); MIN=60
for name in sorted(os.listdir(ssot)):
    fp=os.path.join(ssot,name,name+'.json')
    if not os.path.exists(fp): continue
    try: obj=json.load(io.open(fp,encoding='utf-8'))
    except Exception: continue
    if not ((obj.get('results') or {}).get('by_outcome')): continue
    try: secs=PP.project(obj)
    except Exception: continue
    by={getattr(s,'key',None):s for s in secs}
    bad=[]; missed=[]
    for key in reader:
        s=by.get(key)
        if s is None:
            bad.append((key,'absent')); continue
        words=sum(len(str(t).split()) for t,_ in s.paras)
        if s.refusals and not s.paras: bad.append((key,'refused'))
        elif words<MIN: bad.append((key,f'{words} words'))
        if s.refusals and words>=MIN:
            missed.append((key,words,len(s.refusals)))
    if missed and not bad:
        print('FALSE_NEG_TOPIC',name,missed); raise SystemExit
print('NO_FALSE_NEG_TOPIC')
