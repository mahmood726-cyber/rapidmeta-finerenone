 124: 
 125: def observe(path):
 126:     """What the built page actually carries: slots, drawn, declined, sections."""
 127:     html = io.open(path, encoding="utf-8", errors="replace").read()
 128:     p = panel_of(html)
 129:     blocks = FIG_RE.findall(p)
 130:     drawn = len([b for b in blocks if FOREST_RE.search(b) or "<svg" in b])
 131:     declined = [b for b in blocks if "<svg" not in b]
 132:     reasoned = len([b for b in declined if "not drawn." in b])
 133:     return {"slots": len(blocks), "drawn": drawn, "declined": len(declined),
 134:             "declined_with_reason": reasoned,
 135:             "sections": len(re.findall(r"(?i)<h3", p))}
