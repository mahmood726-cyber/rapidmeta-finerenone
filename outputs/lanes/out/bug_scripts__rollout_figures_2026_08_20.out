 106: 
 107: def is_clean(page):
 108:     """Are this page's bytes on disk exactly what is committed?"""
 109:     r = sh(["git", "status", "--porcelain", "--", page])
 110:     return not r.stdout.decode("utf-8", "replace").strip()
