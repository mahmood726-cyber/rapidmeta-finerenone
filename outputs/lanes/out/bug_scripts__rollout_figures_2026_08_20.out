 202:     todo = [n for n in sorted(led["predicted"])
 203:             if n not in led["done"] and n not in led["failed"]]
 204:     print("REMAINING %d of %d; this batch %d"
 205:           % (len(todo), len(led["predicted"]), min(size, len(todo))))
 206:     batch = todo[:size]
 207:     if not batch:
 208:         print("NOTHING LEFT. done %d, failed %d" % (len(led["done"]), len(led["failed"])))
 209:         return 0
 210: 
 211:     for name in batch:
 212:         page = os.path.join(REPO, name)
 213:         pr = led["predicted"][name]
 214:         topic = pr["topic"]
 215: 
 216:         # CLASS 70, BAKED IN. Build from the last KNOWN-GOOD COMMITTED copy, never from
