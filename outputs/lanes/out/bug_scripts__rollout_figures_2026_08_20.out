 116: 
 117: def panel_of(html):
 118:     i = html.find('id="pn-paper"')
 119:     if i < 0:
 120:         return ""
 121:     j = html.find('<section class="panel"', i + 10)
 122:     return html[i:j if j > 0 else len(html)]
