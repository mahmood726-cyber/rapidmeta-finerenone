 189:                 continue
 190:             pr["topic"] = topic
 191:             led["predicted"][name] = pr
 192:         save_ledger(led)
 193:         print("ROLLOUT PLANNED: %d pages, %d skipped by name or resolution"
 194:               % (len(led["predicted"]), len(led["skipped"])))
 195:         tot_d = sum(v["drawn"] for v in led["predicted"].values())
 196:         tot_s = sum(v["slots"] for v in led["predicted"].values())
 197:         print("PREDICTED ACROSS THE ROLLOUT: %d figure slots, %d forests drawn, %d declined"
 198:               % (tot_s, tot_d, tot_s - tot_d))
 199:         if "--plan" in sys.argv:
