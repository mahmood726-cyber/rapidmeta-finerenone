 138: def predict(topic):
 139:     """From the OBJECT, before the build. Returns None if the object cannot be read."""
 140:     path = os.path.join(SSOT, topic, "%s.json" % topic)
 141:     try:
 142:         obj = json.load(io.open(path, encoding="utf-8"))
 143:     except Exception:
 144:         return None
 145:     figs = []
 146:     for s in ppj.project(obj):
 147:         if getattr(s, "key", None) == "figures":
 148:             figs = list(getattr(s, "figures", []))
 149:     drawn = len([f for f in figs if f[2]])
 150:     has_outcome = bool(((obj.get("results") or {}).get("by_outcome") or {}))
 151:     return {"slots": len(figs), "drawn": drawn, "declined": len(figs) - drawn,
 152:             "has_outcome": has_outcome}
