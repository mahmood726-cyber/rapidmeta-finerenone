 136: 
 137: def clone(config, dry=False):
 138:     base = config['base']
 139:     out = config['out']
 140:     if not os.path.exists(base):
 141:         raise SystemExit(f'base file not found: {base}')
 142: 
 143:     # Read base (no actual file copy yet â€” we'll write the modified version directly)
 144:     src = open(base, 'r', encoding='utf-8').read()
 145:     log = []
 146: 
 147:     # Title
 148:     src = re.sub(r'<title>[^<]+</title>',
 149:                  f"<title>{config['title']}</title>", src, count=1)
 150:     log.append('  [APPLIED]          title')
 151: 
 152:     # Hero h2
 153:     if 'hero_h2' in config:
 154:         src = re.sub(r'(<div class="va-header"><h2[^>]*>)[^<]+(</h2>)',
 155:                      lambda m: m.group(1) + config['hero_h2'] + m.group(2), src, count=1)
 156:         log.append('  [APPLIED]          hero_h2')
 157: 
 158:     # NYT headline
 159:     if 'nyt_headline' in config:
 160:         src = re.sub(r'(<h3 class="nyt-headline[^>]*>)[^<]+(</h3>)',
 161:                      lambda m: m.group(1) + config['nyt_headline'] + m.group(2), src, count=1)
 162:         log.append('  [APPLIED]          nyt_headline')
 163: 
 164:     # AUTO_INCLUDE
 165:     if 'auto_include_ncts' in config:
 166:         new_set = ', '.join(f"'{n}'" for n in config['auto_include_ncts'])
 167:         src = re.sub(r"AUTO_INCLUDE_TRIAL_IDS\s*=\s*new\s+Set\(\[[^\]]*\]\)",
 168:                      f"AUTO_INCLUDE_TRIAL_IDS = new Set([{new_set}])", src, count=1)
 169:         log.append('  [APPLIED]          AUTO_INCLUDE_TRIAL_IDS')
 170: 
 171:     # nctAcronyms
 172:     if 'nct_acronyms' in config:
 173:         new_map = ', '.join(f"'{n}': '{js_escape(a)}'" for n, a in config['nct_acronyms'].items())
 174:         src = re.sub(r"nctAcronyms:\s*\{[^}]*\}",
 175:                      f"nctAcronyms: {{ {new_map} }}", src, count=1)
 176:         log.append('  [APPLIED]          nctAcronyms')
 177: 
 178:     # localStorage keys
 179:     if 'localstorage_old' in config and 'localstorage_new' in config:
 180:         n = src.count(config['localstorage_old'])
 181:         src = src.replace(config['localstorage_old'], config['localstorage_new'])
 182:         log.append(f'  [APPLIED:{n}]        localStorage keys')
 183: 
 184:     # PICO state.protocol. Tolerant of single- OR double-quoted values: the
 185:     # original base used single quotes (pop:'...'), the minified base uses
 186:     # double quotes (pop:"..."). Each field's quote char is captured and the
 187:     # replacement value is escaped for that exact delimiter.
 188:     if 'pico' in config:
 189:         p = config['pico']
 190:         # field-value: opening quote (group), then any escaped char or
 191:         # non-delimiter char, then the matching closing quote (backref).
 192:         def fld(key, qgrp):
 193:             return rf"(\s*,?\s*{key}:\s*)(['\"])(?:\\.|(?!\{qgrp}).)*\{qgrp}"
 194:         proto_re = re.compile(
 195:             r"(protocol:\s*\{\s*pop:\s*)(['\"])(?:\\.|(?!\2).)*\2"
 196:             + fld("int", 4) + fld("comp", 6) + fld("out", 8) + fld("subgroup", 10),
 197:             re.DOTALL,
 198:         )
 199: 
 200:         def _esc(val, q):
 201:             return val.replace('\\', '\\\\').replace(q, '\\' + q)
 202: 
 203:         def repl(m):
 204:             pre = [m.group(1), m.group(3), m.group(5), m.group(7), m.group(9)]
 205:             q = [m.group(2), m.group(4), m.group(6), m.group(8), m.group(10)]
 206:             vals = [p['pop'], p['int'], p['comp'], p['out'], p['subgroup']]
 207:             return ''.join(
 208:                 pre[i] + q[i] + _esc(vals[i], q[i]) + q[i] for i in range(5)
 209:             )
 210:         src, n = proto_re.subn(repl, src, count=1)
 211:         log.append(f'  [APPLIED:{n}]        protocol.pico')
 212: 
 213:     # realData entries â€” replace the entire `realData: { ... }` block.
 214:     # Tolerant of a minified base (`realData:{`) as well as the original
 215:     # pretty-printed form (`realData: {`).
 216:     if 'real_data_entries' in config:
 217:         m = re.search(r'realData\s*:\s*\{', src)
 218:         if not m:
 219:             raise SystemExit('realData block not found in base')
 220:         brace = src.index('{', m.start())
 221:         depth = 0
 222:         started = False
 223:         end = -1
 224:         for j in range(brace, len(src)):
 225:             c = src[j]
 226:             if c == '{': depth += 1; started = True
 227:             elif c == '}':
 228:                 depth -= 1
 229:                 if started and depth == 0: end = j; break
 230:         new_entries = ',\n\n\n                '.join(
 231:             render_trial_entry(t) for t in config['real_data_entries'])
 232:         new_block = '{\n\n\n                ' + new_entries + '\n            }'
 233:         src = src[:brace] + new_block + src[end+1:]
 234:         log.append(f'  [APPLIED:{len(config["real_data_entries"])}]        realData entries')
 235: 
 236:     # Blank hardcoded external benchmarks (e.g. PUBLISHED_META_BENCHMARKS with
 237:     # 'BOREAS dupilumab vs placebo' estimate 0.7) â€” a false reference for any
 238:     # other topic. Per-topic benchmarks are not available for audit-first
 239:     # builds, so the honest value is an empty object.
 240:     if config.get('blank_benchmarks'):
 241:         # Tolerant of both the original (`const PUBLISHED_META_BENCHMARKS = {
 242:         # ...\n};`) and the minified (`,PUBLISHED_META_BENCHMARKS={...}`) forms:
 243:         # locate the identifier, then brace-scan its object literal and blank it.
 244:         bm = re.search(r"PUBLISHED_META_BENCHMARKS\s*[:=]\s*\{", src)
 245:         if bm:
 246:             obrace = src.index('{', bm.start())
 247:             depth, end = 0, -1
 248:             for j in range(obrace, len(src)):
 249:                 if src[j] == '{':
 250:                     depth += 1
 251:                 elif src[j] == '}':
 252:                     depth -= 1
 253:                     if depth == 0:
 254:                         end = j
 255:                         break
 256:             if end > 0:
 257:                 src = src[:obrace] + '{}' + src[end + 1:]
 258:                 log.append('  [APPLIED]          blank_benchmarks (PUBLISHED_META_BENCHMARKS={})')
 259:             else:
 260:                 log.append('  [SKIP_NOT_FOUND]   blank_benchmarks (unbalanced braces)')
 261:         else:
 262:             log.append('  [SKIP_NOT_FOUND]   blank_benchmarks')
 263: 
 264:     # Free-form replaces (precise, single-occurrence claim neutralizers).
 265:     # These run BEFORE global_replaces so claim-bearing strings (mechanism,
 266:     # phenotype) are neutralized to data-driven text rather than token-swapped
 267:     # into a false claim (e.g. "tezepelumab (IL-4Ralpha ...)").
 268:     for old, new in config.get('extra_replaces', []):
 269:         src = replace_one(src, old, new, f'extra_replace [{old[:40]}...]', log)
 270: 
 271:     # Global replaces â€” unconditional replace-ALL. This is the fix for the
 272:     # n>1 SKIP_AMBIGUOUS bug: residual base tokens (dupilumab, COPD, base
 273:     # localStorage key, export filenames, base trial acronyms) appear many
 274:     # times in JS string literals and MUST all be swapped. Order matters:
 275:     # longest/compound tokens first so 'dupilumab' inside 'dupilumab_copd'
 276:     # or 'rapid_meta_dupilumab_copd' is not partially clobbered.
 277:     for old, new in config.get('global_replaces', []):
 278:         n = src.count(old)
 279:         if n == 0:
 280:             log.append(f'  [SKIP_NOT_FOUND]   global [{old[:40]}]')
 281:             continue
 282:         src = src.replace(old, new)
 283:         log.append(f'  [APPLIED:{n}]        global [{old[:40]} -> {new[:30]}]')
 284: 
 285:     if not dry:
 286:         open(out, 'w', encoding='utf-8').write(src)
 287:         # Auto-minify the inline engine block. Without this, freshly cloned
 288:         # pages ship the ~1 MB unminified engine and accumulate Lighthouse
 289:         # debt until a follow-up minify pass runs. Soft-fail if Node/terser
 290:         # isn't available so the clone itself still succeeds.
 291:         _minify_engine_in_place(out, log)
 292:     return log
 293: 
 294: 
 295: def _minify_engine_in_place(path, log):
 296:     """Best-effort terser pass on the inline engine block of a cloned page.
 297:     Mirrors what scripts/minify_all_engines.mjs does for the bulk-portfolio
 298:     case. Logs success or skip; does not raise.
 299:     """
 300:     import subprocess
 301:     script = os.path.join(ROOT, 'scripts', 'minify_engine_block.mjs')
 302:     if not os.path.exists(script):
 303:         log.append('  [SKIP_MINIFY]      minify_engine_block.mjs not present')
 304:         return
 305:     node = 'node.exe' if os.name == 'nt' else 'node'
 306:     try:
 307:         proc = subprocess.run(
 308:             [node, script, path, path],  # read and write same file
 309:             capture_output=True, text=True, timeout=120,
 310:             encoding='utf-8', errors='replace',
 311:         )
 312:     except (FileNotFoundError, subprocess.TimeoutExpired) as e:
 313:         log.append(f'  [SKIP_MINIFY]      {type(e).__name__}')
 314:         return
 315:     if proc.returncode == 0:
 316:         # terser writes its stats to stderr (see minify_engine_block.mjs)
 317:         last = (proc.stderr or '').strip().splitlines()
 318:         savings = last[-2] if len(last) >= 2 else (last[0] if last else 'minified')
 319:         log.append(f'  [APPLIED]          terser: {savings[:80]}')
 320:     else:
 321:         log.append(f'  [SKIP_MINIFY]      terser rc={proc.returncode}: {(proc.stderr or "")[:100]}')
 322: 
 323: 
 324: def main():
 325:     ap = argparse.ArgumentParser()
 326:     ap.add_argument('--config', required=True)
 327:     ap.add_argument('--dry-run', action='store_true')
 328:     args = ap.parse_args()
 329:     cfg = json.loads(open(args.config, 'r', encoding='utf-8').read())
 330:     print(f'Mode: {"DRY-RUN" if args.dry_run else "APPLY"}  Config: {args.config}')
 331:     log = clone(cfg, dry=args.dry_run)
 332:     for line in log:
 333:         print(line)
 334:     print(f'Output: {cfg["out"]}')
 335: 
 336: 
 337: if __name__ == '__main__':
 338:     sys.exit(main())

codex
**Defects Found**

1. **STATUS CODE REPORTING THE WRAPPER**: lines 148-150, 154-156, 160-162, 167-169, 174-176.  
Exact input: base file `<html></html>` with config `{"base":"b.html","out":"o.html","title":"T","hero_h2":"H","nyt_headline":"N","auto_include_ncts":["NCT1"],"nct_acronyms":{"NCT1":"A"}}`.  
Consequence: every replacement logs `[APPLIED]` although zero substitutions occurred, so a gate can pass while the output is unchanged.

2. **STATUS CODE REPORTING THE WRAPPER / CHECK THAT CANNOT FAIL**: lines 127-132, 268-269, 337-338.  
Exact input: base file `<title>Old</title>` with config `{"base":"b.html","out":"o.html","title":"New","extra_replaces":[["MISSING CLAIM","replacement"]]}`.  
Consequence: a missing required neutralizer logs `[SKIP_NOT_FOUND]` but the process exits 0 because `main()` returns `None`.

3. **SELECTOR KEYED TO A FORM THE INPUT NEED NOT USE**: lines 194-211.  
Exact input: base file `<title>X</title><script>state={protocol:{int:'oldI',pop:'oldP',comp:'oldC',out:'oldO',subgroup:'oldS'}};</script>` with config `{"base":"b.html","out":"o.html","title":"Y","pico":{"pop":"newP","int":"newI","comp":"newC","out":"newO","subgroup":"newS"}}`.  
Consequence: valid JS with the same fields in a different order produces `[APPLIED:0] protocol.pico` and keeps the old PICO text.

4. **BRACE COUNT READS TEXT AS STRUCTURE**: lines 224-233.  
Exact input: base file `<title>X</title><script>const cfg={realData:{'NCT0':{name:'A',snippet:'}'},other:1},tail:2};</script>` with config `{"base":"b.html","out":"o.html","title":"Y","real_data_entries":[{"nct":"NCT1","name":"B","tN":1,"cN":1}]}`.  
Consequence: the `}` inside the string is counted as a closing brace, so only part of `realData` is replaced and the generated JS is corrupted.

5. **A NAME VS ITS BINDING**: line 115.  
Exact input: `{"nct":"NCT1","name":"Trial","tN":1,"cN":1,"ctgovUrl":"https://example.test/custom"}` inside `real_data_entries`.  
Consequence: the supplied `ctgovUrl` field is ignored and the output always emits `https://clinicaltrials.gov/study/NCT1`.

No defect proven from this packet for: probe keyed to string a fix removes, idempotency guard satisfied by own comment, CRLF/LF text compare, merged-cell tabulation, zero conflated with absent, or negation dropped.
