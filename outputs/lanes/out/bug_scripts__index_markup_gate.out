 succeeded in 1567ms:
   1: """INDEX MARKUP GATE -- is the root index's link tree well formed, and do its cards point at pages that exist?
   2: 
   3: WHY THIS EXISTS
   4:     On 2026-08-17 the FINERENONE card was superseded and a new card added beside
   5:     it. The edit rewrote the old card's <span class="pub"> text but never closed
   6:     it, so the NEW card was emitted INSIDE the old card's anchor:
   7: 
   8:         <a href="FINERENONE_REVIEW.html" ...><span class="pub">Superseded ...
   9:             <a href="FINERENONE_CV_REVIEW.html" ...>...</a></span></a>
  10: 
  11:     An <a> inside an <a> is not valid HTML and no two browsers repair it the same
  12:     way. The root index is the definition of done -- the surface Mahmood actually
  13:     checks -- and it shipped with the new card reachable only by accident.
  14: 
  15:     Worse than the defect: MY OWN VERIFICATION SAID "ABSENT" FOR THE OLD CARD AND
  16:     I ALMOST REPORTED SUCCESS ANYWAY, because the regex for the new card happened
  17:     to match the inner anchor. The check that found the new card was passing for
  18:     a reason unrelated to correctness. That is the fifth instance this week of a
  19:     check reporting success without having performed the check, and the reason
  20:     this gate tests STRUCTURE (a stack of open anchors) rather than presence.
  21: 
  22:     The repo has carried a div-balance rule for large HTML apps since long before
  23:     this. Nobody had attached the same idea to the index, which is the one file
  24:     edited by hand on nearly every deploy.
  25: 
  26: WHAT A FULL PASS DOES NOT ESTABLISH -- written in advance
  27:     - NOT that the card TEXT is true. A perfectly nested card can quote an
  28:       estimate that no longer matches the page; card_alignment_gate owns that,
  29:       and this gate passing says nothing about it.
  30:     - NOT that a page which SHOULD have a card has one. This walks the cards that
  31:       exist; it cannot see a review that was never linked.
  32:     - NOT that the linked page is correct, current, or non-superseded -- only
  33:       that the file is there to be served.
  34:     - NOT that the rest of the index's markup is valid. It checks anchor nesting
  35:       and card->file resolution, not tables, headings or scripts.
  36: """
  37: from __future__ import annotations
  38: import os, re, sys, io
  39: 
  40: # Guarded: reassigning stdout AT IMPORT closes the caller's wrapper and the
  41: # importer dies on "I/O operation on closed file" at its next print.
  42: if __name__ == "__main__":
  43:     sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
  44: 
  45: SSOT = r"F:\rapidmeta-ssot-shell"
  46: ANCHOR = re.compile(r"<a\b[^>]*>|</a\s*>", re.I)
  47: HREF = re.compile(r'href\s*=\s*["\']([^"\']+)["\']', re.I)
  48: 
  49: 
  50: SCRIPTY = re.compile(r"<(script|style)\b[^>]*>.*?</\1\s*>", re.I | re.S)
  51: 
  52: 
  53: def _markup_only(html):
  54:     """Blank out <script>/<style> bodies, PRESERVING LENGTH so reported offsets
  55:     still point into the real file. The index's own chip-injector contains the
  56:     string '<a> inside <a>' in a comment explaining why it avoids exactly this
  57:     defect -- and the first run of this gate flagged that comment as the defect.
  58:     The repo's div-balance rule has always carried the same 'exclude JS' caveat;
  59:     it had to be rediscovered here because the rule was prose, not code."""
  60:     return SCRIPTY.sub(lambda m: " " * len(m.group(0)), html)
  61: 
  62: 
  63: def nesting_faults(html):
  64:     """-> list of (offset, href_of_inner, href_of_outer) for every <a> opened
  65:     while another <a> is still open. Stack-based: a fragment test cannot see
  66:     this, because each anchor is individually well formed."""
  67:     stack, faults = [], []
  68:     for m in ANCHOR.finditer(_markup_only(html)):
  69:         tok = m.group(0)
  70:         if tok.lower().startswith("</"):
  71:             if stack:
  72:                 stack.pop()
  73:         else:
  74:             h = HREF.search(tok)
  75:             href = h.group(1) if h else "(no href)"
  76:             if stack:
  77:                 faults.append((m.start(), href, stack[-1]))
  78:             stack.append(href)
  79:     return faults, len(stack)
  80: 
  81: 
  82: def dead_cards(html, root):
  83:     """Card hrefs that resolve to no file on disk. Local targets only."""
  84:     dead = []
  85:     for m in re.finditer(r'<a\b[^>]*class\s*=\s*["\'][^"\']*\bcard\b[^"\']*["\'][^>]*>', html, re.I):
  86:         h = HREF.search(m.group(0))
  87:         if not h:
  88:             continue
  89:         u = h.group(1).split("#")[0].split("?")[0]
  90:         if not u or u.startswith(("http", "mailto:", "data:", "//")):
  91:             continue
  92:         if not os.path.exists(os.path.join(root, u.replace("/", os.sep))):
  93:             dead.append(u)
  94:     return sorted(set(dead))
  95: 
  96: 
  97: def check(path, root=None):
  98:     root = root or os.path.dirname(os.path.abspath(path))
  99:     html = open(path, encoding="utf-8", errors="replace").read()
 100:     faults, unclosed = nesting_faults(html)
 101:     dead = dead_cards(html, root)
 102:     verdict = "FAIL" if (faults or unclosed or dead) else "PASS"
 103:     return verdict, faults, unclosed, dead
 104: 
 105: 
 106: def main():
 107:     if len(sys.argv) > 1 and sys.argv[1] == "--selftest":
 108:         return selftest()
 109:     path = sys.argv[1] if len(sys.argv) > 1 else os.path.join(SSOT, "index.html")
 110:     v, faults, unclosed, dead = check(path)
 111:     print("%s" % os.path.basename(path))
 112:     print("  nested anchors : %d" % len(faults))
 113:     if len(faults) > 1:
 114:         print("      (FIX THE FIRST ONE. A single unclosed anchor makes every card after it "
 115:               "look nested; the rest of this list is cascade, not %d separate defects.)" % len(faults))
 116:     for off, inner, outer in faults[:10]:
 117:         print("      at %d  <a href=%s> opened inside <a href=%s>" % (off, inner, outer))
 118:     print("  unclosed <a>   : %d" % unclosed)
 119:     print("  dead card links: %d %s" % (len(dead), dead[:6] if dead else ""))
 120:     print("  -> %s" % v)
 121:     return 0 if v == "PASS" else 1
 122: 
 123: 
 124: def selftest():
 125:     """POSITIVE: the real 2026-08-17 defect, verbatim. NEGATIVE: the repaired
 126:     index, and a card whose target genuinely exists."""
 127:     ok = True
 128:     BROKEN = ('<div class="grid">\n'
 129:               '<a href="FINERENONE_REVIEW.html" class="card ckd"><span class="name">Finerenone (FIDELITY)'
 130:               '</span><span class="pub">Superseded &mdash; rebuilt from source as '
 131:               '<a href="FINERENONE_CV_REVIEW.html">Finerenone CV composite</a>\n'
 132:               '<a href="FINERENONE_CV_REVIEW.html" class="card ckd"><span class="name">Finerenone CV'
 133:               '</span><span class="pub">Published: HR 0.8655</span></a></span></a>\n</div>')
 134:     faults, unclosed = nesting_faults(BROKEN)
 135:     good = len(faults) == 2
 136:     ok &= good
 137:     print("  POSITIVE the real nested-card defect        -> %d nested anchor(s) %s"
 138:           % (len(faults), "correct" if good else "WRONG (expected 2)"))
 139:     for off, inner, outer in faults:
 140:         print("        <a href=%s> inside <a href=%s>" % (inner, outer))
 141: 
 142:     # Written out in full, NOT derived from BROKEN by str.replace. Deriving it
 143:     # was the first attempt and both replaces silently no-opped, so the negative
 144:     # fixture was the positive fixture and the selftest "failed" for the wrong
 145:     # reason. str.replace returns a copy whether or not it matched; a fixture
 146:     # that can quietly become a duplicate of its own opposite proves nothing.
 147:     REPAIRED = ('<div class="grid">\n'
 148:                 '<a href="FINERENONE_REVIEW.html" class="card ckd"><span class="name">Finerenone (FIDELITY)'
 149:                 '</span><span class="pub">Superseded &mdash; rebuilt from source as Finerenone CV composite'
 150:                 '</span></a>\n'
 151:                 '<a href="FINERENONE_CV_REVIEW.html" class="card ckd"><span class="name">Finerenone CV'
 152:                 '</span><span class="pub">Published: HR 0.8655</span></a>\n</div>')
 153:     assert REPAIRED != BROKEN, "negative fixture is identical to the positive one"
 154:     faults2, unclosed2 = nesting_faults(REPAIRED)
 155:     good2 = not faults2
 156:     ok &= good2
 157:     print("  NEGATIVE the same cards, correctly closed   -> %d nested anchor(s) %s"
 158:           % (len(faults2), "correct" if good2 else "WRONG"))
 159: 
 160:     live = os.path.join(SSOT, "index.html")
 161:     if os.path.exists(live):
 162:         v, f, u, d = check(live)
 163:         ok &= v == "PASS"
 164:         print("  NEGATIVE the live root index                -> %-4s %s"
 165:               % (v, "correct" if v == "PASS" else "WRONG: nested=%d unclosed=%d dead=%s" % (len(f), u, d[:4])))
 166: 
 167:     print("\nWHAT A FAILURE WOULD LOOK LIKE: the nested-card defect passing, which is "
 168:           "exactly what shipped to the root index and what my own presence-regex "
 169:           "reported as fine; or the repaired index failing, because a gate nobody "
