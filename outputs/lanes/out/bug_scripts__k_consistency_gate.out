  82: 
  83: # Paths whose strings are NOT this review speaking: other papers' titles, quoted
  84: # assessor rationales, handbook section text, and the correction log, which
  85: # records superseded claims verbatim and must keep saying what it used to say.
  86: EXCLUDE = (".screening.corpus", ".screening.dual_screening", ".sources",
  87:            ".rob2", ".methodological_authority", ".claims_corrected",
  88:            ".citations", ".reconciliation", ".registration", ".protocol",
  89:            ".prisma_items", ".count_recovery", ".attestations",
  90:            ".eligible_but_not_contributing", ".outcomes_considered",
  91:            # The comparison section quotes ANOTHER review verbatim -- "A total of
  92:            # nine studies", "1,066 studies" -- and those counts are theirs, not
  93:            # ours. Reconciling them against our k would demand we misquote the
  94:            # paper we are auditing. The R blocks are captured metafor output and
  95:            # print their own k, which is checked separately and far more strictly
  96:            # by the agreement gate in add_r_output.py.
  97:            # Exempted DELIBERATELY: both were already passing by accident of the
  98:            # bare-noun rule, and an exemption that holds by accident stops holding
  99:            # the moment someone writes "nine included trials" in one of them.
 100:            ".published_comparison", ".r_output",
 101:            ".results.by_outcome.cvdeath_or_hfh_first.r_output")
 102: # Strings that deliberately narrate the k change itself.
 103: HISTORY = ("_stale", "recomputed", "superseded", "k=3", "k = 3", "at k=3")
 104: 
 105: 
 106: def _num(tok):
 107:     tok = tok.lower()
 108:     return NUMWORDS.get(tok) or (int(tok) if tok.isdigit() else None)
 109: 
 110: 
 111: def textual_k_problems(strings, k):
 112:     """strings: iterable of (location, text). Returns (failures, for_review)."""
 113:     fails, review = [], []
 114:     for loc, txt in strings:
 115:         # startswith is not enough: r_output is nested under the outcome, so the
 116:         # path is .results.by_outcome.<id>.r_output and no prefix would match it.
 117:         if any(p in loc for p in EXCLUDE):
 118:             continue
 119:         low = (txt or "").lower()
 120:         if any(h in low for h in HISTORY):
 121:             continue
 122:         for m in K_ASSERT.finditer(txt or ""):
 123:             v = _num(m.group(1))
 124:             if v is None:
 125:                 continue
 126:             # A subset phrase starting at the same number is not a k assertion.
 127:             seg = txt[m.start():m.start() + 60]
 128:             if K_SUBSET.match(seg):
 129:                 if v != k:
 130:                     review.append((loc, m.group(0).strip(), v))
 131:                 continue
 132:             # "one trial carries most of the weight", "rests on any one trial",
 133:             # "a discrepancy in one trial" -- singular emphasis, which is how a
 134:             # dominant-study argument is written, not a claim that the review
 135:             # contains one study. This is what the first cut of the negative
 136:             # self-test caught: the gate failed a document whose every count was
 137:             # correct, which is a regression in its own right.
 138:             noun = (m.group(3) or "").lower()
 139:             if v == 1 and not noun.endswith("s"):
 140:                 continue
 141:             if not m.group(2):
 142:                 # Bare "three trials" -- only enforced where the review states
 143:                 # its own scope. Elsewhere it is usually about someone else's.
 144:                 if not any(s in loc for s in (".title", ".question",
 145:                                               ".manuscript", "definition_note",
 146:                                               "decision_under_test",
 147:                                               "::<title>", "::h1")):
 148:                     continue
 149:             if v != k:
 150:                 fails.append((loc, m.group(0).strip(), v))
 151:     return fails, review
 152: 
 153: 
 154: def check_outcome(oid, res):
 155:     """Returns a list of problem strings. Empty means consistent."""
 156:     bad = []
 157:     per = res.get("per_trial") or []
 158:     k = res.get("k") or len(per)
 159:     if not k:
 160:         return bad
 161: 
 162:     pan = res.get("panels") or {}
 163:     stale = bool(pan.get("_STALE"))
 164:     fit = pan.get("fit") or {}
 165:     if fit.get("k") is not None and fit["k"] != k and not stale:
 166:         bad.append("%s: panels.fit.k=%s but the outcome has k=%s"
 167:                    % (oid, fit["k"], k))
 168:     for name in ROW_PER_TRIAL:
 169:         rows = pan.get(name)
 170:         if isinstance(rows, list) and rows and len(rows) != k and not stale:
 171:             bad.append("%s: panels.%s has %d rows for k=%s"
 172:                        % (oid, name, len(rows), k))
 173: 
 174:     cp = res.get("count_panels") or {}
 175:     cstale = bool(cp.get("_STALE"))
 176:     for meas in ("rr", "or", "rd"):
 177:         m = cp.get(meas)
 178:         if isinstance(m, dict) and m.get("k") is not None and m["k"] != k \
 179:                 and not cstale:
 180:             bad.append("%s: count_panels.%s.k=%s but the outcome has k=%s"
 181:                        % (oid, meas, m["k"], k))
 182: 
 183:     # The pooled interval and the prose must agree about the null. This is the
 184:     # part that changes a reader's conclusion rather than a figure's row count.
 185:     p = res.get("pooled") or {}
 186:     lo, hi = p.get("ci_low"), p.get("ci_high")
 187:     null = 1.0
 188:     if lo is not None and hi is not None:
 189:         includes = lo <= null <= hi
 190:         blob = json.dumps(res.get("_prose", "")) if res.get("_prose") else ""
 191:         if includes and "excludes the null" in blob:
 192:             bad.append("%s: pooled interval %s-%s contains the null but the "
 193:                        "prose says it excludes it" % (oid, lo, hi))
 194:     return bad
 195: 
 196: 
 197: def check_object(path):
 198:     d = json.load(open(path, encoding="utf-8"))
 199:     bad = []
 200:     for oid, res in ((d.get("results") or {}).get("by_outcome") or {}).items():
 201:         bad += check_outcome(oid, res)
 202:     # The manuscript is prose ABOUT the pool, so it is checked against the pool.
 203:     ms = json.dumps(d.get("manuscript") or {}, ensure_ascii=False)
 204:     for oid, res in ((d.get("results") or {}).get("by_outcome") or {}).items():
 205:         p = res.get("pooled") or {}
 206:         lo, hi = p.get("ci_low"), p.get("ci_high")
 207:         if lo is not None and hi is not None and lo <= 1.0 <= hi \
 208:                 and "excludes the null" in ms:
 209:             bad.append("%s: pooled interval %.4g-%.4g contains the null but the "
 210:                        "manuscript says it excludes it" % (oid, lo, hi))
 211:         break
 212: 
 213:     # Textual k, across every string this review speaks in its own voice.
 214:     k = None
 215:     for _oid, res in ((d.get("results") or {}).get("by_outcome") or {}).items():
 216:         k = res.get("k") or len(res.get("per_trial") or [])
 217:         break
 218:     if k:
 219:         fails, _rev = textual_k_problems(walk_strings(d), k)
 220:         for loc, frag, v in fails:
 221:             bad.append("%s states %r (k=%s) but the pool has k=%d"
 222:                        % (loc, frag, v, k))
 223:     return bad
 224: 
 225: 
 226: def walk_strings(o, path=""):
 227:     if isinstance(o, dict):
 228:         for kk, v in o.items():
 229:             yield from walk_strings(v, path + "." + str(kk))
 230:     elif isinstance(o, list):
 231:         for i, v in enumerate(o):
 232:             yield from walk_strings(v, path + "[%d]" % i)
 233:     elif isinstance(o, str):
 234:         yield path, o
 235: 
 236: 
 237: def selftest():
 238:     """A gate that cannot fail is not a gate. These must all be CAUGHT."""
 239:     cases = [
 240:         ("panels stale at k=3 under a k=4 pool",
 241:          {"results": {"by_outcome": {"o": {
 242:              "k": 4, "per_trial": [1, 2, 3, 4],
 243:              "pooled": {"ci_low": 0.7, "ci_high": 1.02},
 244:              "panels": {"fit": {"k": 3},
 245:                         "leave_one_out": [1, 2, 3]}}}}}, True),
 246:         ("count_panels stale at k=3",
 247:          {"results": {"by_outcome": {"o": {
 248:              "k": 4, "per_trial": [1, 2, 3, 4],
 249:              "pooled": {"ci_low": 0.7, "ci_high": 1.02},
 250:              "count_panels": {"rr": {"k": 3}}}}}}, True),
 251:         ("prose says excludes-null while the interval contains it",
 252:          {"results": {"by_outcome": {"o": {
 253:              "k": 2, "per_trial": [1, 2],
 254:              "pooled": {"ci_low": 0.7, "ci_high": 1.02}, "panels": {}}}},
 255:           "manuscript": {"d": "the interval excludes the null"}}, True),
 256:         ("consistent object",
 257:          {"results": {"by_outcome": {"o": {
 258:              "k": 4, "per_trial": [1, 2, 3, 4],
 259:              "pooled": {"ci_low": 0.7, "ci_high": 1.02},
 260:              "panels": {"fit": {"k": 4}, "leave_one_out": [1, 2, 3, 4]}}}},
 261:           "manuscript": {"d": "the interval contains the null"}}, False),
 262:         ("stale but DECLARED -- a stated limitation, not a silent one",
 263:          {"results": {"by_outcome": {"o": {
 264:              "k": 4, "per_trial": [1, 2, 3, 4],
 265:              "pooled": {"ci_low": 0.7, "ci_high": 1.02},
 266:              "panels": {"_STALE": "computed at k=3, recorded",
 267:                         "fit": {"k": 3}, "leave_one_out": [1, 2, 3]}}}}}, False),
 268: 
 269:         # --- textual k. The positive is the REAL title that shipped. ---------
 270:         ("POSITIVE: the actual title that shipped saying three over a k=4 pool",
 271:          {"title": "Sacubitril/valsartan against enalapril in heart failure "
 272:                    "with reduced ejection fraction: the three randomised "
 273:                    "trials that report cardiovascular death or heart failure "
 274:                    "hospitalization as a time-to-first hazard ratio",
 275:           "results": {"by_outcome": {"o": {"k": 4, "per_trial": [1, 2, 3, 4],
 276:                                            "pooled": {"ci_low": .7, "ci_high": 1.02}}}}},
 277:          True),
 278:         ("POSITIVE: digits rather than a number-word",
 279:          {"title": "a pooled analysis of 3 randomised trials",
 280:           "results": {"by_outcome": {"o": {"k": 4, "per_trial": [1, 2, 3, 4],
 281:                                            "pooled": {"ci_low": .7, "ci_high": 1.02}}}}},
 282:          True),
 283:         # --- THE NEGATIVE. This is the criterion that keeps getting skipped: a
 284:         # gate that fires on correct prose is its own regression. Everything
 285:         # here is TRUE at k=4 and must not be flagged: the corrected title, a
 286:         # subset phrase, a singular emphasis, and unrelated counts of things
 287:         # that are not trials.
 288:         ("NEGATIVE: corrected title + subsets + unrelated threes must all PASS",
 289:          {"title": "the four randomised trials that report the composite",
 290:           "manuscript": {
 291:               "a": "The three smaller trials are individually compatible with "
 292:                    "no effect, and one trial carries most of the weight.",
 293:               "b": "Omitting the largest leaves three remaining trials.",
 294:               "c": "Three protocol commits are recorded, and the same 2x2 is "
 295:                    "shown on three scales across three GRADE domains.",
 296:               "d": "the interval contains the null"},
 297:           "results": {"by_outcome": {"o": {"k": 4, "per_trial": [1, 2, 3, 4],
 298:                                            "pooled": {"ci_low": .7, "ci_high": 1.02}}}}},
 299:          False),
 300:         ("NEGATIVE: 'below about ten studies' is a threshold, not a count",
 301:          {"title": "the four randomised trials that report the composite",
 302:           "manuscript": {"a": "the Handbook advises against interpreting these "
 303:                               "tests below about ten studies, and with fewer "
 304:                               "than five trials the test has no power"},
 305:           "results": {"by_outcome": {"o": {
 306:               "k": 4, "per_trial": [1, 2, 3, 4],
 307:               "pooled": {"ci_low": .7, "ci_high": 1.02}}}}}, False),
 308:         ("NEGATIVE: 'both phase 3 trials' is a phase, not a count",
 309:          {"title": "both phase 3 trials, reported as incidence rate ratios",
 310:           "question": "In the two phase 3 trials that supported approval",
 311:           "results": {"by_outcome": {"o": {
 312:               "k": 2, "per_trial": [1, 2],
 313:               "pooled": {"ci_low": .7, "ci_high": 1.02}}}}}, False),
 314:         ("NEGATIVE: another paper's title in the screening corpus is not ours",
 315:          {"title": "the four randomised trials that report the composite",
 316:           "screening": {"corpus": [{"title": "A meta-analysis of 6 randomized "
 317:                                              "trials in heart failure"}]},
 318:           "results": {"by_outcome": {"o": {"k": 4, "per_trial": [1, 2, 3, 4],
 319:                                            "pooled": {"ci_low": .7, "ci_high": 1.02}}}}},
 320:          False),
 321:     ]
 322:     ok = True
 323:     print("=== the gate must FAIL on a silent k mismatch, and PASS otherwise ===")
 324:     import tempfile
 325:     import os
 326:     for name, obj, expect_fail in cases:
 327:         fd, p = tempfile.mkstemp(suffix=".json")
 328:         os.close(fd)
 329:         json.dump(obj, open(p, "w", encoding="utf-8"))
 330:         got = bool(check_object(p))
 331:         os.unlink(p)
 332:         good = got == expect_fail
 333:         ok &= good
 334:         print("  %-52s %s expected=%s %s"
 335:               % (name, "FAIL" if got else "PASS",
 336:                  "FAIL" if expect_fail else "PASS",
 337:                  "correct" if good else "WRONG"))
 338:     print("\nk-consistency gate proved able to fail on every silent mismatch:", ok)
 339:     return 0 if ok else 1
 340: 
 341: 
 342: if __name__ == "__main__":
 343:     if "--selftest" in sys.argv:
 344:         raise SystemExit(selftest())
 345:     paths = [a for a in sys.argv[1:] if not a.startswith("-")]
 346:     if not paths:
 347:         raise SystemExit("usage: k_consistency_gate.py <object.json> ...")
 348:     problems = 0
 349:     for p in paths:
 350:         b = check_object(p)
 351:         problems += len(b)
 352:         print("%s: %s" % (p, "CONSISTENT" if not b else "%d PROBLEM(S)" % len(b)))
 353:         for x in b:
 354:             print("   -", x)
 355:     raise SystemExit(1 if problems else 0)

