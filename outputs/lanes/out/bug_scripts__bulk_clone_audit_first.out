  24: # ----------------------------------------------------------------------------
  25: # AACT-derived enrichment maps. Built upstream by
  26: # `scripts/audit_40_checks.py` workflow (or any equivalent NCT loader). Used to
  27: # (a) inject a verified primary PMID per NCT (prevents the "wrong abstract"
  28: #     defect produced by the topic_doc.pmid field, which was historically
  29: #     unverifiable -- see commit 4917069b8); and
  30: # (b) produce a defensible RoB-2 heuristic from registry design metadata,
  31: #     replacing the all-'low' stub that previously shipped on every trial.
  32: # Files may be missing on a fresh clone; we degrade gracefully.
  33: # ----------------------------------------------------------------------------
  34: _PMID_PATH = HERE / "outputs" / "pmid_resolver" / "nct_to_pmid.json"
  35: _DESIGN_PATH = HERE / "outputs" / "pmid_resolver" / "nct_design.json"
  36: NCT_PMID = json.loads(_PMID_PATH.read_text(encoding="utf-8")) if _PMID_PATH.exists() else {}
  37: NCT_DESIGN = json.loads(_DESIGN_PATH.read_text(encoding="utf-8")) if _DESIGN_PATH.exists() else {}
  38: 
  39: 
  40: 
  41: def _arm_order(per_arm):
  42:     """Group labels ordered TREATMENT FIRST by what the label says, not by the alphabet.
  43: 
  44:     AACT's per-arm map carries no role, so the label is all there is. A label naming a control
  45:     is put SECOND explicitly; where neither label says, the order is left as given and the
  46:     written object must carry `role` for anything downstream to trust it. Sorting was the bug:
  47:     `BG_CONTROL` < `BG_EXPERIMENTAL`, and the effect inverts silently.
  48:     """
  49:     import sys as _s, os as _o
  50:     _s.path.insert(0, _o.path.join(_o.path.dirname(_o.path.dirname(_o.path.abspath(__file__))),
  51:                                    "ssot"))
  52:     from arm_roles import CONTROL as _CTRL
  53:     keys = list(per_arm.keys())
  54:     ctrl = [k for k in keys if any(w in str(k).lower() for w in _CTRL)]
  55:     rest = [k for k in keys if k not in ctrl]
  56:     return rest + ctrl if ctrl else keys
  57: 
  58: 
  59: def _rob_from_aact(nct: str) -> tuple[list[str], str]:
  60:     """Return (5-domain RoB-2 list, source-attribution string).
  61: 
  62:     See scripts/enrich_trials_with_aact_design.py for the same logic; we
  63:     inline it here so a fresh portfolio regeneration produces correctly-coded
  64:     RoB from the start.
  65:     """
  66:     d = NCT_DESIGN.get(nct)
  67:     if not d:
  68:         return ["some-concerns"] * 5, "no AACT design record"
  69:     alloc = d.get("allocation") or ""
  70:     masking = d.get("masking") or ""
  71:     assess = (d.get("outcomes_assessor_masked") or "").lower()
  72:     d1 = "low" if alloc == "RANDOMIZED" else ("high" if alloc == "NON_RANDOMIZED" else "some-concerns")
  73:     if masking in ("QUADRUPLE", "TRIPLE", "DOUBLE"):
  74:         d2 = "low"
  75:     elif masking == "SINGLE":
  76:         d2 = "some-concerns"
  77:     elif masking == "NONE":
  78:         d2 = "high"
  79:     else:
  80:         d2 = "some-concerns"
  81:     d3 = "some-concerns"  # missing data can't be judged from the registry alone
  82:     if assess == "true" or masking in ("QUADRUPLE", "TRIPLE", "DOUBLE"):
  83:         d4 = "low"
  84:     elif masking == "SINGLE":
  85:         d4 = "some-concerns"
  86:     elif masking == "NONE":
  87:         d4 = "high"
  88:     else:
  89:         d4 = "some-concerns"
  90:     d5 = "some-concerns"  # selective-reporting needs cross-check against the publication
  91:     src = f"AACT designs: alloc={alloc or 'âˆ…'}, masking={masking or 'âˆ…'}, assessor_masked={assess or 'âˆ…'}"
  92:     return [d1, d2, d3, d4, d5], src
  93: 
  94: 
  95: def _safe_event_count(raw: int | None, N: int | None) -> int | None:
  96:     """Sanity-check an AACT-derived event count.
  97: 
  98:     The upstream `outputs/new_topics/<STEM>.json` files store the AACT
  99:     outcome_measurements `param_value` cast via `int(float(v))`. That's fine
 100:     when the value is genuinely a count, but AACT also stores percentages and
 101:     continuous-outcome values in the same column. We have no `param_type` to
 102:     discriminate at this layer, so we use a value-vs-N sanity check:
 103:         raw <= N           -> keep (real count)
 104:         N < raw <= 100     -> AACT stored a percentage; recover round(raw/100*N)
 105:         raw > 100          -> not a percentage either; null and the analysis
 106:                               engine will drop the trial from pooling
 107:     """
 108:     if raw is None or N is None or N <= 0:
 109:         return raw
 110:     if raw <= N:
 111:         return raw
 112:     if 0 < raw <= 100:
 113:         return round(raw / 100 * N)
 114:     return None
 115: 
 116: # A small, stable, simple base â€” DUPILUMAB_COPD is 1.2 MB with 2-trial pairwise
 117: # structure. Re-used as the base for audit-first clones; per-topic data
 118: # replaces all per-trial content via clone_dashboard.py's existing logic.
 119: BASE_TEMPLATE = HERE / "DUPILUMAB_COPD_REVIEW.html"
 120: 
 121: # Don't re-clone if output already exists and is recent
 122: SKIP_IF_EXISTS = True
 123: 
 124: 
 125: # Chars that are JS string delimiters or HTML-breaking. Injected drug/
 126: # condition names land in BOTH HTML text nodes and single/double-quoted JS
 127: # string literals, so the only universally safe form swaps the delimiter
 128: # characters for typographic look-alikes (render fine in HTML, inert in JS).
 129: # Without this, a condition like "Crohn's Disease" -> '...CROHN'S...' is a
 130: # JS SyntaxError that the leftover scanner would still pass (lessons.md
 131: # apostrophe-in-single-quoted-JS-string, 2026-04-30).
 132: _SAFE_MAP = {
 133:     "'": "â€™",   # ' -> right single quote
 134:     '"': "â€",   # " -> right double quote
 135:     "`": "Ê¼",   # backtick -> modifier letter apostrophe
 136:     "\\": "/",
 137:     "<": "â€¹",   # < -> single left-pointing angle quote
 138:     ">": "â€º",
 139:     "\r": " ", "\n": " ", "\t": " ",
 140: }
 141: 
 142: 
 143: def safe(s: str) -> str:
 144:     """Make a string safe to inject into HTML text AND quoted JS literals."""
 145:     return "".join(_SAFE_MAP.get(ch, ch) for ch in str(s))
 146: 
