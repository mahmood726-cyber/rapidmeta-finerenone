 148: def build_config(topic_doc):
 149:     topic = topic_doc["topic"]
 150:     stem = safe(topic["stem"])
 151:     name = safe(topic["name"])
 152:     drug = safe((topic["drug_patterns"] or ["intervention"])[0].title())
 153:     cond = safe((topic["condition_patterns"] or ["condition"])[0].title())
 154: 
 155:     trials = []
 156:     ncts = []
 157:     acrs = {}
 158:     for t in topic_doc["trials"]:
 159:         if not all(t["gates"].values()):
 160:             continue
 161:         ex = t["extracted"]
 162:         nct = ex["nct"]
 163:         acr = ex.get("aact_acronym") or nct
 164:         # ARM ROLE IS READ, NEVER SORTED. `sorted(per_arm.keys())[0]` took the
 165:         # lexicographically first label as the treatment arm, and `BG_CONTROL` sorts
 166:         # before `BG_EXPERIMENTAL` -- every effect built that way inverts. AACT's
 167:         # per-arm map is keyed by group label with no role, so this source cannot
 168:         # answer the question and the order is recorded rather than trusted: the
 169:         # written object must carry `role` on each arm, and `ssot/arm_roles.py`
 170:         # refuses any caller that tries to infer it from position.
 171:         per_arm = ex.get("aact_per_arm_counts") or {}
 172:         arms = _arm_order(per_arm)
 173:         tN = per_arm.get(arms[0]) if arms else 0
 174:         cN = per_arm.get(arms[1]) if len(arms) > 1 else 0
 175:         _arm_labels = list(arms[:2])
 176:         outcome_rows = ex.get("aact_outcome_count_rows") or []
 177:         og_vals = {}
 178:         for og, v in outcome_rows:
 179:             if og not in og_vals:
 180:                 try: og_vals[og] = int(float(v))
 181:                 except: pass
 182:             if len(og_vals) >= 2: break
 183:         # SAME SHAPE, SAME DEFECT: the outcome-group order decides which count is the
 184:         # treatment arm, and sorting it alphabetically is the identical coin-flip.
 185:         ogs = _arm_order(og_vals)
 186:         tE_raw = og_vals.get(ogs[0]) if ogs else None
 187:         cE_raw = og_vals.get(ogs[1]) if len(ogs) > 1 else None
 188:         # Apply the percentage-vs-count sanity check at GENERATION time so the
 189:         # shipped page never carries impossible counts (tE > tN). This is the
 190:         # root-cause fix for the bug repaired downstream by
 191:         # `scripts/fix_event_counts_safe.py` -- see commit 4d8476d5d.
 192:         tE = _safe_event_count(tE_raw, tN)
 193:         cE = _safe_event_count(cE_raw, cN)
 194: 
 195:         pub_es = ex.get("published_effect_size")
 196:         pub_t = ex.get("published_effect_type")
 197:         pub_lci = ex.get("published_ci_lower")
 198:         pub_uci = ex.get("published_ci_upper")
 199: 
 200:         outcome_label = (ex.get("aact_primary_outcome_measure") or "Primary outcome")[:120]
 201:         outcome_obj = {
 202:             "shortLabel": "MACE",
 203:             "title": outcome_label + " (primary)",
 204:             "type": "PRIMARY",
 205:             "matchScore": 90,
 206:         }
 207:         if pub_es is not None:
 208:             outcome_obj["estimandType"] = pub_t or "OR"
 209:             if pub_t == "MD":
 210:                 outcome_obj["md"] = pub_es
 211:             else:
 212:                 outcome_obj["effect"] = pub_es
 213:                 if pub_lci is not None: outcome_obj["lci"] = pub_lci
 214:                 if pub_uci is not None: outcome_obj["uci"] = pub_uci
 215:         else:
 216:             outcome_obj["estimandType"] = "OR"
 217:             if tE is not None: outcome_obj["tE"] = tE
 218:             if cE is not None: outcome_obj["cE"] = cE
 219: 
 220:         # Resolve a verified primary PMID from the AACT study_references map.
 221:         # Picking the smallest RESULT/DERIVED PMID per NCT yields the trial's
 222:         # original primary publication (oldest = first to be PubMed-indexed).
 223:         # The topic_doc.pmid field is corpus-wide unreliable and is NOT used.
 224:         pmid_info = NCT_PMID.get(nct) or {}
 225:         pmid_val = pmid_info.get("pmid", "")
 226: 
 227:         rob5, rob_src = _rob_from_aact(nct)
 228: 
 229:         trial_entry = {
 230:             "nct": nct,
 231:             "name": acr,
 232:             "pmid": pmid_val,
 233:             "phase": "III",
 234:             "year": ex.get("pubmed_year") or 2024,
 235:             "tE": tE, "tN": tN or 0, "cE": cE, "cN": cN or 0,
 236:             "group": f"{drug} vs comparator in {cond} (AACT-verified primary)",
 237:             "publishedHR": pub_es if pub_t in ("HR","OR","RR","IRR") else None,
 238:             "hrLCI": pub_lci if pub_t in ("HR","OR","RR","IRR") else None,
 239:             "hrUCI": pub_uci if pub_t in ("HR","OR","RR","IRR") else None,
 240:             "allOutcomes": [outcome_obj],
 241:             "rob": rob5,
 242:             "robSource": rob_src,
 243:             "snippet": f"NCT {nct}: {outcome_label}. Source: ClinicalTrials.gov registry (AACT-verified); publication resolved live via NCT.",
 244:             "sourceUrl": f"https://clinicaltrials.gov/study/{nct}",
 245:             "evidence": [],
 246:         }
 247:         trials.append(trial_entry)
 248:         ncts.append(nct)
 249:         acrs[nct] = acr
 250: 
 251:     if not trials:
 252:         return None
 253: 
 254:     drug_l = drug.lower()
 255:     cond_u = cond.upper()
 256:     stem_l = stem.lower()
 257:     pop_txt = f"Adults randomised in trials registered on ClinicalTrials.gov for {cond}"
 258:     # PICO outcome shown in the editable `#p-out` field + meta strings. Derive
 259:     # from the first included trial's primary-outcome title (strip the
