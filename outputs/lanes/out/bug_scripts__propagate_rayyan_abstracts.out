 182: def migrate(text: str) -> tuple[str, list[str]]:
 183:     """Atomic: returns (migrated_text, statuses). If any edit fails, the ORIGINAL
 184:     text is returned unchanged so we never write a partially-migrated file.
 185:     Both the input and the patch strings are LF-normalised so CRLF files match."""
 186:     statuses = []
 187:     if HYDRATOR_MARKER in text:
 188:         return text, ["skip: already-migrated (AbstractHydrator present)"]
 189: 
 190:     # Remember the original line-ending so we can restore it after the replacements.
 191:     original_uses_crlf = "\r\n" in text
 192:     work = text.replace("\r\n", "\n") if original_uses_crlf else text
 193: 
 194:     # Variant detection: apps with the toggle pattern get VARIANT A; those
 195:     # without (older, simpler template) get VARIANT B. Detect by the toggle's
 196:     # distinctive leading comment.
 197:     has_toggle = "/* Full abstract toggle (Task 6: D2) */" in work
 198: 
 199:     if has_toggle:
 200:         edit_sequence = (
 201:             ("edit1-hydrator-namespace",   EDIT1_OLD,  EDIT1_NEW),
 202:             ("edit2-init-hook",            EDIT2_OLD,  EDIT2_NEW),
 203:             ("edit3a-toggle-variables",    EDIT3A_OLD, EDIT3A_NEW),
 204:             ("edit3b-inline-markup",       EDIT3B_OLD, EDIT3B_NEW),
 205:         )
 206:         variant = "A"
 207:     else:
 208:         # Variant B: no toggle to remove, just tighten the render tag.
 209:         edit_sequence = (
 210:             ("edit1-hydrator-namespace",   EDIT1_OLD,          EDIT1_NEW),
 211:             ("edit2-init-hook",            EDIT2_OLD,          EDIT2_NEW),
 212:             ("edit3b-p-to-div-preline",    VARB_P_OLD,         VARB_P_NEW),
 213:         )
 214:         variant = "B"
 215: 
 216:     statuses.append(f"variant={variant}")
 217: 
 218:     scratch = work
 219:     for label, old, new in edit_sequence:
 220:         hit = scratch.count(old)
 221:         if hit != 1:
 222:             return text, statuses + [f"fail: {label} marker matched {hit} times (expected 1)"]
 223:         scratch = scratch.replace(old, new, 1)
 224:         statuses.append(f"{label}: OK")
 225: 
 226:     migrated = scratch.replace("\n", "\r\n") if original_uses_crlf else scratch
 227:     return migrated, statuses
 228: 
 229: 
 230: def process(path: pathlib.Path, dry_run: bool) -> tuple[str, list[str], str | None]:
 231:     """Read file, migrate, write if !dry_run. Return (path_str, statuses, diff_or_None)."""
 232:     original = path.read_text(encoding="utf-8", newline="")
 233:     migrated, statuses = migrate(original)
 234:     diff = None
 235:     if migrated != original:
 236:         diff = f"+{len(migrated) - len(original)} chars"
 237:         if not dry_run:
 238:             path.write_text(migrated, encoding="utf-8", newline="")
 239:     return str(path.name), statuses, diff
 240: 
 241: 
 242: def main():
 243:     ap = argparse.ArgumentParser(description=__doc__)
 244:     ap.add_argument("--dry-run", action="store_true", help="Report action without writing")
 245:     ap.add_argument("--apply", action="store_true", help="Apply changes to disk")
 246:     ap.add_argument("--file", type=str, default=None, help="Restrict to one filename (basename) under the Finrenone root")
 247:     args = ap.parse_args()
 248: 
 249:     if not (args.dry_run or args.apply):
 250:         ap.error("pass --dry-run or --apply")
 251:     if args.dry_run and args.apply:
 252:         ap.error("--dry-run and --apply are mutually exclusive")
 253: 
 254:     if args.file:
 255:         p = pathlib.Path(args.file)
 256:         # Accept either an absolute path or a basename under ROOT.
 257:         targets = [p if p.is_absolute() else (ROOT / args.file)]
 258:         if not targets[0].exists():
 259:             sys.exit(f"file not found: {targets[0]}")
 260:     else:
 261:         targets = sorted(ROOT.glob("*_REVIEW.html"))
 262: 
 263:     migrated_ok, skipped, failed = 0, 0, 0
 264:     for p in targets:
 265:         name, statuses, diff = process(p, dry_run=args.dry_run)
 266:         last = statuses[-1] if statuses else ""
 267:         if last.startswith("fail:"):
 268:             failed += 1
 269:             print(f"FAIL  {name:50s}  {last}")
 270:         elif last.startswith("skip:"):
 271:             skipped += 1
 272:             print(f"SKIP  {name:50s}  {last}")
 273:         else:
 274:             migrated_ok += 1
 275:             tag = "DRY" if args.dry_run else "APPLIED"
 276:             print(f"{tag:7s} {name:50s}  {', '.join(statuses)}  ({diff or 'no-op'})")
 277: 
 278:     total = len(targets)
 279:     print()
 280:     print(f"Summary: {total} files  |  {migrated_ok} migrate  |  {skipped} skip  |  {failed} fail  |  mode={'dry-run' if args.dry_run else 'apply'}")
 281:     if failed and args.apply:
 282:         sys.exit(1)
 283: 
 284: 
 285: if __name__ == "__main__":
 286:     main()

