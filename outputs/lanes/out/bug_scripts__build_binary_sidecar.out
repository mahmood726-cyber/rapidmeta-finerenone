  72:          66.80131188771972, -13.28068155288572]
  73:     c = [-0.007784894002430293, -0.3223964580411365, -2.400758277161838,
  74:          -2.549732539343734, 4.374664141464968, 2.938163982698783]
  75:     d = [0.007784695709041462, 0.3224671290700398, 2.445134137142996,
  76:          3.754408661907416]
  77:     plow = 0.02425
  78:     phigh = 1 - plow
  79:     if p < plow:
  80:         q = math.sqrt(-2 * math.log(p))
  81:         return ((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5] / \
  82:                ((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1)
  83:     if p > phigh:
  84:         q = math.sqrt(-2 * math.log(1 - p))
  85:         return -((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5] / \
  86:                ((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1)
  87:     q = p - 0.5
  88:     r = q*q
  89:     return (((((a[0]*r+a[1])*r+a[2])*r+a[3])*r+a[4])*r+a[5])*q / \
  90:            (((((b[0]*r+b[1])*r+b[2])*r+b[3])*r+b[4])*r+1)
  91: 
  92: 
  93: def t_quantile_975(df):
  94:     """Two-sided 97.5% t-quantile (alpha=0.025 upper tail), with df>=1.
  95:     Hill (1970) approximation; good to ~1e-4 for df>=2."""
  96:     if df <= 0:
  97:         return float('nan')
  98:     if df == 1:
  99:         return 12.7062
 100:     if df == 2:
 101:         return 4.30265
 102:     if df == 3:
 103:         return 3.18245
 104:     if df == 4:
 105:         return 2.77645
 106:     if df == 5:
 107:         return 2.57058
 108:     if df == 6:
 109:         return 2.44691
 110:     if df == 7:
 111:         return 2.36462
 112:     if df == 8:
 113:         return 2.306
 114:     if df == 9:
 115:         return 2.26216
 116:     if df == 10:
 117:         return 2.22814
 118:     if df == 12:
 119:         return 2.1788
 120:     if df == 15:
 121:         return 2.13145
 122:     if df == 20:
 123:         return 2.08596
 124:     if df == 30:
 125:         return 2.04227
 126:     if df == 60:
 127:         return 2.0003
 128:     # Hill's algorithm for general df
 129:     z = 1.959964   # qnorm(0.975)
 130:     g1 = (z**3 + z) / 4
 131:     g2 = (5*z**5 + 16*z**3 + 3*z) / 96
 132:     g3 = (3*z**7 + 19*z**5 + 17*z**3 - 15*z) / 384
 133:     g4 = (79*z**9 + 776*z**7 + 1482*z**5 - 1920*z**3 - 945*z) / 92160
 134:     return z + g1/df + g2/df**2 + g3/df**3 + g4/df**4
 135: 
 136: 
 137: def log_or_per_trial(tE, tN, cE, cN):
 138:     """Compute logOR + variance for one trial. Returns (yi, vi) or None
 139:     if the trial is unanalyzable (e.g., 100% in both arms)."""
 140:     # Yates 0.5 only if any cell is 0
 141:     tNE = tN - tE
 142:     cNE = cN - cE
 143:     cells = [tE, tNE, cE, cNE]
 144:     if any(c < 0 for c in cells):
 145:         return None
 146:     if min(cells) == 0:
 147:         a = tE + 0.5
 148:         b = tNE + 0.5
 149:         c = cE + 0.5
 150:         d = cNE + 0.5
 151:     else:
 152:         a, b, c, d = tE, tNE, cE, cNE
 153:     try:
 154:         yi = math.log((a * d) / (b * c))
 155:         vi = 1/a + 1/b + 1/c + 1/d
 156:     except (ValueError, ZeroDivisionError):
 157:         return None
 158:     if not math.isfinite(yi) or not math.isfinite(vi) or vi <= 0:
 159:         return None
 160:     return yi, vi
 161: 
 162: 
 163: def reml_tau2(yis, vis, max_iter=200, tol=1e-10):
 164:     """REML estimator of tau-squared. Iterative per Viechtbauer 2005.
 165:     Returns tau^2."""
 166:     k = len(yis)
 167:     if k < 2:
 168:         return 0.0
 169:     tau2 = 0.0
 170:     for _ in range(max_iter):
 171:         ws = [1.0 / (v + tau2) for v in vis]
 172:         sw = sum(ws)
 173:         mu = sum(w * y for w, y in zip(ws, yis)) / sw
 174:         # REML update: numerator and denominator per V&D 2005
 175:         num = sum((w**2) * ((y - mu)**2 - v) for w, y, v in zip(ws, yis, vis))
 176:         den = sum(w**2 for w in ws)
 177:         new_tau2 = tau2 + num / den
 178:         new_tau2 = max(0.0, new_tau2)
 179:         if abs(new_tau2 - tau2) < tol:
 180:             tau2 = new_tau2
 181:             break
 182:         tau2 = new_tau2
 183:     return tau2
 184: 
 185: 
 186: def pool_binary(trials_xy):
 187:     """Pool a list of (yi, vi) tuples via REML+HKSJ+floor and compute the
 188:     Cochrane v6.5 prediction interval. Returns a dict ready for JSON output."""
 189:     yis = [t[0] for t in trials_xy]
 190:     vis = [t[1] for t in trials_xy]
 191:     k = len(yis)
 192: 
 193:     tau2 = reml_tau2(yis, vis)
 194:     ws = [1.0 / (v + tau2) for v in vis]
 195:     sw = sum(ws)
 196:     mu = sum(w * y for w, y in zip(ws, yis)) / sw
 197:     var_mu_re = 1.0 / sw
 198:     se_re = math.sqrt(var_mu_re)
 199: 
 200:     # Q statistic (random-effects: still computed at fixed-effect weights)
 201:     ws_fe = [1.0 / v for v in vis]
 202:     mu_fe = sum(w * y for w, y in zip(ws_fe, yis)) / sum(ws_fe)
 203:     Q = sum(w * (y - mu_fe)**2 for w, y in zip(ws_fe, yis))
 204:     Qdf = k - 1
 205:     # Chi-square upper-tail p via Wilson-Hilferty approximation
 206:     # X^2(df) ~ df * (1 - 2/(9df) + z * sqrt(2/(9df)))^3  =>  invert
 207:     if Qdf > 0:
 208:         # Use Pearson chi-square approximation
 209:         from math import exp, sqrt as _sqrt, lgamma
 210:         # Use complementary CDF via incomplete gamma series
 211:         # Simplification: use the regularized incomplete gamma function Q(s, x)
 212:         # via series. Acceptable for our display purposes.
 213:         def _gammaincc(s, x):
 214:             # Complementary regularized incomplete gamma function.
 215:             if x < 0 or s <= 0: return 1.0
 216:             if x == 0: return 1.0
 217:             # Continued fraction for x > s+1, series otherwise
 218:             if x < s + 1:
 219:                 # series
 220:                 ap = s
 221:                 summ = 1 / s
 222:                 term = summ
 223:                 for _ in range(200):
 224:                     ap += 1
 225:                     term *= x / ap
 226:                     summ += term
 227:                     if abs(term) < abs(summ) * 1e-12:
 228:                         break
 229:                 return 1 - summ * exp(-x + s * math.log(x) - lgamma(s))
 230:             else:
 231:                 # continued fraction
 232:                 b = x + 1 - s
 233:                 c = 1e300
 234:                 d = 1.0 / b
 235:                 h = d
 236:                 for i in range(1, 200):
 237:                     an = -i * (i - s)
 238:                     b += 2
 239:                     d = an * d + b
 240:                     if abs(d) < 1e-30: d = 1e-30
 241:                     c = b + an / c
 242:                     if abs(c) < 1e-30: c = 1e-30
 243:                     d = 1.0 / d
 244:                     delt = d * c
 245:                     h *= delt
 246:                     if abs(delt - 1.0) < 1e-12:
 247:                         break
 248:                 return h * exp(-x + s * math.log(x) - lgamma(s))
 249:         Qp = _gammaincc(Qdf / 2.0, Q / 2.0)
 250:     else:
 251:         Qp = float('nan')
 252: 
 253:     # I^2
 254:     I2 = max(0.0, (Q - Qdf) / Q) * 100 if Q > 0 else 0.0
 255:     H2 = max(1.0, Q / Qdf) if Qdf > 0 else 1.0
 256: 
 257:     # HKSJ correction with floor at 1 (Wiksten 2016)
 258:     hksj_scale_raw = sum(w * (y - mu)**2 for w, y in zip(ws, yis)) / (k - 1) if k > 1 else 1.0
 259:     hksj_scale = max(1.0, hksj_scale_raw)
 260:     se_hksj = math.sqrt(hksj_scale * var_mu_re)
 261:     floor_applied = hksj_scale_raw < 1.0
 262: 
 263:     # CI on log scale using t_(k-1)
 264:     t_crit = t_quantile_975(k - 1)
 265:     ci_lo = mu - t_crit * se_hksj
 266:     ci_hi = mu + t_crit * se_hksj
 267: 
 268:     # Prediction interval via t_(k-1) (Cochrane v6.5)
 269:     if k >= 3:
 270:         pi_se = math.sqrt(tau2 + se_hksj**2)
 271:         pi_lo = mu - t_crit * pi_se
 272:         pi_hi = mu + t_crit * pi_se
 273:     else:
 274:         pi_lo = pi_hi = float('nan')
 275: 
 276:     return {
 277:         "k": k,
 278:         "pooled_logOR": mu,
 279:         "pooled_se": se_hksj,
 280:         "pooled_OR": math.exp(mu),
 281:         "ci_low_OR": math.exp(ci_lo),
 282:         "ci_high_OR": math.exp(ci_hi),
 283:         "tau2": tau2,
 284:         "I2": I2,
 285:         "H2": H2,
 286:         "Q": Q,
 287:         "Qdf": Qdf,
 288:         "Qp": Qp,
 289:         "PI_low_OR": math.exp(pi_lo) if not math.isnan(pi_lo) else None,
 290:         "PI_high_OR": math.exp(pi_hi) if not math.isnan(pi_hi) else None,
 291:         "pi_df_convention": "t_{k-1}_Cochrane_v6.5",
 292:         "hksj_floor_applied": floor_applied,
 293:         "hksj_scale_raw": hksj_scale_raw,
 294:         "method": "REML+HKSJ+floor",
 295:     }
 296: 
 297: 
 298: def extract_binary_trials(page_path):
 299:     """Return list of dicts with name/nct/pmid/tE/tN/cE/cN/yi/vi.
 300:     Skips trials without 4 binary counts."""
 301:     txt = page_path.read_text(encoding="utf-8", errors="replace")
 302:     out = []
 303:     for m in TRIAL_RE.finditer(txt):
 304:         nct = m.group(1) or m.group(2) or m.group(3)
 305:         body = m.group("body")
 306:         tE = get_num(body, "tE")
 307:         tN = get_num(body, "tN")
 308:         cE = get_num(body, "cE")
 309:         cN = get_num(body, "cN")
 310:         if None in (tE, tN, cE, cN):
 311:             continue
 312:         if tN <= 0 or cN <= 0:
 313:             continue
 314:         if tE > tN or cE > cN:
 315:             continue  # impossible; skip
 316:         r = log_or_per_trial(int(tE), int(tN), int(cE), int(cN))
 317:         if r is None:
 318:             continue
 319:         yi, vi = r
 320:         out.append({
 321:             "name": get_str(body, "name") or nct,
 322:             "nct": nct,
 323:             "pmid": get_str(body, "pmid"),
 324:             "tE": tE,
 325:             "tN": tN,
 326:             "cE": cE,
 327:             "cN": cN,
 328:             "yi": yi,
 329:             "vi": vi,
 330:         })
 331:     return out
 332: 
 333: 
 334: def sidecar_stem(page_name: str) -> str:
 335:     """The engine fetches outputs/r_validation/<STEM>.json where <STEM> is
 336:     the page name with only the final _REVIEW.html removed. Verified via
 337:     puppeteer log: ABALOPARATIDE_OSTEO_AUTO_FULL_REVIEW.html fetches
 338:     `ABALOPARATIDE_OSTEO_AUTO_FULL.json`, not the topic-only stem.
 339:     Existing sidecars (FINERENONE.json for FINERENONE_REVIEW.html) match
 340:     this rule once you account for `_REVIEW` being the only suffix on
 341:     those flagship pages.
 342:     """
 343:     n = page_name.replace(".html", "")
 344:     if n.endswith("_REVIEW"):
 345:         n = n[: -len("_REVIEW")]
 346:     return n
 347: 
 348: 
 349: def emit_sidecar(page_path: Path, force=False) -> dict:
 350:     """Generate (or refuse) a sidecar for the given page. Returns status dict."""
 351:     stem = sidecar_stem(page_path.name)
 352:     out_path = SIDECAR_DIR / f"{stem}.json"
 353:     if out_path.exists() and not force:
 354:         return {"status": "exists", "page": page_path.name, "stem": stem}
 355: 
 356:     trials = extract_binary_trials(page_path)
 357:     if len(trials) < 2:
 358:         return {"status": "insufficient_k", "page": page_path.name, "k": len(trials)}
 359: 
 360:     pool = pool_binary([(t["yi"], t["vi"]) for t in trials])
 361:     # Trim trial detail to publishable fields
 362:     trial_records = [{
 363:         "name": t["name"],
 364:         "nct": t["nct"],
 365:         "tE": t["tE"], "tN": t["tN"], "cE": t["cE"], "cN": t["cN"],
 366:         "yi": round(t["yi"], 6),
 367:         "vi": round(t["vi"], 6),
 368:     } for t in trials]
 369: 
 370:     # Match the existing field ordering (FINERENONE.json layout)
 371:     sidecar = {
 372:         "k": pool["k"],
 373:         "pooled_logOR": round(pool["pooled_logOR"], 6),
 374:         "pooled_se": round(pool["pooled_se"], 6),
 375:         "pooled_OR": round(pool["pooled_OR"], 6),
 376:         "ci_low_OR": round(pool["ci_low_OR"], 6),
 377:         "ci_high_OR": round(pool["ci_high_OR"], 6),
 378:         "tau2": round(pool["tau2"], 10),
 379:         "I2": round(pool["I2"], 6),
 380:         "H2": round(pool["H2"], 6),
 381:         "Q": round(pool["Q"], 6),
 382:         "Qdf": pool["Qdf"],
 383:         "Qp": float(f"{pool['Qp']:.6e}") if pool["Qp"] == pool["Qp"] else None,
 384:         "PI_low_OR": round(pool["PI_low_OR"], 6) if pool["PI_low_OR"] is not None else None,
 385:         "PI_high_OR": round(pool["PI_high_OR"], 6) if pool["PI_high_OR"] is not None else None,
 386:         "pi_df_convention": pool["pi_df_convention"],
 387:         "hksj_floor_applied": pool["hksj_floor_applied"],
 388:         "method": pool["method"],
 389:         "generated_by": "scripts/build_binary_sidecar.py",
 390:         "generated_on": "2026-05-26",
 391:         "trials": trial_records,
 392:     }
 393:     out_path.write_text(json.dumps(sidecar, indent=2), encoding="utf-8")
 394:     return {"status": "generated", "page": page_path.name, "stem": stem,
 395:             "k": pool["k"], "pooled_OR": pool["pooled_OR"]}
 396: 
 397: 
 398: def main():
 399:     if hasattr(sys.stdout, "buffer"):
 400:         sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
 401:     targets = sorted(p for p in HERE.glob("*_FULL_REVIEW.html") if p.is_file())
 402:     print(f"Candidate FULL_REVIEW pages: {len(targets):,}")
 403: 
 404:     stats = {"generated": 0, "exists": 0, "insufficient_k": 0}
 405:     for i, p in enumerate(targets, 1):
 406:         r = emit_sidecar(p)
 407:         stats[r["status"]] = stats.get(r["status"], 0) + 1
 408:         if i % 200 == 0:
 409:             print(f"  [{i}/{len(targets)}]  {stats}")
 410:     print(f"\nDone. {stats}")
 411:     print(f"Existing sidecars before: 378")
 412:     print(f"Sidecars now in outputs/r_validation: {len(list(SIDECAR_DIR.rglob('*.json'))):,}")
 413: 
 414: 
 415: if __name__ == "__main__":
 416:     main()

