 269:                 got = [(a.get("label"), a.get("role")) for a in tr.get("arms") or []]
 270:                 print("   NEURO-TTRansform, untouched and asserted: %s" % got)
 271:                 if dict(got).get("Eplontersen") != "control":
 272:                     sys.exit("REFUSED: NEURO-TTRansform's arms moved. That pair is an "
 273:                              "external-comparator design and must not be 'corrected'.")
