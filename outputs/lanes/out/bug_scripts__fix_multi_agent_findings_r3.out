 167: for rv in QUARANTINE_REVIEWS + PARTIAL_QUARANTINE:
 168:     html_path = HERE / f"{rv}.html"
 169:     if not html_path.exists():
 170:         log["batch2"].append({"review": rv, "status": "FILE_MISSING"})
