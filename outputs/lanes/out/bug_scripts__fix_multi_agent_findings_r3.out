 157:     "IGAN_TARGETED_BROAD_NMA_REVIEW",        # 1-2 real + fabricated companions
 158:     "NEONATAL_NEC_NMA_REVIEW",
 159: ]
 160: # Quarantine via banner injection at top of <body>
 161: BANNER_HTML = """
 162: <div id="rapidmeta-quarantine-banner" role="alert" style="background:#7f1d1d;color:#fff;padding:12px 20px;font-family:system-ui,sans-serif;font-size:14px;border-bottom:3px solid #fbbf24;text-align:center;">
 163:   âš  DATA-INTEGRITY QUARANTINE â€” Multi-agent audit found â‰¥80% of trials in this review have non-resolvable PMIDs, fabricated NCTs, or fabricated trial acronyms. Pooled estimates and forest plots on this page should NOT be cited or shipped until ground-up re-extraction from verified primary sources is completed.
 164: </div>
 165: """
