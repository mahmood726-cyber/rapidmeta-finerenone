 174:         log["batch2"].append({"review": rv, "status": "ALREADY_QUARANTINED"})
 175:         continue
 176:     # Inject banner right after <body> opening tag
 177:     body_pat = re.compile(r"(<body[^>]*>)", re.IGNORECASE)
