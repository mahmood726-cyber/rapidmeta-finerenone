--- THE FILE, IN FULL ---
#!/usr/bin/env python3
"""E8 -- ASSERT THAT A SHIPPED PAGE NAMES A BUILD COMMAND THAT EXISTS AND A COMMIT THAT RESOLVES.

WHY THIS EXISTS. Two pages were rebuilt and re-gated in served bytes on 2026-08-19, and hours
later, in the same session, THE ROUTE USED TO BUILD THEM COULD NOT BE STATED. It had to be
recovered from a commit diff by working out which module emits the `Page standard` card.

    A BUILD PATH NOBODY CAN NAME IS A BUILD PATH NOBODY CAN AUDIT -- and one nobody can
    reproduce, which makes every artefact it produced unverifiable in principle.

`build_tabbed.py` already emits a generator stamp, and it is an honest one: it reports DIRTY
when a generator file is uncommitted and UNKNOWN when git is unavailable, rather than guessing.
So the recording was never the gap. THE GAP WAS THE ASSERTION -- nothing checked that the stamp
on a shipped page names something real.

WHAT THIS CHECKS, on the page's actual bytes:

  1. THE STAMP IS PRESENT.        A page with no `Generator build` stamp cannot be traced at all.
  2. THE COMMIT RESOLVES.         `git cat-file -e <sha>` -- the stamp names a commit that
                                  EXISTS in this repository, not a plausible-looking hex string.
  3. THE STAMP IS NOT UNKNOWN.    "UNKNOWN -- git unavailable at build time" is honest, and it
                                  is also unverifiable. Honest is not the same as sufficient.
  4. DIRTY IS REPORTED, NOT PASSED. A page built from uncommitted generator code cannot be
                                  reproduced from its stamp. The stamp says so; this makes that
                                  statement BLOCKING for a page being gated, instead of prose a
                                  reader may or may not notice.
  5. THE BUILD COMMAND EXISTS.    The module the route depends on is on disk and importable.

WHAT IT DOES NOT CHECK, named rather than implied: it does not re-run the generator and compare
bytes. That would be the complete answer and it costs a full page build (minutes, plus figure
rasterisation) per page. This asserts the stamp is TRACEABLE, not that it is TRUE. The
difference is real and is the residual half of E8.
"""
import io
import os
import re
import subprocess
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
BUILD_MODULE = os.path.join(REPO, "ssot", "build_tabbed.py")
BUILD_COMMAND = "python ssot/build_tabbed.py <object.json> <out.html>"

STAMP_RE = re.compile(r"Generator build.{0,80}?<code>([^<]{1,60})</code>([^<]{0,160})",
                      re.DOTALL)

# Pages under gate. Declared, because a glob over ~1500 shipped pages would make this
# unrunnable and would silently include pages nobody claims to have rebuilt.
GATED_PAGES = ["IV_IRON_HF_REVIEW.html", "SGLT2_HF_REVIEW.html", "BEMPEDOIC_ACID_REVIEW.html"]


def commit_exists(sha):
    try:
        r = subprocess.run(["git", "-C", REPO, "cat-file", "-e", sha + "^{commit}"],
                           capture_output=True, timeout=30)
        return r.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return None          # git unavailable HERE -- not the same as a bad stamp


def check(page):
    """Return (ok, [messages])."""
    path = os.path.join(REPO, page)
    if not os.path.exists(path):
        return False, ["page not on disk"]
    with io.open(path, encoding="utf-8", errors="replace") as fh:
        html = fh.read()
    m = STAMP_RE.search(html)
    if not m:
        return False, ["NO generator stamp -- this page cannot be traced to any build"]
    sha, suffix = m.group(1).strip(), m.group(2)
    msgs = ["stamp %r" % sha]
    ok = True
    if sha.upper() == "UNKNOWN":
        return False, msgs + ["stamp is UNKNOWN (git unavailable at build time). Honest, and "
                              "unverifiable -- honest is not the same as sufficient."]
    exists = commit_exists(sha)
    if exists is None:
        return False, msgs + ["git unavailable HERE, so the stamp could not be resolved. "
                              "Reported as UNRESOLVED, never as a pass."]
    if not exists:
        ok = False
        msgs.append("commit does NOT exist in this repository -- the stamp names nothing")
    else:
        msgs.append("commit resolves")
    if "NOT REPRODUCIBLE" in suffix or "uncommitted" in suffix:
        ok = False
        msgs.append("built from UNCOMMITTED generator code -- not reproducible from this stamp")
    if not os.path.exists(BUILD_MODULE):
        ok = False
        msgs.append("build module missing: %s" % BUILD_MODULE)
    return ok, msgs


def main():
    sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
    print("build command asserted: %s" % BUILD_COMMAND)
    print("build module present:   %s" % os.path.exists(BUILD_MODULE))
    print()
    bad = 0
    for page in GATED_PAGES:
        ok, msgs = check(page)
        print("%-28s %s" % (page, "OK" if ok else "REFUSED"))
        for m in msgs:
            print("      %s" % m)
        if not ok:
            bad += 1
    print()
    print("gated pages   %d" % len(GATED_PAGES))
    print("failing       %d" % bad)
    print()
    print("NOT CHECKED, and named rather than implied: this asserts the stamp is TRACEABLE,")
    print("not that it is TRUE. Re-running the generator and comparing bytes would settle it")
    print("and costs a full page build per page. That is the residual half of E8.")
    if bad:
        print()
        print("REFUSED: %d gated page(s) carry a stamp that names nothing checkable." % bad)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())

