  71: # R2: state a bound that is TRUE. 0.341 is not (0.34133 > 0.341); 0.3413 is not
  72: # either at full precision, so round the bound UP rather than to nearest.
  73: DEV_BOUND = math.ceil(MAX_DEV * 10000) / 10000        # 0.3414
  74: DEV_TXT = f"{DEV_BOUND:.4f}"
