  86: print(f"pooled OR {OR:.4f} ({LO:.4f}-{HI:.4f}) p={P:.4f}  events={TOTAL_EVENTS} N={TOTAL_N}  (unchanged)")
  87: 
  88: # The single sentence that governs every rate-ratio / odds-ratio mention.
