 174: @media (max-width: 540px) {{
 175:   .card-host > .card {{ padding-right: 1rem; }}
 176:   .card-host .claim-chip {{
 177:     position: static;
 178:     display: block;
 179:     margin: .4rem 0 0 0;
 180:     width: max-content;
 181:     font-size: .52rem;
 182:     padding: .18rem .4rem;
 183:   }}
 184: }}
 185: </style>
 186: {end}""".format(begin=STYLE_BEGIN, end=STYLE_END)
 187: 
 188: 
 189: SCRIPT_TEMPLATE = """__BEGIN__
 190: <script>
 191: (function () {
 192:   var RAPIDMETA_TO_E156 = __JSON__;
 193:   var E156_BASE = "__E156_BASE__";
 194:   function buildClaimLink(num, title, klass) {
 195:     var a = document.createElement("a");
 196:     a.href = E156_BASE + "?focus=" + encodeURIComponent(num);
 197:     a.target = "_blank";
 198:     a.rel = "noopener";
 199:     a.className = "claim-chip" + (klass ? " " + klass : "");
 200:     a.textContent = "ðŸ“‹ Claim on E156";
 201:     a.title = "Open the E156 student board, paper #" + num + (title ? " â€” " + title : "");
 202:     a.addEventListener("click", function (e) { e.stopPropagation(); });
 203:     return a;
 204:   }
 205:   function inject() {
 206:     var anchors = document.querySelectorAll("a[href$='_REVIEW.html']");
 207:     var injected = 0;
 208:     anchors.forEach(function (a) {
 209:       // Per-anchor idempotency flag â€” descendant search on parent is unsafe
 210:       // because a single grid/td may contain many sibling anchors and the
 211:       // first-card chip would falsely satisfy the check for all the others.
 212:       if (a.dataset && a.dataset.e156ChipInjected === "1") return;
 213:       var href = a.getAttribute("href") || "";
 214:       var basename = href.split("/").pop();
 215:       var rec = RAPIDMETA_TO_E156[basename];
 216:       if (!rec) return;
 217:       // Card style â€” wrap in .card-host so the absolute-positioned chip
 218:       // can anchor without nesting <a> inside <a> (invalid HTML).
 219:       if (a.classList && a.classList.contains("card")) {
 220:         if (a.parentNode && a.parentNode.classList.contains("card-host")) {
 221:           a.dataset.e156ChipInjected = "1";
 222:           return;
 223:         }
 224:         var wrap = document.createElement("div");
 225:         wrap.className = "card-host";
 226:         a.parentNode.insertBefore(wrap, a);
 227:         wrap.appendChild(a);
 228:         wrap.appendChild(buildClaimLink(rec.num, rec.title));
 229:         a.dataset.e156ChipInjected = "1";
 230:         injected++;
 231:         return;
 232:       }
 233:       // Inline / table cell â€” append the chip as a sibling of the <a>.
 234:       var chip = buildClaimLink(rec.num, rec.title, "inline-claim-chip");
 235:       a.insertAdjacentElement("afterend", chip);
 236:       a.dataset.e156ChipInjected = "1";
 237:       injected++;
 238:     });
 239:     return injected;
 240:   }
 241:   if (document.readyState === "loading") {
 242:     document.addEventListener("DOMContentLoaded", inject);
 243:   } else { inject(); }
 244:   // Dashboard renders rows after a JSON fetch â€” re-run inject on DOM
 245:   // mutations (throttled) so dynamically-added review links also get chips.
 246:   let __scheduled = false;
 247:   const __obs = new MutationObserver(() => {
 248:     if (__scheduled) return;
 249:     __scheduled = true;
 250:     setTimeout(() => { __scheduled = false; inject(); }, 250);
 251:   });
 252:   if (document.body) __obs.observe(document.body, { childList: true, subtree: true });
 253:   else document.addEventListener("DOMContentLoaded", () => __obs.observe(document.body, { childList: true, subtree: true }));
 254: })();
 255: </script>
 256: __END__"""
 257: 
 258: 
 259: def remove_block(html: str, begin: str, end: str) -> str:
 260:     pat = re.compile(re.escape(begin) + r".*?" + re.escape(end), re.DOTALL)
 261:     return pat.sub("", html)
 262: 
 263: 
 264: def patch_index(index_html: str, mapping: dict[str, dict]) -> tuple[str, int]:
 265:     json_map = json.dumps(mapping, ensure_ascii=False, indent=0).replace("\n", "")
 266:     script_block = (SCRIPT_TEMPLATE
 267:                     .replace("__JSON__", json_map)
 268:                     .replace("__E156_BASE__", E156_BASE)
 269:                     .replace("__BEGIN__", MARKER_BEGIN)
 270:                     .replace("__END__", MARKER_END))
 271:     # Remove any prior version, then insert fresh
 272:     new_html = remove_block(index_html, STYLE_BEGIN, STYLE_END)
 273:     new_html = remove_block(new_html, MARKER_BEGIN, MARKER_END)
 274:     if "</head>" in new_html:
 275:         new_html = new_html.replace("</head>", STYLE_BLOCK + "\n</head>", 1)
 276:     if "</body>" in new_html:
 277:         new_html = new_html.replace("</body>", script_block + "\n</body>", 1)
 278:     return new_html, len(mapping)
 279: 
 280: 
 281: def main() -> None:
 282:     if not STUDENTS.exists():
 283:         print("ERROR: students.html not found at", STUDENTS)
 284:         sys.exit(1)
 285:     if not INDEX.exists():
 286:         print("ERROR: index.html not found at", INDEX)
 287:         sys.exit(1)
 288: 
 289:     students_html = STUDENTS.read_text(encoding="utf-8", errors="replace")
 290:     entries = parse_entries(students_html)
 291:     mapping, audit = build_map(entries)
 292:     print(f"Parsed {len(entries)} ENTRIES; built map with {len(mapping)} review files.")
 293:     if audit:
 294:         print(f"Resolved {len(audit)} collisions:")
 295:         for a in audit:
 296:             print(f"  {a['basename']}")
 297:             print(f"    KEEP  #{a['chosen']['num']:3d}  {a['chosen']['title'][:70]}")
 298:             for r in a["rejected"]:
 299:                 print(f"    drop  #{r['num']:3d}  {r['title'][:70]}")
 300: 
 301:     if not mapping:
 302:         print("ERROR: no rapidmeta entries matched. Aborting.")
 303:         sys.exit(2)
 304: 
 305:     # Audit CSV: every landing-page review + chip status
 306:     landing_hrefs: set[str] = set()
 307:     if INDEX.exists():
 308:         idx_text = INDEX.read_text(encoding="utf-8", errors="replace")
 309:         landing_hrefs |= set(re.findall(r'href="([A-Z0-9_]+_REVIEW\.html)"', idx_text))
 310:     audit_csv = REPO / "outputs" / "e156_chip_audit.csv"
 311:     write_audit_csv(mapping, landing_hrefs, audit_csv)
 312:     uncovered = sum(1 for h in landing_hrefs if h not in mapping)
 313:     print(f"Audit CSV: {audit_csv.relative_to(REPO)}  "
 314:           f"({len(landing_hrefs)} reviews on landing, {uncovered} UNCOVERED)")
 315: 
 316:     for target in (INDEX, DASHBOARD, *EXTRA_LANDING_PAGES):
 317:         if not target.exists():
 318:             print(f"  skip (missing): {target.name}")
 319:             continue
 320:         text = target.read_text(encoding="utf-8", errors="replace")
 321:         new_text, n = patch_index(text, mapping)
 322:         if new_text == text:
 323:             print(f"  no-op: {target.name}")
 324:             continue
 325:         target.write_text(new_text, encoding="utf-8")
 326:         print(f"  patched: {target.name} ({n} mappings)")
 327: 
 328: 
 329: if __name__ == "__main__":
 330:     main()

codex
Defects found:

- `instrument reading a name vs its binding` — line 85.  
  Exact input: local `ABC_REVIEW.html` exists, and `entries=[{"num":1,"code_url":"https://github.com/x/not-rapidmeta-finerenone","pages_url":"https://x/ABC_REVIEW.html","title":"ABC"}]`.  
  Consequence: a paper from a different repo is accepted because the repo check is substring-based.

- `idempotency guard satisfied by marker rather than work` — lines 220-222.  
  Exact input DOM after script load: `<div class="card-host"><a class="card" href="ABC_REVIEW.html">ABC</a></div>` with `RAPIDMETA_TO_E156={"ABC_REVIEW.html":{"num":1,"title":"ABC"}}`.  
  Consequence: the anchor is marked injected and no chip is created.

- `instrument reading a different copy than the one being changed` — lines 307-309 versus line 316.  
  Exact input: `index.html` contains no review links; `AutoManuscript.html` contains `<a href="ABC_REVIEW.html">ABC</a>`; mapping contains only `OTHER_REVIEW.html`.  
  Consequence: the audit reports zero uncovered landing reviews while a patched landing page contains an uncovered review link.

- `selector keyed to a form the instrument itself accepts but the audit does not` — line 309.  
  Exact input: `index.html` contains `<a href="./ABC_REVIEW.html">ABC</a>` and mapping contains `{"ABC_REVIEW.html":{"num":1,"title":"ABC"}}`.  
  Consequence: runtime injection handles the link, but the audit CSV omits it entirely.

- `status code reporting the wrapper rather than the work` — lines 274-278, reported at line 326.  
  Exact input: `patch_index('<html><head></head><body><a href="ABC_REVIEW.html">ABC</a></html>', {"ABC_REVIEW.html":{"num":1,"title":"ABC"}})`.  
  Consequence: style is inserted, script is not inserted, and `main()` can still print `patched`.

No proven defect found for: probe keyed to the string a fix removes; CRLF/LF text comparison; merged-cell/off-by-one tabulation; zero conflated with absent; negation dropped.
