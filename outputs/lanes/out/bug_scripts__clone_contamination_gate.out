 608: 
 609: def assert_no_silent_skip(log, extra_claim_terms=()):
 610:     """Check 4. Promote a SKIP on a CLAIM-BEARING anchor to a hard failure.
 611: 
 612:     `clone_dashboard.replace_one` appends '  [SKIP_NOT_FOUND] <label>' or
 613:     '  [SKIP_AMBIGUOUS:n] <label>'. A skip on a cosmetic anchor is tolerable; a
 614:     skip on an anchor that carries a CLAIM (a drug name, an AE profile, a report
 615:     title, a seal, a trial registry) means the base's claim survived into the
 616:     clone. That is the exact bug that produced 147 contaminated apps.
 617:     """
 618:     extra = tuple(t.lower() for t in extra_claim_terms)
 619:     offenders = []
 620:     for line in log:
 621:         if "[SKIP_NOT_FOUND]" not in line and "[SKIP_AMBIGUOUS" not in line:
 622:             continue
 623:         low = line.lower()
 624:         claim = bool(_CLAIM_RX.search(line)) or any(t in low for t in extra)
 625:         # A skipped anchor whose OWN TEXT names a drug class, an adverse-event
 626:         # fingerprint, a base trial or a base subject label is claim-bearing no
 627:         # matter what the label around it says. This is what closes the
 628:         # `extra_replace [...]` hole: those anchors are described in
 629:         # clone_dashboard.py as "precise, single-occurrence claim neutralizers",
 630:         # yet their label carried no claim word and the skip stayed silent.
 631:         if not claim:
 632:             claim = bool(classes_in(low) or ae_classes_in(low)
 633:                          or any(_TRIAL_RX[t].search(line) for t in BASE_TRIALS)
 634:                          or any(lab.lower() in low for lab in BASE_SUBJECT_LABELS))
 635:         if claim:
 636:             offenders.append(line.strip())
 637:     if offenders:
 638:         raise CloneContaminationError(
 639:             "clone left claim-bearing anchor(s) unreplaced - the base engine "
 640:             "survives in the output:\n  " + "\n  ".join(offenders))
