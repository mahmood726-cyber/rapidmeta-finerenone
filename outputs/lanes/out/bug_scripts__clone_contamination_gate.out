 235: # ---------------------------------------------------------------------------
 236: def _realdata_block(src):
 237:     """The app's own realData object literal, brace-scanned. This is the ONLY
 238:     trustworthy in-file source of 'which trials are mine' - a global regex over
 239:     the whole document picks up the base engine's leftover PICO/i18n strings
 240:     and would launder the contamination into the subject basis (observed: the
 241:     base's `"SGLT2 inhibitor therapy (dapagliflozin...)"` i18n key made a
 242:     vaccine app look like an SGLT2i app, silencing the AE check)."""
 243:     m = re.search(r"realData\s*:\s*\{", src)
 244:     if not m:
 245:         return ""
 246:     o = src.index("{", m.start())
 247:     depth = 0
 248:     for j in range(o, len(src)):
 249:         if src[j] == "{":
 250:             depth += 1
 251:         elif src[j] == "}":
 252:             depth -= 1
 253:             if depth == 0:
 254:                 return src[o:j + 1]
 255:     return ""
