 590: # ---------------------------------------------------------------------------
 591: # Library entrypoints for clone_dashboard.py / generators
 592: # ---------------------------------------------------------------------------
 593: # Matched on WORD BOUNDARIES, not as raw substrings. As bare substrings, "ae"
 594: # matched "michAEl", "AEtiology" and "hAEmoglobin", so a purely cosmetic skip
 595: # hard-failed the clone; and the list contained no concrete drug or trial token,
 596: # so a skip on `extra_replace [Fournier's gangrene, genital mycotic ...]` was
 597: # TOLERATED. Both reproduced 2026-07-23 - the check was simultaneously too loud
 598: # and too quiet.
 599: CLAIM_BEARING = ("ae", "aes", "adverse", "safety", "title", "hero", "headline",
 600:                  "seal", "report", "subject", "drug", "indication", "trial",
 601:                  "registry", "waiting", "benchmark", "reference", "global",
 602:                  "outcome", "pico", "protocol", "acronym")
 603: 
 604: _CLAIM_RX = re.compile(
 605:     r"(?<![a-z0-9])(?:" + "|".join(re.escape(t) for t in CLAIM_BEARING) +
 606:     r")(?![a-z0-9])", re.I)
