 915:             if pl and is_green_verdict(pl):
 916:                 vgroups.setdefault(hashlib.sha1(pl.encode()).hexdigest(), []).append(
 917:                     os.path.basename(p))
 918:         shared = {k: v for k, v in vgroups.items() if len(v) > 1}
 919:         if shared:
 920:             worst = max(shared.values(), key=len)
 921:             print(f"VERDICT-BADGE duplication (advisory): "
 922:                   f"{sum(len(v) for v in shared.values())} apps share a GREEN "
 923:                   f"window.__verdict payload with another app across "
 924:                   f"{len(shared)} payload group(s); largest group = {len(worst)} apps "
 925:                   f"(e.g. {worst[0]}). A shared payload is a verdict computed for a "
 926:                   f"different app.")
 927:     if os.path.isdir(outdir):
 928:         with open(os.path.join(outdir, "clone_contamination_report.json"),
 929:                   "w", encoding="utf-8") as fh:
 930:             json.dump({"hard": [list(f) for f in HARD],
 931:                        "blocking": [list(f) for f in new],
 932:                        "grandfathered": [list(f) for f in old],
 933:                        "warn": [list(f) for f in WARN]}, fh, indent=1)
 934:     if new:
 935:         print(f"\nBLOCKED: {len(new)} new hard contamination finding(s).")
 936:         return 1
 937:     print(f"\nGATE OK: 0 new hard contamination findings"
 938:           + (f" ({len(old)} grandfathered, still owed)." if old else "."))
 939:     return 0
