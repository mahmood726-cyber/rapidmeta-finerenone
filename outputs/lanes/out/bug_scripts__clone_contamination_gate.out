 167: # Embedded (non-rendered) registry literals. SLOTS above only cover strings the
 168: # user can SEE; the audit's class C survivor is a JS literal that never renders
 169: # until a matching trial enters the set - `KNOWN_TRIAL_ALIASES` (NCT -> alias),
 170: # `AUTO_INCLUDE_TRIAL_IDS` (auto-screen allowlist). A foreign alias map is not
 171: # inert: `findConflictingTrialAlias()` substring-matches its aliases against
 172: # candidate abstracts and applies score -= 32, so the base's "deliver" alias
 173: # penalises every obstetric candidate mentioning "delivery". Checked separately
 174: # from SLOTS because there is no rendered text to inspect.
 175: # Located by IDENTIFIER and then BRACE-SCANNED, not matched by a fixed shape.
 176: # The previous patterns required the literal to be followed by `},` (and
 177: # rReference by `}, runRValidation`), so the same contaminated registry written
 178: # with a trailing `;` - or followed by a `function` declaration instead of a
 179: # method shorthand - scanned completely clean (codex review F-03, both
 180: # reproduced 2026-07-23 against passing controls). Terminator punctuation is an
 181: # accident of minifier output; the gate must not depend on it.
 182: REGISTRY_IDENTS = [
 183:     ("known_trial_aliases", r"KNOWN_TRIAL_ALIASES\s*[:=]\s*", "{",
 184:      "embedded NCT->alias trial registry"),
 185:     ("auto_include_trial_ids", r"AUTO_INCLUDE_TRIAL_IDS\s*[:=]\s*(?:new\s+Set\s*\(\s*)?", "[",
 186:      "auto-screen INCLUDE allowlist"),
 187:     ("r_reference", r"rReference\s*[:=]\s*", "{",
 188:      "baked R cross-validation reference"),
 189: ]
 190: 
 191: _PAIR = {"{": "}", "[": "]"}
 192: 
 193: 
 194: def _balanced(src, start, opener, limit=200000):
 195:     """Return the balanced literal beginning at the first `opener` at/after
 196:     `start`, or "" if it does not close within `limit` chars. Quote-aware so a
 197:     brace inside a JS string does not unbalance the scan."""
 198:     try:
 199:         o = src.index(opener, start)
 200:     except ValueError:
 201:         return ""
 202:     closer = _PAIR[opener]
 203:     depth = 0
 204:     quote = None
 205:     esc = False
 206:     for j in range(o, min(len(src), o + limit)):
 207:         c = src[j]
 208:         if esc:
 209:             esc = False
 210:             continue
 211:         if quote:
 212:             if c == "\\":
 213:                 esc = True
 214:             elif c == quote:
 215:                 quote = None
 216:             continue
 217:         if c in "\"'`":
 218:             quote = c
 219:         elif c == opener:
 220:             depth += 1
 221:         elif c == closer:
 222:             depth -= 1
 223:             if depth == 0:
 224:                 return src[o:j + 1]
 225:     return ""
 226: 
 227: _NCT = re.compile(r"NCT\d{8}")
 228: _WORD = re.compile(r"[a-z0-9]+")
 229: 
 230: 
 231: def _tokens(text):
 232:     return set(_WORD.findall((text or "").lower()))
 233: 
