 500: # ---------------------------------------------------------------------------
 501: # App-integrity checks (the HFrEF failure classes)
 502: # ---------------------------------------------------------------------------
 503: _VERDICT = re.compile(r"window\.__verdict\s*=\s*", re.I)
 504: _GREEN = ("stable", "pass", "clean", "ok", "green", "verified")
 505: # `RapidMeta.foo(` reached from an inline HTML event-handler attribute.
 506: _HANDLER_ATTR = re.compile(r"\son[a-z]+\s*=\s*\"([^\"]{1,400})\"", re.I)
 507: _RM_CALL = re.compile(r"RapidMeta\.([A-Za-z_$][\w$]*)\s*\(")
 508: # Anything that plausibly DEFINES `name`: method shorthand, `name: function`,
 509: # `name: (`, or `X.name = function/(`. Deliberately permissive - a definition we
 510: # fail to recognise would be a false BLOCK, and this check must stay
 511: # false-positive-free to be safe to block on.
 512: _DEFS = re.compile(
 513:     r"(?:(?<![.\w$])([A-Za-z_$][\w$]*)\s*(?:\([^()]{0,300}\)\s*\{"
 514:     r"|:\s*(?:async\s+)?(?:function\b|\()))"
 515:     r"|(?:(?<![\w$])([A-Za-z_$][\w$]*)\s*=\s*(?:async\s*)?(?:function\b|\())")
 516: 
 517: 
 518: def _scan_app_integrity(src, fn):
 519:     """Two structural defects that no vocabulary blocklist can see.
 520: 
 521:     (a) DEAD EVENT HANDLERS. `<button onclick="RapidMeta.switchTab('protocol')">`
 522:         with no `switchTab` defined anywhere in the file: every tab throws
 523:         TypeError and the app is unusable. HFREF_NMA_FULL_REVIEW.html shipped
 524:         with all 16 of its RapidMeta.* handler targets undefined.
 525:         Measured false-positive rate: 1 hit across 759 corpus apps, and the one
 526:         hit IS HFrEF. The other 758 define every handler they call.
 527: 
 528:     (b) INHERITED GREEN VERDICT BADGE. `window.__verdict = {"verdict":"STABLE"}`
 529:         renders a reassuring badge. If the payload carries no binding to THIS
 530:         app - no self-naming `app` field - a clone inherits its base's verdict
 531:         and displays a green badge it never earned. Reported as a finding only
 532:         when the verdict is a GREEN one: an inherited red badge is a bug too,
 533:         but it does not mislead a reader into trusting the numbers."""
 534:     out = []
 535: 
 536:     handler_targets = set()
 537:     for m in _HANDLER_ATTR.finditer(src):
 538:         handler_targets |= set(_RM_CALL.findall(m.group(1)))
 539:     if handler_targets:
 540:         defined = {g for m in _DEFS.finditer(src) for g in m.groups() if g}
 541:         dead = sorted(handler_targets - defined)
 542:         if dead:
 543:             out.append((fn, "dead_event_handler",
 544:                         f"{len(dead)} inline handler target(s) are never defined in "
 545:                         f"this file - every such control throws TypeError when "
 546:                         f"clicked: {dead[:8]}"))
 547: 
 548:     return out
 549: 
 550: 
 551: def verdict_payload(src):
 552:     """The `window.__verdict = {...}` object literal, or "" if absent."""
 553:     m = _VERDICT.search(src)
 554:     return _balanced(src, m.end(), "{", limit=20000) if m else ""
 555: 
 556: 
 557: def verdict_grade(payload):
 558:     m = re.search(r'"verdict"\s*:\s*"([^"]{1,40})"', payload or "")
 559:     return (m.group(1) if m else "").lower()
 560: 
 561: 
 562: def is_green_verdict(payload):
 563:     v = verdict_grade(payload)
 564:     return bool(v) and any(g in v for g in _GREEN)
