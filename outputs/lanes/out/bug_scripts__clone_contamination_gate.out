 485:     if i18n_foreign:
 486:         warn.append((fn, "foreign_drug_class_in_i18n_value",
 487:                      f"{i18n_foreign} translated value(s) name a drug class this "
 488:                      f"app does not declare"))
 489: 
 490:     # --- 5: APP-INTEGRITY checks (added 2026-07-23 after HFREF_NMA_FULL_REVIEW
 491:     # shipped a green badge it had not earned AND a completely dead tab bar).
 492:     # These are not contamination-vocabulary checks; they catch a clone that is
 493:     # STRUCTURALLY broken or that displays an INHERITED verdict. Kept in this
 494:     # gate because it is the only fail-closed check that runs on every freshly
 495:     # written clone, and both defects are born at clone time.
 496:     hard += _scan_app_integrity(src, fn)
 497:     return hard, warn
