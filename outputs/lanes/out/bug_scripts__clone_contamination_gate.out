 643: def assert_clean(out_path, delete_on_failure=True, name_as=None, base_path=None):
 644:     """Checks 1-3 + app-integrity against a freshly written clone. Fail-closed.
 645: 
 646:     `name_as` is the filename the scan should judge the content AS. Callers that
 647:     stage to a temp path must pass the final name: the seal check and the
 648:     subject-class basis are both derived from the filename, and scanning
 649:     `FOO_REVIEW.html.staging` would compare the seal against the wrong stem.
 650: 
 651:     `delete_on_failure` is retained for direct callers, but clone_dashboard.py
 652:     now stages to a temp file and never asks the gate to delete anything at the
 653:     destination - see the stage-then-promote block there."""
 654:     with open(out_path, "r", encoding="utf-8", newline="") as fh:
 655:         src = fh.read()
 656:     hard, _ = scan(src, name_as or out_path)
 657:     # Inherited green verdict badge - only decidable with the base in hand,
 658:     # which is exactly the situation at clone time. See inherited_verdict().
 659:     if base_path and os.path.exists(base_path):
 660:         with open(base_path, "r", encoding="utf-8", newline="") as fh:
 661:             base_src = fh.read()
 662:         if inherited_verdict(src, base_src):
 663:             hard.append((os.path.basename(name_as or out_path),
 664:                          "inherited_verdict_badge",
 665:                          f"window.__verdict is byte-identical to the base "
 666:                          f"({os.path.basename(base_path)}) and reports "
 667:                          f"{verdict_grade(verdict_payload(src))!r} - this clone would "
 668:                          f"display a green verdict computed for a different app"))
 669:     if hard:
 670:         if delete_on_failure and os.path.exists(out_path):
 671:             os.unlink(out_path)
 672:         raise CloneContaminationError(
 673:             f"post-clone contamination gate FAILED for {out_path} "
 674:             f"({len(hard)} hard finding(s)); output deleted:\n  "
 675:             + "\n  ".join(f"[{c}] {d}" for _, c, d in hard[:12]))
 676:     return True
