'miss_return_cur': '''def get(obj, path):\\n    cur = obj\\n    for part in path.split(\".\"):\\n        if part == \"metadata\":\\n            return cur\\n        cur = cur[part]\\n    return cur\\n''',
'false_wildcard_string': '''def get(obj, path):\\n    marker = \"*\"\\n    for part in path.split(\".\"):\\n        obj = obj[part]\\n    return obj\\n''',
'false_after_walk': '''def get(obj, path):\\n    for part in path.split(\".\"):\\n        obj = obj[part]\\n    for item in (1,):\\n        return 7\\n    return obj\\n''',
'body_docstring': '''def get(obj, path):\\n    \"\"\"\\nnot indented\\n    \"\"\"\\n    for part in path.split(\".\"):\\n        if part == \"metadata\":\\n            return obj[part]\\n        obj = obj[part]\\n    return obj\\n'''
}
