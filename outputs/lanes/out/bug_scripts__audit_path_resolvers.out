"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import re, textwrap
DEF = re.compile(r\""'^([ '"\\t]*)def\\s+(\\w+)\\s*\\((["'^)]*)'"\\)\\s*:\", re.M)
SPLITS = re.compile(r\"\\.split\\(\\s*['\\\"]\\.['\\\"]\\s*\\)|\\.split\\(\\s*['\\\"]/['\\\"]\\s*\\)\")
WALKS = re.compile(r\"\\bfor\\s+\\w+(?:\\s*,\\s*\\w+)?\\s+in\\s+\")
def body_of(src,start,indent):
    lines=src[start:].split('\\n'); out=[lines[0]]
    for ln in lines[1:]:
        if ln.strip() and not ln.startswith(indent+' ') and not ln.startswith(indent+'\\t'):
            break
        out.append(ln)
    return '\\n'.join(out)
def scan(src):
    out=[]
    for m in DEF.finditer(src):
        body=body_of(src,m.start(),m.group(1))
        if not SPLITS.search(body) or not WALKS.search(body):
            continue
        reasons=[]; tail=body[WALKS.search(body).start():]
        if re.search(r\""'^'"\\s+return\\b(?"'!'"\\s*(None|obj|cur)\\s*"'$)", tail, re.M): reasons.append('"'returns')
        if re.search(r\""'^'"\\s+break\\b\", tail, re.M): reasons.append('breaks')
        if re.search(r\"['\\\"]\\*['\\\"]\", body): reasons.append('wildcard')
        out.append((m.group(2), reasons))
    return out
