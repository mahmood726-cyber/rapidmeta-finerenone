  70: # Adjudicated 2026-08-20 by reading each body. The four opened were chosen because they are
  71: # load-bearing: the projector feeds the manuscript a reader meets, and two are CHECKERS --
  72: # a checker with a silently widened resolver certifies rather than catches.
  73: ADJUDICATED = {
  74:     ("ssot/paper_projector.py", "get"): (
  75:         "CORRECT",
  76:         "Returns None ONLY on a missing segment (`else: return None`) and returns `cur` "
  77:         "only after consuming every segment. No wildcard. The early return is on ABSENCE, "
  78:         "which is the correct case for this shape."),
  79:     ("scripts/lint_refusal_citation_resolves.py", "resolve"): (
  80:         "CORRECT",
  81:         "Returns (False, None) only on a missing or malformed segment and (True, cur) only "
  82:         "after the full walk. IT IS THE ONLY RESOLVER IN THE CORPUS THAT EXPLICITLY "
  83:         "DISTINGUISHES 'resolved' FROM 'terminated early', by returning the boolean beside "
  84:         "the node -- which is the general form the wildcard bug violated."),
  85:     ("ssot/apply_reml_corpus.py", "main"): (
  86:         "CORRECT",
  87:         "Walks every segment but the last and reads the last by name; the `continue` "
  88:         "statements the sweep flagged are in the loop over PATHS, not over segments. It "
  89:         "would raise on a missing segment rather than widen, and its paths come from the "
  90:         "guard's own output."),
  91:     ("scripts/prose_claim_gate.py", "check"): (
  92:         "DEFECT",
  93:         "NOT the container-return bug -- a different narrowing, and real. It takes the "
  94:         "FIRST outcome's pooled interval (`for res in ...values(): pooled = ...; break`) "
  95:         "and then judges direction claims found ANYWHERE on the object against that one "
  96:         "interval. On an object with several pooled outcomes -- sglt2-hf has three -- the "
  97:         "interval judged against is whichever dict ordering puts first, and a claim about "
  98:         "outcome B is tested against outcome A's interval. Same family as reading the "
  99:         "primary by position rather than by identity. A GATE THAT NARROWS SILENTLY "
 100:         "CERTIFIES RATHER THAN CATCHES."),
 101: }
 102: 
 103: # A resolver: a def whose body splits a path and iterates the segments.
 104: DEF = re.compile(r"^([ 	]*)def\s+(\w+)\s*\(([^)]*)\)\s*:", re.M)
 105: # `\s*` NOT `[ 	]*` -- the first version used \s*, which under re.M consumed the
 106: # preceding NEWLINES into the indent capture, so every extracted body came back as two
 107: # empty lines and the sweep reported ZERO resolvers across 782 files. It returned
 108: # NOT_ASSESSABLE rather than a clean bill, which is the only reason it was noticed --
 109: # a matcher that matched and yielded nothing, in the file written to sweep for matchers
 110: # that resolve to the wrong thing.
 111: SPLITS = re.compile(r"\.split\(\s*['\"]\.['\"]\s*\)|\.split\(\s*['\"]/['\"]\s*\)")
 112: WALKS = re.compile(r"\bfor\s+\w+(?:\s*,\s*\w+)?\s+in\s+")
 113: 
 114: 
 115: def body_of(src, start, indent):
 116:     """The lines of a def, by indentation."""
 117:     lines = src[start:].split("\n")
 118:     out = [lines[0]]
 119:     for ln in lines[1:]:
 120:         if ln.strip() and not ln.startswith(indent + " ") and not ln.startswith(indent + "\t"):
 121:             break
 122:         out.append(ln)
 123:     return "\n".join(out)
 124: 
 125: 
 126: def main():
 127:     resolvers, flagged = 0, []
 128:     files = 0
 129:     for root in SEARCH:
 130:         if not os.path.isdir(root):
 131:             continue
 132:         for dirpath, _dirs, names in os.walk(root):
 133:             for nm in sorted(names):
 134:                 if not nm.endswith(".py"):
 135:                     continue
 136:                 fp = os.path.join(dirpath, nm)
 137:                 try:
 138:                     src = io.open(fp, encoding="utf-8", errors="replace").read()
 139:                 except Exception:
 140:                     continue
 141:                 files += 1
 142:                 for m in DEF.finditer(src):
 143:                     indent, name = m.group(1), m.group(2)
 144:                     body = body_of(src, m.start(), indent)
 145:                     if not SPLITS.search(body) or not WALKS.search(body):
 146:                         continue
 147:                     resolvers += 1
 148:                     reasons = []
 149:                     # Does it exit the walk without consuming every segment?
 150:                     walk_at = WALKS.search(body).start()
 151:                     tail = body[walk_at:]
 152:                     if re.search(r"^\s+return\b(?!\s*(None|obj|cur)\s*$)", tail, re.M):
 153:                         reasons.append("returns from inside the walk")
 154:                     if re.search(r"^\s+break\b", tail, re.M):
 155:                         reasons.append("breaks out of the walk")
 156:                     if re.search(r"['\"]\*['\"]", body):
 157:                         reasons.append("has a wildcard branch")
 158:                     if reasons:
 159:                         rel = os.path.relpath(fp, REPO).replace("\\", "/")
 160:                         flagged.append((rel, name, "; ".join(reasons)))
 161: 
 162:     print("python files read              %d" % files)
 163:     print("path resolvers found           %d" % resolvers)
 164:     print("with the container-return shape %d" % len(flagged))
 165:     print()
 166:     if resolvers == 0:
 167:         print("NOT_ASSESSABLE: found no path resolver at all across %d files. The matcher "
 168:               "is wrong, not the corpus." % files)
 169:         return 2
 170:     defect = [f for f in flagged if ADJUDICATED.get((f[0], f[1]), ("UNREAD",))[0] == "DEFECT"]
 171:     correct = [f for f in flagged if ADJUDICATED.get((f[0], f[1]), ("UNREAD",))[0] == "CORRECT"]
 172:     unread = [f for f in flagged if (f[0], f[1]) not in ADJUDICATED]
 173: 
 174:     print("  CONFIRMED DEFECT   %2d   a body was read and it widens" % len(defect))
 175:     print("  CONFIRMED CORRECT  %2d   a body was read and it does not" % len(correct))
 176:     print("  UNREAD             %2d   <- NOT A FINDING. Nobody has opened these."
 177:           % len(unread))
 178:     print()
 179:     for state, rows in (("DEFECT", defect), ("CORRECT", correct)):
 180:         for rel, name, why in sorted(rows):
 181:             verdict, reason = ADJUDICATED[(rel, name)]
 182:             print("[%s] %s::%s" % (verdict, rel, name))
 183:             print("    shape flagged: %s" % why)
 184:             print("    verdict      : %s" % reason)
 185:             print()
 186:     if unread:
 187:         print("THE REFERENCE IMPLEMENTATION IS scripts/lint_refusal_citation_resolves.py::")
 188:         print("resolve. It is the only resolver in this corpus that RETURNS THE ANSWER TO")
 189:         print("'did this path resolve?' BESIDE THE NODE -- `(ok, node)` -- so a caller")
 190:         print("cannot mistake an intermediate container for a leaf, which is the exact")
 191:         print("mistake the wildcard made. READ EACH BODY BELOW AGAINST THAT ONE: the")
 192:         print("question is whether it can exit the walk with segments remaining, and")
 193:         print("whether its caller could tell if it did. That makes each reading a")
 194:         print("COMPARISON rather than a fresh judgement.")
 195:         print()
 196:         print("UNREAD -- flagged by shape and never opened. THE SHAPE IS A REASON TO READ")
 197:         print("THE BODY AND NOTHING ELSE. A resolver that returns early on a MISSING segment")
 198:         print("is correct; one that returns early on a PRESENT segment while segments remain")
 199:         print("is the defect. These counts must not be quoted as defects:")
 200:         print()
 201:         print("%-56s %-22s %s" % ("file", "function", "why it has the shape"))
 202:         print("-" * 130)
 203:         for rel, name, why in sorted(unread):
 204:             print("%-56s %-22s %s" % (rel, name, why))
 205:         print()
 206:         print("REPORTED WITH %d UNREAD. This is not a clean bill and it is not a defect "
 207:               "count; it is a reading list." % len(unread))
 208:     return 0
 209: 
 210: 
 211: if __name__ == "__main__":
 212:     sys.exit(main())

