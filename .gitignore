PROGRESS.md
STUCK_FAILURES.md
STUCK_FAILURES.jsonl
sentinel-findings.md
sentinel-findings.jsonl

# Auto-generated review/audit traces (per-session, not portable)
review-findings*.md

# Backup and packaging artifacts
*.htmlxx
*.bak.html
editorial_pack_*/
*.zip
generate_log.txt
.claude/worktrees/
.claude/settings.local.json

# P1-1 + P2-9: R-validation intermediate artifacts. The .json output is the
# audit trail; .input.json + .input.sha256 + .error.log are plumbing.
outputs/r_validation/**/*.input.json
outputs/r_validation/**/*.input.sha256
outputs/r_validation/**/*.error.log

.truthcert_8agent.key

# auto-generated audit-first clone configs (build artifacts)
scripts/configs/_audit_*.json
outputs/_bulk*.log
outputs/_jscheck_all.log

# Node toolchain (terser pulled in by scripts/minify_*.mjs)
node_modules/
package-lock.json

# JS parse-gate state
.js_parse_failures.log
.sentinel_bypass.log

# Scratch / one-shot diagnostic helpers (everything in scripts/ that
# starts with _ is a probe; production tools have plain names)
scripts/_*.py
scripts/_*.mjs

# .git commit-message drafts
.git/COMMIT_EDITMSG_v*
.git/staged.txt

# Lighthouse audit dumps (regenerated per session)
outputs/lighthouse/

# Pre-existing broken file with a JS syntax bug (untracked since inception).
# Sentinel R8 will warn until it's repaired or removed.
HIV_NEXTGEN_ART_REVIEW.html

outputs/app_quality_audit.json
outputs/poolability_remove_candidates.json
# Regenerable data-integrity audit snapshot (the live test re-runs the audit;
# this file is only a human-readable dump and goes stale -- don't track it).
outputs/data_integrity_audit_current.json

# Runtime/workflow state (regenerated; not source)
.workflow-state/

# Generated full-functionality / critical-care extraction-audit traces.
# Regenerable diagnostics (many are realData_parse_error reports). The curated
# extraction outputs (*_AUTO_REVIEW.json, *_NMA_REVIEW.json, ...) stay tracked;
# these full-audit passes do not.
outputs/extraction_audit/data/*_FULL_REVIEW.json
outputs/extraction_audit/data/*_ICU_REVIEW.json
outputs/extraction_audit/data/*_REVERSAL_REVIEW.json

# render_check.py writes this into a page directory to share its file:// origin
blank__rmwave.html
# --- Pages slim-down 2026-08-06 -------------------------------------
# Data, cache and audit artefacts. Untracked from the published branch
# because GitHub Pages publishes this branch and the site had grown past
# the 1 GB limit, which made the build fail rather than merely be large.
# Every path here was checked to be referenced by NO served file --
# not by href/src/fetch, and not even mentioned in page text.
# Files remain on disk and in git history; only the published tree shrinks.
outputs/audit40/
outputs/ctgov/
outputs/ctgov_cache/
outputs/ctgov_denom/
outputs/extraction_audit/8agent_chunks/
outputs/extraction_audit/agent_inputs/
outputs/extraction_audit/agent_partitions/
outputs/extraction_audit/data/
outputs/extraction_audit/evidence_patches/
outputs/extraction_audit/pmc_cache/
outputs/extraction_audit/pubmed_cache/
outputs/extraction_audit/quarantine/
outputs/extraction_audit/retraction_watch/
outputs/pmid_resolver/
outputs/r_parity/
outputs/stat_engine/
outputs/_pubmed_cache.json
outputs/_pmid_reaudit.json
# Mixed directories: the referenced files inside them are ALREADY TRACKED,
# and .gitignore does not untrack anything, so these survive. This only
# stops the untracked cache siblings from being re-added by 'git add -A'.
outputs/new_topics/
outputs/extraction_audit/
outputs/*.json
outputs/*.csv

# Evidence archive: preservation beats hygiene. The only surviving copy of a
# day of generator work was a .pyc, and *.pyc above silently excluded it from
# the commit that existed to preserve it.
!evidence/**/*.pyc
build-artefacts/

