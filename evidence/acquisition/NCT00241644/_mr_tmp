<?xml version="1.0"  ?><!DOCTYPE pmc-articleset PUBLIC "-//NLM//DTD ARTICLE SET 2.0//EN" "https://dtd.nlm.nih.gov/ncbi/pmc/articleset/nlm-articleset-2.0.dtd"><pmc-articleset><article article-type="research-article" xml:lang="en" dtd-version="1.4"><front><journal-meta><journal-id journal-id-type="nlm-ta">Vaccine</journal-id><journal-id journal-id-type="iso-abbrev">Vaccine</journal-id><journal-id journal-id-type="pmc-domain-id">358</journal-id><journal-id journal-id-type="pmc-domain">wtpa</journal-id><journal-id journal-id-type="nlm-id">8406899</journal-id><journal-title-group><journal-title>Vaccine</journal-title></journal-title-group><issn pub-type="ppub">0264-410X</issn><issn pub-type="epub">1873-2518</issn><custom-meta-group><custom-meta><meta-name>pmc-is-collection-domain</meta-name><meta-value>yes</meta-value></custom-meta><custom-meta><meta-name>pmc-collection-title</meta-name><meta-value>UKPMC Funders Author Manuscripts</meta-value></custom-meta></custom-meta-group></journal-meta><article-meta><article-id pub-id-type="pmcid">PMC3982044</article-id><article-id pub-id-type="pmcid-ver">PMC3982044.1</article-id><article-id pub-id-type="pmcaid">3982044</article-id><article-id pub-id-type="pmcaiid">3982044</article-id><article-id pub-id-type="manuscript-id">EMS58002</article-id><article-id pub-id-type="pmid">22520135</article-id><article-id pub-id-type="doi">10.1016/j.vaccine.2011.09.120</article-id><article-id pub-id-type="manuscript-id-alternative">EMS58002</article-id><article-id pub-id-type="manuscript-id-alternative">WTPA58002</article-id><article-id pub-id-type="manuscript-id-alternative">WTMS58002</article-id><article-id pub-id-type="manuscript-id-alternative">UKMS58002</article-id><article-version article-version-type="pmc-version">1</article-version><article-categories><subj-group subj-group-type="heading"><subject>Article</subject></subj-group></article-categories><title-group><article-title>Efficacy of human rotavirus vaccine against severe gastroenteritis in Malawian children in the first two years of life: a randomised, double-blind, placebo controlled trial</article-title></title-group><contrib-group><contrib contrib-type="author"><name name-style="western"><surname>Cunliffe</surname><given-names initials="NA">Nigel A</given-names></name><xref ref-type="aff" rid="A1">1</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Witte</surname><given-names initials="D">Desiree</given-names></name><xref ref-type="aff" rid="A1">1</xref><xref ref-type="aff" rid="A2">2</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Ngwira</surname><given-names initials="BM">Bagrey M</given-names></name><xref ref-type="aff" rid="A2">2</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Todd</surname><given-names initials="S">Stacy</given-names></name><xref ref-type="aff" rid="A1">1</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Bostock</surname><given-names initials="NJ">Nancy J</given-names></name><xref ref-type="aff" rid="A1">1</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Turner</surname><given-names initials="AM">Ann M</given-names></name><xref ref-type="aff" rid="A1">1</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Chimpeni</surname><given-names initials="P">Philips</given-names></name><xref ref-type="aff" rid="A2">2</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Victor</surname><given-names initials="JC">John C</given-names></name><xref ref-type="aff" rid="A3">3</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Steele</surname><given-names initials="AD">A Duncan</given-names></name><xref ref-type="aff" rid="A3">3</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Bouckenooghe</surname><given-names initials="A">Alain</given-names></name><xref ref-type="aff" rid="A4">4</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Neuzil</surname><given-names initials="KM">Kathleen M</given-names></name><xref ref-type="aff" rid="A3">3</xref></contrib></contrib-group><aff id="A1"><label>1</label>Department of Clinical Infection, Microbiology and Immunology, Institute of Infection and Global Health, University of Liverpool, Liverpool, United Kingdom
