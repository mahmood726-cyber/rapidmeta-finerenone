</article-categories><title-group><article-title>Bone Changes with Long-Acting Cabotegravir or Tenofovir Disoproxil Fumarate/ Emtricitabine for HIV Prevention in Cisgender Men and Transgender Women: HPTN 083</article-title></title-group><contrib-group><contrib contrib-type="author"><name name-style="western"><surname>Brown</surname><given-names initials="TT">Todd T.</given-names></name><xref rid="A1" ref-type="aff">1</xref><xref rid="CR1" ref-type="corresp">*</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Arao</surname><given-names initials="RF">Robert F</given-names></name><xref rid="A2" ref-type="aff">2</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Warsi</surname><given-names initials="M">Maryam</given-names></name><xref rid="A2" ref-type="aff">2</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Phanuphak</surname><given-names initials="N">Nittaya</given-names></name><xref rid="A3" ref-type="aff">3</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Vasconcelos</surname><given-names initials="R">Ricardo</given-names></name><xref rid="A4" ref-type="aff">4</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Oyedele</surname><given-names initials="T">Temitope</given-names></name><xref rid="A5" ref-type="aff">5</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Sullivan</surname><given-names initials="PA">Philip A.</given-names></name><xref rid="A1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Hanscom</surname><given-names initials="B">Brett</given-names></name><xref rid="A2" ref-type="aff">2</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Rooney</surname><given-names initials="JF">James F.</given-names></name><xref rid="A6" ref-type="aff">6</xref></contrib><contrib contrib-type="aut